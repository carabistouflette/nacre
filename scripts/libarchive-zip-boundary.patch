+int
+archive_mstring_copy_utf8_len(struct archive_mstring *aes, const char *utf8,
+    size_t len)
+{
+	if (utf8 == NULL) {
+		aes->aes_set = 0;
+		return (0);
+	}
+	aes->aes_set = AES_SET_UTF8;
+	archive_string_empty(&(aes->aes_mbs));
+	archive_string_empty(&(aes->aes_wcs));
+	if (archive_strncpy(&(aes->aes_utf8), utf8, len) == NULL) {
+		aes->aes_set = 0;
+		errno = ENOMEM;
+		return (-1);
+	}
+	return (0);
+}
