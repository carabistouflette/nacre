{
  "Main function": {
    "prefix": "main",
    "body": [
      "void main() {",
      "    $0",
      "}"
    ],
    "description": "Declare the Nacre program entry point"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    $0",
      "}"
    ],
    "description": "Declare a class"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "    $0",
      "}"
    ],
    "description": "Declare a Nacre interface"
  },
  "Constructor": {
    "prefix": "constructor",
    "body": [
      "public ${1:Name}(${2}) {",
      "    $0",
      "}"
    ],
    "description": "Declare a class constructor"
  },
  "Readonly method": {
    "prefix": "readonly-method",
    "body": [
      "public readonly ${1:void} ${2:methodName}(${3}) {",
      "    $0",
      "}"
    ],
    "description": "Declare an instance method that cannot mutate its receiver"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while (${1:true}) {",
      "    $0",
      "}"
    ],
    "description": "Loop while a condition is true"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if (${1:true}) {",
      "    ${2}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Branch on a boolean condition"
  },
  "List declaration": {
    "prefix": "list",
    "body": [
      "List<${1:int}> ${2:items} = new List<${1:int}>();"
    ],
    "description": "Declare and initialize a typed List"
  },
  "Text declaration": {
    "prefix": "text",
    "body": [
      "Text ${1:text} = new Text(\"${2}\");"
    ],
    "description": "Declare and initialize a Text value"
  },
  "Borrowed parameter": {
    "prefix": "borrow",
    "body": [
      "borrow ${1:Type} ${2:value}"
    ],
    "description": "Declare an immutable borrowed parameter type"
  },
  "Enum declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Choice}<${2:T}> {",
      "    ${3:None};",
      "    ${4:Some}(${2:T});",
      "}"
    ],
    "description": "Declare a generic enum and its variants"
  },
  "Variant construction": {
    "prefix": "variant",
    "body": [
      "new Option<int>.Some(${1:42})"
    ],
    "description": "Construct a payload-carrying Option variant"
  },
  "Consuming match": {
    "prefix": "match",
    "body": [
      "match (${1:option}) {",
      "    Some(${2:value}) {",
      "        ${3}",
      "    }",
      "    None {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Exhaustively consume an Option and bind its payload"
  },
  "Receiver-bound borrowed getter": {
    "prefix": "getref",
    "body": [
      "public readonly borrow ${1:Text} ${2:getValue}() {",
      "    return this.${3:value};",
      "}"
    ],
    "description": "Return shared access tied to the receiver"
  },
  "Exclusive list element": {
    "prefix": "listmut",
    "body": [
      "borrow mut ${1:Contact} ${2:contact} = ${3:contacts}.getMut(${4:0});"
    ],
    "description": "Borrow a nominal list element without extracting it"
  },
  "Borrowed enum match": {
    "prefix": "bmatch",
    "body": [
      "match (borrow ${1:option}) {",
      "    Some(${2:value}) {",
      "        ${3}",
      "    }",
      "    None {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Exhaustively inspect an Option without consuming it"
  },
  "Copied list traversal": {
    "prefix": "foreach",
    "body": [
      "for (${1:int} ${2:value} : ${3:numbers}) {",
      "    $0",
      "}"
    ],
    "description": "Traverse copied primitive elements under a shared list loan"
  },
  "Shared list traversal": {
    "prefix": "foreachref",
    "body": [
      "for (borrow ${1:Contact} ${2:contact} : ${3:contacts}) {",
      "    $0",
      "}"
    ],
    "description": "Traverse affine elements without extracting ownership"
  },
  "Exclusive list traversal": {
    "prefix": "foreachmut",
    "body": [
      "for (borrow mut ${1:Contact} ${2:contact} : ${3:contacts}) {",
      "    $0",
      "}"
    ],
    "description": "Mutate affine elements while the whole list is exclusively borrowed"
  },
  "Recoverable list removal": {
    "prefix": "tryremove",
    "body": [
      "match (${1:items}.tryRemove(${2:0})) {",
      "    Some(${3:value}) {",
      "        ${4}",
      "    }",
      "    None {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Remove an element without aborting on an invalid index"
  },
  "Integer-keyed map": {
    "prefix": "map",
    "body": [
      "Map<int,${1:Text}> ${2:entries} = new Map<int,${1:Text}>();"
    ],
    "description": "Own values under stable signed integer keys"
  },
  "Shared map value": {
    "prefix": "mapref",
    "body": [
      "borrow ${1:Contact} ${2:contact} = ${3:entries}.getRef(${4:1});"
    ],
    "description": "Borrow an affine map value while retaining a whole-map shared loan"
  },
  "Exclusive map value": {
    "prefix": "mapmut",
    "body": [
      "borrow mut ${1:Contact} ${2:contact} = ${3:entries}.getMut(${4:1});"
    ],
    "description": "Mutate an affine map value under an exclusive whole-map loan"
  },
  "Copied map traversal": {
    "prefix": "mapfor",
    "body": [
      "for (int ${1:key}, ${2:int} ${3:value} : ${4:counts}) {",
      "    $0",
      "}"
    ],
    "description": "Traverse copied map values under a shared whole-map loan"
  },
  "Shared map traversal": {
    "prefix": "mapforeachref",
    "body": [
      "for (int ${1:key}, borrow ${2:Contact} ${3:value} : ${4:entries}) {",
      "    $0",
      "}"
    ],
    "description": "Traverse affine map values under a shared whole-map loan"
  },
  "Exclusive map traversal": {
    "prefix": "mapforeachmut",
    "body": [
      "for (int ${1:key}, borrow mut ${2:Contact} ${3:value} : ${4:entries}) {",
      "    $0",
      "}"
    ],
    "description": "Mutate affine map values under an exclusive whole-map loan"
  },
  "Text-keyed map": {
    "prefix": "textmap",
    "body": [
      "Map<Text,int> ${1:counts} = new Map<Text,int>();"
    ],
    "description": "Declare a map that owns exact Text keys"
  },
  "Shared text key with copied value": {
    "prefix": "textmapfor",
    "body": [
      "for (borrow Text ${1:key}, int ${2:count} : ${3:counts}) {",
      "    ${1:key}.print();",
      "    println(${2:count});",
      "    $0",
      "}"
    ],
    "description": "Read an owned Text key and copy its primitive value"
  },
  "Mutable value with shared text key": {
    "prefix": "textmapforeachmut",
    "body": [
      "for (borrow Text ${1:key}, borrow mut Counter ${2:counter} : ${3:counters}) {",
      "    ${1:key}.print();",
      "    ${2:counter}.increment();",
      "    $0",
      "}"
    ],
    "description": "Keep the Text key shared while mutating its borrowed value"
  },
  "Recoverable map removal": {
    "prefix": "mapremove",
    "body": [
      "match (${1:entries}.tryRemove(${2:1})) {",
      "    Some(${3:value}) {",
      "        ${4}",
      "    }",
      "    None {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Transfer a map value or preserve the map when its key is absent"
  },
  "Owned task thread": {
    "prefix": "nacre-task",
    "body": [
      "class ValueTask implements Task<long> {",
      "    long value;",
      "    public ValueTask(long value) { this.value = value; }",
      "    public long run() { return this.value; }",
      "}",
      "",
      "void main() {",
      "    Result<Thread<long>, Text> started = Thread<long>.spawn(new ValueTask(${1:42L}));",
      "    match (started) {",
      "        Ok(worker) {",
      "            match (worker.join()) {",
      "                Ok(value) { println(value); }",
      "                Err(error) { error.print(); }",
      "            }",
      "        }",
      "        Err(error) { error.print(); }",
      "    }",
      "}"
    ],
    "description": "Transfer a concrete Task to an owned thread and join its result"
  },
  "Bounded channel": {
    "prefix": "nacre-channel",
    "body": [
      "Result<Channel<Text>, Text> created = Channel<Text>.bounded(${1:2L});",
      "match (created) {",
      "    Ok(channel) {",
      "        match (channel.takeSender()) {",
      "            Ok(sender) {",
      "                match (channel.takeReceiver()) {",
      "                    Ok(receiver) {",
      "                        match (sender.send(new Text(\"${2:message}\"))) {",
      "                            Ok(sent) {}",
      "                            Err(failure) {",
      "                                match (failure) {",
      "                                    Closed(value) { value.print(); }",
      "                                    System(message, value) { message.print(); value.print(); }",
      "                                }",
      "                            }",
      "                        }",
      "                        match (sender.close()) {",
      "                            Ok(done) {}",
      "                            Err(error) { error.print(); }",
      "                        }",
      "                        match (receiver.receive()) {",
      "                            Ok(item) {",
      "                                match (item) {",
      "                                    Some(value) { value.print(); }",
      "                                    None {}",
      "                                }",
      "                            }",
      "                            Err(error) { error.print(); }",
      "                        }",
      "                    }",
      "                    Err(error) { error.print(); }",
      "                }",
      "            }",
      "            Err(error) { error.print(); }",
      "        }",
      "    }",
      "    Err(error) { error.print(); }",
      "}"
    ],
    "description": "Transfer a value through one sender and receiver with explicit closure"
  },
  "TCP connection": {
    "prefix": "nacre-tcp",
    "body": [
      "Text host = new Text(\"${1:127.0.0.1}\");",
      "Result<List<SocketAddress>, Text> resolved = SocketAddress.resolve(host, ${2:8080}, false);",
      "match (resolved) {",
      "    Ok(addresses) {",
      "        if (addresses.size() > 0) {",
      "            borrow SocketAddress address = addresses.getRef(0);",
      "            match (TcpStream.connect(address, ${3:5000L})) {",
      "                Ok(stream) {",
      "                    match (stream.close()) {",
      "                        Ok(done) {}",
      "                        Err(error) { error.print(); }",
      "                    }",
      "                }",
      "                Err(error) { error.print(); }",
      "            }",
      "        }",
      "    }",
      "    Err(error) { error.print(); }",
      "}"
    ],
    "description": "Resolve a host and connect with a bounded timeout"
  },
  "Process output": {
    "prefix": "nacre-process",
    "body": [
      "Text executableText = new Text(\"${1:/usr/bin/printf}\");",
      "match (Path.fromText(executableText)) {",
      "    Ok(executable) {",
      "        Command command = Command.create(executable);",
      "        match (command.addArg(new Text(\"${2:hello from Nacre}\"))) {",
      "            Ok(added) {",
      "                match (command.output(1024L, ${3:5000L})) {",
      "                    Ok(output) {",
      "                        borrow ByteBuffer stdout = output.stdout();",
      "                        long index = 0L;",
      "                        while (index < stdout.length()) {",
      "                            println(stdout.get(index));",
      "                            index = index + 1L;",
      "                        }",
      "                        if (output.stdoutTruncated()) { println(\"Captured output was truncated\"); }",
      "                    }",
      "                    Err(error) { error.print(); }",
      "                }",
      "            }",
      "            Err(error) { error.print(); }",
      "        }",
      "    }",
      "    Err(error) { error.print(); }",
      "}"
    ],
    "description": "Capture a process output stream without invoking a shell"
  }
}
