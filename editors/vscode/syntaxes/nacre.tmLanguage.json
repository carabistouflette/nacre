{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nacre",
  "scopeName": "source.nacre",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#character-literals" },
    { "include": "#enum-declarations" },
    { "include": "#class-interface-declarations" },
    { "include": "#trait-declarations" },
    { "include": "#new-expressions" },
    { "include": "#generic-types" },
    { "include": "#keywords" },
    { "include": "#built-in-types" },
    { "include": "#member-functions" },
    { "include": "#member-fields" },
    { "include": "#match-arm-variants" },
    { "include": "#function-names" },
    { "include": "#type-names" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nacre",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nacre",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.nacre" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.nacre" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nacre",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.nacre" }
          },
          "end": "(\"|$)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.nacre" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nacre",
              "match": "\\\\(?:[nrt0\"'\\\\])"
            },
            {
              "name": "invalid.illegal.escape.nacre",
              "match": "\\\\(?:[^nrt0\"'\\\\]|$)"
            }
          ]
        }
      ]
    },
    "character-literals": {
      "patterns": [
        {
          "name": "string.quoted.single.nacre",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.nacre" }
          },
          "end": "('|$)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.nacre" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nacre",
              "match": "\\\\(?:[nrt0\"'\\\\]|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "invalid.illegal.escape.nacre",
              "match": "\\\\(?:[^nrt0\"'\\\\]|$)"
            }
          ]
        }
      ]
    },
    "enum-declarations": {
      "patterns": [
        {
          "name": "meta.enum.declaration.nacre",
          "begin": "\\b(enum)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*(?:<[^>]+>)?\\s*)(\\{)",
          "beginCaptures": {
            "1": { "name": "storage.type.enum.nacre" },
            "3": { "name": "entity.name.type.enum.nacre" },
            "5": { "name": "punctuation.section.block.begin.nacre" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.nacre" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            {
              "name": "entity.name.enum-variant.nacre",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:\\(|;))"
            },
            { "include": "#generic-types" },
            { "include": "#built-in-types" },
            { "include": "#type-names" }
          ]
        }
      ]
    },
    "class-interface-declarations": {
      "patterns": [
        {
          "name": "meta.generic.type-declaration.nacre",
          "begin": "\\b(class|interface)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(<)",
          "beginCaptures": {
            "1": { "name": "storage.type.class.nacre" },
            "3": { "name": "entity.name.type.class.nacre" },
            "5": { "name": "punctuation.definition.typeparameters.begin.nacre" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.nacre" }
          },
          "patterns": [
            { "include": "#generic-arguments" }
          ]
        },
        {
          "match": "\\b(class|interface)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.nacre" },
            "3": { "name": "entity.name.type.class.nacre" }
          }
        }
      ]
    },

    "trait-declarations": {
      "patterns": [
        {
          "match": "\\b(trait)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.trait.nacre" },
            "3": { "name": "entity.name.type.trait.nacre" }
          }
        }
      ]
    },
    "new-expressions": {
      "patterns": [
        {
          "name": "meta.object.creation.nacre",
          "begin": "\\bnew\\b",
          "beginCaptures": {
            "0": { "name": "keyword.operator.new.nacre" }
          },
          "end": "(?=\\s*\\()",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#generic-list" },
            { "include": "#generic-builtin" },
            { "include": "#generic-any-type" },
            { "include": "#built-in-types" },
            {
              "name": "entity.name.enum-variant.nacre",
              "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
            },
            {
              "name": "entity.name.type.nacre",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "generic-types": {
      "patterns": [
        { "include": "#generic-list" },
        { "include": "#generic-builtin" },
        { "include": "#generic-type" }
      ]
    },
    "generic-list": {
      "name": "meta.generic.nacre",
      "begin": "\\b(List)(\\s*)(<)",
      "beginCaptures": {
        "1": { "name": "support.type.builtin.nacre" },
        "3": { "name": "punctuation.definition.typeparameters.begin.nacre" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.nacre" }
      },
      "patterns": [
        { "include": "#generic-arguments" }
      ]
    },
    "generic-type": {
      "name": "meta.generic.nacre",
      "begin": "\\b([A-Z][A-Za-z0-9_]*)(\\s*)(<)",
      "beginCaptures": {
        "1": { "name": "entity.name.type.nacre" },
        "3": { "name": "punctuation.definition.typeparameters.begin.nacre" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.nacre" }
      },
      "patterns": [
        { "include": "#generic-arguments" }
      ]
    },
    "generic-any-type": {
      "name": "meta.generic.nacre",
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*)(<)",
      "beginCaptures": {
        "1": { "name": "entity.name.type.nacre" },
        "3": { "name": "punctuation.definition.typeparameters.begin.nacre" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.nacre" }
      },
      "patterns": [
        { "include": "#generic-arguments" }
      ]
    },
    "generic-arguments": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#generic-list" },
        { "include": "#generic-builtin" },
        { "include": "#generic-any-type" },
        {
          "name": "storage.modifier.ownership.nacre",
          "match": "\\b(?:borrow|mut)\\b"
        },
        { "include": "#built-in-types" },
        {
          "name": "entity.name.type.nacre",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.type.nacre",
          "match": ","
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.nacre",
          "match": "\\b(?:borrow|mut)\\b"
        },
        {
          "name": "storage.modifier.nacre",
          "match": "\\b(?:public|private|static|readonly|async)\\b"
        },
        {
          "name": "keyword.control.nacre",
          "match": "\\b(?:enum|match|if|else|while|for|return|break|continue|await)\\b"
        },
        {
          "name": "keyword.other.nacre",
          "match": "\\b(?:implements|this|module|import|trait|impl)\\b"
        },
        {
          "name": "keyword.operator.new.nacre",
          "match": "\\bnew\\b"
        },
        {
          "name": "constant.language.boolean.nacre",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "built-in-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.nacre",
          "match": "\\b(?:byte|char|int|long|double|boolean|Unit|void)\\b"
        },
        {
          "name": "support.type.builtin.nacre",
          "match": "\\b(?:String|Array|Arrays|List|Map|Set|Deque|Comparator|Text|Option|Result|ByteBuffer|Regex|RegexMatch|Console|Files|Args|Math|Random|Time|Path|File|FileInfo|Directory|Env|Command|Process|ExitStatus|ProcessOutput|Task|Thread|Mutex|Guard|Channel|Sender|Receiver|SendError|SocketAddress|TcpListener|TcpStream|UdpSocket|Datagram|TlsConfig|TlsStream|Uri|WebSocket|WebSocketMessage)\\b"
        },
        {
          "name": "support.type.builtin.nacre",
          "match": "\\b(?:BigInt|BigDecimal|RoundingMode|OrderedMap|OrderedSet|PriorityQueue|BitSet|Pair|RefMapper|Folder|Iterator|Mapper|Predicate|ListIterator|MapIterator|FilterIterator|TakeIterator|SkipIterator|Iterators|Hasher|Unicode|Character|Charset|Locale|CryptoKey|CryptoDigest|CryptoMac|Certificate|Encoding|Crypto|ByteSource|ByteSink|StreamError|Streams|BinaryReader|BinaryWriter|Codec|Serialization|ByteCodec|CharCodec|UnitCodec|IntCodec|LongCodec|DoubleCodec|BooleanCodec|TextCodec|ListCodec|OptionCodec|ResultCodec|UuidCodec|BytesCodec|Uuid|WatchKind|Watcher|WatchEvent|ZipReader|ZipWriter|ZipEntry|Compression|Checksums|DateFields|CalendarFields|DateTime|Temporal|XmlDocument|XmlReader|XmlEvent|XmlWriter|XsltStylesheet|HttpRequest|HttpResponse|Dns|AtomicInt|AtomicLong|AtomicBoolean|Semaphore|CountDownLatch|Barrier|Condition|CancellationToken|CancelableTask|Future|ThreadPool|SubmitError|Database|SqlStatement)\\b"
        }
      ]
    },
    "generic-builtin": {
      "name": "meta.generic.nacre",
      "begin": "\\b(Option|Result|List|Deque|Set|Comparator|Hasher|Array|Map|OrderedMap|OrderedSet|PriorityQueue|Pair|RefMapper|Folder|Iterator|Mapper|Predicate|ListIterator|MapIterator|FilterIterator|TakeIterator|SkipIterator|Iterators|Task|Thread|Mutex|Guard|Channel|Sender|Receiver|Condition|CancelableTask|Future|ThreadPool|Codec|Serialization|ListCodec|OptionCodec|ResultCodec)(\\s*)(<)",
      "beginCaptures": {
        "1": { "name": "support.type.builtin.nacre" },
        "3": { "name": "punctuation.definition.typeparameters.begin.nacre" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.nacre" }
      },
      "patterns": [
        { "include": "#generic-arguments" }
      ]
    },
    "member-functions": {
      "patterns": [
        {
          "match": "(?<=\\.)(\\s*)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "2": { "name": "entity.name.function.member.nacre" }
          }
        }
      ]
    },
    "member-fields": {
      "patterns": [
        {
          "name": "variable.other.property.nacre",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "match-arm-variants": {
      "patterns": [
        {
          "name": "meta.match.arm.nacre",
          "begin": "\\b([A-Z][A-Za-z0-9_]*)(\\s*)(\\()(?=\\s*(?:[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)?\\s*\\)\\s*\\{)",
          "beginCaptures": {
            "1": { "name": "entity.name.enum-variant.nacre" },
            "3": { "name": "punctuation.section.group.begin.nacre" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.nacre" }
          },
          "patterns": [
            {
              "name": "variable.parameter.match.nacre",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        },
        {
          "name": "entity.name.enum-variant.nacre",
          "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\s*\\{)"
        }
      ]
    },
    "function-names": {
      "patterns": [
        {
          "name": "entity.name.function.nacre",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "entity.name.type.nacre",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*(?:[=;,()]))",
          "captures": {
            "1": { "name": "entity.name.type.nacre" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nacre",
          "match": "(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+"
        },
        {
          "name": "constant.numeric.integer.long.nacre",
          "match": "\\b[0-9]+L\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.nacre",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nacre",
          "match": "(?:==|!=|<=|>=|&&|\\|\\||<<|>>|[+*/%!=<>?&|^~-])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nacre",
          "match": "[;,:\\.]"
        },
        {
          "name": "punctuation.section.group.nacre",
          "match": "[(){}]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nacre",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
