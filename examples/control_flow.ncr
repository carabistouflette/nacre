void main() {
    int i = 0;
    int total = 0;
    while (i < 20) {
        i = i + 1;
        if (i % 2 == 0) {
            continue;
        }
        if (i > 9) {
            break;
        }
        total = total + i;
    }
    println(total); // 1 + 3 + 5 + 7 + 9 = 25
    println(false && (10 / 0 > 1)); // Aucun calcul de 10 / 0.
}
