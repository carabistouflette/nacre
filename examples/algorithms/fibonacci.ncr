public class Main {
    public static int fib(int n) {
        if (n <= 1) {
            return n;
        }
        return fib(n - 1) + fib(n - 2);
    }

    public static void main() {
        System.out.println("Fibonacci from 0 to 10:");
        int i = 0;
        while (i <= 10) {
            System.out.println(fib(i));
            i = i + 1;
        }
    }
}
