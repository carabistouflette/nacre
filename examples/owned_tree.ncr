class Node {
    private int value;
    private List<Node> children = new List<Node>();
    public Node(int value) { this.value = value; }
    public void add(Node child) { this.children.add(child); }
    public Node detachLast() { return this.children.pop(); }
    public readonly int getValue() { return this.value; }
}
void main() {
    Node root = new Node(1);
    root.add(new Node(2));
    root.add(new Node(3));
    Node detached = root.detachLast();
    drop(root); // Detruit le sous-arbre restant; pas detached.
    println(detached.getValue());
}
