class Box {
    int value;
    Box(int value) { this.value = value; }
}
void main() {
    Box current = new Box(0);
    int i = 0;
    while (i < 4) {
        i = i + 1;
        drop(current);
        if (i < 3) {
            current = new Box(i);
            continue;
        }
        current = new Box(i * 10);
    }
    println(current.value);
}
