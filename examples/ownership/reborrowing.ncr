class Counter {
    int value = 0;
    void increment() { value = value + 1; }
    readonly int getValue() { return value; }
}
void main() {
    Counter counter = new Counter();
    {
        borrow mut Counter editor = counter;
        editor.increment();
        {
            borrow Counter reader = editor;
            println(reader.getValue());
            // This shared reborrow prevents exclusive access while reader exists.
        }
        editor.increment();
        println(editor.getValue());
    }
    println(counter.getValue());
}
