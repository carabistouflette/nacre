class Counter {
    private int value;
    Counter(int value) { this.value = value; }
    void increment() { this.value = this.value + 1; }
    readonly int getValue() { return this.value; }
}

// A borrowed-field view is scoped to the lifetime of its owner.
class CounterView {
    private borrow Counter target;
    private String title;

    CounterView(borrow Counter target, String title) {
        this.target = target;
        this.title = title;
    }
    readonly void display() {
        println(this.title);
        println(this.target.getValue());
    }
}

void main() {
    Counter counter = new Counter(42);
    {
        CounterView view = new CounterView(counter, "Shared counter");
        view.display();
        // counter.increment() would be rejected while view borrows it.
    } // view is destroyed, but not the object it borrows.
    counter.increment();
    println(counter.getValue());
}
