String salutation(boolean formel) {
    if (formel) {
        return "Bonjour !";
    } else {
        return "Salut !";
    }
}

void main() {
    String texte = "Une chaîne UTF-8, sans objet alloué par le langage.";
    println(texte);
    println(salutation(false));
    println("Une ligne\net une autre.");
}
