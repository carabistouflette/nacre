interface Animal {
    readonly void speak();
}

class Dog implements Animal {
    public readonly void speak() { println("Woof!"); }
}

class Cat implements Animal {
    public readonly void speak() { println("Meow!"); }
}

void speakTwice(borrow Animal animal) {
    animal.speak();
    animal.speak();
}

void main() {
    Animal animal = new Dog();
    speakTwice(animal);
    // Replacing the animal destroys the Dog and keeps the Cat.
    animal = new Cat();
    animal.speak();
}
