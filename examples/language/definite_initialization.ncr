class Message {
    String text;
    Message(String text) { this.text = text; }
    void print() { println(text); }
}

void show(boolean firstBranch) {
    Message message;
    if (firstBranch) {
        message = new Message("Initialized through the first branch.");
    } else {
        message = new Message("Initialized through the second branch.");
    }
    message.print();
}

void main() {
    show(true);
    show(false);
    // An unused uninitialized owner has nothing to free.
    Message unused;
}
