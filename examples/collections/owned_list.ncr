interface Named {
    readonly String name();
}
class Person implements Named {
    private String value;
    public Person(String value) { this.value = value; }
    public readonly String name() { return this.value; }
}
void main() {
    List<Named> people = new List<Named>();
    Person alice = new Person("Alice");
    people.add(alice); // Move; alice is no longer usable.
    people.add(new Person("Bob"));
    Named first = people.remove(0);
    println(first.name());
    // Clearing the list destroys Bob, but not Alice, who was extracted by remove.
    people.clear();
    println(first.name());
    println(people.isEmpty());
}
