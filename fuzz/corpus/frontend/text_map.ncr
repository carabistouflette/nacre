void main() {
    Map<Text, int> stock = new Map<Text, int>();
    stock.put(new Text("empty"), 0);
    stock.put(new Text("a\0b"), 3);
    stock.put(new Text("é"), 5);

    Text query = new Text("a\0b");
    match (stock.tryGet(query)) {
        None { println("missing"); }
        Some(value) { println(value); }
    }
    for (borrow Text key, int value : stock) {
        if (key.byteLength() > 0) { println(value); }
    }
}
