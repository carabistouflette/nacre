static ncr_obj_@DB_STEP_RESULT@ @SQL_STATEMENT_STEP@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, NULL, &mutex)) {
        return NCR_DB_ERROR(@DB_STEP_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    if (ncr_self->statement_done) {
        ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
        return (ncr_obj_@DB_STEP_RESULT@){
            .tag = @DB_STEP_OK_TAG@,
            .data.v@DB_STEP_OK_TAG@.f0 = false
        };
    }
    if (ncr_self->statement_reset_required) {
        NCR_SQL_STATEMENT_FAIL(mutex, @DB_STEP_RESULT@, "SqlStatement.step requires reset after a failed step", ncr_line, ncr_column);
    }
    int result = sqlite3_step(statement);
    if (result == SQLITE_ROW) {
        ncr_self->row_active = true;
        ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
        return (ncr_obj_@DB_STEP_RESULT@){
            .tag = @DB_STEP_OK_TAG@,
            .data.v@DB_STEP_OK_TAG@.f0 = true
        };
    }
    ncr_self->row_active = false;
    if (result == SQLITE_DONE) {
        ncr_self->statement_done = true;
        ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
        return (ncr_obj_@DB_STEP_RESULT@){
            .tag = @DB_STEP_OK_TAG@,
            .data.v@DB_STEP_OK_TAG@.f0 = false
        };
    }
    ncr_self->statement_reset_required = true;
    NCR_SQL_STATEMENT_FAIL(mutex, @DB_STEP_RESULT@, "SqlStatement.step failed", ncr_line, ncr_column);
}

static ncr_obj_@STATEMENT_UNIT_RESULT@ @SQL_STATEMENT_RESET@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, NULL, &mutex)) {
        return NCR_DB_ERROR(@STATEMENT_UNIT_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    int result = sqlite3_reset(statement);
    ncr_self->row_active = false;
    ncr_self->statement_done = false;
    ncr_self->statement_reset_required = false;
    if (result != SQLITE_OK) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.reset failed", ncr_line, ncr_column);
    }
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
