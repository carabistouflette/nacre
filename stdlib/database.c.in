static ncr_obj_@DB_COLUMN_TEXT_RESULT@ @DATABASE_COLUMN_TEXT@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, int32_t ncr_v_@DB_COLUMN_TEXT_INDEX_ID@,
    size_t ncr_line, size_t ncr_column
) {
    if (ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self) == NULL) {
        return NCR_DB_ERROR(@DB_COLUMN_TEXT_RESULT@, "Database is closed", ncr_line, ncr_column);
    }
    sqlite3_stmt *statement = ncr_database_statement_@DATABASE_CLASS_ID@(ncr_self);
    if (statement == NULL) { return NCR_DB_ERROR(@DB_COLUMN_TEXT_RESULT@, "Database has no prepared statement", ncr_line, ncr_column); }
    if (!ncr_self->row_active) { return NCR_DB_ERROR(@DB_COLUMN_TEXT_RESULT@, "Database.columnText requires a current row", ncr_line, ncr_column); }
    if (ncr_v_@DB_COLUMN_TEXT_INDEX_ID@ < 0 || ncr_v_@DB_COLUMN_TEXT_INDEX_ID@ >= sqlite3_column_count(statement)) {
        return NCR_DB_ERROR(@DB_COLUMN_TEXT_RESULT@, "Database column index is out of range", ncr_line, ncr_column);
    }
    int type = sqlite3_column_type(statement, ncr_v_@DB_COLUMN_TEXT_INDEX_ID@);
    ncr_obj_@DB_COLUMN_TEXT_OPTION@ option = { .tag = @DB_COLUMN_TEXT_NONE_TAG@ };
    if (type != SQLITE_NULL) {
        if (type != SQLITE_TEXT) {
            return NCR_DB_ERROR(@DB_COLUMN_TEXT_RESULT@, "Database.columnText requires TEXT or NULL", ncr_line, ncr_column);
        }
        const unsigned char *bytes = sqlite3_column_text(statement, ncr_v_@DB_COLUMN_TEXT_INDEX_ID@);
        int count = sqlite3_column_bytes(statement, ncr_v_@DB_COLUMN_TEXT_INDEX_ID@);
        static const unsigned char empty_text = 0;
        if (count < 0 || (count > 0 && bytes == NULL)) {
            return NCR_DB_ERROR(@DB_COLUMN_TEXT_RESULT@, "Database.columnText failed", ncr_line, ncr_column);
        }
        if (!ncr_utf8_valid(count == 0 ? &empty_text : bytes, (size_t)count)) {
            return NCR_DB_ERROR(@DB_COLUMN_TEXT_RESULT@, "Database.columnText returned invalid UTF-8", ncr_line, ncr_column);
        }
        ncr_obj_@TEXT_CLASS_ID@ *copy = ncr_text_from_bytes_@TEXT_CLASS_ID@(
            count == 0 ? &empty_text : bytes, (size_t)count, ncr_line, ncr_column);
        option.tag = @DB_COLUMN_TEXT_SOME_TAG@;
        option.data.v@DB_COLUMN_TEXT_SOME_TAG@.f0 = copy;
    }
    return (ncr_obj_@DB_COLUMN_TEXT_RESULT@){
        .tag = @DB_COLUMN_TEXT_OK_TAG@,
        .data.v@DB_COLUMN_TEXT_OK_TAG@.f0 = option
    };
}

static ncr_obj_@DB_COLUMN_BLOB_RESULT@ @DATABASE_COLUMN_BLOB@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, int32_t ncr_v_@DB_COLUMN_BLOB_INDEX_ID@,
    size_t ncr_line, size_t ncr_column
) {
    if (ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self) == NULL) {
        return NCR_DB_ERROR(@DB_COLUMN_BLOB_RESULT@, "Database is closed", ncr_line, ncr_column);
    }
    sqlite3_stmt *statement = ncr_database_statement_@DATABASE_CLASS_ID@(ncr_self);
    if (statement == NULL) { return NCR_DB_ERROR(@DB_COLUMN_BLOB_RESULT@, "Database has no prepared statement", ncr_line, ncr_column); }
    if (!ncr_self->row_active) { return NCR_DB_ERROR(@DB_COLUMN_BLOB_RESULT@, "Database.columnBlob requires a current row", ncr_line, ncr_column); }
    if (ncr_v_@DB_COLUMN_BLOB_INDEX_ID@ < 0 || ncr_v_@DB_COLUMN_BLOB_INDEX_ID@ >= sqlite3_column_count(statement)) {
        return NCR_DB_ERROR(@DB_COLUMN_BLOB_RESULT@, "Database column index is out of range", ncr_line, ncr_column);
    }
    int type = sqlite3_column_type(statement, ncr_v_@DB_COLUMN_BLOB_INDEX_ID@);
    ncr_obj_@DB_COLUMN_BLOB_OPTION@ option = { .tag = @DB_COLUMN_BLOB_NONE_TAG@ };
    if (type != SQLITE_NULL) {
        if (type != SQLITE_BLOB) {
            return NCR_DB_ERROR(@DB_COLUMN_BLOB_RESULT@, "Database.columnBlob requires BLOB or NULL", ncr_line, ncr_column);
        }
        const void *bytes = sqlite3_column_blob(statement, ncr_v_@DB_COLUMN_BLOB_INDEX_ID@);
        int count = sqlite3_column_bytes(statement, ncr_v_@DB_COLUMN_BLOB_INDEX_ID@);
        if (count < 0 || (count > 0 && bytes == NULL)) {
            return NCR_DB_ERROR(@DB_COLUMN_BLOB_RESULT@, "Database.columnBlob failed", ncr_line, ncr_column);
        }
        ncr_obj_@BUFFER_CLASS_ID@ *copy = ncr_allocate(sizeof(*copy), ncr_line, ncr_column);
        copy->bytes = NULL;
        copy->length = (size_t)count;
        copy->capacity = (size_t)count;
        if (count > 0) {
            copy->bytes = ncr_allocate((size_t)count, ncr_line, ncr_column);
            memcpy(copy->bytes, bytes, (size_t)count);
        }
        option.tag = @DB_COLUMN_BLOB_SOME_TAG@;
        option.data.v@DB_COLUMN_BLOB_SOME_TAG@.f0 = copy;
    }
    return (ncr_obj_@DB_COLUMN_BLOB_RESULT@){
        .tag = @DB_COLUMN_BLOB_OK_TAG@,
        .data.v@DB_COLUMN_BLOB_OK_TAG@.f0 = option
    };
}

static ncr_obj_@DB_CHANGES_RESULT@ @DATABASE_CHANGES@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_ERROR(@DB_CHANGES_RESULT@, "Database is closed", ncr_line, ncr_column); }
    return (ncr_obj_@DB_CHANGES_RESULT@){
        .tag = @DB_CHANGES_OK_TAG@,
        .data.v@DB_CHANGES_OK_TAG@.f0 = (int64_t)sqlite3_changes64(database)
    };
}

static ncr_obj_@DB_ROWID_RESULT@ @DATABASE_LAST_INSERT_ROW_ID@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
