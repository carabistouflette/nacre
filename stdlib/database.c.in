    }
    static const unsigned char empty_blob = 0;
    const void *bytes = value->length == 0 ? (const void *)&empty_blob : (const void *)value->bytes;
    if (sqlite3_bind_blob(statement, ncr_v_@STMT_BIND_BLOB_INDEX_ID@, bytes,
            (int)value->length, SQLITE_TRANSIENT) != SQLITE_OK) {
