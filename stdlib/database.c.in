) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_ERROR(@DB_ROWID_RESULT@, "Database is closed", ncr_line, ncr_column); }
    return (ncr_obj_@DB_ROWID_RESULT@){
        .tag = @DB_ROWID_OK_TAG@,
        .data.v@DB_ROWID_OK_TAG@.f0 = (int64_t)sqlite3_last_insert_rowid(database)
    };
}

static ncr_obj_@DB_EXECUTE_RESULT@ @DATABASE_EXECUTE@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, ncr_obj_@TEXT_CLASS_ID@ *ncr_v_@DB_EXECUTE_SQL_ID@,
    size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_ERROR(@DB_EXECUTE_RESULT@, "Database is closed", ncr_line, ncr_column); }
    ncr_obj_@TEXT_CLASS_ID@ *sql = ncr_v_@DB_EXECUTE_SQL_ID@;
    if (!ncr_database_text_valid_@DATABASE_CLASS_ID@(sql, true)) {
        return NCR_DB_ERROR(@DB_EXECUTE_RESULT@, "Database.execute requires valid UTF-8 SQL text without NUL", ncr_line, ncr_column);
    }
    sqlite3_stmt *statement = NULL;
    static const char empty_sql[] = "";
    const char *sql_bytes = sql->length == 0 ? empty_sql : (const char *)sql->bytes;
    int result = ncr_database_prepare_one_@DATABASE_CLASS_ID@(
        database, sql_bytes, (size_t)sql->length, &statement);
    if (result != SQLITE_OK) {
        return NCR_DB_ERROR(@DB_EXECUTE_RESULT@, "Database.execute requires exactly one valid command", ncr_line, ncr_column);
    }
    if (sqlite3_bind_parameter_count(statement) != 0 || sqlite3_column_count(statement) != 0) {
        (void)sqlite3_finalize(statement);
        return NCR_DB_ERROR(@DB_EXECUTE_RESULT@, "Database.execute accepts only unparameterized commands without result columns", ncr_line, ncr_column);
    }
    result = sqlite3_step(statement);
    int finalize_result = sqlite3_finalize(statement);
    if (result != SQLITE_DONE || finalize_result != SQLITE_OK) {
        return NCR_DB_ERROR(@DB_EXECUTE_RESULT@, "Database.execute failed", ncr_line, ncr_column);
    }
    return (ncr_obj_@DB_EXECUTE_RESULT@){
        .tag = @DB_EXECUTE_OK_TAG@,
        .data.v@DB_EXECUTE_OK_TAG@.f0 = (int64_t)sqlite3_changes64(database)
    };
}

static ncr_obj_@DB_UNIT_RESULT@ @DATABASE_BEGIN@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database is closed", ncr_line, ncr_column); }
    if (sqlite3_exec(database, "BEGIN", NULL, NULL, NULL) != SQLITE_OK) {
        return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database.begin failed", ncr_line, ncr_column);
    }
    return NCR_DB_UNIT_OK();
}

static ncr_obj_@DB_UNIT_RESULT@ @DATABASE_COMMIT@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database is closed", ncr_line, ncr_column); }
    if (sqlite3_exec(database, "COMMIT", NULL, NULL, NULL) != SQLITE_OK) {
        return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database.commit failed", ncr_line, ncr_column);
    }
    return NCR_DB_UNIT_OK();
}

static ncr_obj_@DB_UNIT_RESULT@ @DATABASE_ROLLBACK@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database is closed", ncr_line, ncr_column); }
    if (sqlite3_exec(database, "ROLLBACK", NULL, NULL, NULL) != SQLITE_OK) {
        return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database.rollback failed", ncr_line, ncr_column);
    }
    return NCR_DB_UNIT_OK();
}

static ncr_obj_@DB_UNIT_RESULT@ @DATABASE_SET_BUSY_TIMEOUT_MILLIS@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, int64_t ncr_v_@DB_TIMEOUT_MILLIS_ID@,
    size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database is closed", ncr_line, ncr_column); }
    if (ncr_v_@DB_TIMEOUT_MILLIS_ID@ < 0 || ncr_v_@DB_TIMEOUT_MILLIS_ID@ > INT_MAX) {
        return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database busy timeout is outside the supported range", ncr_line, ncr_column);
    }
    if (sqlite3_busy_timeout(database, (int)ncr_v_@DB_TIMEOUT_MILLIS_ID@) != SQLITE_OK) {
        return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database.setBusyTimeoutMillis failed", ncr_line, ncr_column);
    }
    return NCR_DB_UNIT_OK();
}

static ncr_obj_@DB_UNIT_RESULT@ @DATABASE_CLOSE@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) { return NCR_DB_UNIT_OK(); }
    ncr_database_lifetime_@DATABASE_CLASS_ID@ *lifetime =
        (ncr_database_lifetime_@DATABASE_CLASS_ID@ *)ncr_self->lifetime;
    sqlite3_mutex *mutex = sqlite3_db_mutex(database);
    if (mutex != NULL) { sqlite3_mutex_enter(mutex); }
    if (lifetime != NULL) {
        atomic_store_explicit(&lifetime->closed, true, memory_order_release);
    }
    if (mutex != NULL) { sqlite3_mutex_leave(mutex); }

    int result = sqlite3_close_v2(database);
    if (result != SQLITE_OK) {
        if (lifetime != NULL) {
            if (mutex != NULL) { sqlite3_mutex_enter(mutex); }
            atomic_store_explicit(&lifetime->closed, false, memory_order_release);
            if (mutex != NULL) { sqlite3_mutex_leave(mutex); }
        }
        return NCR_DB_ERROR(@DB_UNIT_RESULT@, "Database.close failed", ncr_line, ncr_column);
    }
    ncr_self->database = NULL;
    ncr_self->lifetime = NULL;
    return NCR_DB_UNIT_OK();
}

#undef NCR_DB_UNIT_OK
#undef NCR_STATEMENT_UNIT_OK
#undef NCR_SQL_STATEMENT_FAIL
#undef NCR_DB_ERROR
