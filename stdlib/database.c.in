    size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3 *database;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, &database, &mutex)) {
        return NCR_DB_ERROR(@STATEMENT_COLUMN_TEXT_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    if (!ncr_self->row_active) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_TEXT_RESULT@, "SqlStatement.columnText requires a current row", ncr_line, ncr_column);
    }
    if (ncr_v_@STMT_COLUMN_TEXT_INDEX_ID@ < 0 ||
            ncr_v_@STMT_COLUMN_TEXT_INDEX_ID@ >= sqlite3_column_count(statement)) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_TEXT_RESULT@, "SqlStatement column index is out of range", ncr_line, ncr_column);
    }
    int type = sqlite3_column_type(statement, ncr_v_@STMT_COLUMN_TEXT_INDEX_ID@);
    ncr_obj_@STATEMENT_COLUMN_TEXT_OPTION@ option = { .tag = @STATEMENT_COLUMN_TEXT_NONE_TAG@ };
    if (type != SQLITE_NULL) {
        if (type != SQLITE_TEXT) {
            NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_TEXT_RESULT@, "SqlStatement.columnText requires TEXT or NULL", ncr_line, ncr_column);
        }
        const unsigned char *bytes = sqlite3_column_text(statement, ncr_v_@STMT_COLUMN_TEXT_INDEX_ID@);
        if (sqlite3_errcode(database) == SQLITE_NOMEM || bytes == NULL) {
            NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_TEXT_RESULT@, "SqlStatement.columnText failed", ncr_line, ncr_column);
        }
        int count = sqlite3_column_bytes(statement, ncr_v_@STMT_COLUMN_TEXT_INDEX_ID@);
        if (sqlite3_errcode(database) == SQLITE_NOMEM || count < 0) {
            NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_TEXT_RESULT@, "SqlStatement.columnText failed", ncr_line, ncr_column);
        }
        static const unsigned char empty_text = 0;
        if (!ncr_utf8_valid(count == 0 ? &empty_text : bytes, (size_t)count)) {
            NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_TEXT_RESULT@, "SqlStatement.columnText returned invalid UTF-8", ncr_line, ncr_column);
        }
        ncr_obj_@TEXT_CLASS_ID@ *copy = ncr_text_from_bytes_@TEXT_CLASS_ID@(
            count == 0 ? &empty_text : bytes, (size_t)count, ncr_line, ncr_column);
        option.tag = @STATEMENT_COLUMN_TEXT_SOME_TAG@;
        option.data.v@STATEMENT_COLUMN_TEXT_SOME_TAG@.f0 = copy;
    }
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
    return (ncr_obj_@STATEMENT_COLUMN_TEXT_RESULT@){
        .tag = @STATEMENT_COLUMN_TEXT_OK_TAG@,
        .data.v@STATEMENT_COLUMN_TEXT_OK_TAG@.f0 = option
    };
}

static ncr_obj_@STATEMENT_COLUMN_BLOB_RESULT@ @SQL_STATEMENT_COLUMN_BLOB@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, int32_t ncr_v_@STMT_COLUMN_BLOB_INDEX_ID@,
    size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3 *database;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, &database, &mutex)) {
        return NCR_DB_ERROR(@STATEMENT_COLUMN_BLOB_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    if (!ncr_self->row_active) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_BLOB_RESULT@, "SqlStatement.columnBlob requires a current row", ncr_line, ncr_column);
    }
    if (ncr_v_@STMT_COLUMN_BLOB_INDEX_ID@ < 0 ||
            ncr_v_@STMT_COLUMN_BLOB_INDEX_ID@ >= sqlite3_column_count(statement)) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_BLOB_RESULT@, "SqlStatement column index is out of range", ncr_line, ncr_column);
    }
    int type = sqlite3_column_type(statement, ncr_v_@STMT_COLUMN_BLOB_INDEX_ID@);
    ncr_obj_@STATEMENT_COLUMN_BLOB_OPTION@ option = { .tag = @STATEMENT_COLUMN_BLOB_NONE_TAG@ };
    if (type != SQLITE_NULL) {
        if (type != SQLITE_BLOB) {
            NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_BLOB_RESULT@, "SqlStatement.columnBlob requires BLOB or NULL", ncr_line, ncr_column);
        }
        const void *bytes = sqlite3_column_blob(statement, ncr_v_@STMT_COLUMN_BLOB_INDEX_ID@);
        if (sqlite3_errcode(database) == SQLITE_NOMEM) {
            NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_BLOB_RESULT@, "SqlStatement.columnBlob failed", ncr_line, ncr_column);
        }
        int count = sqlite3_column_bytes(statement, ncr_v_@STMT_COLUMN_BLOB_INDEX_ID@);
        if (sqlite3_errcode(database) == SQLITE_NOMEM || count < 0 || (count > 0 && bytes == NULL)) {
            NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_COLUMN_BLOB_RESULT@, "SqlStatement.columnBlob failed", ncr_line, ncr_column);
        }
        ncr_obj_@BUFFER_CLASS_ID@ *copy = ncr_allocate(sizeof(*copy), ncr_line, ncr_column);
        copy->bytes = NULL;
        copy->length = (size_t)count;
        copy->capacity = (size_t)count;
        if (count > 0) {
            copy->bytes = ncr_allocate((size_t)count, ncr_line, ncr_column);
            memcpy(copy->bytes, bytes, (size_t)count);
        }
        option.tag = @STATEMENT_COLUMN_BLOB_SOME_TAG@;
        option.data.v@STATEMENT_COLUMN_BLOB_SOME_TAG@.f0 = copy;
    }
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
    return (ncr_obj_@STATEMENT_COLUMN_BLOB_RESULT@){
        .tag = @STATEMENT_COLUMN_BLOB_OK_TAG@,
        .data.v@STATEMENT_COLUMN_BLOB_OK_TAG@.f0 = option
    };
}

static ncr_obj_@STATEMENT_UNIT_RESULT@ @SQL_STATEMENT_CLOSE@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement = ncr_sql_statement_handle_@STATEMENT_CLASS_ID@(ncr_self);
    ncr_self->statement = NULL;
    ncr_self->lifetime = NULL;
    ncr_self->row_active = false;
    ncr_self->statement_done = false;
    ncr_self->statement_reset_required = false;
    if (statement == NULL) { return NCR_STATEMENT_UNIT_OK(); }
    int result = sqlite3_finalize(statement);
    if (result != SQLITE_OK) {
        return NCR_DB_ERROR(@STATEMENT_UNIT_RESULT@, "SqlStatement.close failed", ncr_line, ncr_column);
    }
    return NCR_STATEMENT_UNIT_OK();
}

