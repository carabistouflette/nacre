/* nacre-link: sqlite */
#include <sqlite3.h>
#include <stdatomic.h>
#include <limits.h>

#define NCR_DB_ERROR(result_id, message, line, column) \
    ncr_result_error_##result_id((message), sizeof(message) - 1, (line), (column))
#define NCR_DB_UNIT_OK() ((ncr_obj_@DB_UNIT_RESULT@){ \
    .tag = @DB_UNIT_OK_TAG@, \
    .data.v@DB_UNIT_OK_TAG@.f0 = UINT8_C(0) \
})
#define NCR_STATEMENT_UNIT_OK() ((ncr_obj_@STATEMENT_UNIT_RESULT@){ \
    .tag = @STATEMENT_UNIT_OK_TAG@, \
    .data.v@STATEMENT_UNIT_OK_TAG@.f0 = UINT8_C(0) \
})

static bool ncr_database_text_valid_@DATABASE_CLASS_ID@(const ncr_obj_@TEXT_CLASS_ID@ *text, bool reject_nul) {
    if (text == NULL || text->length < 0 || (text->length > 0 && text->bytes == NULL)) { return false; }
    const size_t length = (size_t)text->length;
    if (!ncr_utf8_valid(text->bytes, length)) { return false; }
    return !reject_nul || length == 0 || memchr(text->bytes, 0, length) == NULL;
}

typedef struct ncr_database_lifetime_@DATABASE_CLASS_ID@ {
    atomic_bool closed;
} ncr_database_lifetime_@DATABASE_CLASS_ID@;

static void ncr_database_lifetime_marker_@DATABASE_CLASS_ID@(
    sqlite3_context *context, int argument_count, sqlite3_value **arguments
) {
    (void)argument_count;
    (void)arguments;
    sqlite3_result_null(context);
}

static void ncr_database_lifetime_destroy_@DATABASE_CLASS_ID@(void *opaque) {
    ncr_deallocate(opaque);
}

/* Skip SQLite's lexical whitespace, token-leading UTF-8 BOMs, and comments. */
static size_t ncr_database_sql_skip_trivia_@DATABASE_CLASS_ID@(
    const char *sql, size_t length, size_t offset
) {
    while (offset < length) {
        unsigned char byte = (unsigned char)sql[offset];
        if (byte == ' ' || byte == '\t' || byte == '\n' || byte == '\f' || byte == '\r') {
            offset++;
        } else if (length - offset >= 3 && byte == 0xef &&
                (unsigned char)sql[offset + 1] == 0xbb &&
                (unsigned char)sql[offset + 2] == 0xbf) {
            offset += 3;
        } else if (byte == '-' && offset + 1 < length && sql[offset + 1] == '-') {
            offset += 2;
            while (offset < length && sql[offset] != '\n') { offset++; }
        } else if (byte == '/' && offset + 1 < length && sql[offset + 1] == '*') {
            offset += 2;
            while (offset + 1 < length &&
                    !(sql[offset] == '*' && sql[offset + 1] == '/')) {
                offset++;
            }
            if (offset + 1 < length) { offset += 2; }
            else { offset = length; }
        } else {
            break;
        }
    }
    return offset;
}

static bool ncr_database_sql_word_is_@DATABASE_CLASS_ID@(
    const char *sql, size_t start, size_t end, const char *keyword
) {
    size_t index = 0;
    while (start < end && keyword[index] != '\0') {
        unsigned char byte = (unsigned char)sql[start++];
        if (byte >= 'a' && byte <= 'z') { byte = (unsigned char)(byte - ('a' - 'A')); }
        if (byte != (unsigned char)keyword[index++]) { return false; }
    }
    return start == end && keyword[index] == '\0';
}

static bool ncr_database_sql_id_char_@DATABASE_CLASS_ID@(unsigned char byte) {
    return (byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z') ||
        (byte >= '0' && byte <= '9') || byte == '_' || byte == '$' || byte >= 0x80;
}

/* Mirror SQLite's linear statement-completion states. In a CREATE TRIGGER,
   body semicolons are internal; only the following END and final semicolon
   close the outer command. */
static bool ncr_database_sql_is_single_statement_@DATABASE_CLASS_ID@(
    const char *sql, size_t length
) {
    enum {
        SQL_NOTHING, SQL_START, SQL_NORMAL, SQL_EXPLAIN,
        SQL_CREATE, SQL_TRIGGER, SQL_TRIGGER_SEMI, SQL_TRIGGER_END
    };
    enum {
        SQL_SEMICOLON, SQL_WHITESPACE, SQL_OTHER, SQL_EXPLAIN_TOKEN,
        SQL_CREATE_TOKEN, SQL_TEMP_TOKEN, SQL_TRIGGER_TOKEN, SQL_END_TOKEN
    };
    static const unsigned char transitions[8][8] = {
        {1, 0, 2, 3, 4, 2, 2, 2},
        {1, 1, 2, 3, 4, 2, 2, 2},
        {1, 2, 2, 2, 2, 2, 2, 2},
        {1, 3, 3, 2, 4, 2, 2, 2},
        {1, 4, 2, 2, 2, 4, 5, 2},
        {6, 5, 5, 5, 5, 5, 5, 5},
        {6, 6, 5, 5, 5, 5, 5, 7},
        {1, 7, 5, 5, 5, 5, 5, 5}
    };
    unsigned char state = SQL_NOTHING;
    bool complete = false;
    size_t offset = 0;

    while ((offset = ncr_database_sql_skip_trivia_@DATABASE_CLASS_ID@(
            sql, length, offset)) < length) {
        if (complete) { return false; }

        unsigned char byte = (unsigned char)sql[offset];
        unsigned char token = SQL_OTHER;
        if (byte == ';') {
            token = SQL_SEMICOLON;
            if (state == SQL_NOTHING || state == SQL_START) { offset++; continue; }
            if (state != SQL_TRIGGER && state != SQL_TRIGGER_SEMI) { complete = true; }
            offset++;
        } else if (byte == '\'' || byte == '"' || byte == '`') {
            offset++;
            while (offset < length) {
                if (sql[offset] == (char)byte) {
                    if (offset + 1 < length && sql[offset + 1] == (char)byte) {
                        offset += 2;
                    } else {
                        offset++;
                        break;
                    }
                } else {
                    offset++;
                }
            }
        } else if (byte == '[') {
            offset++;
            while (offset < length && sql[offset] != ']') { offset++; }
            if (offset < length) { offset++; }
        } else if (byte == '?' ) {
            offset++;
            while (offset < length && sql[offset] >= '0' && sql[offset] <= '9') { offset++; }
        } else if (byte == ':' || byte == '@' || byte == '#' || byte == '$') {
            size_t name_length = 0;
            offset++;
            while (offset < length) {
                byte = (unsigned char)sql[offset];
                if (ncr_database_sql_id_char_@DATABASE_CLASS_ID@(byte)) {
                    name_length++;
                    offset++;
                } else if (byte == ':' && offset + 1 < length && sql[offset + 1] == ':') {
                    offset += 2;
                } else if (byte == '(' && name_length > 0) {
                    offset++;
                    while (offset < length &&
                            sql[offset] != ')' && sql[offset] != ' ' && sql[offset] != '\t' &&
                            sql[offset] != '\n' && sql[offset] != '\f' && sql[offset] != '\r') {
                        offset++;
                    }
                    if (offset < length && sql[offset] == ')') { offset++; }
                    break;
                } else {
                    break;
                }
            }
        } else if (byte >= '0' && byte <= '9') {
            offset++;
            while (offset < length &&
                    ncr_database_sql_id_char_@DATABASE_CLASS_ID@((unsigned char)sql[offset])) {
                offset++;
            }
        } else if ((byte >= 'A' && byte <= 'Z') ||
                (byte >= 'a' && byte <= 'z') || byte == '_' || byte >= 0x80) {
            size_t start = offset++;
            while (offset < length &&
                    ncr_database_sql_id_char_@DATABASE_CLASS_ID@((unsigned char)sql[offset])) {
                offset++;
            }
            if (ncr_database_sql_word_is_@DATABASE_CLASS_ID@(sql, start, offset, "EXPLAIN")) {
                token = SQL_EXPLAIN_TOKEN;
            } else if (ncr_database_sql_word_is_@DATABASE_CLASS_ID@(sql, start, offset, "CREATE")) {
                token = SQL_CREATE_TOKEN;
            } else if (ncr_database_sql_word_is_@DATABASE_CLASS_ID@(sql, start, offset, "TEMP") ||
                    ncr_database_sql_word_is_@DATABASE_CLASS_ID@(sql, start, offset, "TEMPORARY")) {
                token = SQL_TEMP_TOKEN;
            } else if (ncr_database_sql_word_is_@DATABASE_CLASS_ID@(sql, start, offset, "TRIGGER")) {
                token = SQL_TRIGGER_TOKEN;
            } else if (ncr_database_sql_word_is_@DATABASE_CLASS_ID@(sql, start, offset, "END")) {
                token = SQL_END_TOKEN;
            }
        } else {
            offset++;
        }

        if (token == SQL_SEMICOLON && state == SQL_TRIGGER_END) { complete = true; }
        state = transitions[state][token];
    }
    return state != SQL_TRIGGER && state != SQL_TRIGGER_SEMI;
}

static bool ncr_database_sql_tail_is_trivia_@DATABASE_CLASS_ID@(
    const char *sql, size_t length
) {
    return ncr_database_sql_skip_trivia_@DATABASE_CLASS_ID@(sql, length, 0) == length;
}

static int ncr_database_prepare_one_@DATABASE_CLASS_ID@(
    sqlite3 *database, const char *sql, size_t length, sqlite3_stmt **output
) {
    *output = NULL;
    if (length > (size_t)INT_MAX) { return SQLITE_TOOBIG; }
    if (!ncr_database_sql_is_single_statement_@DATABASE_CLASS_ID@(sql, length)) {
        return SQLITE_ERROR;
    }
    const char *tail = NULL;
    int result = sqlite3_prepare_v2(database, sql, (int)length, output, &tail);
    if (result != SQLITE_OK) {
        if (*output != NULL) { (void)sqlite3_finalize(*output); *output = NULL; }
        return result;
    }
    if (*output == NULL || tail == NULL) {
        if (*output != NULL) { (void)sqlite3_finalize(*output); *output = NULL; }
        return SQLITE_ERROR;
    }

    const char *end = sql + length;
    if (tail < sql || tail > end) {
        (void)sqlite3_finalize(*output);
        *output = NULL;
        return SQLITE_ERROR;
    }
    const size_t remaining = (size_t)(end - tail);
    if (!ncr_database_sql_tail_is_trivia_@DATABASE_CLASS_ID@(tail, remaining)) {
        (void)sqlite3_finalize(*output);
        *output = NULL;
        return SQLITE_ERROR;
    }
    return SQLITE_OK;
}


static sqlite3 *ncr_database_handle_@DATABASE_CLASS_ID@(ncr_obj_@DATABASE_CLASS_ID@ *database) {
    return database == NULL ? NULL : (sqlite3 *)database->database;
}

static sqlite3_stmt *ncr_sql_statement_handle_@STATEMENT_CLASS_ID@(
    ncr_obj_@STATEMENT_CLASS_ID@ *statement
) {
    return statement == NULL ? NULL : (sqlite3_stmt *)statement->statement;
}

static ncr_database_lifetime_@DATABASE_CLASS_ID@ *ncr_sql_statement_lifetime_@STATEMENT_CLASS_ID@(
    ncr_obj_@STATEMENT_CLASS_ID@ *statement
) {
    return statement == NULL ? NULL :
        (ncr_database_lifetime_@DATABASE_CLASS_ID@ *)statement->lifetime;
}

static bool ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(
    ncr_obj_@STATEMENT_CLASS_ID@ *statement,
    sqlite3_stmt **statement_handle, sqlite3 **database_handle,
    sqlite3_mutex **database_mutex
) {
    sqlite3_stmt *handle = ncr_sql_statement_handle_@STATEMENT_CLASS_ID@(statement);
    if (handle == NULL) { return false; }
    sqlite3 *database = sqlite3_db_handle(handle);
    if (database == NULL) { return false; }
    sqlite3_mutex *mutex = sqlite3_db_mutex(database);
    if (mutex != NULL) { sqlite3_mutex_enter(mutex); }
    ncr_database_lifetime_@DATABASE_CLASS_ID@ *lifetime =
        ncr_sql_statement_lifetime_@STATEMENT_CLASS_ID@(statement);
    if (lifetime == NULL || atomic_load_explicit(&lifetime->closed, memory_order_acquire)) {
        if (mutex != NULL) { sqlite3_mutex_leave(mutex); }
        return false;
    }
    if (statement_handle != NULL) { *statement_handle = handle; }
    if (database_handle != NULL) { *database_handle = database; }
    if (database_mutex != NULL) { *database_mutex = mutex; }
    return true;
}

static void ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(sqlite3_mutex *mutex) {
    if (mutex != NULL) { sqlite3_mutex_leave(mutex); }
}

#define NCR_SQL_STATEMENT_FAIL(mutex, result_id, message, line, column) do { \
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex); \
    return NCR_DB_ERROR(result_id, message, line, column); \
} while (0)

static void ncr_sql_statement_destroy_@STATEMENT_CLASS_ID@(void *opaque) {
    ncr_obj_@STATEMENT_CLASS_ID@ *statement = (ncr_obj_@STATEMENT_CLASS_ID@ *)opaque;
    if (statement == NULL) { return; }
    sqlite3_stmt *handle = ncr_sql_statement_handle_@STATEMENT_CLASS_ID@(statement);
    statement->statement = NULL;
    statement->lifetime = NULL;
    statement->row_active = false;
    statement->statement_done = false;
    statement->statement_reset_required = false;
    if (handle != NULL) { (void)sqlite3_finalize(handle); }
}

/* close_v2 keeps SQLite's zombie connection alive until every owned statement
   is finalized; the lifetime marker is owned by SQLite's function registry. */
static void ncr_database_destroy_@DATABASE_CLASS_ID@(void *opaque) {
    ncr_obj_@DATABASE_CLASS_ID@ *database = (ncr_obj_@DATABASE_CLASS_ID@ *)opaque;
    if (database == NULL) { return; }
    sqlite3 *handle = ncr_database_handle_@DATABASE_CLASS_ID@(database);
    ncr_database_lifetime_@DATABASE_CLASS_ID@ *lifetime =
        (ncr_database_lifetime_@DATABASE_CLASS_ID@ *)database->lifetime;
    database->database = NULL;
    database->lifetime = NULL;
    if (handle != NULL) {
        sqlite3_mutex *mutex = sqlite3_db_mutex(handle);
        if (mutex != NULL) { sqlite3_mutex_enter(mutex); }
        if (lifetime != NULL) {
            atomic_store_explicit(&lifetime->closed, true, memory_order_release);
        }
        if (mutex != NULL) { sqlite3_mutex_leave(mutex); }
        if (sqlite3_close_v2(handle) != SQLITE_OK) { abort(); }
    }
}

static ncr_obj_@DB_OPEN_RESULT@ @DATABASE_OPEN@(
    ncr_obj_@TEXT_CLASS_ID@ *ncr_v_@DB_OPEN_PATH_ID@, size_t ncr_line, size_t ncr_column
) {
    ncr_obj_@TEXT_CLASS_ID@ *path = ncr_v_@DB_OPEN_PATH_ID@;
    if (!ncr_database_text_valid_@DATABASE_CLASS_ID@(path, true)) {
        return NCR_DB_ERROR(@DB_OPEN_RESULT@, "Database.open requires valid UTF-8 path text without NUL", ncr_line, ncr_column);
    }
    if (path->length == 0) {
        return NCR_DB_ERROR(@DB_OPEN_RESULT@, "Database.open requires a nonempty path", ncr_line, ncr_column);
    }

    const size_t path_length = (size_t)path->length;
    if (path_length == SIZE_MAX) {
        return NCR_DB_ERROR(@DB_OPEN_RESULT@, "Database.open path is too large", ncr_line, ncr_column);
    }
    char *filename = ncr_allocate(path_length + 1, ncr_line, ncr_column);
    memcpy(filename, path->bytes, path_length);
    filename[path_length] = '\0';
    sqlite3 *handle = NULL;
    int result = sqlite3_open_v2(filename, &handle,
        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX, NULL);
    ncr_deallocate(filename);
    if (result != SQLITE_OK) {
        if (handle != NULL && sqlite3_close(handle) != SQLITE_OK) { abort(); }
        return NCR_DB_ERROR(@DB_OPEN_RESULT@, "Database.open failed", ncr_line, ncr_column);
    }
    result = sqlite3_exec(handle, "PRAGMA foreign_keys = ON", NULL, NULL, NULL);
    if (result != SQLITE_OK) {
        if (sqlite3_close(handle) != SQLITE_OK) { abort(); }
        return NCR_DB_ERROR(@DB_OPEN_RESULT@, "Database.open failed", ncr_line, ncr_column);
    }
    ncr_database_lifetime_@DATABASE_CLASS_ID@ *lifetime =
        ncr_allocate(sizeof(*lifetime), ncr_line, ncr_column);
    atomic_init(&lifetime->closed, false);
    result = sqlite3_create_function_v2(handle, "ncr_internal_sql_statement_lifetime", 0,
        SQLITE_UTF8, lifetime, ncr_database_lifetime_marker_@DATABASE_CLASS_ID@,
        NULL, NULL, ncr_database_lifetime_destroy_@DATABASE_CLASS_ID@);
    if (result != SQLITE_OK) {
        if (sqlite3_close(handle) != SQLITE_OK) { abort(); }
        return NCR_DB_ERROR(@DB_OPEN_RESULT@, "Database.open failed", ncr_line, ncr_column);
    }

    ncr_obj_@DATABASE_CLASS_ID@ *database = ncr_allocate(sizeof(*database), ncr_line, ncr_column);
    database->database = handle;
    database->lifetime = lifetime;
    database->destroy = ncr_database_destroy_@DATABASE_CLASS_ID@;
    return (ncr_obj_@DB_OPEN_RESULT@){
        .tag = @DB_OPEN_OK_TAG@,
        .data.v@DB_OPEN_OK_TAG@.f0 = database
    };
}

static ncr_obj_@DB_PREPARE_RESULT@ @DATABASE_PREPARE@(
    ncr_obj_@DATABASE_CLASS_ID@ *ncr_self,
    ncr_obj_@TEXT_CLASS_ID@ *ncr_v_@DB_PREPARE_SQL_ID@,
    size_t ncr_line, size_t ncr_column
) {
    sqlite3 *database = ncr_database_handle_@DATABASE_CLASS_ID@(ncr_self);
    if (database == NULL) {
        return NCR_DB_ERROR(@DB_PREPARE_RESULT@, "Database is closed", ncr_line, ncr_column);
    }
    ncr_obj_@TEXT_CLASS_ID@ *sql = ncr_v_@DB_PREPARE_SQL_ID@;
    if (!ncr_database_text_valid_@DATABASE_CLASS_ID@(sql, true)) {
        return NCR_DB_ERROR(@DB_PREPARE_RESULT@, "Database.prepare requires valid UTF-8 SQL text without NUL", ncr_line, ncr_column);
    }

    sqlite3_stmt *prepared = NULL;
    static const char empty_sql[] = "";
    const char *sql_bytes = sql->length == 0 ? empty_sql : (const char *)sql->bytes;
    int result = ncr_database_prepare_one_@DATABASE_CLASS_ID@(
        database, sql_bytes, (size_t)sql->length, &prepared);
    if (result != SQLITE_OK) {
        return NCR_DB_ERROR(@DB_PREPARE_RESULT@, "Database.prepare requires exactly one valid statement", ncr_line, ncr_column);
    }

    ncr_obj_@STATEMENT_CLASS_ID@ *statement =
        ncr_allocate(sizeof(*statement), ncr_line, ncr_column);
    statement->statement = prepared;
    statement->lifetime = ncr_self->lifetime;
    statement->row_active = false;
    statement->statement_done = false;
    statement->statement_reset_required = false;
    statement->destroy = ncr_sql_statement_destroy_@STATEMENT_CLASS_ID@;
    return (ncr_obj_@DB_PREPARE_RESULT@){
        .tag = @DB_PREPARE_OK_TAG@,
        .data.v@DB_PREPARE_OK_TAG@.f0 = statement
    };
}


static ncr_obj_@STATEMENT_UNIT_RESULT@ @SQL_STATEMENT_BIND_NULL@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, int32_t ncr_v_@STMT_BIND_NULL_INDEX_ID@,
    size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, NULL, &mutex)) {
        return NCR_DB_ERROR(@STATEMENT_UNIT_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    if (ncr_self->row_active) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindNull requires reset after a row", ncr_line, ncr_column);
    }
    if (ncr_v_@STMT_BIND_NULL_INDEX_ID@ <= 0 ||
            ncr_v_@STMT_BIND_NULL_INDEX_ID@ > sqlite3_bind_parameter_count(statement)) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement bind index is out of range", ncr_line, ncr_column);
    }
    if (sqlite3_bind_null(statement, ncr_v_@STMT_BIND_NULL_INDEX_ID@) != SQLITE_OK) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindNull failed", ncr_line, ncr_column);
    }
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
    return NCR_STATEMENT_UNIT_OK();
}

static ncr_obj_@STATEMENT_UNIT_RESULT@ @SQL_STATEMENT_BIND_LONG@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, int32_t ncr_v_@STMT_BIND_LONG_INDEX_ID@,
    int64_t ncr_v_@STMT_BIND_LONG_VALUE_ID@, size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, NULL, &mutex)) {
        return NCR_DB_ERROR(@STATEMENT_UNIT_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    if (ncr_self->row_active) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindLong requires reset after a row", ncr_line, ncr_column);
    }
    if (ncr_v_@STMT_BIND_LONG_INDEX_ID@ <= 0 ||
            ncr_v_@STMT_BIND_LONG_INDEX_ID@ > sqlite3_bind_parameter_count(statement)) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement bind index is out of range", ncr_line, ncr_column);
    }
    if (sqlite3_bind_int64(statement, ncr_v_@STMT_BIND_LONG_INDEX_ID@,
            ncr_v_@STMT_BIND_LONG_VALUE_ID@) != SQLITE_OK) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindLong failed", ncr_line, ncr_column);
    }
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
    return NCR_STATEMENT_UNIT_OK();
}

static ncr_obj_@STATEMENT_UNIT_RESULT@ @SQL_STATEMENT_BIND_DOUBLE@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, int32_t ncr_v_@STMT_BIND_DOUBLE_INDEX_ID@,
    double ncr_v_@STMT_BIND_DOUBLE_VALUE_ID@, size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, NULL, &mutex)) {
        return NCR_DB_ERROR(@STATEMENT_UNIT_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    if (ncr_self->row_active) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindDouble requires reset after a row", ncr_line, ncr_column);
    }
    if (ncr_v_@STMT_BIND_DOUBLE_INDEX_ID@ <= 0 ||
            ncr_v_@STMT_BIND_DOUBLE_INDEX_ID@ > sqlite3_bind_parameter_count(statement)) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement bind index is out of range", ncr_line, ncr_column);
    }
    if (sqlite3_bind_double(statement, ncr_v_@STMT_BIND_DOUBLE_INDEX_ID@,
            ncr_v_@STMT_BIND_DOUBLE_VALUE_ID@) != SQLITE_OK) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindDouble failed", ncr_line, ncr_column);
    }
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
    return NCR_STATEMENT_UNIT_OK();
}

static ncr_obj_@STATEMENT_UNIT_RESULT@ @SQL_STATEMENT_BIND_TEXT@(
    ncr_obj_@STATEMENT_CLASS_ID@ *ncr_self, int32_t ncr_v_@STMT_BIND_TEXT_INDEX_ID@,
    ncr_obj_@TEXT_CLASS_ID@ *ncr_v_@STMT_BIND_TEXT_VALUE_ID@, size_t ncr_line, size_t ncr_column
) {
    sqlite3_stmt *statement;
    sqlite3_mutex *mutex;
    if (!ncr_sql_statement_enter_@STATEMENT_CLASS_ID@(ncr_self, &statement, NULL, &mutex)) {
        return NCR_DB_ERROR(@STATEMENT_UNIT_RESULT@, "SqlStatement is closed", ncr_line, ncr_column);
    }
    if (ncr_self->row_active) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindText requires reset after a row", ncr_line, ncr_column);
    }
    if (ncr_v_@STMT_BIND_TEXT_INDEX_ID@ <= 0 ||
            ncr_v_@STMT_BIND_TEXT_INDEX_ID@ > sqlite3_bind_parameter_count(statement)) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement bind index is out of range", ncr_line, ncr_column);
    }
    ncr_obj_@TEXT_CLASS_ID@ *value = ncr_v_@STMT_BIND_TEXT_VALUE_ID@;
    if (!ncr_database_text_valid_@DATABASE_CLASS_ID@(value, false)) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindText requires valid UTF-8 Text", ncr_line, ncr_column);
    }
    const char *bytes = value->length == 0 ? "" : (const char *)value->bytes;
    if (sqlite3_bind_text(statement, ncr_v_@STMT_BIND_TEXT_INDEX_ID@, bytes,
            value->length, SQLITE_TRANSIENT) != SQLITE_OK) {
        NCR_SQL_STATEMENT_FAIL(mutex, @STATEMENT_UNIT_RESULT@, "SqlStatement.bindText failed", ncr_line, ncr_column);
    }
    ncr_sql_statement_leave_@STATEMENT_CLASS_ID@(mutex);
