/* Native owned UTF-8 byte text; no returned pointers or temporary String views. */
static void ncr_text_append_@ID@(ncr_obj_@ID@ *p, const unsigned char *data, size_t length, size_t line, size_t column) {
    if (length > (size_t)(INT32_MAX - p->length)) { ncr_fail("Text is too large", line, column); }
    int32_t required = p->length + (int32_t)length;
    if (required > p->capacity) {
        int64_t capacity = p->capacity;
        while (capacity < required) { capacity = capacity > INT32_MAX / 2 ? INT32_MAX : capacity * 2; }
        if ((uint64_t)capacity > SIZE_MAX) { ncr_fail("Text is too large", line, column); }
        unsigned char *bytes;
        if (p->bytes == p->inline_storage) {
            bytes = ncr_allocate_raw((size_t)capacity, line, column);
            if (p->length > 0) { memcpy(bytes, p->bytes, (size_t)p->length); }
        } else {
            bytes = ncr_reallocate(p->bytes, (size_t)capacity, line, column);
        }
        p->bytes = bytes; p->capacity = (int32_t)capacity;
    }
    /* The frontend forbids self-aliasing for appendText's retained argument. */
    if (length == 1) {
        p->bytes[p->length] = data[0];
    } else if (length > 0) {
        memcpy(p->bytes + p->length, data, length);
    }
    p->length = required;
}
static inline bool ncr_text_is_valid_utf8_@ID@(const unsigned char *data, size_t length) {
    if (length == 0) { return true; }
    if (data == NULL) { return false; }
    if (length == 1) { return data[0] <= 0x7f; }
    if (length == 2 && data[0] <= 0x7f && data[1] <= 0x7f) { return true; }
    return ncr_utf8_valid(data, length);
}
static void @TEXT_NEW@(ncr_obj_@ID@ *p, ncr_string initial, size_t line, size_t column) {
    @TEXT_INIT@(p);
    if (!ncr_text_is_valid_utf8_@ID@(initial.data, initial.length)) { ncr_fail("Text requires valid UTF-8", line, column); }
    ncr_text_append_@ID@(p, initial.data, initial.length, line, column);
}
static void @TEXT_APPEND@(ncr_obj_@ID@ *p, ncr_string value, size_t line, size_t column) {
    if (!ncr_text_is_valid_utf8_@ID@(value.data, value.length)) { ncr_fail("Text append requires valid UTF-8", line, column); }
    ncr_text_append_@ID@(p, value.data, value.length, line, column);
}
static void @TEXT_APPEND_INT@(ncr_obj_@ID@ *p, int32_t value, size_t line, size_t column) {
    unsigned char buffer[11];
    unsigned char *end = buffer + sizeof(buffer);
    unsigned char *start = end;
    bool negative = value < 0;
    uint32_t magnitude = negative ? UINT32_C(0) - (uint32_t)value : (uint32_t)value;
    do {
        *--start = (unsigned char)('0' + magnitude % UINT32_C(10));
        magnitude /= UINT32_C(10);
    } while (magnitude != 0);
    if (negative) { *--start = '-'; }
    ncr_text_append_@ID@(p, start, (size_t)(end - start), line, column);
}
static void @TEXT_APPEND_BYTE@(ncr_obj_@ID@ *p, uint8_t value, size_t line, size_t column) {
    char buffer[4];
    int count = snprintf(buffer, sizeof(buffer), "%u", (unsigned)value);
    if (count < 0 || (size_t)count >= sizeof(buffer)) { ncr_fail("[E6106] byte formatting failed", line, column); }
    ncr_text_append_@ID@(p, (const unsigned char *)buffer, (size_t)count, line, column);
}
static void @TEXT_APPEND_CHAR@(ncr_obj_@ID@ *p, uint32_t value, size_t line, size_t column) {
    unsigned char bytes[4];
    size_t length = ncr_utf8_encode_scalar(value, bytes);
    if (length == 0) { ncr_fail("[E6102] value is not a Unicode scalar", line, column); }
    ncr_text_append_@ID@(p, bytes, length, line, column);
}
static void @TEXT_APPEND_LONG@(ncr_obj_@ID@ *p, int64_t value, size_t line, size_t column) {
    char buffer[32];
    int count = snprintf(buffer, sizeof(buffer), "%" PRId64, value);
    if (count < 0 || (size_t)count >= sizeof(buffer)) { ncr_fail("[E6106] long formatting failed", line, column); }
    ncr_text_append_@ID@(p, (const unsigned char *)buffer, (size_t)count, line, column);
}
static void @TEXT_APPEND_DOUBLE@(ncr_obj_@ID@ *p, double value, size_t line, size_t column) {
    char buffer[64];
    int count = snprintf(buffer, sizeof(buffer), "%.*g", DBL_DECIMAL_DIG, value);
    if (count < 0 || (size_t)count >= sizeof(buffer)) { ncr_fail("[E6106] double formatting failed", line, column); }
    ncr_text_append_@ID@(p, (const unsigned char *)buffer, (size_t)count, line, column);
}
static void @TEXT_APPEND_BOOLEAN@(ncr_obj_@ID@ *p, bool value, size_t line, size_t column) {
    const unsigned char *data = (const unsigned char *)(value ? "true" : "false");
    ncr_text_append_@ID@(p, data, value ? 4 : 5, line, column);
}
static void @TEXT_APPEND_TEXT@(ncr_obj_@ID@ *p, ncr_obj_@ID@ *other, size_t line, size_t column) {
    ncr_text_append_@ID@(p, other->bytes, (size_t)other->length, line, column);
}
static int32_t @TEXT_BYTE_LENGTH@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column; return p->length;
}
static int32_t @TEXT_BYTE_AT@(ncr_obj_@ID@ *p, int32_t index, size_t line, size_t column) {
    if (index < 0 || index >= p->length) { ncr_fail("Text index out of bounds", line, column); }
    return p->bytes[index];
}
static bool @TEXT_IS_EMPTY@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column; return p->length == 0;
}
static void @TEXT_CLEAR@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column; p->length = 0;
}
static void @TEXT_PRINT@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    if (p->length > 0) { (void)fwrite(p->bytes, 1, (size_t)p->length, stdout); }
    (void)fputc('\n', stdout);
}
static ncr_obj_@ID@ *ncr_text_copy_trusted_@ID@(
    const unsigned char *bytes, size_t length, size_t line, size_t column
) {
    ncr_obj_@ID@ *copy = ncr_allocate(sizeof(*copy), line, column);
    @TEXT_INIT@(copy);
    ncr_text_append_@ID@(copy, bytes, length, line, column);
    return copy;
}
static ncr_obj_@ID@ *@TEXT_CLONE@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    return ncr_text_copy_trusted_@ID@(p->bytes, (size_t)p->length, line, column);
}
static bool @TEXT_EQUALS@(ncr_obj_@ID@ *p, ncr_obj_@ID@ *other, size_t line, size_t column) {
    (void)line; (void)column;
    return p->length == other->length && (p->length == 0 || memcmp(p->bytes, other->bytes, (size_t)p->length) == 0);
}
static bool @TEXT_EQUALS_STRING@(ncr_obj_@ID@ *p, ncr_string other, size_t line, size_t column) {
    (void)line; (void)column;
    return (size_t)p->length == other.length && (p->length == 0 || memcmp(p->bytes, other.data, (size_t)p->length) == 0);
}
static ncr_obj_@PARSE_RESULT@ @TEXT_PARSE_INT@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    size_t length = (size_t)p->length;
    size_t index = 0;
    bool negative = false;
    if (length == 0) {
        return @ERROR_PARSE_RESULT@("Text.parseInt: invalid integer", sizeof("Text.parseInt: invalid integer") - 1, line, column);
    }
    if (p->bytes[index] == '+' || p->bytes[index] == '-') {
        negative = p->bytes[index] == '-';
        ++index;
    }
    if (index == length) {
        return @ERROR_PARSE_RESULT@("Text.parseInt: invalid integer", sizeof("Text.parseInt: invalid integer") - 1, line, column);
    }
    uint32_t limit = negative ? UINT32_C(2147483648) : (uint32_t)INT32_MAX;
    uint32_t value = 0;
    for (; index < length; ++index) {
        unsigned char byte = p->bytes[index];
        if (byte < '0' || byte > '9') {
            return @ERROR_PARSE_RESULT@("Text.parseInt: invalid integer", sizeof("Text.parseInt: invalid integer") - 1, line, column);
        }
        uint32_t digit = (uint32_t)(byte - '0');
        if (value > (limit - digit) / 10) {
            return @ERROR_PARSE_RESULT@("Text.parseInt: invalid integer", sizeof("Text.parseInt: invalid integer") - 1, line, column);
        }
        value = value * 10 + digit;
    }
    int32_t parsed;
    if (negative) {
        parsed = value == UINT32_C(2147483648) ? INT32_MIN : -(int32_t)value;
    } else {
        parsed = (int32_t)value;
    }
    return (ncr_obj_@PARSE_RESULT@){
        .tag = @PARSE_OK_TAG@,
        .data.v@PARSE_OK_TAG@.f0 = parsed
    };
}
static ncr_obj_@PARSE_LONG_RESULT@ @TEXT_PARSE_LONG@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    static const char error_message[] = "[E6111] Text.parseLong: invalid or out-of-range integer";
    size_t length = (size_t)p->length;
    size_t index = 0;
    bool negative = false;
    if (length == 0) {
        return @ERROR_PARSE_LONG_RESULT@(error_message, sizeof(error_message) - 1, line, column);
    }
    if (p->bytes[index] == '+' || p->bytes[index] == '-') {
        negative = p->bytes[index] == '-';
        ++index;
    }
    if (index == length) {
        return @ERROR_PARSE_LONG_RESULT@(error_message, sizeof(error_message) - 1, line, column);
    }
    uint64_t limit = negative ? UINT64_C(9223372036854775808) : (uint64_t)INT64_MAX;
    uint64_t value = 0;
    for (; index < length; ++index) {
        unsigned char byte = p->bytes[index];
        if (byte < '0' || byte > '9') {
            return @ERROR_PARSE_LONG_RESULT@(error_message, sizeof(error_message) - 1, line, column);
        }
        uint64_t digit = (uint64_t)(byte - '0');
        if (value > (limit - digit) / 10) {
            return @ERROR_PARSE_LONG_RESULT@(error_message, sizeof(error_message) - 1, line, column);
        }
        value = value * 10 + digit;
    }
    int64_t parsed = negative
        ? (value == UINT64_C(9223372036854775808) ? INT64_MIN : -(int64_t)value)
        : (int64_t)value;
    return (ncr_obj_@PARSE_LONG_RESULT@){
        .tag = @PARSE_LONG_OK_TAG@,
        .data.v@PARSE_LONG_OK_TAG@.f0 = parsed
    };
}
static bool ncr_text_double_syntax_@ID@(const unsigned char *bytes, size_t length) {
    if (length == 0) { return false; }
    size_t index = 0;
    if (bytes[index] == '+' || bytes[index] == '-') { ++index; }
    size_t digits = 0;
    while (index < length && bytes[index] >= '0' && bytes[index] <= '9') { ++index; ++digits; }
    if (index < length && bytes[index] == '.') {
        ++index;
        while (index < length && bytes[index] >= '0' && bytes[index] <= '9') { ++index; ++digits; }
    }
    if (digits == 0) { return false; }
    if (index < length && (bytes[index] == 'e' || bytes[index] == 'E')) {
        ++index;
        if (index < length && (bytes[index] == '+' || bytes[index] == '-')) { ++index; }
        size_t exponent_digits = 0;
        while (index < length && bytes[index] >= '0' && bytes[index] <= '9') { ++index; ++exponent_digits; }
        if (exponent_digits == 0) { return false; }
    }
    return index == length;
}
static bool ncr_text_double_special_@ID@(const unsigned char *bytes, size_t length) {
    size_t index = length > 0 && (bytes[0] == '+' || bytes[0] == '-') ? 1 : 0;
    if (length - index != 3) { return false; }
    const unsigned char *word = bytes + index;
    return ((word[0] | 0x20u) == 'n' && (word[1] | 0x20u) == 'a' && (word[2] | 0x20u) == 'n')
        || ((word[0] | 0x20u) == 'i' && (word[1] | 0x20u) == 'n' && (word[2] | 0x20u) == 'f');
}
static ncr_obj_@PARSE_DOUBLE_RESULT@ @TEXT_PARSE_DOUBLE@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    static const char error_message[] = "[E6112] Text.parseDouble: invalid or out-of-range number";
    size_t length = (size_t)p->length;
    if (!ncr_text_double_syntax_@ID@(p->bytes, length)
        && !ncr_text_double_special_@ID@(p->bytes, length)) {
        return @ERROR_PARSE_DOUBLE_RESULT@(error_message, sizeof(error_message) - 1, line, column);
    }
    char *buffer = ncr_allocate(length + 1, line, column);
    if (length > 0) { memcpy(buffer, p->bytes, length); }
    buffer[length] = '\0';
    char *end = NULL;
    errno = 0;
    double value = strtod(buffer, &end);
    bool valid = end == buffer + length && errno != ERANGE;
    ncr_deallocate(buffer);
    if (!valid) {
        return @ERROR_PARSE_DOUBLE_RESULT@(error_message, sizeof(error_message) - 1, line, column);
    }
    return (ncr_obj_@PARSE_DOUBLE_RESULT@){
        .tag = @PARSE_DOUBLE_OK_TAG@,
        .data.v@PARSE_DOUBLE_OK_TAG@.f0 = value
    };
}

static bool ncr_text_boundary_@ID@(ncr_obj_@ID@ *p, int32_t index) {
    if (index < 0 || index > p->length) { return false; }
    // Text producers validate UTF-8; only endpoint alignment needs checking here.
    return index == 0 || index == p->length || (p->bytes[index] & 0xc0u) != 0x80u;
}
static ncr_obj_@SLICE_BYTES_RESULT@ @TEXT_SLICE_BYTES@(ncr_obj_@ID@ *p, int32_t start, int32_t end, size_t line, size_t column) {
    if (start < 0 || end < start || end > p->length
        || !ncr_text_boundary_@ID@(p, start) || !ncr_text_boundary_@ID@(p, end)) {
        return @ERROR_SLICE_BYTES_RESULT@("Text.sliceBytes: invalid byte range", sizeof("Text.sliceBytes: invalid byte range") - 1, line, column);
    }
    size_t length = (size_t)(end - start);
    const unsigned char *bytes = p->bytes == NULL || length == 0 ? NULL : p->bytes + start;
    /* Boundary-aligned bytes from Text are already valid UTF-8. */
    ncr_obj_@ID@ *slice = ncr_text_copy_trusted_@ID@(bytes, length, line, column);
    return (ncr_obj_@SLICE_BYTES_RESULT@){
        .tag = @SLICE_BYTES_OK_TAG@,
        .data.v@SLICE_BYTES_OK_TAG@.f0 = slice
    };
}
static bool ncr_text_scalar_offset_@ID@(ncr_obj_@ID@ *p, int32_t scalar_index, size_t *offset) {
    if (scalar_index < 0 || offset == NULL) { return false; }
    size_t cursor = 0;
    uint32_t scalar;
    for (int32_t index = 0; index < scalar_index; ++index) {
        if (!ncr_utf8_decode(p->bytes, (size_t)p->length, &cursor, &scalar)) { return false; }
    }
    *offset = cursor;
    return true;
}

static int32_t @TEXT_CHAR_COUNT@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    size_t cursor = 0;
    int32_t count = 0;
    uint32_t scalar;
    while (cursor < (size_t)p->length) {
        if (!ncr_utf8_decode(p->bytes, (size_t)p->length, &cursor, &scalar) || count == INT32_MAX) {
            ncr_fail("Text contains invalid UTF-8", line, column);
        }
        ++count;
    }
    return count;
}

static uint32_t @TEXT_CHAR_AT@(ncr_obj_@ID@ *p, int32_t index, size_t line, size_t column) {
    size_t cursor;
    if (!ncr_text_scalar_offset_@ID@(p, index, &cursor) || cursor >= (size_t)p->length) {
        ncr_fail("Text character index out of bounds", line, column);
    }
    uint32_t scalar;
    if (!ncr_utf8_decode(p->bytes, (size_t)p->length, &cursor, &scalar)) {
        ncr_fail("Text contains invalid UTF-8", line, column);
    }
    return scalar;
}

static int32_t @TEXT_COMPARE_TO@(ncr_obj_@ID@ *p, ncr_obj_@ID@ *other, size_t line, size_t column) {
    (void)line; (void)column;
    size_t common = (size_t)(p->length < other->length ? p->length : other->length);
    int comparison = common == 0 ? 0 : memcmp(p->bytes, other->bytes, common);
    if (comparison < 0) { return -1; }
    if (comparison > 0) { return 1; }
    return (p->length > other->length) - (p->length < other->length);
}

static size_t ncr_text_find_bytes_@ID@(
    const unsigned char *bytes, size_t length,
    const unsigned char *needle, size_t needle_length, size_t start
) {
    if (start > length) { return SIZE_MAX; }
    if (needle_length == 0) { return start; }
    if (needle_length > length - start) { return SIZE_MAX; }
    size_t remaining = length - start;
    const unsigned char *cursor = bytes + start;
    while (remaining >= needle_length) {
        const unsigned char *candidate = (const unsigned char *)memchr(cursor, needle[0], remaining - needle_length + 1);
        if (candidate == NULL) { return SIZE_MAX; }
        if (needle_length == 1 || memcmp(candidate, needle, needle_length) == 0) {
            return (size_t)(candidate - bytes);
        }
        size_t advanced = (size_t)(candidate - cursor) + 1;
        cursor += advanced;
        remaining -= advanced;
    }
    return SIZE_MAX;
}

static int32_t @TEXT_INDEX_OF@(ncr_obj_@ID@ *p, ncr_obj_@ID@ *needle, size_t line, size_t column) {
    (void)line; (void)column;
    size_t found = ncr_text_find_bytes_@ID@(
        p->bytes, (size_t)p->length, needle->bytes, (size_t)needle->length, 0);
    return found == SIZE_MAX ? -1 : (int32_t)found;
}

static bool @TEXT_STARTS_WITH@(ncr_obj_@ID@ *p, ncr_obj_@ID@ *prefix, size_t line, size_t column) {
    (void)line; (void)column;
    return prefix->length <= p->length
        && (prefix->length == 0 || memcmp(p->bytes, prefix->bytes, (size_t)prefix->length) == 0);
}

static bool @TEXT_ENDS_WITH@(ncr_obj_@ID@ *p, ncr_obj_@ID@ *suffix, size_t line, size_t column) {
    (void)line; (void)column;
    return suffix->length <= p->length
        && (suffix->length == 0
            || memcmp(p->bytes + p->length - suffix->length, suffix->bytes, (size_t)suffix->length) == 0);
}

static ncr_obj_@SLICE_RESULT@ @TEXT_SLICE@(
    ncr_obj_@ID@ *p, int32_t start, int32_t end, size_t line, size_t column
) {
    size_t byte_start;
    size_t byte_end;
    if (start < 0 || end < start
        || !ncr_text_scalar_offset_@ID@(p, start, &byte_start)
        || !ncr_text_scalar_offset_@ID@(p, end, &byte_end)
        || byte_end > (size_t)p->length) {
        return @ERROR_SLICE_RESULT@(
            "Text.slice: invalid scalar range", sizeof("Text.slice: invalid scalar range") - 1, line, column);
    }
    size_t length = byte_end - byte_start;
    const unsigned char *bytes = length == 0 ? NULL : p->bytes + byte_start;
    /* Scalar-aligned bytes from Text are already valid UTF-8. */
    ncr_obj_@ID@ *slice = ncr_text_copy_trusted_@ID@(bytes, length, line, column);
    return (ncr_obj_@SLICE_RESULT@){
        .tag = @SLICE_OK_TAG@,
        .data.v@SLICE_OK_TAG@.f0 = slice
    };
}

static bool ncr_text_whitespace_@ID@(uint32_t scalar) {
    return (scalar >= UINT32_C(0x09) && scalar <= UINT32_C(0x0d))
        || scalar == UINT32_C(0x20) || scalar == UINT32_C(0x85)
        || scalar == UINT32_C(0xa0) || scalar == UINT32_C(0x1680)
        || (scalar >= UINT32_C(0x2000) && scalar <= UINT32_C(0x200a))
        || scalar == UINT32_C(0x2028) || scalar == UINT32_C(0x2029)
        || scalar == UINT32_C(0x202f) || scalar == UINT32_C(0x205f)
        || scalar == UINT32_C(0x3000);
}

static ncr_obj_@ID@ *@TEXT_TRIM@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    size_t cursor = 0;
    size_t start = 0;
    size_t end = 0;
    bool seen_non_whitespace = false;
    uint32_t scalar;
    while (cursor < (size_t)p->length) {
        size_t before = cursor;
        if (!ncr_utf8_decode(p->bytes, (size_t)p->length, &cursor, &scalar)) {
            ncr_fail("Text contains invalid UTF-8", line, column);
        }
        if (!ncr_text_whitespace_@ID@(scalar)) {
            if (!seen_non_whitespace) { start = before; }
            end = cursor;
            seen_non_whitespace = true;
        }
    }
    size_t length = seen_non_whitespace ? end - start : 0;
    const unsigned char *bytes = length == 0 ? NULL : p->bytes + start;
    /* Trimmed bytes from valid Text are already valid UTF-8. */
    return ncr_text_copy_trusted_@ID@(bytes, length, line, column);
}

static ncr_obj_@ID@ *@TEXT_REPLACE@(
    ncr_obj_@ID@ *p, ncr_obj_@ID@ *needle, ncr_obj_@ID@ *replacement, size_t line, size_t column
) {
    size_t source_length = (size_t)p->length;
    size_t needle_length = (size_t)needle->length;
    size_t replacement_length = (size_t)replacement->length;
    size_t matches = 0;
    size_t cursor = 0;
    size_t output_length;
    if (needle_length == 0) {
        matches = 1;
        uint32_t scalar;
        while (cursor < source_length) {
            if (!ncr_utf8_decode(p->bytes, source_length, &cursor, &scalar)) {
                ncr_fail("Text contains invalid UTF-8", line, column);
            }
            ++matches;
        }
        if (replacement_length > 0
            && matches > ((size_t)INT32_MAX - source_length) / replacement_length) {
            ncr_fail("Text replacement is too large", line, column);
        }
        output_length = source_length + matches * replacement_length;
    } else {
        while ((cursor = ncr_text_find_bytes_@ID@(
            p->bytes, source_length, needle->bytes, needle_length, cursor)) != SIZE_MAX) {
            ++matches;
            cursor += needle_length;
        }
        if (replacement_length >= needle_length) {
            size_t growth = replacement_length - needle_length;
            if (growth > 0 && matches > ((size_t)INT32_MAX - source_length) / growth) {
                ncr_fail("Text replacement is too large", line, column);
            }
            output_length = source_length + matches * growth;
        } else {
            output_length = source_length - matches * (needle_length - replacement_length);
        }
    }

    unsigned char *output = output_length == 0 ? NULL : ncr_allocate(output_length, line, column);
    size_t written = 0;
    cursor = 0;
    if (needle_length == 0) {
        uint32_t scalar;
        while (cursor < source_length) {
            size_t next = cursor;
            if (!ncr_utf8_decode(p->bytes, source_length, &next, &scalar)) {
                ncr_fail("Text contains invalid UTF-8", line, column);
            }
            if (replacement_length > 0) {
                memcpy(output + written, replacement->bytes, replacement_length);
                written += replacement_length;
            }
            memcpy(output + written, p->bytes + cursor, next - cursor);
            written += next - cursor;
            cursor = next;
        }
        if (replacement_length > 0) {
            memcpy(output + written, replacement->bytes, replacement_length);
            written += replacement_length;
        }
    } else {
        size_t found;
        while ((found = ncr_text_find_bytes_@ID@(
            p->bytes, source_length, needle->bytes, needle_length, cursor)) != SIZE_MAX) {
            size_t prefix_length = found - cursor;
            if (prefix_length > 0) {
                memcpy(output + written, p->bytes + cursor, prefix_length);
                written += prefix_length;
            }
            if (replacement_length > 0) {
                memcpy(output + written, replacement->bytes, replacement_length);
                written += replacement_length;
            }
            cursor = found + needle_length;
        }
        size_t suffix_length = source_length - cursor;
        if (suffix_length > 0) {
            memcpy(output + written, p->bytes + cursor, suffix_length);
            written += suffix_length;
        }
    }
    if (written != output_length) { ncr_fail("Text replacement length invariant failed", line, column); }
    return @TEXT_TAKE@(output, output_length, output_length, line, column);
}

static @LIST_TYPE@ @TEXT_SPLIT@(
    ncr_obj_@ID@ *p, ncr_obj_@ID@ *delimiter, size_t line, size_t column
) {
    @LIST_TYPE@ list = ncr_allocate(sizeof(*list), line, column);
    @LIST_NEW@(list, line, column);
    size_t source_length = (size_t)p->length;
    size_t delimiter_length = (size_t)delimiter->length;
    if (delimiter_length == 0) {
        size_t cursor = 0;
        uint32_t scalar;
        while (cursor < source_length) {
            size_t next = cursor;
            if (!ncr_utf8_decode(p->bytes, source_length, &next, &scalar)) {
                ncr_fail("Text contains invalid UTF-8", line, column);
            }
            /* Scalar bytes from valid Text are already valid UTF-8. */
            ncr_obj_@ID@ *part = ncr_text_copy_trusted_@ID@(p->bytes + cursor, next - cursor, line, column);
            @LIST_ADD@(list, part, line, column);
            cursor = next;
        }
        return list;
    }
    size_t item_count = 0;
    size_t segment_start = 0;
    size_t cursor = 0;
    size_t found;
    while ((found = ncr_text_find_bytes_@ID@(
        p->bytes, source_length, delimiter->bytes, delimiter_length, cursor)) != SIZE_MAX) {
        if (item_count == INT32_MAX) { ncr_fail("Text split has too many fields", line, column); }
        /* Delimiter-split fields from valid Text are already valid UTF-8. */
        ncr_obj_@ID@ *part = ncr_text_copy_trusted_@ID@(p->bytes == NULL ? NULL : p->bytes + segment_start,
            found - segment_start, line, column);
        ++item_count;
        @LIST_ADD@(list, part, line, column);
        cursor = found + delimiter_length;
        segment_start = cursor;
    }
    size_t final_length = source_length - segment_start;
    if (item_count == INT32_MAX) { ncr_fail("Text split has too many fields", line, column); }
    /* Final field from valid Text is already valid UTF-8. */
    ncr_obj_@ID@ *last = ncr_text_copy_trusted_@ID@(final_length == 0 ? NULL : p->bytes + segment_start,
        final_length, line, column);
    @LIST_ADD@(list, last, line, column);
    return list;
}
