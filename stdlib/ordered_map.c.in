/* Comparator-backed sorted contiguous storage shared by OrderedMap and OrderedSet. */
static int32_t ncr_ordered_compare_@ID@(struct ncr_ordered_storage_@ID@ *table,
                                        @COMPARE_TYPE@ left, @COMPARE_TYPE@ right) {
    return table->comparator->vtable->m@COMPARE_SLOT@(table->comparator->data, left, right);
}

static int32_t ncr_ordered_lower_bound_@ID@(struct ncr_ordered_storage_@ID@ *table,
                                            @COMPARE_TYPE@ key, bool *found) {
    int32_t low = 0;
    int32_t high = table->length;
    while (low < high) {
        int32_t middle = low + (high - low) / 2;
        int32_t compared = ncr_ordered_compare_@ID@(table,
            @COMPARE_STORED_KEY@, key);
        if (compared < 0) { low = middle + 1; }
        else { high = middle; }
    }
    *found = low < table->length &&
        ncr_ordered_compare_@ID@(table, @COMPARE_LOWER_KEY@, key) == 0;
    return low;
}

static int32_t ncr_ordered_lookup_@ID@(struct ncr_ordered_storage_@ID@ *table,
                                       @COMPARE_TYPE@ key) {
    bool found = false;
    int32_t index = ncr_ordered_lower_bound_@ID@(table, key, &found);
    return found ? index : -1;
}

static void ncr_ordered_reserve_@ID@(struct ncr_ordered_storage_@ID@ *table,
                                     int32_t requested, size_t line, size_t column) {
    if (requested < 0) { ncr_fail("OrderedMap capacity is too large", line, column); }
    if (requested <= table->capacity) { return; }
    int64_t capacity = table->capacity == 0 ? 4 : table->capacity;
    while (capacity < requested) {
        capacity = capacity > INT32_MAX / 2 ? INT32_MAX : capacity * 2;
    }
    if ((uint64_t)capacity > SIZE_MAX / sizeof(struct ncr_ordered_entry_@ID@)) {
        ncr_fail("OrderedMap capacity is too large", line, column);
    }
    struct ncr_ordered_entry_@ID@ *items = ncr_allocate(
        (size_t)capacity * sizeof(struct ncr_ordered_entry_@ID@), line, column);
    if (table->length > 0) {
        memcpy(items, table->items, (size_t)table->length * sizeof(struct ncr_ordered_entry_@ID@));
    }
    /* Raw relocation transfers all key and value owners without cloning. */
    ncr_deallocate(table->items);
    table->items = items;
    table->capacity = (int32_t)capacity;
}

static void ncr_ordered_insert_at_@ID@(struct ncr_ordered_storage_@ID@ *table,
                                       int32_t index, @KEY_TYPE@ key, @VALUE_TYPE@ value,
                                       size_t line, size_t column) {
    if (table->length == INT32_MAX) { ncr_fail("OrderedMap is full", line, column); }
    ncr_ordered_reserve_@ID@(table, table->length + 1, line, column);
    int32_t remaining = table->length - index;
    if (remaining > 0) {
        memmove(&table->items[index + 1], &table->items[index],
                (size_t)remaining * sizeof(struct ncr_ordered_entry_@ID@));
    }
    table->items[index].key = key;
    table->items[index].value = value;
    ++table->length;
}

static void ncr_ordered_remove_at_@ID@(struct ncr_ordered_storage_@ID@ *table, int32_t index) {
    @DROP_KEY_FIELD@
    @DROP_VALUE_FIELD@
    int32_t remaining = table->length - index - 1;
    if (remaining > 0) {
        memmove(&table->items[index], &table->items[index + 1],
                (size_t)remaining * sizeof(struct ncr_ordered_entry_@ID@));
    }
    --table->length;
    table->items[table->length].key = @ZERO_KEY@;
    table->items[table->length].value = @ZERO_VALUE@;
}

static void ncr_ordered_clear_@ID@(struct ncr_ordered_storage_@ID@ *table) {
    while (table->length > 0) {
        int32_t index = --table->length;
        @DROP_KEY_FIELD@
        @DROP_VALUE_FIELD@
        table->items[index].key = @ZERO_KEY@;
        table->items[index].value = @ZERO_VALUE@;
    }
}

static void @ORDERED_MAP_NEW@(ncr_obj_@ID@ *p, @COMPARATOR_TYPE@ comparator,
                              size_t line, size_t column) {
    (void)line; (void)column;
    p->table.items = NULL;
    p->table.length = 0;
    p->table.capacity = 0;
    p->@COMPARATOR_FIELD@ = comparator;
    p->table.comparator = &p->@COMPARATOR_FIELD@;
}

static @OPTION_TYPE@ @ORDERED_MAP_PUT@(ncr_obj_@ID@ *p, @KEY_TYPE@ key, @VALUE_TYPE@ value,
                                       size_t line, size_t column) {
    bool found = false;
    int32_t index = ncr_ordered_lower_bound_@ID@(&p->table, @KEY_QUERY_EXPR@, &found);
    if (found) {
        @DROP_DUPLICATE_KEY@
        @VALUE_TYPE@ previous = p->table.items[index].value;
        p->table.items[index].value = value;
        return (@OPTION_TYPE@){ .tag = @SOME_TAG@, .data.v@SOME_TAG@.f0 = previous };
    }
    ncr_ordered_insert_at_@ID@(&p->table, index, key, value, line, column);
    return (@OPTION_TYPE@){ .tag = @NONE_TAG@ };
}

static @OPTION_TYPE@ @ORDERED_MAP_TRY_REMOVE@(ncr_obj_@ID@ *p, @QUERY_TYPE@ key,
                                                size_t line, size_t column) {
    (void)line; (void)column;
    int32_t index = ncr_ordered_lookup_@ID@(&p->table, key);
    if (index < 0) { return (@OPTION_TYPE@){ .tag = @NONE_TAG@ }; }
    @VALUE_TYPE@ value = p->table.items[index].value;
    @DROP_KEY_AT_INDEX@
    int32_t remaining = p->table.length - index - 1;
    if (remaining > 0) {
        memmove(&p->table.items[index], &p->table.items[index + 1],
                (size_t)remaining * sizeof(struct ncr_ordered_entry_@ID@));
    }
    --p->table.length;
    p->table.items[p->table.length].key = @ZERO_KEY@;
    p->table.items[p->table.length].value = @ZERO_VALUE@;
    return (@OPTION_TYPE@){ .tag = @SOME_TAG@, .data.v@SOME_TAG@.f0 = value };
}

static bool @ORDERED_MAP_CONTAINS@(ncr_obj_@ID@ *p, @QUERY_TYPE@ key,
                                   size_t line, size_t column) {
    (void)line; (void)column;
    return ncr_ordered_lookup_@ID@(&p->table, key) >= 0;
}

@TRY_GET_METHOD@
@BORROWED_GETTERS@

static @KEY_AT_TYPE@ @ORDERED_MAP_KEY_AT@(ncr_obj_@ID@ *p, int32_t index,
                                          size_t line, size_t column) {
    if (index < 0 || index >= p->table.length) { ncr_fail("OrderedMap index out of bounds", line, column); }
    return @KEY_AT_EXPR@;
}

static @VALUE_AT_TYPE@ @ORDERED_MAP_VALUE_AT@(ncr_obj_@ID@ *p, int32_t index,
                                               size_t line, size_t column) {
    if (index < 0 || index >= p->table.length) { ncr_fail("OrderedMap index out of bounds", line, column); }
    return @VALUE_AT_EXPR@;
}

static int32_t @ORDERED_MAP_SIZE@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->table.length;
}

static bool @ORDERED_MAP_IS_EMPTY@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->table.length == 0;
}

static void @ORDERED_MAP_CLEAR@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    ncr_ordered_clear_@ID@(&p->table);
}

static @OPTION_INDEX_TYPE@ @ORDERED_MAP_FLOOR_INDEX@(ncr_obj_@ID@ *p, @QUERY_TYPE@ key,
                                                       size_t line, size_t column) {
    (void)line; (void)column;
    bool found = false;
    int32_t position = ncr_ordered_lower_bound_@ID@(&p->table, key, &found);
    int32_t index = found ? position : position - 1;
    if (index < 0) { return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_NONE_TAG@ }; }
    return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_SOME_TAG@, .data.v@INDEX_SOME_TAG@.f0 = index };
}

static @OPTION_INDEX_TYPE@ @ORDERED_MAP_CEILING_INDEX@(ncr_obj_@ID@ *p, @QUERY_TYPE@ key,
                                                         size_t line, size_t column) {
    (void)line; (void)column;
    bool found = false;
    int32_t position = ncr_ordered_lower_bound_@ID@(&p->table, key, &found);
    if (position >= p->table.length) { return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_NONE_TAG@ }; }
    return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_SOME_TAG@, .data.v@INDEX_SOME_TAG@.f0 = position };
}

static @OPTION_INDEX_TYPE@ @ORDERED_MAP_LOWER_INDEX@(ncr_obj_@ID@ *p, @QUERY_TYPE@ key,
                                                       size_t line, size_t column) {
    (void)line; (void)column;
    bool found = false;
    int32_t position = ncr_ordered_lower_bound_@ID@(&p->table, key, &found);
    int32_t index = position - 1;
    if (index < 0) { return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_NONE_TAG@ }; }
    return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_SOME_TAG@, .data.v@INDEX_SOME_TAG@.f0 = index };
}

static @OPTION_INDEX_TYPE@ @ORDERED_MAP_HIGHER_INDEX@(ncr_obj_@ID@ *p, @QUERY_TYPE@ key,
                                                        size_t line, size_t column) {
    (void)line; (void)column;
    bool found = false;
    int32_t position = ncr_ordered_lower_bound_@ID@(&p->table, key, &found);
    int32_t index = found ? position + 1 : position;
    if (index >= p->table.length) { return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_NONE_TAG@ }; }
    return (@OPTION_INDEX_TYPE@){ .tag = @INDEX_SOME_TAG@, .data.v@INDEX_SOME_TAG@.f0 = index };
}
