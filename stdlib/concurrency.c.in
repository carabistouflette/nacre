static bool ncr_sync_ref_acquire(_Atomic size_t *references) {
    size_t current = atomic_load_explicit(references, memory_order_relaxed);
    for (;;) {
        if (current == SIZE_MAX) { return false; }
        if (atomic_compare_exchange_weak_explicit(references, &current, current + 1,
                memory_order_relaxed, memory_order_relaxed)) { return true; }
    }
}
static bool ncr_sync_ref_release(_Atomic size_t *references) {
    size_t current = atomic_load_explicit(references, memory_order_acquire);
    for (;;) {
        if (current == 0) { abort(); }
        if (atomic_compare_exchange_weak_explicit(references, &current, current - 1,
                memory_order_acq_rel, memory_order_acquire)) { return current == 1; }
    }
}
static void ncr_sync_fatal(const char *operation, int error) {
    fprintf(stderr, "internal concurrency failure: %s (pthread error %d)\n", operation, error);
    abort();
}
static size_t ncr_sync_error_text(char *buffer, size_t capacity, const char *operation, int error) {
    int written = snprintf(buffer, capacity, "%s failed (pthread error %d)", operation, error);
    if (written < 0) { return 0; }
    return (size_t)written < capacity ? (size_t)written : capacity - 1;
}
static int ncr_sync_pthread_create(pthread_t *thread, void *(*start)(void *), void *context) {
#ifdef NCR_TEST_FAIL_PTHREAD_CREATE
    (void)thread; (void)start; (void)context;
    return EAGAIN;
#else
    return pthread_create(thread, NULL, start, context);
#endif
}

#ifdef NCR_TEST_FAIL_PTHREAD_COND_WAIT
#define pthread_cond_wait(condition, mutex) ((void)(condition), (void)(mutex), EAGAIN)
#endif

struct ncr_condition_node {
    pthread_cond_t condition;
    struct ncr_condition_node *next;
};

struct ncr_condition_handle_node {
    struct ncr_condition_node node;
    _Atomic size_t references;
};

static bool ncr_condition_node_retain(struct ncr_condition_node *node) {
    struct ncr_condition_handle_node *handle =
        (struct ncr_condition_handle_node *)node;
    return ncr_sync_ref_acquire(&handle->references);
}

static void ncr_condition_node_release(struct ncr_condition_node *node) {
    struct ncr_condition_handle_node *handle =
        (struct ncr_condition_handle_node *)node;
    if (!ncr_sync_ref_release(&handle->references)) { return; }
    int error = pthread_cond_destroy(&node->condition);
    if (error != 0) { ncr_sync_fatal("pthread_cond_destroy(condition handle release)", error); }
    ncr_deallocate(handle);
}

static int ncr_sync_deadline_after_millis(int64_t timeout_ms, struct timespec *deadline) {
    if (timeout_ms < 0) { return EINVAL; }
    int64_t now;
    int failure = 0;
    int64_t absolute_ns;
    if (!ncr_time_monotonic_value(&now, &failure)) { return failure; }
    if (!ncr_time_deadline_after_millis(now, timeout_ms, &absolute_ns)) { return EOVERFLOW; }
    int64_t seconds = absolute_ns / INT64_C(1000000000);
    int64_t nanoseconds = absolute_ns % INT64_C(1000000000);
    time_t converted = (time_t)seconds;
    if ((int64_t)converted != seconds) { return EOVERFLOW; }
    deadline->tv_sec = converted;
    deadline->tv_nsec = (long)nanoseconds;
    return 0;
}

static int ncr_sync_monotonic_now(int64_t *value) {
    int failure = 0;
    if (!ncr_time_monotonic_value(value, &failure)) { return failure; }
    return 0;
}

static int ncr_sync_timespec_from_monotonic_ns(int64_t absolute_ns, struct timespec *deadline) {
    if (absolute_ns < 0) { return EOVERFLOW; }
    int64_t seconds = absolute_ns / INT64_C(1000000000);
    int64_t nanoseconds = absolute_ns % INT64_C(1000000000);
    time_t converted = (time_t)seconds;
    if ((int64_t)converted != seconds) { return EOVERFLOW; }
    deadline->tv_sec = converted;
    deadline->tv_nsec = (long)nanoseconds;
    return 0;
}
