/* NACRE_LOCALE_BEGIN AVAILABLE */
static @LIST_TYPE@ @LOCALE_AVAILABLE@(size_t ncr_line, size_t ncr_column) {
    @LIST_TYPE@ locales = ncr_allocate(sizeof(*locales), ncr_line, ncr_column);
    @LIST_NEW@(locales, ncr_line, ncr_column);
    bool has_root = false;
    static const unsigned char root_tag[] = { 'u', 'n', 'd' };
    int32_t available_count = uloc_countAvailable();
    if (available_count < 0) {
        ncr_drop_@LIST_ID@(locales);
        ncr_fail("ICU locale inventory failed", ncr_line, ncr_column);
    }
    for (int32_t index = 0; index < available_count; ++index) {
        const char *locale_id = uloc_getAvailable(index);
        if (locale_id == NULL) {
            ncr_drop_@LIST_ID@(locales);
            ncr_fail("ICU locale inventory returned an invalid entry", ncr_line, ncr_column);
        }
        UErrorCode status = U_ZERO_ERROR;
        int32_t tag_length = uloc_toLanguageTag(locale_id, NULL, 0, true, &status);
        if (!ncr_unicode_preflight_ok(status) || tag_length < 0 || tag_length >= INT32_MAX) {
            ncr_drop_@LIST_ID@(locales);
            ncr_fail("ICU locale tag conversion failed", ncr_line, ncr_column);
        }
        size_t capacity = (size_t)tag_length + 1;
        unsigned char *tag = ncr_allocate(capacity, ncr_line, ncr_column);
        status = U_ZERO_ERROR;
        int32_t written = uloc_toLanguageTag(locale_id, (char *)tag, (int32_t)capacity, true, &status);
        if (U_FAILURE(status) || written != tag_length) {
            ncr_deallocate(tag);
            ncr_drop_@LIST_ID@(locales);
            ncr_fail("ICU locale tag conversion failed", ncr_line, ncr_column);
        }
        if (written == 3 && memcmp(tag, root_tag, sizeof(root_tag)) == 0) { has_root = true; }
        ncr_obj_@TEXT_ID@ *tag_text = ncr_text_take_bytes_@TEXT_ID@(tag, (size_t)written, capacity, ncr_line, ncr_column);
        @LIST_ADD@(locales, tag_text, ncr_line, ncr_column);
    }
    if (!has_root) {
        ncr_obj_@TEXT_ID@ *root_text = ncr_text_from_bytes_@TEXT_ID@(root_tag, sizeof(root_tag), ncr_line, ncr_column);
        @LIST_ADD@(locales, root_text, ncr_line, ncr_column);
    }
    return locales;
}
/* NACRE_LOCALE_END AVAILABLE */

/* NACRE_LOCALE_BEGIN OPEN_DECIMAL */
static bool ncr_locale_open_decimal(ncr_obj_@TEXT_ID@ *pattern, ncr_obj_@TEXT_ID@ *locale, UNumberFormat **output, size_t line, size_t column) {
    *output = NULL;
    if (pattern == NULL || pattern->length <= 0 || memchr(pattern->bytes, 0, (size_t)pattern->length) != NULL) { return false; }
    char locale_id[ULOC_FULLNAME_CAPACITY];
    if (!ncr_unicode_locale(locale, locale_id)) { return false; }
    UChar *pattern_utf16 = NULL;
    int32_t pattern_length = 0;
    if (!ncr_unicode_text_to_utf16(pattern, &pattern_utf16, &pattern_length, line, column) || pattern_length == 0) {
        if (pattern_utf16 != NULL) { ncr_deallocate(pattern_utf16); }
        return false;
    }
    UErrorCode status = U_ZERO_ERROR;
    UNumberFormat *format = unum_open(UNUM_PATTERN_DECIMAL, pattern_utf16, pattern_length, locale_id, NULL, &status);
    ncr_deallocate(pattern_utf16);
    if (U_FAILURE(status) || format == NULL) {
        if (format != NULL) { unum_close(format); }
        return false;
    }
    *output = format;
    return true;
}
/* NACRE_LOCALE_END OPEN_DECIMAL */

/* NACRE_LOCALE_BEGIN CURRENCY */
static bool ncr_locale_currency_code(ncr_obj_@TEXT_ID@ *text, UChar code[4]) {
    if (text == NULL || text->length != 3) { return false; }
    for (int32_t index = 0; index < 3; ++index) {
        unsigned char byte = text->bytes[index];
        if (byte >= 'a' && byte <= 'z') { byte = (unsigned char)(byte - ('a' - 'A')); }
        if (byte < 'A' || byte > 'Z') { return false; }
        code[index] = (UChar)byte;
    }
    code[3] = 0;
    UErrorCode status = U_ZERO_ERROR;
    return ucurr_isAvailable(code, U_DATE_MIN, U_DATE_MAX, &status) && U_SUCCESS(status);
}

static bool ncr_locale_open_currency(ncr_obj_@TEXT_ID@ *currency_text, ncr_obj_@TEXT_ID@ *locale, UNumberFormat **output) {
    *output = NULL;
    UChar currency[4];
    if (!ncr_locale_currency_code(currency_text, currency)) { return false; }
    char locale_id[ULOC_FULLNAME_CAPACITY];
    if (!ncr_unicode_locale(locale, locale_id)) { return false; }
    UErrorCode status = U_ZERO_ERROR;
    UNumberFormat *format = unum_open(UNUM_CURRENCY, NULL, 0, locale_id, NULL, &status);
    if (U_FAILURE(status) || format == NULL) {
        if (format != NULL) { unum_close(format); }
        return false;
    }
    status = U_ZERO_ERROR;
    unum_setTextAttribute(format, UNUM_CURRENCY_CODE, currency, 3, &status);
    if (U_FAILURE(status)) { unum_close(format); return false; }
    *output = format;
    return true;
}
/* NACRE_LOCALE_END CURRENCY */

/* NACRE_LOCALE_BEGIN FORMAT_DOUBLE */
static bool ncr_locale_format_double(const UNumberFormat *format, double value, UChar **output, int32_t *output_length, size_t line, size_t column) {
    *output = NULL;
    *output_length = 0;
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = unum_formatDouble(format, value, NULL, 0, NULL, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0 || required >= INT32_MAX ||
        (size_t)(required + 1) > SIZE_MAX / sizeof(UChar)) { return false; }
    UChar *formatted = ncr_allocate((size_t)(required + 1) * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = unum_formatDouble(format, value, formatted, required + 1, NULL, &status);
    if (U_FAILURE(status) || written != required) { ncr_deallocate(formatted); return false; }
    *output = formatted;
    *output_length = written;
    return true;
}
/* NACRE_LOCALE_END FORMAT_DOUBLE */

/* NACRE_LOCALE_BEGIN FORMAT_DECIMAL */
static bool ncr_locale_format_decimal(const UNumberFormat *format, const char *decimal, int32_t decimal_length, UChar **output, int32_t *output_length, size_t line, size_t column) {
    *output = NULL;
    *output_length = 0;
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = unum_formatDecimal(format, decimal, decimal_length, NULL, 0, NULL, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0 || required >= INT32_MAX ||
        (size_t)(required + 1) > SIZE_MAX / sizeof(UChar)) { return false; }
    UChar *formatted = ncr_allocate((size_t)(required + 1) * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = unum_formatDecimal(format, decimal, decimal_length, formatted, required + 1, NULL, &status);
    if (U_FAILURE(status) || written != required) { ncr_deallocate(formatted); return false; }
    *output = formatted;
    *output_length = written;
    return true;
}
/* NACRE_LOCALE_END FORMAT_DECIMAL */

/* NACRE_LOCALE_BEGIN EXACT_DECIMAL */
static bool ncr_locale_exact_decimal(ncr_obj_@TEXT_ID@ *text) {
    if (text == NULL || text->length <= 0) { return false; }
    for (int32_t index = 0; index < text->length; ++index) {
        if (text->bytes[index] == 0 || text->bytes[index] > 0x7f) { return false; }
    }
    return true;
}
/* NACRE_LOCALE_END EXACT_DECIMAL */

/* NACRE_LOCALE_BEGIN FORMAT_NUMBER */
static ncr_obj_@FORMAT_NUMBER_RESULT@ @LOCALE_FORMAT_NUMBER@(double ncr_v_@FORMAT_NUMBER_VALUE@, ncr_obj_@TEXT_ID@ *ncr_v_@FORMAT_NUMBER_PATTERN@, ncr_obj_@TEXT_ID@ *ncr_v_@FORMAT_NUMBER_LOCALE@, size_t ncr_line, size_t ncr_column) {
    UNumberFormat *format = NULL;
    if (!ncr_locale_open_decimal(ncr_v_@FORMAT_NUMBER_PATTERN@, ncr_v_@FORMAT_NUMBER_LOCALE@, &format, ncr_line, ncr_column)) {
        return ncr_result_error_@FORMAT_NUMBER_RESULT@("invalid decimal pattern or BCP-47 locale", sizeof("invalid decimal pattern or BCP-47 locale") - 1, ncr_line, ncr_column);
    }
    UChar *formatted = NULL; int32_t formatted_length = 0;
    bool ok = ncr_locale_format_double(format, ncr_v_@FORMAT_NUMBER_VALUE@, &formatted, &formatted_length, ncr_line, ncr_column);
    unum_close(format);
    if (!ok) { return ncr_result_error_@FORMAT_NUMBER_RESULT@("number formatting failed", sizeof("number formatting failed") - 1, ncr_line, ncr_column); }
    ncr_obj_@TEXT_ID@ *text = ncr_unicode_make_text(formatted, formatted_length, ncr_line, ncr_column);
    ncr_deallocate(formatted);
    if (text == NULL) { return ncr_result_error_@FORMAT_NUMBER_RESULT@("formatted number is not valid Unicode", sizeof("formatted number is not valid Unicode") - 1, ncr_line, ncr_column); }
    return (ncr_obj_@FORMAT_NUMBER_RESULT@){ .tag = @FORMAT_NUMBER_OK@, .data.v@FORMAT_NUMBER_OK@.f0 = text };
}
/* NACRE_LOCALE_END FORMAT_NUMBER */

/* NACRE_LOCALE_BEGIN FORMAT_DECIMAL_API */
static ncr_obj_@FORMAT_DECIMAL_RESULT@ @LOCALE_FORMAT_DECIMAL@(ncr_obj_@TEXT_ID@ *ncr_v_@FORMAT_DECIMAL_VALUE@, ncr_obj_@TEXT_ID@ *ncr_v_@FORMAT_DECIMAL_PATTERN@, ncr_obj_@TEXT_ID@ *ncr_v_@FORMAT_DECIMAL_LOCALE@, size_t ncr_line, size_t ncr_column) {
    if (!ncr_locale_exact_decimal(ncr_v_@FORMAT_DECIMAL_VALUE@)) {
        return ncr_result_error_@FORMAT_DECIMAL_RESULT@("exact decimal must be nonempty ASCII numeric text without NUL", sizeof("exact decimal must be nonempty ASCII numeric text without NUL") - 1, ncr_line, ncr_column);
    }
    UNumberFormat *format = NULL;
    if (!ncr_locale_open_decimal(ncr_v_@FORMAT_DECIMAL_PATTERN@, ncr_v_@FORMAT_DECIMAL_LOCALE@, &format, ncr_line, ncr_column)) {
        return ncr_result_error_@FORMAT_DECIMAL_RESULT@("invalid decimal pattern or BCP-47 locale", sizeof("invalid decimal pattern or BCP-47 locale") - 1, ncr_line, ncr_column);
    }
    UChar *formatted = NULL; int32_t formatted_length = 0;
    bool ok = ncr_locale_format_decimal(format, (const char *)ncr_v_@FORMAT_DECIMAL_VALUE@->bytes,
        ncr_v_@FORMAT_DECIMAL_VALUE@->length, &formatted, &formatted_length, ncr_line, ncr_column);
    unum_close(format);
    if (!ok) { return ncr_result_error_@FORMAT_DECIMAL_RESULT@("exact decimal formatting failed", sizeof("exact decimal formatting failed") - 1, ncr_line, ncr_column); }
    ncr_obj_@TEXT_ID@ *text = ncr_unicode_make_text(formatted, formatted_length, ncr_line, ncr_column);
    ncr_deallocate(formatted);
    if (text == NULL) { return ncr_result_error_@FORMAT_DECIMAL_RESULT@("formatted decimal is not valid Unicode", sizeof("formatted decimal is not valid Unicode") - 1, ncr_line, ncr_column); }
    return (ncr_obj_@FORMAT_DECIMAL_RESULT@){ .tag = @FORMAT_DECIMAL_OK@, .data.v@FORMAT_DECIMAL_OK@.f0 = text };
}
/* NACRE_LOCALE_END FORMAT_DECIMAL_API */

/* NACRE_LOCALE_BEGIN PARSE_NUMBER */
static ncr_obj_@PARSE_NUMBER_RESULT@ @LOCALE_PARSE_NUMBER@(ncr_obj_@TEXT_ID@ *ncr_v_@PARSE_NUMBER_VALUE@, ncr_obj_@TEXT_ID@ *ncr_v_@PARSE_NUMBER_PATTERN@, ncr_obj_@TEXT_ID@ *ncr_v_@PARSE_NUMBER_LOCALE@, size_t ncr_line, size_t ncr_column) {
    if (ncr_v_@PARSE_NUMBER_VALUE@ == NULL || ncr_v_@PARSE_NUMBER_VALUE@->length < 0 ||
        memchr(ncr_v_@PARSE_NUMBER_VALUE@->bytes, 0, (size_t)ncr_v_@PARSE_NUMBER_VALUE@->length) != NULL) {
        return ncr_result_error_@PARSE_NUMBER_RESULT@("number text must not contain NUL", sizeof("number text must not contain NUL") - 1, ncr_line, ncr_column);
    }
    UNumberFormat *format = NULL;
    if (!ncr_locale_open_decimal(ncr_v_@PARSE_NUMBER_PATTERN@, ncr_v_@PARSE_NUMBER_LOCALE@, &format, ncr_line, ncr_column)) {
        return ncr_result_error_@PARSE_NUMBER_RESULT@("invalid decimal pattern or BCP-47 locale", sizeof("invalid decimal pattern or BCP-47 locale") - 1, ncr_line, ncr_column);
    }
    UChar *value = NULL; int32_t value_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@PARSE_NUMBER_VALUE@, &value, &value_length, ncr_line, ncr_column)) {
        unum_close(format);
        return ncr_result_error_@PARSE_NUMBER_RESULT@("number text could not be converted to UTF-16", sizeof("number text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    static const UChar empty[1] = { 0 };
    int32_t parse_position = 0;
    UErrorCode status = U_ZERO_ERROR;
    double number = unum_parseDouble(format, value == NULL ? empty : value, value_length, &parse_position, &status);
    unum_close(format);
    if (value != NULL) { ncr_deallocate(value); }
    if (U_FAILURE(status) || parse_position != value_length) {
        return ncr_result_error_@PARSE_NUMBER_RESULT@("number text is malformed or has trailing content", sizeof("number text is malformed or has trailing content") - 1, ncr_line, ncr_column);
    }
    return (ncr_obj_@PARSE_NUMBER_RESULT@){ .tag = @PARSE_NUMBER_OK@, .data.v@PARSE_NUMBER_OK@.f0 = number };
}
/* NACRE_LOCALE_END PARSE_NUMBER */

/* NACRE_LOCALE_BEGIN FORMAT_CURRENCY */
static ncr_obj_@FORMAT_CURRENCY_RESULT@ @LOCALE_FORMAT_CURRENCY@(double ncr_v_@FORMAT_CURRENCY_VALUE@, ncr_obj_@TEXT_ID@ *ncr_v_@FORMAT_CURRENCY_CODE@, ncr_obj_@TEXT_ID@ *ncr_v_@FORMAT_CURRENCY_LOCALE@, size_t ncr_line, size_t ncr_column) {
    UNumberFormat *format = NULL;
    if (!ncr_locale_open_currency(ncr_v_@FORMAT_CURRENCY_CODE@, ncr_v_@FORMAT_CURRENCY_LOCALE@, &format)) {
        return ncr_result_error_@FORMAT_CURRENCY_RESULT@("unknown ISO 4217 currency or invalid BCP-47 locale", sizeof("unknown ISO 4217 currency or invalid BCP-47 locale") - 1, ncr_line, ncr_column);
    }
    UChar *formatted = NULL; int32_t formatted_length = 0;
    bool ok = ncr_locale_format_double(format, ncr_v_@FORMAT_CURRENCY_VALUE@, &formatted, &formatted_length, ncr_line, ncr_column);
    unum_close(format);
    if (!ok) { return ncr_result_error_@FORMAT_CURRENCY_RESULT@("currency formatting failed", sizeof("currency formatting failed") - 1, ncr_line, ncr_column); }
    ncr_obj_@TEXT_ID@ *text = ncr_unicode_make_text(formatted, formatted_length, ncr_line, ncr_column);
    ncr_deallocate(formatted);
    if (text == NULL) { return ncr_result_error_@FORMAT_CURRENCY_RESULT@("formatted currency is not valid Unicode", sizeof("formatted currency is not valid Unicode") - 1, ncr_line, ncr_column); }
    return (ncr_obj_@FORMAT_CURRENCY_RESULT@){ .tag = @FORMAT_CURRENCY_OK@, .data.v@FORMAT_CURRENCY_OK@.f0 = text };
}
/* NACRE_LOCALE_END FORMAT_CURRENCY */
