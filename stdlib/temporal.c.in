    fields->ncr_f_8 = ncr_v_0->second;
    fields->ncr_f_9 = ncr_v_0->nanosecond;
    fields->ncr_f_10 = ncr_v_0->offset_seconds;
    return (ncr_obj_@TEMPORAL_FIELDS_RESULT@){ .tag = @TEMPORAL_FIELDS_OK_TAG@,
        .data.v@TEMPORAL_FIELDS_OK_TAG@.f0 = fields };
}

ncr_obj_@TEMPORAL_INT_RESULT@ @TEMPORAL_COMPARE_TO@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, ncr_obj_@TEMPORAL_ID@ *ncr_v_1,
    size_t ncr_line, size_t ncr_column
) {
    int32_t left_timeline = ncr_v_0->kind == NCR_TV_INSTANT
        || ncr_v_0->kind == NCR_TV_OFFSET_DATE_TIME || ncr_v_0->kind == NCR_TV_ZONED_DATE_TIME;
    int32_t right_timeline = ncr_v_1->kind == NCR_TV_INSTANT
        || ncr_v_1->kind == NCR_TV_OFFSET_DATE_TIME || ncr_v_1->kind == NCR_TV_ZONED_DATE_TIME;
    int32_t comparison = 0;
    if (left_timeline && right_timeline) {
        comparison = ncr_tv_compare_parts(ncr_v_0->epoch_second, ncr_v_0->nanosecond,
            ncr_v_1->epoch_second, ncr_v_1->nanosecond);
    } else if (ncr_v_0->kind == NCR_TV_DURATION && ncr_v_1->kind == NCR_TV_DURATION) {
        comparison = ncr_tv_compare_parts(ncr_v_0->epoch_second, ncr_v_0->nanosecond,
            ncr_v_1->epoch_second, ncr_v_1->nanosecond);
    } else if ((ncr_v_0->kind == NCR_TV_LOCAL_DATE
            || ncr_v_0->kind == NCR_TV_LOCAL_DATE_TIME)
        && ncr_v_0->kind == ncr_v_1->kind && ncr_v_0->calendar == ncr_v_1->calendar) {
        comparison = ncr_tv_compare_parts(ncr_v_0->local_second, ncr_v_0->nanosecond,
            ncr_v_1->local_second, ncr_v_1->nanosecond);
    } else if (ncr_v_0->kind == NCR_TV_LOCAL_TIME && ncr_v_1->kind == NCR_TV_LOCAL_TIME) {
        comparison = ncr_tv_compare_parts(ncr_v_0->local_second, ncr_v_0->nanosecond,
            ncr_v_1->local_second, ncr_v_1->nanosecond);
    } else {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_INT_RESULT@,
            "Temporal.compareTo: values are from incomparable temporal domains or calendars",
            ncr_line, ncr_column);
    }
    return (ncr_obj_@TEMPORAL_INT_RESULT@){ .tag = @TEMPORAL_INT_OK_TAG@,
        .data.v@TEMPORAL_INT_OK_TAG@.f0 = comparison };
}

static bool ncr_tv_resolve_stored_wall(
    ncr_obj_@TEMPORAL_ID@ *value, bool prefer_later, size_t line, size_t column
) {
    UChar *zone = NULL;
    int32_t zone_length = 0;
    if (!ncr_tv_zone_to_uchar(value->zone, value->zone_length,
        &zone, &zone_length, line, column)) { return false; }
    UCalendar *calendar = ncr_tv_open_calendar(zone, zone_length, value->calendar,
        line, column);
    ncr_deallocate(zone);
    if (calendar == NULL) { return false; }
    int64_t millis = 0;
    struct ncr_tv_fields fields;
    bool valid = ncr_tv_resolve_wall(calendar, value->era, value->year, value->month,
        value->day, value->hour, value->minute, value->second,
        value->nanosecond / 1000000, prefer_later, &millis, &fields);
    int32_t offset = 0;
    if (valid) { valid = ncr_tv_offset_seconds(calendar, &offset); }
    ucal_close(calendar);
    if (!valid) { return false; }
    ncr_tv_parts_from_millis(millis, value->nanosecond % 1000000,
        &value->epoch_second, &value->nanosecond);
    value->offset_seconds = offset;
    ncr_tv_store_fields(value, &fields, value->nanosecond);
    return ncr_tv_add_i64(value->epoch_second, offset, &value->local_second);
}

static void ncr_tv_add_calendar_component(
    UCalendar *calendar, UCalendarDateFields field, int32_t amount, UErrorCode *status
) {
    if (U_FAILURE(*status) || amount == 0) { return; }
    ucal_add(calendar, field, amount, status);
    if (U_FAILURE(*status)) { return; }
    int64_t millis;
    UDate adjusted = ucal_getMillis(calendar, status);
    if (U_SUCCESS(*status) && !ncr_dt_udate_to_epoch(adjusted, &millis)) {
        *status = U_ILLEGAL_ARGUMENT_ERROR;
    }
}

static bool ncr_tv_apply_calendar_period(
    ncr_obj_@TEMPORAL_ID@ *value,
    const ncr_obj_@TEMPORAL_ID@ *period,
    bool prefer_later,
    size_t line,
    size_t column
) {
    int64_t local_millis = 0;
    if (!ncr_tv_epoch_millis(value->local_second, value->nanosecond, &local_millis)) {
        return false;
    }
    UCalendar *calendar = ncr_tv_open_utc(value->calendar, line, column);
    if (calendar == NULL) { return false; }
    UErrorCode status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)local_millis, &status);
    ncr_tv_add_calendar_component(calendar, UCAL_YEAR, period->period_years, &status);
    ncr_tv_add_calendar_component(calendar, UCAL_MONTH, period->period_months, &status);
    ncr_tv_add_calendar_component(calendar, UCAL_DATE, period->period_days, &status);
    UDate adjusted = U_FAILURE(status) ? 0.0 : ucal_getMillis(calendar, &status);
    int64_t adjusted_millis = 0;
    struct ncr_tv_fields fields;
    bool valid = U_SUCCESS(status) && ncr_dt_udate_to_epoch(adjusted, &adjusted_millis)
        && ncr_tv_read_fields(calendar, &fields);
    ucal_close(calendar);
    if (!valid) { return false; }
    int64_t local_second = 0;
    int32_t nanos = 0;
    ncr_tv_parts_from_millis(adjusted_millis, value->nanosecond % 1000000,
        &local_second, &nanos);
    value->local_second = local_second;
    value->nanosecond = nanos;
    ncr_tv_store_fields(value, &fields, nanos);
    if (value->kind == NCR_TV_OFFSET_DATE_TIME) {
        return ncr_tv_add_i64(local_second, -(int64_t)value->offset_seconds,
            &value->epoch_second);
    }
    if (value->kind == NCR_TV_ZONED_DATE_TIME) {
        return ncr_tv_resolve_stored_wall(value, prefer_later, line, column);
    }
    value->epoch_second = local_second;
    return true;
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_PLUS_DURATION@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, ncr_obj_@TEMPORAL_ID@ *ncr_v_1,
    size_t ncr_line, size_t ncr_column
) {
    if (ncr_v_1->kind != NCR_TV_DURATION) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.plusDuration: argument must be a Duration", ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_clone(ncr_v_0, ncr_line, ncr_column);
    bool valid = false;
    if (value->kind == NCR_TV_DURATION || value->kind == NCR_TV_INSTANT) {
        valid = ncr_tv_add_parts(value->epoch_second, value->nanosecond,
            ncr_v_1->epoch_second, ncr_v_1->nanosecond,
            &value->epoch_second, &value->nanosecond);
    } else if (value->kind == NCR_TV_OFFSET_DATE_TIME
        || value->kind == NCR_TV_ZONED_DATE_TIME) {
        valid = ncr_tv_add_parts(value->epoch_second, value->nanosecond,
            ncr_v_1->epoch_second, ncr_v_1->nanosecond,
            &value->epoch_second, &value->nanosecond)
            && ncr_tv_update_from_instant(value, ncr_line, ncr_column);
    } else if (value->kind == NCR_TV_LOCAL_DATE_TIME) {
        valid = ncr_tv_add_parts(value->local_second, value->nanosecond,
            ncr_v_1->epoch_second, ncr_v_1->nanosecond,
            &value->local_second, &value->nanosecond)
            && ncr_tv_update_local_from_second(value, ncr_line, ncr_column);
        value->epoch_second = value->local_second;
    } else if (value->kind == NCR_TV_LOCAL_TIME) {
        int64_t add_seconds = ncr_v_1->epoch_second % NCR_TV_SECONDS_PER_DAY;
        int64_t sum = 0;
        int64_t total_nanos = (int64_t)value->nanosecond + ncr_v_1->nanosecond;
        int64_t carry = total_nanos >= NCR_TV_NANOS_PER_SECOND ? 1 : 0;
        if (carry != 0) { total_nanos -= NCR_TV_NANOS_PER_SECOND; }
        valid = ncr_tv_add_i64(value->local_second, add_seconds, &sum)
            && ncr_tv_add_i64(sum, carry, &sum);
        if (valid) {
            sum %= NCR_TV_SECONDS_PER_DAY;
            if (sum < 0) { sum += NCR_TV_SECONDS_PER_DAY; }
            value->local_second = sum;
            value->nanosecond = (int32_t)total_nanos;
            value->hour = (int32_t)(sum / 3600);
            value->minute = (int32_t)((sum % 3600) / 60);
            value->second = (int32_t)(sum % 60);
        }
    }
    if (!valid) {
        ncr_drop_@TEMPORAL_ID@(value);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.plusDuration: unsupported kind, overflow, or ICU range exceeded",
            ncr_line, ncr_column);
    }
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_PLUS_PERIOD@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, ncr_obj_@TEMPORAL_ID@ *ncr_v_1,
    bool ncr_v_2, size_t ncr_line, size_t ncr_column
) {
    if (ncr_v_1->kind != NCR_TV_PERIOD) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.plusPeriod: argument must be a Period", ncr_line, ncr_column);
    }
    if (ncr_v_0->kind != NCR_TV_LOCAL_DATE && ncr_v_0->kind != NCR_TV_LOCAL_DATE_TIME
        && ncr_v_0->kind != NCR_TV_OFFSET_DATE_TIME
        && ncr_v_0->kind != NCR_TV_ZONED_DATE_TIME) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.plusPeriod: receiver must have calendar date fields", ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_clone(ncr_v_0, ncr_line, ncr_column);
    if (!ncr_tv_apply_calendar_period(value, ncr_v_1, ncr_v_2, ncr_line, ncr_column)) {
        ncr_drop_@TEMPORAL_ID@(value);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.plusPeriod: invalid target date, DST gap, overflow, or ICU range",
            ncr_line, ncr_column);
    }
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_AT_ZONE@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_1,
    bool ncr_v_2, size_t ncr_line, size_t ncr_column
) {
    if (ncr_v_0->kind != NCR_TV_LOCAL_DATE && ncr_v_0->kind != NCR_TV_LOCAL_DATE_TIME) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.atZone: receiver must be a LocalDate or LocalDateTime", ncr_line, ncr_column);
    }
    char *zone_bytes = NULL;
    int32_t zone_bytes_length = 0;
    UChar *zone = NULL;
    int32_t zone_length = 0;
    if (!ncr_tv_zone_from_text(ncr_v_1, &zone_bytes, &zone_bytes_length,
        &zone, &zone_length, ncr_line, ncr_column)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.atZone: zone must be a known ICU time-zone ID", ncr_line, ncr_column);
    }
    UCalendar *calendar = ncr_tv_open_calendar(zone, zone_length, ncr_v_0->calendar,
        ncr_line, ncr_column);
    ncr_deallocate(zone);
    if (calendar == NULL) {
        ncr_deallocate(zone_bytes);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.atZone: ICU calendar initialization failed", ncr_line, ncr_column);
    }
    int64_t millis = 0;
    struct ncr_tv_fields fields;
    bool valid = ncr_tv_resolve_wall(calendar, ncr_v_0->era, ncr_v_0->year,
        ncr_v_0->month, ncr_v_0->day, ncr_v_0->hour, ncr_v_0->minute,
        ncr_v_0->second, ncr_v_0->nanosecond / 1000000, ncr_v_2, &millis, &fields);
    int32_t offset = 0;
    if (valid) { valid = ncr_tv_offset_seconds(calendar, &offset); }
    ucal_close(calendar);
    int64_t epoch_second = 0, local_second = 0;
    int32_t nanos = 0;
    if (valid) {
        ncr_tv_parts_from_millis(millis, ncr_v_0->nanosecond % 1000000,
            &epoch_second, &nanos);
        valid = ncr_tv_add_i64(epoch_second, offset, &local_second);
    }
    if (!valid) {
        ncr_deallocate(zone_bytes);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.atZone: local time falls in a daylight-saving gap or ICU range",
            ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_clone(ncr_v_0, ncr_line, ncr_column);
    value->kind = NCR_TV_ZONED_DATE_TIME;
    value->zone = zone_bytes;
    value->zone_length = zone_bytes_length;
    value->epoch_second = epoch_second;
    value->local_second = local_second;
    value->offset_seconds = offset;
    value->nanosecond = nanos;
    ncr_tv_store_fields(value, &fields, nanos);
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_WITH_ZONE@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_1,
    size_t ncr_line, size_t ncr_column
) {
    if (ncr_v_0->kind != NCR_TV_INSTANT && ncr_v_0->kind != NCR_TV_OFFSET_DATE_TIME
        && ncr_v_0->kind != NCR_TV_ZONED_DATE_TIME) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withZone: receiver must represent an instant", ncr_line, ncr_column);
    }
    char *zone_bytes = NULL;
    int32_t zone_bytes_length = 0;
    UChar *zone = NULL;
    int32_t zone_length = 0;
    if (!ncr_tv_zone_from_text(ncr_v_1, &zone_bytes, &zone_bytes_length,
        &zone, &zone_length, ncr_line, ncr_column)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withZone: zone must be a known ICU time-zone ID", ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_copy_without_zone(ncr_v_0, ncr_line, ncr_column);
    value->zone = zone_bytes;
    value->zone_length = zone_bytes_length;
    value->kind = NCR_TV_ZONED_DATE_TIME;
    bool valid = ncr_tv_update_from_zone(value, zone, zone_length, ncr_line, ncr_column);
    ncr_deallocate(zone);
    if (!valid) {
        ncr_drop_@TEMPORAL_ID@(value);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withZone: instant exceeds ICU's exact calendar range", ncr_line, ncr_column);
    }
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_WITH_OFFSET@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, int32_t ncr_v_1,
    size_t ncr_line, size_t ncr_column
) {
    if (ncr_v_0->kind != NCR_TV_INSTANT && ncr_v_0->kind != NCR_TV_OFFSET_DATE_TIME
        && ncr_v_0->kind != NCR_TV_ZONED_DATE_TIME) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withOffset: receiver must represent an instant", ncr_line, ncr_column);
    }
    if (ncr_v_1 < -64800 || ncr_v_1 > 64800) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withOffset: offset must be within plus or minus 18 hours",
            ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_copy_without_zone(ncr_v_0, ncr_line, ncr_column);
    value->kind = NCR_TV_OFFSET_DATE_TIME;
    value->offset_seconds = ncr_v_1;
    if (!ncr_tv_update_from_instant(value, ncr_line, ncr_column)) {
        ncr_drop_@TEMPORAL_ID@(value);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withOffset: instant exceeds ICU's exact calendar range",
            ncr_line, ncr_column);
    }
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_WITH_TIME@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, ncr_obj_@TEMPORAL_ID@ *ncr_v_1,
    size_t ncr_line, size_t ncr_column
) {
    if (ncr_v_0->kind != NCR_TV_LOCAL_DATE || ncr_v_1->kind != NCR_TV_LOCAL_TIME) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withTime: receiver must be LocalDate and argument LocalTime",
            ncr_line, ncr_column);
    }
    int64_t local_second = 0;
    struct ncr_tv_fields fields;
    if (!ncr_tv_local_fields(ncr_v_0->calendar, ncr_v_0->era, ncr_v_0->year,
        ncr_v_0->month, ncr_v_0->day, ncr_v_1->hour, ncr_v_1->minute,
        ncr_v_1->second, ncr_v_1->nanosecond, &local_second, &fields,
        ncr_line, ncr_column)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withTime: civil date/time exceeds ICU's exact range",
            ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_clone(ncr_v_0, ncr_line, ncr_column);
    value->kind = NCR_TV_LOCAL_DATE_TIME;
    value->local_second = local_second;
    value->epoch_second = local_second;
    value->nanosecond = ncr_v_1->nanosecond;
    ncr_tv_store_fields(value, &fields, value->nanosecond);
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_WITH_CALENDAR@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_1,
    size_t ncr_line, size_t ncr_column
) {
    int32_t calendar = 0;
    if (!ncr_tv_calendar_from_text(ncr_v_1, &calendar)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withCalendar: unsupported ICU calendar identifier", ncr_line, ncr_column);
    }
    if (ncr_v_0->kind != NCR_TV_LOCAL_DATE && ncr_v_0->kind != NCR_TV_LOCAL_DATE_TIME
        && ncr_v_0->kind != NCR_TV_OFFSET_DATE_TIME
        && ncr_v_0->kind != NCR_TV_ZONED_DATE_TIME) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withCalendar: receiver has no civil calendar fields", ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_clone(ncr_v_0, ncr_line, ncr_column);
    value->calendar = calendar;
    bool valid = value->kind == NCR_TV_LOCAL_DATE || value->kind == NCR_TV_LOCAL_DATE_TIME
        ? ncr_tv_update_local_from_second(value, ncr_line, ncr_column)
        : ncr_tv_update_from_instant(value, ncr_line, ncr_column);
    if (!valid) {
        ncr_drop_@TEMPORAL_ID@(value);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.withCalendar: value exceeds ICU's exact calendar range", ncr_line, ncr_column);
    }
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

static bool ncr_tv_gregorian_fields(
    const ncr_obj_@TEMPORAL_ID@ *value,
    struct ncr_tv_fields *fields,
    int32_t *offset,
    size_t line,
    size_t column
) {
    UChar fixed[20];
    const UChar *zone = ncr_tv_utc_zone;
    int32_t zone_length = 3;
    UChar *owned_zone = NULL;
    bool needs_zone = value->kind == NCR_TV_ZONED_DATE_TIME
        || value->kind == NCR_TV_OFFSET_DATE_TIME;
    if (value->kind == NCR_TV_ZONED_DATE_TIME) {
        if (!ncr_tv_zone_to_uchar(value->zone, value->zone_length,
            &owned_zone, &zone_length, line, column)) { return false; }
        zone = owned_zone;
    } else if (value->kind == NCR_TV_OFFSET_DATE_TIME) {
        if (!ncr_tv_fixed_zone(value->offset_seconds, fixed, &zone_length)) { return false; }
        zone = fixed;
    }
    UCalendar *calendar = ncr_tv_open_calendar(zone, zone_length,
        NCR_TV_GREGORIAN, line, column);
    if (owned_zone != NULL) { ncr_deallocate(owned_zone); }
    if (calendar == NULL) { return false; }
    int64_t seconds = value->kind == NCR_TV_LOCAL_DATE
        || value->kind == NCR_TV_LOCAL_DATE_TIME
        ? value->local_second : value->epoch_second;
    int64_t millis = 0;
    bool valid = ncr_tv_epoch_millis(seconds, value->nanosecond, &millis);
    UErrorCode status = U_ZERO_ERROR;
    if (valid) { ucal_setMillis(calendar, (UDate)millis, &status); }
    valid = valid && U_SUCCESS(status);
    if (valid && needs_zone) {
        valid = ncr_tv_read_instant_fields(calendar, millis, fields, offset);
    } else if (valid) {
        *offset = 0;
        valid = ncr_tv_read_fields(calendar, fields);
    }
    ucal_close(calendar);
    return valid;
}

static bool ncr_tv_append_fraction(char *output, size_t capacity, size_t *used,
                                   int32_t nanosecond) {
    if (nanosecond == 0) { return true; }
    char fraction[10];
    (void)snprintf(fraction, sizeof(fraction), "%09d", nanosecond);
    int32_t length = 9;
    while (length > 0 && fraction[length - 1] == '0') { --length; }
    if (*used + (size_t)length + 2 > capacity) { return false; }
    output[(*used)++] = '.';
    memcpy(output + *used, fraction, (size_t)length);
    *used += (size_t)length;
    output[*used] = '\0';
    return true;
}

static bool ncr_tv_append_offset(char *output, size_t capacity, size_t *used,
                                 int32_t offset_seconds) {
    if (offset_seconds < -64800 || offset_seconds > 64800) { return false; }
    int64_t magnitude = offset_seconds < 0 ? -(int64_t)offset_seconds : offset_seconds;
    int32_t hours = (int32_t)(magnitude / 3600);
    int32_t minutes = (int32_t)((magnitude % 3600) / 60);
    int32_t seconds = (int32_t)(magnitude % 60);
    int written = seconds == 0
        ? snprintf(output + *used, capacity - *used, "%c%02d:%02d",
            offset_seconds < 0 ? '-' : '+', hours, minutes)
        : snprintf(output + *used, capacity - *used, "%c%02d:%02d:%02d",
            offset_seconds < 0 ? '-' : '+', hours, minutes, seconds);
    if (written < 0 || (size_t)written >= capacity - *used) { return false; }
    *used += (size_t)written;
    return true;
}

static bool ncr_tv_append_date(char *output, size_t capacity, size_t *used, int32_t year,
                               int32_t month, int32_t day) {
    char expanded_year[24];
    if (year >= 0 && year <= 9999) {
        (void)snprintf(expanded_year, sizeof(expanded_year), "%04d", year);
    } else if (year < 0) {
        (void)snprintf(expanded_year, sizeof(expanded_year), "-%06lld",
            (long long)-(int64_t)year);
    } else {
        (void)snprintf(expanded_year, sizeof(expanded_year), "+%06d", year);
    }
    int written = snprintf(output + *used, capacity - *used, "%s-%02d-%02d",
        expanded_year, month, day);
    if (written < 0 || (size_t)written >= capacity - *used) { return false; }
    *used += (size_t)written;
    return true;
}

static bool ncr_tv_append_time(char *output, size_t capacity, size_t *used,
                               int32_t hour, int32_t minute, int32_t second) {
    int written = snprintf(output + *used, capacity - *used, "T%02d:%02d:%02d",
        hour, minute, second);
    if (written < 0 || (size_t)written >= capacity - *used) { return false; }
    *used += (size_t)written;
    return true;
}

ncr_obj_@TEMPORAL_TEXT_RESULT@ @TEMPORAL_FORMAT_ISO@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0, size_t ncr_line, size_t ncr_column
) {
    char output[256] = { 0 };
    size_t used = 0;
    if (ncr_v_0->kind == NCR_TV_DURATION) {
        int64_t seconds = ncr_v_0->epoch_second;
        int32_t nanos = ncr_v_0->nanosecond;
        bool negative = seconds < 0;
        uint64_t magnitude_seconds = negative
            ? (uint64_t)(-(seconds + 1)) + 1 : (uint64_t)seconds;
        uint32_t magnitude_nanos = (uint32_t)nanos;
        if (negative && nanos != 0) {
            --magnitude_seconds;
            magnitude_nanos = (uint32_t)(1000000000 - nanos);
        }
        int written = snprintf(output, sizeof(output), "%sPT%llu",
            negative ? "-" : "", (unsigned long long)magnitude_seconds);
        if (written < 0 || (size_t)written >= sizeof(output)) { goto format_error; }
        used = (size_t)written;
        if (!ncr_tv_append_fraction(output, sizeof(output), &used, (int32_t)magnitude_nanos)) {
            goto format_error;
        }
        if (used + 1 >= sizeof(output)) { goto format_error; }
        output[used++] = 'S';
        output[used] = '\0';
    } else if (ncr_v_0->kind == NCR_TV_PERIOD) {
        int written = snprintf(output, sizeof(output), "P%dY%dM%dD",
            ncr_v_0->period_years, ncr_v_0->period_months, ncr_v_0->period_days);
        if (written < 0 || (size_t)written >= sizeof(output)) { goto format_error; }
        used = (size_t)written;
    } else if (ncr_v_0->kind == NCR_TV_LOCAL_TIME) {
        int written = snprintf(output, sizeof(output), "%02d:%02d:%02d",
            ncr_v_0->hour, ncr_v_0->minute, ncr_v_0->second);
        if (written < 0 || (size_t)written >= sizeof(output)) { goto format_error; }
        used = (size_t)written;
        if (!ncr_tv_append_fraction(output, sizeof(output), &used, ncr_v_0->nanosecond)) {
            goto format_error;
        }
    } else {
        if (ncr_v_0->kind != NCR_TV_INSTANT && ncr_v_0->kind != NCR_TV_LOCAL_DATE
            && ncr_v_0->kind != NCR_TV_LOCAL_DATE_TIME
            && ncr_v_0->kind != NCR_TV_OFFSET_DATE_TIME
            && ncr_v_0->kind != NCR_TV_ZONED_DATE_TIME) { goto format_error; }
        struct ncr_tv_fields fields;
        int32_t offset = 0;
        if (!ncr_tv_gregorian_fields(ncr_v_0, &fields, &offset, ncr_line, ncr_column)
            || !ncr_tv_append_date(output, sizeof(output), &used,
                fields.extended_year, fields.month, fields.day)) { goto format_error; }
        if (ncr_v_0->kind != NCR_TV_LOCAL_DATE) {
            if (!ncr_tv_append_time(output, sizeof(output), &used,
                fields.hour, fields.minute, fields.second)
                || !ncr_tv_append_fraction(output, sizeof(output), &used,
                    ncr_v_0->nanosecond)) { goto format_error; }
        }
        if (ncr_v_0->kind == NCR_TV_INSTANT) {
            if (used + 1 >= sizeof(output)) { goto format_error; }
            output[used++] = 'Z';
            output[used] = '\0';
        } else if (ncr_v_0->kind == NCR_TV_OFFSET_DATE_TIME
            || ncr_v_0->kind == NCR_TV_ZONED_DATE_TIME) {
            if (!ncr_tv_append_offset(output, sizeof(output), &used, offset)) { goto format_error; }
            if (ncr_v_0->kind == NCR_TV_ZONED_DATE_TIME) {
                int written = snprintf(output + used, sizeof(output) - used, "[%.*s]",
                    ncr_v_0->zone_length, ncr_v_0->zone);
                if (written < 0 || (size_t)written >= sizeof(output) - used) { goto format_error; }
                used += (size_t)written;
            }
        }
    }
    {
        ncr_obj_@TEMPORAL_TEXT_ID@ *text = ncr_tv_text_ascii(output, used, ncr_line, ncr_column);
        if (text == NULL) { goto format_error; }
        return (ncr_obj_@TEMPORAL_TEXT_RESULT@){ .tag = @TEMPORAL_TEXT_OK_TAG@,
            .data.v@TEMPORAL_TEXT_OK_TAG@.f0 = text };
    }

format_error:
    return NCR_TV_RESULT_ERROR(@TEMPORAL_TEXT_RESULT@,
        "Temporal.formatIso: unsupported kind, invalid state, or ICU exact-range limit",
        ncr_line, ncr_column);
}

static bool ncr_tv_pattern_applicable(const UChar *pattern, int32_t length,
                                     int32_t kind, bool *has_fraction) {
    bool has_date = kind != NCR_TV_LOCAL_TIME;
    bool has_time = kind != NCR_TV_LOCAL_DATE;
    bool has_zone = kind == NCR_TV_INSTANT || kind == NCR_TV_OFFSET_DATE_TIME
        || kind == NCR_TV_ZONED_DATE_TIME;
    bool quoted = false;
    *has_fraction = false;
    for (int32_t index = 0; index < length; ++index) {
        UChar field = pattern[index];
        if (field == '\'') {
            if (index + 1 < length && pattern[index + 1] == '\'') {
                ++index;
            } else {
                quoted = !quoted;
            }
            continue;
        }
        if (quoted) { continue; }
        if (field == 'S') {
            int32_t width = 1;
            while (index + width < length && pattern[index + width] == 'S') {
                ++width;
            }
            if (!has_time || width > 9) { return false; }
            *has_fraction = true;
            index += width - 1;
        } else if (strchr("GyYuUrQqMLlwWdDFgEec", (char)field) != NULL) {
            if (!has_date) { return false; }
        } else if (strchr("abBhHKkmsSA", (char)field) != NULL) {
            if (!has_time) { return false; }
        } else if (strchr("zZOvVXx", (char)field) != NULL) {
            if (!has_zone) { return false; }
        }
    }
    return !quoted;
}

struct ncr_tv_local_digits {
    UChar *storage;
    int32_t offsets[10];
    int32_t lengths[10];
};

static bool ncr_tv_localized_digits(UNumberFormat *formatter,
                                    struct ncr_tv_local_digits *digits,
                                    size_t line, size_t column) {
    int32_t total = 0;
    for (int32_t digit = 0; digit < 10; ++digit) {
        UErrorCode status = U_ZERO_ERROR;
        int32_t required = unum_formatInt64(formatter, digit, NULL, 0, NULL, &status);
        if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status))
            || required <= 0 || required > INT32_MAX - total - 1) {
            return false;
        }
        digits->offsets[digit] = total;
        digits->lengths[digit] = required;
        total += required + 1;
    }
    digits->storage = ncr_allocate((size_t)total * sizeof(UChar), line, column);
    for (int32_t digit = 0; digit < 10; ++digit) {
        UErrorCode status = U_ZERO_ERROR;
        int32_t offset = digits->offsets[digit];
        int32_t capacity = digits->lengths[digit] + 1;
        int32_t written = unum_formatInt64(formatter, digit,
            digits->storage + offset, capacity, NULL, &status);
        if (U_FAILURE(status) || written != digits->lengths[digit]) {
            ncr_deallocate(digits->storage);
            digits->storage = NULL;
            return false;
        }
    }
    return true;
}

static bool ncr_tv_append_pattern_segment(
    UDateFormat *formatter, const UChar *pattern, int32_t pattern_length,
    UDate millis, UChar *output, int32_t capacity, int32_t *used
) {
    if (pattern_length == 0) { return true; }
    udat_applyPattern(formatter, false, pattern, pattern_length);
    UFieldPosition field_position;
    memset(&field_position, 0, sizeof(field_position));
    UErrorCode status = U_ZERO_ERROR;
    if (output == NULL) {
        int32_t required = udat_format(formatter, millis, NULL, 0,
            &field_position, &status);
        if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status))
            || required < 0 || required > INT32_MAX - *used) {
            return false;
        }
        *used += required;
        return true;
    }
    if (*used < 0 || *used >= capacity) { return false; }
    int32_t written = udat_format(formatter, millis, output + *used,
        capacity - *used, &field_position, &status);
    if (U_FAILURE(status) || written < 0 || written > capacity - *used) {
        return false;
    }
    *used += written;
    return true;
}

static bool ncr_tv_append_fraction_digits(
    const struct ncr_tv_local_digits *digits, int32_t nanosecond, int32_t width,
    UChar *output, int32_t capacity, int32_t *used
) {
    if (nanosecond < 0 || nanosecond >= 1000000000 || width < 1 || width > 9) {
        return false;
    }
    int32_t divisor = 100000000;
    for (int32_t index = 0; index < width; ++index, divisor /= 10) {
        int32_t digit = (nanosecond / divisor) % 10;
        int32_t digit_length = digits->lengths[digit];
        if (digit_length > INT32_MAX - *used
            || (output != NULL && (capacity - *used < digit_length))) {
            return false;
        }
        if (output != NULL) {
            memcpy(output + *used, digits->storage + digits->offsets[digit],
                (size_t)digit_length * sizeof(UChar));
        }
        *used += digit_length;
    }
    return true;
}

static bool ncr_tv_format_pattern_parts(
    UDateFormat *formatter, const UChar *pattern, int32_t pattern_length,
    UDate millis, int32_t nanosecond, const struct ncr_tv_local_digits *digits,
    UChar *output, int32_t capacity, int32_t *used
) {
    bool quoted = false;
    int32_t segment_start = 0;
    for (int32_t index = 0; index < pattern_length; ++index) {
        UChar field = pattern[index];
        if (field == '\'') {
            if (index + 1 < pattern_length && pattern[index + 1] == '\'') {
                ++index;
            } else {
                quoted = !quoted;
            }
            continue;
        }
        if (quoted || field != 'S') { continue; }
        if (!ncr_tv_append_pattern_segment(formatter, pattern + segment_start,
            index - segment_start, millis, output, capacity, used)) {
            return false;
        }
        int32_t width = 1;
        while (index + width < pattern_length && pattern[index + width] == 'S') {
            ++width;
        }
        if (!ncr_tv_append_fraction_digits(digits, nanosecond, width,
            output, capacity, used)) {
            return false;
        }
        index += width - 1;
        segment_start = index + 1;
    }
    return ncr_tv_append_pattern_segment(formatter, pattern + segment_start,
        pattern_length - segment_start, millis, output, capacity, used);
}

ncr_obj_@TEMPORAL_TEXT_RESULT@ @TEMPORAL_FORMAT@(
    ncr_obj_@TEMPORAL_ID@ *ncr_v_0,
    ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_1,
    ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_2,
    size_t ncr_line, size_t ncr_column
) {
    UChar *pattern = NULL;
    int32_t pattern_length = 0;
    char *locale = NULL;
    UChar *owned_zone = NULL;
    UChar fixed_zone[20];
    const UChar *zone = ncr_tv_utc_zone;
    int32_t zone_length = 3;
    UCalendar *calendar = NULL;
    UDateFormat *formatter = NULL;
    UNumberFormat *number_formatter = NULL;
    struct ncr_tv_local_digits digits = { 0 };
    UChar *output = NULL;
    int32_t output_length = 0;
    ncr_obj_@TEMPORAL_TEXT_ID@ *text = NULL;
    bool has_fraction = false;
    int64_t seconds = 0;
    int64_t millis = 0;
    int32_t calendar_id = ncr_v_0->calendar;
    UErrorCode status = U_ZERO_ERROR;

    if (ncr_v_0->kind == NCR_TV_DURATION || ncr_v_0->kind == NCR_TV_PERIOD
        || (ncr_v_0->kind != NCR_TV_INSTANT && ncr_v_0->kind != NCR_TV_LOCAL_DATE
            && ncr_v_0->kind != NCR_TV_LOCAL_TIME
            && ncr_v_0->kind != NCR_TV_LOCAL_DATE_TIME
            && ncr_v_0->kind != NCR_TV_OFFSET_DATE_TIME
            && ncr_v_0->kind != NCR_TV_ZONED_DATE_TIME)
        || calendar_id < 0 || calendar_id >= NCR_TV_CALENDAR_COUNT) {
        goto format_error;
    }
    if (!ncr_dt_utf8_to_uchar(ncr_v_1, true, &pattern, &pattern_length,
            ncr_line, ncr_column)
        || pattern_length == 0 || !ncr_dt_pattern_valid(pattern, pattern_length)
        || !ncr_tv_pattern_applicable(pattern, pattern_length, ncr_v_0->kind,
            &has_fraction)) {
        goto format_error;
    }
    {
        const char *locale_failure = ncr_dt_locale_id_for_calendar(ncr_v_2,
            ncr_tv_calendar_specs[calendar_id].keyword, &locale, ncr_line, ncr_column);
        if (locale_failure != NULL) { goto format_error; }
    }
    if (ncr_v_0->kind == NCR_TV_ZONED_DATE_TIME) {
        if (!ncr_tv_zone_to_uchar(ncr_v_0->zone, ncr_v_0->zone_length,
                &owned_zone, &zone_length, ncr_line, ncr_column)) {
            goto format_error;
        }
        zone = owned_zone;
    } else if (ncr_v_0->kind == NCR_TV_OFFSET_DATE_TIME) {
        if (!ncr_tv_fixed_zone(ncr_v_0->offset_seconds, fixed_zone, &zone_length)) {
            goto format_error;
        }
        zone = fixed_zone;
    }
    seconds = ncr_v_0->kind == NCR_TV_LOCAL_DATE
            || ncr_v_0->kind == NCR_TV_LOCAL_DATE_TIME
            || ncr_v_0->kind == NCR_TV_LOCAL_TIME
        ? ncr_v_0->local_second : ncr_v_0->epoch_second;
    if (!ncr_tv_epoch_millis(seconds, ncr_v_0->nanosecond, &millis)) {
        goto format_error;
    }
    calendar = ncr_tv_open_calendar(zone, zone_length, calendar_id, ncr_line, ncr_column);
    if (calendar == NULL) { goto format_error; }
    status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)millis, &status);
    if (U_FAILURE(status) || !ncr_dt_calendar_epoch_exact(calendar, millis)) {
        goto format_error;
    }
    status = U_ZERO_ERROR;
    formatter = udat_open(UDAT_PATTERN, UDAT_PATTERN, locale, zone, zone_length,
        pattern, pattern_length, &status);
    if (U_FAILURE(status) || formatter == NULL) { goto format_error; }
    udat_setCalendar(formatter, calendar);
    udat_setLenient(formatter, false);

    if (has_fraction) {
        number_formatter = unum_open(UNUM_DECIMAL, NULL, 0, locale, NULL, &status);
        if (U_FAILURE(status) || number_formatter == NULL) { goto format_error; }
        unum_setAttribute(number_formatter, UNUM_GROUPING_USED, UNUM_FALSE);
        if (!ncr_tv_localized_digits(number_formatter, &digits, ncr_line, ncr_column)) {
            goto format_error;
        }
    }
    {
        int32_t measured = 0;
        if (!ncr_tv_format_pattern_parts(formatter, pattern, pattern_length,
                (UDate)millis, ncr_v_0->nanosecond, &digits, NULL, 0, &measured)
            || measured < 0 || measured == INT32_MAX) {
            goto format_error;
        }
        output_length = measured;
    }
    output = ncr_allocate(((size_t)output_length + 1) * sizeof(UChar),
        ncr_line, ncr_column);
    {
        int32_t written = 0;
        if (!ncr_tv_format_pattern_parts(formatter, pattern, pattern_length,
                (UDate)millis, ncr_v_0->nanosecond, &digits, output,
                output_length + 1, &written) || written != output_length) {
            goto format_error;
        }
    }
    output[output_length] = 0;
    text = ncr_dt_text_from_uchar(output, output_length, ncr_line, ncr_column);
    if (text == NULL) { goto format_error; }

    ncr_deallocate(output);
    ncr_deallocate(digits.storage);
    if (number_formatter != NULL) { unum_close(number_formatter); }
    udat_close(formatter);
    ucal_close(calendar);
    if (owned_zone != NULL) { ncr_deallocate(owned_zone); }
    ncr_deallocate(locale);
    ncr_deallocate(pattern);
    return (ncr_obj_@TEMPORAL_TEXT_RESULT@){ .tag = @TEMPORAL_TEXT_OK_TAG@,
        .data.v@TEMPORAL_TEXT_OK_TAG@.f0 = text };

format_error:
    if (output != NULL) { ncr_deallocate(output); }
    if (digits.storage != NULL) { ncr_deallocate(digits.storage); }
    if (number_formatter != NULL) { unum_close(number_formatter); }
    if (formatter != NULL) { udat_close(formatter); }
    if (calendar != NULL) { ucal_close(calendar); }
    if (owned_zone != NULL) { ncr_deallocate(owned_zone); }
    if (locale != NULL) { ncr_deallocate(locale); }
    if (pattern != NULL) { ncr_deallocate(pattern); }
    return NCR_TV_RESULT_ERROR(@TEMPORAL_TEXT_RESULT@,
        "Temporal.format: invalid, unavailable, or inapplicable pattern or ICU value",
        ncr_line, ncr_column);
}

static bool ncr_tv_parse_fraction(const unsigned char *bytes, size_t length,
                                  size_t *position, int32_t *nanosecond) {
    *nanosecond = 0;
    if (*position >= length || bytes[*position] != '.') { return true; }
    ++*position;
    int32_t digits = 0;
    while (*position < length && bytes[*position] >= '0' && bytes[*position] <= '9'
        && digits < 9) {
        *nanosecond = *nanosecond * 10 + (bytes[(*position)++] - '0');
        ++digits;
    }
    if (digits == 0 || (*position < length
        && bytes[*position] >= '0' && bytes[*position] <= '9')) { return false; }
    for (; digits < 9; ++digits) { *nanosecond *= 10; }
    return true;
}
static bool ncr_tv_parse_iso_year(const unsigned char *bytes, size_t length,
                                  size_t *position, int32_t *year) {
    int32_t sign = 1;
    int32_t digits = 4;
    if (*position < length && (bytes[*position] == '+' || bytes[*position] == '-')) {
        sign = bytes[(*position)++] == '-' ? -1 : 1;
        digits = 6;
    }
    int32_t magnitude = 0;
    if (!ncr_tv_parse_digits(bytes, length, position, digits, &magnitude)) { return false; }
    *year = sign * magnitude;
    return true;
}

static bool ncr_tv_parse_signed_magnitude(
    const unsigned char *bytes, size_t length, size_t *position,
    uint64_t limit, int32_t *sign, uint64_t *magnitude
) {
    if (*position >= length) { return false; }
    *sign = 1;
    if (bytes[*position] == '-' || bytes[*position] == '+') {
        *sign = bytes[(*position)++] == '-' ? -1 : 1;
    }
    size_t first_digit = *position;
    uint64_t value = 0;
    while (*position < length && bytes[*position] >= '0' && bytes[*position] <= '9') {
        uint64_t digit = (uint64_t)(bytes[(*position)++] - '0');
        if (value > (limit - digit) / 10) { return false; }
        value = value * 10 + digit;
    }
    if (*position == first_digit) { return false; }
    *magnitude = value;
    return true;
}

static bool ncr_tv_parse_period_component(
    const unsigned char *bytes, size_t length, size_t *position, int32_t *value
) {
    int32_t sign = 1;
    uint64_t magnitude = 0;
    uint64_t limit = (uint64_t)INT32_MAX + 1;
    if (!ncr_tv_parse_signed_magnitude(bytes, length, position, limit,
            &sign, &magnitude)
        || (sign > 0 && magnitude > (uint64_t)INT32_MAX)) {
        return false;
    }
    if (sign < 0) {
        *value = magnitude == (uint64_t)INT32_MAX + 1
            ? INT32_MIN : -(int32_t)magnitude;
    } else {
        *value = (int32_t)magnitude;
    }
    return true;
}

static ncr_obj_@TEMPORAL_ID@ *ncr_tv_parse_iso_period(
    const unsigned char *bytes, size_t length, size_t position, int32_t global_sign,
    size_t line, size_t column
) {
    int32_t years = 0, months = 0, days = 0;
    int32_t last_order = 0, components = 0;
    while (position < length) {
        int32_t component = 0;
        if (!ncr_tv_parse_period_component(bytes, length, &position, &component)
            || position >= length) {
            return NULL;
        }
        unsigned char unit = bytes[position++];
        int32_t order = unit == 'Y' ? 1 : unit == 'M' ? 2 : unit == 'D' ? 3 : 0;
        if (order <= last_order) { return NULL; }
        last_order = order;
        ++components;
        if (global_sign < 0) {
            int64_t reversed = -(int64_t)component;
            if (reversed < INT32_MIN || reversed > INT32_MAX) { return NULL; }
            component = (int32_t)reversed;
        }
        if (unit == 'Y') { years = component; }
        else if (unit == 'M') { months = component; }
        else if (unit == 'D') { days = component; }
        else { return NULL; }
    }
    if (components == 0) { return NULL; }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_new(NCR_TV_PERIOD, line, column);
    value->period_years = years;
    value->period_months = months;
    value->period_days = days;
    return value;
}

static bool ncr_tv_signed_scaled_seconds(uint64_t magnitude, int64_t scale,
                                         int32_t sign, int64_t *seconds) {
    if (scale <= 0 || magnitude > UINT64_MAX / (uint64_t)scale) { return false; }
    uint64_t value = magnitude * (uint64_t)scale;
    if (sign > 0) {
        if (value > (uint64_t)INT64_MAX) { return false; }
        *seconds = (int64_t)value;
    } else {
        uint64_t minimum_magnitude = (uint64_t)INT64_MAX + 1;
        if (value > minimum_magnitude) { return false; }
        *seconds = value == minimum_magnitude ? INT64_MIN : -(int64_t)value;
    }
    return true;
}

static bool ncr_tv_signed_decimal_parts(uint64_t magnitude, int32_t fraction,
                                        int32_t sign, int64_t *seconds,
                                        int32_t *nanosecond) {
    if (fraction < 0 || fraction >= 1000000000) { return false; }
    if (sign > 0) {
        if (magnitude > (uint64_t)INT64_MAX) { return false; }
        *seconds = (int64_t)magnitude;
        *nanosecond = fraction;
        return true;
    }
    if (fraction == 0) {
        uint64_t minimum_magnitude = (uint64_t)INT64_MAX + 1;
        if (magnitude > minimum_magnitude) { return false; }
        *seconds = magnitude == minimum_magnitude
            ? INT64_MIN : -(int64_t)magnitude;
        *nanosecond = 0;
        return true;
    }
    if (magnitude > (uint64_t)INT64_MAX) { return false; }
    *seconds = -(int64_t)magnitude - 1;
    *nanosecond = 1000000000 - fraction;
    return true;
}

static bool ncr_tv_accumulate_duration(
    int64_t component_seconds, int32_t component_nanos, bool *has_component,
    int32_t *duration_sign, int64_t *seconds, int32_t *nanosecond
) {
    int32_t sign = component_seconds < 0 ? -1
        : component_seconds > 0 || component_nanos > 0 ? 1 : 0;
    if (sign != 0 && *duration_sign != 0 && sign != *duration_sign) { return false; }
    if (sign != 0) { *duration_sign = sign; }
    int64_t combined_seconds = 0;
    int32_t combined_nanos = 0;
    if (!ncr_tv_add_parts(*seconds, *nanosecond, component_seconds,
            component_nanos, &combined_seconds, &combined_nanos)) {
        return false;
    }
    *seconds = combined_seconds;
    *nanosecond = combined_nanos;
    *has_component = true;
    return true;
}

static ncr_obj_@TEMPORAL_ID@ *ncr_tv_parse_iso_duration(
    const unsigned char *bytes, size_t length, size_t position, int32_t global_sign,
    size_t line, size_t column
) {
    const uint64_t maximum_magnitude = (uint64_t)INT64_MAX + 1;
    int64_t seconds = 0;
    int32_t nanosecond = 0;
    int32_t duration_sign = 0;
    bool has_component = false;
    if (position < length && bytes[position] != 'T') {
        int32_t component_sign = 1;
        uint64_t magnitude = 0;
        int64_t component_seconds = 0;
        if (!ncr_tv_parse_signed_magnitude(bytes, length, &position,
                maximum_magnitude, &component_sign, &magnitude)
            || position >= length || bytes[position++] != 'D'
            || !ncr_tv_signed_scaled_seconds(magnitude, NCR_TV_SECONDS_PER_DAY,
                component_sign * global_sign, &component_seconds)
            || !ncr_tv_accumulate_duration(component_seconds, 0, &has_component,
                &duration_sign, &seconds, &nanosecond)) {
            return NULL;
        }
    }
    if (position >= length || bytes[position++] != 'T') { return NULL; }
    int32_t last_order = 0;
    bool has_time_component = false;
    while (position < length) {
        int32_t component_sign = 1;
        uint64_t magnitude = 0;
        int32_t fraction = 0;
        if (!ncr_tv_parse_signed_magnitude(bytes, length, &position,
                maximum_magnitude, &component_sign, &magnitude)) {
            return NULL;
        }
        bool has_fraction = position < length && bytes[position] == '.';
        if (has_fraction
            && !ncr_tv_parse_fraction(bytes, length, &position, &fraction)) {
            return NULL;
        }
        if (position >= length) { return NULL; }
        unsigned char unit = bytes[position++];
        int32_t order = unit == 'H' ? 1 : unit == 'M' ? 2 : unit == 'S' ? 3 : 0;
        if (order <= last_order || (has_fraction && unit != 'S')) { return NULL; }
        last_order = order;
        int32_t sign = component_sign * global_sign;
        int64_t component_seconds = 0;
        int32_t component_nanos = 0;
        if (unit == 'S') {
            if (!ncr_tv_signed_decimal_parts(magnitude, fraction, sign,
                    &component_seconds, &component_nanos)) {
                return NULL;
            }
        } else if (!ncr_tv_signed_scaled_seconds(magnitude,
                unit == 'H' ? 3600 : 60, sign, &component_seconds)) {
            return NULL;
        }
        if (!ncr_tv_accumulate_duration(component_seconds, component_nanos,
                &has_component, &duration_sign, &seconds, &nanosecond)) {
            return NULL;
        }
        has_time_component = true;
    }
    if (!has_time_component) { return NULL; }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_new(NCR_TV_DURATION, line, column);
    value->epoch_second = seconds;
    value->nanosecond = nanosecond;
    return value;
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_PARSE_ISO@(
    ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_0, size_t ncr_line, size_t ncr_column
) {
    const unsigned char *bytes = ncr_v_0->bytes;
    size_t length = (size_t)ncr_v_0->length;
    size_t position = 0;
    int32_t iso_year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0;
    if (length == 0 || memchr(bytes, 0, length) != NULL) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: input must be nonempty UTF-8 without NUL", ncr_line, ncr_column);
    }
    size_t p_position = 0;
    int32_t global_sign = 1;
    if (bytes[p_position] == '-' || bytes[p_position] == '+') {
        global_sign = bytes[p_position++] == '-' ? -1 : 1;
    }
    if (p_position < length && bytes[p_position] == 'P') {
        bool has_time_designator = false;
        for (size_t index = p_position + 1; index < length; ++index) {
            if (bytes[index] == 'T') { has_time_designator = true; break; }
        }
        ncr_obj_@TEMPORAL_ID@ *value = has_time_designator
            ? ncr_tv_parse_iso_duration(bytes, length, p_position + 1, global_sign,
                ncr_line, ncr_column)
            : ncr_tv_parse_iso_period(bytes, length, p_position + 1, global_sign,
                ncr_line, ncr_column);
        if (value == NULL) {
            return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
                "Temporal.parseIso: invalid ISO duration or period syntax or range",
                ncr_line, ncr_column);
        }
        return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
            .data.v@TEMPORAL_OK_TAG@.f0 = value };
    }
    if (length >= 3 && bytes[2] == ':') {
        int32_t nanos = 0;
        if (!ncr_tv_parse_digits(bytes, length, &position, 2, &hour)
            || !ncr_tv_next(bytes, length, &position, ':')
            || !ncr_tv_parse_digits(bytes, length, &position, 2, &minute)
            || !ncr_tv_next(bytes, length, &position, ':')
            || !ncr_tv_parse_digits(bytes, length, &position, 2, &second)
            || !ncr_tv_parse_fraction(bytes, length, &position, &nanos)
            || position != length || hour > 23 || minute > 59 || second > 59) {
            return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
                "Temporal.parseIso: invalid ISO local-time syntax", ncr_line, ncr_column);
        }
        ncr_obj_@TEMPORAL_ID@ *time = ncr_tv_new(NCR_TV_LOCAL_TIME, ncr_line, ncr_column);
        time->hour = hour;
        time->minute = minute;
        time->second = second;
        time->nanosecond = nanos;
        time->local_second = (int64_t)hour * 3600 + minute * 60 + second;
        return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
            .data.v@TEMPORAL_OK_TAG@.f0 = time };
    }
    if (!ncr_tv_parse_iso_year(bytes, length, &position, &iso_year)
        || !ncr_tv_next(bytes, length, &position, '-')
        || !ncr_tv_parse_digits(bytes, length, &position, 2, &month)
        || !ncr_tv_next(bytes, length, &position, '-')
        || !ncr_tv_parse_digits(bytes, length, &position, 2, &day)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: invalid ISO date syntax", ncr_line, ncr_column);
    }
    int32_t era = iso_year <= 0 ? 0 : 1;
    int32_t year = iso_year <= 0 ? 1 - iso_year : iso_year;
    if (position == length) {
        int64_t local_second = 0;
        struct ncr_tv_fields fields;
        if (!ncr_tv_local_fields(NCR_TV_GREGORIAN, era, year, month, day,
            0, 0, 0, 0, &local_second, &fields, ncr_line, ncr_column)) {
            return ncr_tv_failed(ncr_line, ncr_column);
        }
        ncr_obj_@TEMPORAL_ID@ *date = ncr_tv_new(NCR_TV_LOCAL_DATE, ncr_line, ncr_column);
        date->calendar = NCR_TV_GREGORIAN;
        date->local_second = local_second;
        ncr_tv_store_fields(date, &fields, 0);
        return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
            .data.v@TEMPORAL_OK_TAG@.f0 = date };
    }
    int32_t nanos = 0;
    if (!ncr_tv_next(bytes, length, &position, 'T')
        || !ncr_tv_parse_digits(bytes, length, &position, 2, &hour)
        || !ncr_tv_next(bytes, length, &position, ':')
        || !ncr_tv_parse_digits(bytes, length, &position, 2, &minute)
        || !ncr_tv_next(bytes, length, &position, ':')
        || !ncr_tv_parse_digits(bytes, length, &position, 2, &second)
        || !ncr_tv_parse_fraction(bytes, length, &position, &nanos)
        || hour > 23 || minute > 59 || second > 59) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: invalid ISO local date-time syntax", ncr_line, ncr_column);
    }
    bool has_offset = position < length
        && (bytes[position] == 'Z' || bytes[position] == '+' || bytes[position] == '-');
    int32_t offset = 0;
    if (has_offset && !ncr_tv_offset_text(bytes, length, &position, &offset)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: invalid numeric UTC offset", ncr_line, ncr_column);
    }
    bool has_zone = position < length && bytes[position] == '[';
    if (!has_offset && !has_zone) {
        if (position != length) {
            return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
                "Temporal.parseIso: trailing local date-time input", ncr_line, ncr_column);
        }
        int64_t local_second = 0;
        struct ncr_tv_fields fields;
        if (!ncr_tv_local_fields(NCR_TV_GREGORIAN, era, year, month, day,
            hour, minute, second, nanos, &local_second, &fields, ncr_line, ncr_column)) {
            return ncr_tv_failed(ncr_line, ncr_column);
        }
        ncr_obj_@TEMPORAL_ID@ *local = ncr_tv_new(NCR_TV_LOCAL_DATE_TIME,
            ncr_line, ncr_column);
        local->calendar = NCR_TV_GREGORIAN;
        local->epoch_second = local_second;
        local->local_second = local_second;
        local->nanosecond = nanos;
        ncr_tv_store_fields(local, &fields, nanos);
        return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
            .data.v@TEMPORAL_OK_TAG@.f0 = local };
    }
    if (has_zone && !has_offset) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: a bracketed zone requires an explicit numeric offset",
            ncr_line, ncr_column);
    }
    const unsigned char *zone_bytes_input = NULL;
    size_t zone_input_length = 0;
    if (has_zone) {
        ++position;
        size_t start = position;
        while (position < length && bytes[position] != ']') { ++position; }
        if (position == start || position >= length) {
            return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
                "Temporal.parseIso: invalid bracketed time-zone ID", ncr_line, ncr_column);
        }
        zone_bytes_input = bytes + start;
        zone_input_length = position - start;
        ++position;
    }
    if (position != length) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: trailing input", ncr_line, ncr_column);
    }
    if (has_offset && !has_zone) {
        UCalendar *calendar = ncr_tv_open_utc(NCR_TV_GREGORIAN, ncr_line, ncr_column);
        if (calendar == NULL) { return ncr_tv_failed(ncr_line, ncr_column); }
        int64_t millis = 0;
        struct ncr_tv_fields fields;
        bool valid = ncr_tv_resolve_wall(calendar, era, year, month, day, hour,
            minute, second, nanos / 1000000, false, &millis, &fields);
        ucal_close(calendar);
        int64_t local_second = 0, epoch_second = 0;
        int32_t normalized_nanos = 0;
        if (valid) {
            ncr_tv_parts_from_millis(millis, nanos % 1000000,
                &local_second, &normalized_nanos);
            valid = ncr_tv_add_i64(local_second, -(int64_t)offset, &epoch_second);
        }
        if (!valid) { return ncr_tv_failed(ncr_line, ncr_column); }
        ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_new(NCR_TV_OFFSET_DATE_TIME,
            ncr_line, ncr_column);
        value->calendar = NCR_TV_GREGORIAN;
        value->local_second = local_second;
        value->epoch_second = epoch_second;
        value->offset_seconds = offset;
        value->nanosecond = normalized_nanos;
        ncr_tv_store_fields(value, &fields, normalized_nanos);
        return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
            .data.v@TEMPORAL_OK_TAG@.f0 = value };
    }
    char *canonical_bytes = NULL;
    int32_t canonical_length = 0;
    UChar *zone = NULL;
    int32_t zone_length = 0;
    if (!ncr_tv_zone_from_bytes(zone_bytes_input, zone_input_length,
        &canonical_bytes, &canonical_length, &zone, &zone_length, ncr_line, ncr_column)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: bracketed zone must be a known ICU system zone", ncr_line, ncr_column);
    }
    UCalendar *calendar = ncr_tv_open_calendar(zone, zone_length,
        NCR_TV_GREGORIAN, ncr_line, ncr_column);
    if (calendar == NULL) {
        ncr_deallocate(zone);
        ncr_deallocate(canonical_bytes);
        return ncr_tv_failed(ncr_line, ncr_column);
    }
    int64_t first_millis = 0, later_millis = 0;
    struct ncr_tv_fields first_fields = { 0 }, later_fields = { 0 };
    bool first_valid = ncr_tv_resolve_wall(calendar, era, year, month, day,
        hour, minute, second, nanos / 1000000, false, &first_millis, &first_fields);
    bool later_valid = ncr_tv_resolve_wall(calendar, era, year, month, day,
        hour, minute, second, nanos / 1000000, true, &later_millis, &later_fields);
    int32_t first_offset = 0, later_offset = 0;
    first_valid = first_valid && ncr_tv_offset_at(calendar, first_millis, &first_offset);
    later_valid = later_valid && ncr_tv_offset_at(calendar, later_millis, &later_offset);
    bool choose_later = later_valid && later_offset == offset
        && (!first_valid || first_offset != offset || later_millis != first_millis);
    bool choose_first = first_valid && first_offset == offset;
    bool valid = choose_first || choose_later;
    int64_t selected_millis = choose_later ? later_millis : first_millis;
    struct ncr_tv_fields selected_fields = choose_later ? later_fields : first_fields;
    ucal_close(calendar);
    ncr_deallocate(zone);
    int64_t epoch_second = 0, local_second = 0;
    int32_t normalized_nanos = 0;
    if (valid) {
        ncr_tv_parts_from_millis(selected_millis, nanos % 1000000,
            &epoch_second, &normalized_nanos);
        valid = ncr_tv_add_i64(epoch_second, offset, &local_second);
    }
    if (!valid) {
        ncr_deallocate(canonical_bytes);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.parseIso: zone offset conflicts or local time is in a DST gap",
            ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_new(NCR_TV_ZONED_DATE_TIME,
        ncr_line, ncr_column);
    value->calendar = NCR_TV_GREGORIAN;
    value->zone = canonical_bytes;
    value->zone_length = canonical_length;
    value->epoch_second = epoch_second;
    value->local_second = local_second;
    value->offset_seconds = offset;
    value->nanosecond = normalized_nanos;
    ncr_tv_store_fields(value, &selected_fields, normalized_nanos);
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}
