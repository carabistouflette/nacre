#define NCR_TV_NANOS_PER_SECOND INT64_C(1000000000)
#define NCR_TV_SECONDS_PER_DAY INT64_C(86400)
#define NCR_TV_RESULT_ERROR(result_id, message, line, column) \
    ncr_result_error_##result_id((message), sizeof(message) - 1, (line), (column))

enum {
    NCR_TV_INSTANT = 1,
    NCR_TV_DURATION,
    NCR_TV_PERIOD,
    NCR_TV_LOCAL_DATE,
    NCR_TV_LOCAL_TIME,
    NCR_TV_LOCAL_DATE_TIME,
    NCR_TV_OFFSET_DATE_TIME,
    NCR_TV_ZONED_DATE_TIME
};

#define NCR_TV_GREGORIAN 0

struct ncr_tv_calendar_spec {
    const char *name;
    const char *keyword;
};

/* This table is the sole registry for supported ICU calendar identifiers. */
static const struct ncr_tv_calendar_spec ncr_tv_calendar_specs[] = {
    { "gregorian", "gregorian" },
    { "japanese", "japanese" },
    { "buddhist", "buddhist" },
    { "roc", "roc" },
    { "islamic", "islamic" },
    { "islamic-civil", "islamic-civil" },
    { "islamic-umalqura", "islamic-umalqura" }
};
#define NCR_TV_CALENDAR_COUNT \
    ((int32_t)(sizeof(ncr_tv_calendar_specs) / sizeof(ncr_tv_calendar_specs[0])))

struct ncr_tv_fields {
    int32_t era;
    int32_t year;
    int32_t extended_year;
    int32_t month;
    int32_t day;
    int32_t day_of_year;
    int32_t hour;
    int32_t minute;
    int32_t second;
    int32_t millisecond;
};

static ncr_obj_@TEMPORAL_ID@ *ncr_tv_new(int32_t kind, size_t line, size_t column) {
    ncr_obj_@TEMPORAL_ID@ *value = ncr_allocate(sizeof(*value), line, column);
    memset(value, 0, sizeof(*value));
    value->kind = kind;
    value->calendar = NCR_TV_GREGORIAN;
    return value;
}

static bool ncr_tv_add_i64(int64_t left, int64_t right, int64_t *result) {
    if ((right > 0 && left > INT64_MAX - right)
        || (right < 0 && left < INT64_MIN - right)) {
        return false;
    }
    *result = left + right;
    return true;
}

static bool ncr_tv_normalize_duration(int64_t seconds, int64_t adjustment,
                                      int64_t *out_seconds, int32_t *out_nanos) {
    int64_t carry = adjustment / NCR_TV_NANOS_PER_SECOND;
    int64_t remainder = adjustment % NCR_TV_NANOS_PER_SECOND;
    if (remainder < 0) {
        remainder += NCR_TV_NANOS_PER_SECOND;
        --carry;
    }
    if (!ncr_tv_add_i64(seconds, carry, out_seconds)) { return false; }
    *out_nanos = (int32_t)remainder;
    return true;
}

static bool ncr_tv_add_parts(int64_t left_seconds, int32_t left_nanos,
                             int64_t right_seconds, int32_t right_nanos,
                             int64_t *seconds, int32_t *nanos) {
    int64_t total_nanos = (int64_t)left_nanos + right_nanos;
    int64_t carry = total_nanos >= NCR_TV_NANOS_PER_SECOND ? 1 : 0;
    if (carry != 0) { total_nanos -= NCR_TV_NANOS_PER_SECOND; }
    if (carry != 0) {
        if (left_seconds < 0) { ++left_seconds; }
        else if (!ncr_tv_add_i64(right_seconds, carry, &right_seconds)) { return false; }
    }
    if (!ncr_tv_add_i64(left_seconds, right_seconds, seconds)) { return false; }
    *nanos = (int32_t)total_nanos;
    return true;
}

static int32_t ncr_tv_compare_parts(int64_t left_seconds, int32_t left_nanos,
                                    int64_t right_seconds, int32_t right_nanos) {
    if (left_seconds < right_seconds) { return -1; }
    if (left_seconds > right_seconds) { return 1; }
    return left_nanos < right_nanos ? -1 : left_nanos > right_nanos ? 1 : 0;
}

static const char *ncr_tv_calendar_name(int32_t calendar) {
    return calendar >= 0 && calendar < NCR_TV_CALENDAR_COUNT
        ? ncr_tv_calendar_specs[calendar].name : "";
}

static bool ncr_tv_calendar_from_text(
    const ncr_obj_@TEMPORAL_TEXT_ID@ *text, int32_t *calendar
) {
    if (text->length <= 0 || memchr(text->bytes, 0, (size_t)text->length) != NULL) {
        return false;
    }
    for (int32_t index = 0; index < NCR_TV_CALENDAR_COUNT; ++index) {
        const char *name = ncr_tv_calendar_specs[index].name;
        size_t length = strlen(name);
        if ((size_t)text->length == length && memcmp(text->bytes, name, length) == 0) {
            *calendar = index;
            return true;
        }
    }
    return false;
}

static UCalendar *ncr_tv_open_calendar(
    const UChar *zone, int32_t zone_length, int32_t calendar,
    size_t line, size_t column
) {
    if (calendar < 0 || calendar >= NCR_TV_CALENDAR_COUNT) { return NULL; }
    char locale[80] = "en_US_POSIX";
    UErrorCode status = U_ZERO_ERROR;
    int32_t written = uloc_setKeywordValue("calendar",
        ncr_tv_calendar_specs[calendar].keyword, locale, (int32_t)sizeof(locale), &status);
    if (U_FAILURE(status) || written >= (int32_t)sizeof(locale)) { return NULL; }
    status = U_ZERO_ERROR;
    UCalendar *result = ucal_open(zone, zone_length, locale,
        calendar == NCR_TV_GREGORIAN ? UCAL_GREGORIAN : UCAL_TRADITIONAL, &status);
    const char *actual_type = result == NULL ? NULL : ucal_getType(result, &status);
    if (U_FAILURE(status) || actual_type == NULL
        || strcmp(actual_type, ncr_tv_calendar_specs[calendar].keyword) != 0) {
        if (result != NULL) { ucal_close(result); }
        return NULL;
    }
    if (calendar == NCR_TV_GREGORIAN) {
        ucal_setGregorianChange(result, -9007199254740992.0, &status);
        if (U_FAILURE(status)) {
            ucal_close(result);
            return NULL;
        }
    }
    ucal_setAttribute(result, UCAL_LENIENT, false);
    (void)line;
    (void)column;
    return result;
}

static const UChar ncr_tv_utc_zone[] = { 0x0055, 0x0054, 0x0043 };

static UCalendar *ncr_tv_open_utc(int32_t calendar, size_t line, size_t column) {
    return ncr_tv_open_calendar(ncr_tv_utc_zone, 3, calendar, line, column);
}

static bool ncr_tv_fixed_zone(int32_t offset_seconds, UChar *zone, int32_t *length) {
    if (offset_seconds < -64800 || offset_seconds > 64800) { return false; }
    char buffer[20];
    int64_t magnitude = offset_seconds < 0 ? -(int64_t)offset_seconds : offset_seconds;
    int32_t hours = (int32_t)(magnitude / 3600);
    int32_t minutes = (int32_t)((magnitude % 3600) / 60);
    int32_t seconds = (int32_t)(magnitude % 60);
    int32_t used = snprintf(buffer, sizeof(buffer), "GMT%c%02d:%02d:%02d",
        offset_seconds < 0 ? '-' : '+', hours, minutes, seconds);
    if (used <= 0 || used >= (int32_t)sizeof(buffer)) { return false; }
    for (int32_t index = 0; index < used; ++index) { zone[index] = (UChar)buffer[index]; }
    *length = used;
    return true;
}

static bool ncr_tv_zone_copy(const UChar *zone, int32_t zone_length,
                             char **bytes, int32_t *byte_length,
                             size_t line, size_t column) {
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = 0;
    (void)u_strToUTF8(NULL, 0, &required, zone, zone_length, &status);
    if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) || required <= 0
        || required == INT32_MAX) {
        return false;
    }
    char *output = ncr_allocate((size_t)required + 1, line, column);
    status = U_ZERO_ERROR;
    int32_t written = 0;
    (void)u_strToUTF8(output, required + 1, &written, zone, zone_length, &status);
    if (U_FAILURE(status) || written != required) {
        ncr_deallocate(output);
        return false;
    }
    output[written] = '\0';
    *bytes = output;
    *byte_length = written;
    return true;
}

static bool ncr_tv_zone_from_text(
    const ncr_obj_@TEMPORAL_TEXT_ID@ *text,
    char **bytes,
    int32_t *byte_length,
    UChar **zone,
    int32_t *zone_length,
    size_t line,
    size_t column
) {
    const char *failure = ncr_dt_zone_id(text, zone, zone_length, line, column);
    if (failure != NULL) { return false; }
    if (!ncr_tv_zone_copy(*zone, *zone_length, bytes, byte_length, line, column)) {
        ncr_deallocate(*zone);
        *zone = NULL;
        return false;
    }
    return true;
}

static bool ncr_tv_zone_to_uchar(
    const char *bytes, int32_t byte_length,
    UChar **zone, int32_t *zone_length,
    size_t line, size_t column
) {
    if (bytes == NULL || byte_length <= 0) { return false; }
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = 0;
    (void)u_strFromUTF8(NULL, 0, &required, bytes, byte_length, &status);
    if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) || required <= 0
        || required == INT32_MAX) { return false; }
    UChar *converted = ncr_allocate(((size_t)required + 1) * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = 0;
    (void)u_strFromUTF8(converted, required + 1, &written, bytes, byte_length, &status);
    if (U_FAILURE(status) || written != required) {
        ncr_deallocate(converted);
        return false;
    }
    *zone = converted;
    *zone_length = written;
    return true;
}

static bool ncr_tv_zone_from_bytes(
    const unsigned char *bytes, size_t byte_length,
    char **canonical_bytes, int32_t *canonical_length,
    UChar **canonical_zone, int32_t *canonical_zone_length,
    size_t line, size_t column
) {
    if (byte_length == 0 || byte_length > (size_t)INT32_MAX
        || memchr(bytes, 0, byte_length) != NULL) { return false; }
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = 0;
    (void)u_strFromUTF8(NULL, 0, &required, (const char *)bytes,
        (int32_t)byte_length, &status);
    if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) || required <= 0
        || required == INT32_MAX) { return false; }
    UChar *input = ncr_allocate(((size_t)required + 1) * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = 0;
    (void)u_strFromUTF8(input, required + 1, &written, (const char *)bytes,
        (int32_t)byte_length, &status);
    if (U_FAILURE(status) || written != required) {
        ncr_deallocate(input);
        return false;
    }
    int32_t capacity = 64;
    UChar *canonical = ncr_allocate((size_t)capacity * sizeof(UChar), line, column);
    UBool is_system_id = false;
    status = U_ZERO_ERROR;
    int32_t written_canonical_length = ucal_getCanonicalTimeZoneID(input, written,
        canonical, capacity, &is_system_id, &status);
    if ((status == U_BUFFER_OVERFLOW_ERROR || status == U_STRING_NOT_TERMINATED_WARNING)
        && written_canonical_length > 0 && written_canonical_length < INT32_MAX) {
        ncr_deallocate(canonical);
        capacity = written_canonical_length + 1;
        canonical = ncr_allocate((size_t)capacity * sizeof(UChar), line, column);
        status = U_ZERO_ERROR;
        written_canonical_length = ucal_getCanonicalTimeZoneID(input, written,
            canonical, capacity, &is_system_id, &status);
    }
    ncr_deallocate(input);
    if (U_FAILURE(status) || !is_system_id || written_canonical_length <= 0
        || written_canonical_length >= capacity) {
        ncr_deallocate(canonical);
        return false;
    }
    if (!ncr_tv_zone_copy(canonical, written_canonical_length,
        canonical_bytes, canonical_length, line, column)) {
        ncr_deallocate(canonical);
        return false;
    }
    *canonical_zone = canonical;
    *canonical_zone_length = written_canonical_length;
    return true;
}

static bool ncr_tv_read_fields(UCalendar *calendar, struct ncr_tv_fields *fields) {
    UErrorCode status = U_ZERO_ERROR;
    fields->era = ucal_get(calendar, UCAL_ERA, &status);
    fields->year = ucal_get(calendar, UCAL_YEAR, &status);
    fields->extended_year = ucal_get(calendar, UCAL_EXTENDED_YEAR, &status);
    fields->month = ucal_get(calendar, UCAL_MONTH, &status) + 1;
    fields->day = ucal_get(calendar, UCAL_DATE, &status);
    fields->day_of_year = ucal_get(calendar, UCAL_DAY_OF_YEAR, &status);
    fields->hour = ucal_get(calendar, UCAL_HOUR_OF_DAY, &status);
    fields->minute = ucal_get(calendar, UCAL_MINUTE, &status);
    fields->second = ucal_get(calendar, UCAL_SECOND, &status);
    fields->millisecond = ucal_get(calendar, UCAL_MILLISECOND, &status);
    return U_SUCCESS(status);
}

static void ncr_tv_set_wall(
    UCalendar *calendar, int32_t era, int32_t year, int32_t month, int32_t day,
    int32_t hour, int32_t minute, int32_t second, int32_t millisecond,
    UCalendarWallTimeOption repeated, UCalendarWallTimeOption skipped
) {
    ucal_clear(calendar);
    ucal_setAttribute(calendar, UCAL_LENIENT, false);
    ucal_setAttribute(calendar, UCAL_REPEATED_WALL_TIME, repeated);
    ucal_setAttribute(calendar, UCAL_SKIPPED_WALL_TIME, skipped);
    ucal_set(calendar, UCAL_ERA, era);
    ucal_set(calendar, UCAL_YEAR, year);
    ucal_set(calendar, UCAL_MONTH, month - 1);
    ucal_set(calendar, UCAL_DATE, day);
    ucal_set(calendar, UCAL_HOUR_OF_DAY, hour);
    ucal_set(calendar, UCAL_MINUTE, minute);
    ucal_set(calendar, UCAL_SECOND, second);
    ucal_set(calendar, UCAL_MILLISECOND, millisecond);
}

static bool ncr_tv_fields_match(
    UCalendar *calendar, int32_t era, int32_t year, int32_t month, int32_t day,
    int32_t hour, int32_t minute, int32_t second, int32_t millisecond,
    struct ncr_tv_fields *fields
) {
    return ncr_tv_read_fields(calendar, fields)
        && fields->era == era && fields->year == year && fields->month == month
        && fields->day == day && fields->hour == hour && fields->minute == minute
        && fields->second == second && fields->millisecond == millisecond;
}

static bool ncr_tv_resolve_wall(
    UCalendar *calendar, int32_t era, int32_t year, int32_t month, int32_t day,
    int32_t hour, int32_t minute, int32_t second, int32_t millisecond,
    bool prefer_later, int64_t *epoch_millis, struct ncr_tv_fields *fields
) {
    if (era < 0 || year < 1 || month < 1 || month > 12 || day < 1
        || hour < 0 || hour > 23 || minute < 0 || minute > 59
        || second < 0 || second > 59 || millisecond < 0 || millisecond > 999) {
        return false;
    }
    ncr_tv_set_wall(calendar, era, year, month, day, hour, minute, second,
        millisecond, prefer_later ? UCAL_WALLTIME_LAST : UCAL_WALLTIME_FIRST,
        UCAL_WALLTIME_FIRST);
    UErrorCode status = U_ZERO_ERROR;
    UDate instant = ucal_getMillis(calendar, &status);
    if (U_FAILURE(status) || !ncr_tv_fields_match(calendar, era, year, month, day,
        hour, minute, second, millisecond, fields)
        || !ncr_dt_udate_to_epoch(instant, epoch_millis)) {
        return false;
    }
    return true;
}

static bool ncr_tv_epoch_millis(int64_t seconds, int32_t nanosecond, int64_t *millis) {
    if (nanosecond < 0 || nanosecond >= 1000000000
        || seconds < INT64_MIN / 1000 || seconds > INT64_MAX / 1000) { return false; }
    int64_t base = seconds * INT64_C(1000);
    int64_t result;
    if (!ncr_tv_add_i64(base, nanosecond / 1000000, &result)
        || !ncr_dt_epoch_in_range(result)) { return false; }
    *millis = result;
    return true;
}

static void ncr_tv_parts_from_millis(int64_t millis, int32_t submillisecond,
                                    int64_t *seconds, int32_t *nanosecond) {
    int64_t quotient = millis / 1000;
    int64_t remainder = millis % 1000;
    if (remainder < 0) { remainder += 1000; --quotient; }
    *seconds = quotient;
    *nanosecond = (int32_t)(remainder * 1000000 + submillisecond);
}

static bool ncr_tv_offset_seconds(UCalendar *calendar, int32_t *offset_seconds) {
    UErrorCode status = U_ZERO_ERROR;
    int64_t offset = (int64_t)ucal_get(calendar, UCAL_ZONE_OFFSET, &status)
        + (int64_t)ucal_get(calendar, UCAL_DST_OFFSET, &status);
    if (U_FAILURE(status) || offset % 1000 != 0
        || offset / 1000 < INT32_MIN || offset / 1000 > INT32_MAX) { return false; }
    *offset_seconds = (int32_t)(offset / 1000);
    return true;
}

static bool ncr_tv_read_instant_fields(
    UCalendar *calendar, int64_t millis, struct ncr_tv_fields *fields, int32_t *offset
) {
    return ncr_tv_offset_seconds(calendar, offset)
        && ncr_dt_local_epoch_in_range(millis, (int64_t)*offset * 1000)
        && ncr_tv_read_fields(calendar, fields);
}

static void ncr_tv_store_fields(ncr_obj_@TEMPORAL_ID@ *value,
                                const struct ncr_tv_fields *fields, int32_t nanos) {
    value->era = fields->era;
    value->year = fields->year;
    value->extended_year = fields->extended_year;
    value->month = fields->month;
    value->day = fields->day;
    value->day_of_year = fields->day_of_year;
    value->hour = fields->hour;
    value->minute = fields->minute;
    value->second = fields->second;
    value->nanosecond = nanos;
}

static ncr_obj_@TEMPORAL_ID@ *ncr_tv_copy_without_zone(
    const ncr_obj_@TEMPORAL_ID@ *source, size_t line, size_t column
) {
    ncr_obj_@TEMPORAL_ID@ *result = ncr_allocate(sizeof(*result), line, column);
    *result = *source;
    result->zone = NULL;
    result->zone_length = 0;
    return result;
}

static ncr_obj_@TEMPORAL_ID@ *ncr_tv_clone(
    const ncr_obj_@TEMPORAL_ID@ *source, size_t line, size_t column
) {
    ncr_obj_@TEMPORAL_ID@ *result = ncr_tv_copy_without_zone(source, line, column);
    if (source->zone != NULL) {
        result->zone = ncr_allocate((size_t)source->zone_length + 1, line, column);
        memcpy(result->zone, source->zone, (size_t)source->zone_length + 1);
        result->zone_length = source->zone_length;
    }
    return result;
}

static bool ncr_tv_local_fields(
    int32_t calendar_id, int32_t era, int32_t year, int32_t month, int32_t day,
    int32_t hour, int32_t minute, int32_t second, int32_t nanosecond,
    int64_t *local_second, struct ncr_tv_fields *fields, size_t line, size_t column
) {
    if (nanosecond < 0 || nanosecond >= 1000000000) { return false; }
    UCalendar *calendar = ncr_tv_open_utc(calendar_id, line, column);
    if (calendar == NULL) { return false; }
    int64_t millis = 0;
    bool valid = ncr_tv_resolve_wall(calendar, era, year, month, day, hour, minute,
        second, nanosecond / 1000000, false, &millis, fields);
    ucal_close(calendar);
    if (!valid) { return false; }
    int32_t remainder = nanosecond % 1000000;
    int32_t normalized_nanos = 0;
    ncr_tv_parts_from_millis(millis, remainder, local_second, &normalized_nanos);
    fields->millisecond = normalized_nanos / 1000000;
    return true;
}

static bool ncr_tv_update_from_zone(
    ncr_obj_@TEMPORAL_ID@ *value, const UChar *zone, int32_t zone_length,
    size_t line, size_t column
) {
    int64_t millis = 0;
    if (!ncr_tv_epoch_millis(value->epoch_second, value->nanosecond, &millis)) {
        return false;
    }
    UCalendar *calendar = ncr_tv_open_calendar(zone, zone_length, value->calendar, line, column);
    if (calendar == NULL) { return false; }
    UErrorCode status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)millis, &status);
    struct ncr_tv_fields fields;
    int32_t offset = 0;
    bool valid = U_SUCCESS(status)
        && ncr_tv_read_instant_fields(calendar, millis, &fields, &offset);
    ucal_close(calendar);
    if (!valid) { return false; }
    ncr_tv_store_fields(value, &fields, value->nanosecond);
    value->offset_seconds = value->kind == NCR_TV_OFFSET_DATE_TIME
        ? value->offset_seconds : offset;
    return ncr_tv_add_i64(value->epoch_second, value->offset_seconds,
        &value->local_second);
}

static bool ncr_tv_update_from_instant(
    ncr_obj_@TEMPORAL_ID@ *value, size_t line, size_t column
) {
    UChar fixed[20];
    UChar *owned_zone = NULL;
    const UChar *zone;
    int32_t zone_length = 0;
    if (value->kind == NCR_TV_ZONED_DATE_TIME) {
        if (!ncr_tv_zone_to_uchar(value->zone, value->zone_length,
            &owned_zone, &zone_length, line, column)) { return false; }
        zone = owned_zone;
    } else if (value->kind == NCR_TV_OFFSET_DATE_TIME) {
        if (!ncr_tv_fixed_zone(value->offset_seconds, fixed, &zone_length)) { return false; }
        zone = fixed;
    } else {
        return false;
    }
    bool valid = ncr_tv_update_from_zone(value, zone, zone_length, line, column);
    if (owned_zone != NULL) { ncr_deallocate(owned_zone); }
    return valid;
}

static bool ncr_tv_update_local_from_second(
    ncr_obj_@TEMPORAL_ID@ *value, size_t line, size_t column
) {
    int64_t millis = 0;
    if (!ncr_tv_epoch_millis(value->local_second, value->nanosecond, &millis)) { return false; }
    UCalendar *calendar = ncr_tv_open_utc(value->calendar, line, column);
    if (calendar == NULL) { return false; }
    UErrorCode status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)millis, &status);
    struct ncr_tv_fields fields;
    bool valid = U_SUCCESS(status) && ncr_tv_read_fields(calendar, &fields);
    ucal_close(calendar);
    if (!valid) { return false; }
    ncr_tv_store_fields(value, &fields, value->nanosecond);
    return true;
}

static ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_tv_text_ascii(
    const char *bytes, size_t length, size_t line, size_t column
) {
    if (length > (size_t)INT32_MAX) { return NULL; }
    if (length <= @TEMPORAL_TEXT_INLINE_CAPACITY@) {
        ncr_obj_@TEMPORAL_TEXT_ID@ *text = ncr_allocate(sizeof(*text), line, column);
        @TEMPORAL_TEXT_INIT@(text);
        if (length > 0) { memcpy(text->inline_storage, bytes, length); }
        text->length = (int32_t)length;
        return text;
    }
    unsigned char *copy = ncr_allocate(length, line, column);
    memcpy(copy, bytes, length);
    return @TEMPORAL_TEXT_TAKE@(copy, length, length, line, column);
}

static int32_t ncr_tv_offset_at(UCalendar *calendar, int64_t millis, int32_t *offset) {
    UErrorCode status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)millis, &status);
    if (U_FAILURE(status) || !ncr_tv_offset_seconds(calendar, offset)) { return 0; }
    return 1;
}

static bool ncr_tv_parse_digits(const unsigned char *bytes, size_t length,
                                size_t *position, int32_t count, int32_t *result) {
    if (count < 1 || (size_t)count > length - *position) { return false; }
    int32_t value = 0;
    for (int32_t index = 0; index < count; ++index) {
        unsigned char byte = bytes[(*position)++];
        if (byte < '0' || byte > '9') { return false; }
        value = value * 10 + (byte - '0');
    }
    *result = value;
    return true;
}

static bool ncr_tv_next(const unsigned char *bytes, size_t length,
                        size_t *position, unsigned char expected) {
    if (*position >= length || bytes[*position] != expected) { return false; }
    ++*position;
    return true;
}

static bool ncr_tv_offset_text(const unsigned char *bytes, size_t length,
                               size_t *position, int32_t *offset) {
    if (*position < length && bytes[*position] == 'Z') {
        ++*position;
        *offset = 0;
        return true;
    }
    if (*position >= length || (bytes[*position] != '+' && bytes[*position] != '-')) { return false; }
    int32_t sign = bytes[(*position)++] == '-' ? -1 : 1;
    int32_t hours = 0, minutes = 0, seconds = 0;
    if (!ncr_tv_parse_digits(bytes, length, position, 2, &hours)
        || !ncr_tv_next(bytes, length, position, ':')
        || !ncr_tv_parse_digits(bytes, length, position, 2, &minutes)) { return false; }
    if (*position < length && bytes[*position] == ':') {
        ++*position;
        if (!ncr_tv_parse_digits(bytes, length, position, 2, &seconds)) { return false; }
    }
    if (hours > 18 || minutes > 59 || seconds > 59
        || (hours == 18 && (minutes != 0 || seconds != 0))) { return false; }
    *offset = sign * (hours * 3600 + minutes * 60 + seconds);
    return true;
}

static ncr_obj_@TEMPORAL_RESULT@ ncr_tv_failed(size_t line, size_t column) {
    return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
        "Temporal: invalid value, unsupported conversion, or ICU range exceeded", line, column);
}

