static ncr_obj_@TEMPORAL_INT_RESULT@ ncr_tv_integer_component(
    ncr_obj_@TEMPORAL_ID@ *value, int32_t component, size_t line, size_t column
) {
    int32_t result = 0;
    if (component < 3) {
        if (value->kind != NCR_TV_PERIOD) {
            return NCR_TV_RESULT_ERROR(@TEMPORAL_INT_RESULT@,
                "Temporal period component requires a Period", line, column);
        }
        result = component == 0 ? value->period_years
            : component == 1 ? value->period_months : value->period_days;
    } else {
        if (value->kind != NCR_TV_LOCAL_TIME && value->kind != NCR_TV_LOCAL_DATE_TIME
            && value->kind != NCR_TV_OFFSET_DATE_TIME && value->kind != NCR_TV_ZONED_DATE_TIME) {
            return NCR_TV_RESULT_ERROR(@TEMPORAL_INT_RESULT@,
                "Temporal clock component requires a time-bearing value", line, column);
        }
        result = component == 3 ? value->hour : component == 4 ? value->minute : value->second;
    }
    return (ncr_obj_@TEMPORAL_INT_RESULT@){ .tag = @TEMPORAL_INT_OK_TAG@,
        .data.v@TEMPORAL_INT_OK_TAG@.f0 = result };
}

