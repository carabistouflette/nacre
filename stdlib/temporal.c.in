ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_OFFSET_DATE_TIME@(
    int32_t ncr_v_0, int32_t ncr_v_1, int32_t ncr_v_2, int32_t ncr_v_3,
    int32_t ncr_v_4, int32_t ncr_v_5, int32_t ncr_v_6, int32_t ncr_v_7,
    int32_t ncr_v_8, ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_9,
    size_t ncr_line, size_t ncr_column
) {
    int32_t calendar = 0;
    int64_t local_second = 0;
    int64_t epoch_second = 0;
    struct ncr_tv_fields fields;
    if (ncr_v_8 < -64800 || ncr_v_8 > 64800
        || !ncr_tv_calendar_from_text(ncr_v_9, &calendar)
        || !ncr_tv_local_fields(calendar, ncr_v_0, ncr_v_1, ncr_v_2, ncr_v_3,
            ncr_v_4, ncr_v_5, ncr_v_6, ncr_v_7, &local_second, &fields,
            ncr_line, ncr_column)
        || !ncr_tv_add_i64(local_second, -(int64_t)ncr_v_8, &epoch_second)) {
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.offsetDateTime: invalid civil fields, offset, or calendar", ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_new(NCR_TV_OFFSET_DATE_TIME, ncr_line, ncr_column);
    value->calendar = calendar;
    value->local_second = local_second;
    value->epoch_second = epoch_second;
    value->offset_seconds = ncr_v_8;
    value->nanosecond = ncr_v_7;
    ncr_tv_store_fields(value, &fields, ncr_v_7);
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_RESULT@ @TEMPORAL_ZONED_DATE_TIME@(
    int32_t ncr_v_0, int32_t ncr_v_1, int32_t ncr_v_2, int32_t ncr_v_3,
    int32_t ncr_v_4, int32_t ncr_v_5, int32_t ncr_v_6, int32_t ncr_v_7,
    ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_8,
    ncr_obj_@TEMPORAL_TEXT_ID@ *ncr_v_9, bool ncr_v_10,
    size_t ncr_line, size_t ncr_column
) {
    int32_t calendar_id = 0;
    char *zone_bytes = NULL;
    int32_t zone_bytes_length = 0;
    UChar *zone = NULL;
    int32_t zone_length = 0;
    if (ncr_v_7 < 0 || ncr_v_7 >= 1000000000
        || !ncr_tv_calendar_from_text(ncr_v_9, &calendar_id)
        || !ncr_tv_zone_from_text(ncr_v_8, &zone_bytes, &zone_bytes_length,
            &zone, &zone_length, ncr_line, ncr_column)) {
        if (zone != NULL) { ncr_deallocate(zone); }
        if (zone_bytes != NULL) { ncr_deallocate(zone_bytes); }
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.zonedDateTime: invalid zone, calendar, or nanosecond", ncr_line, ncr_column);
    }
    UCalendar *calendar = ncr_tv_open_calendar(zone, zone_length, calendar_id,
        ncr_line, ncr_column);
    ncr_deallocate(zone);
    if (calendar == NULL) {
        ncr_deallocate(zone_bytes);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.zonedDateTime: ICU calendar initialization failed", ncr_line, ncr_column);
    }
    int64_t millis = 0;
    struct ncr_tv_fields fields;
    bool valid = ncr_tv_resolve_wall(calendar, ncr_v_0, ncr_v_1, ncr_v_2, ncr_v_3,
        ncr_v_4, ncr_v_5, ncr_v_6, ncr_v_7 / 1000000,
        ncr_v_10, &millis, &fields);
    int32_t offset = 0;
    if (valid) { valid = ncr_tv_offset_seconds(calendar, &offset); }
    ucal_close(calendar);
    int64_t epoch_second = 0;
    int32_t nanos = 0;
    if (valid) {
        ncr_tv_parts_from_millis(millis, ncr_v_7 % 1000000, &epoch_second, &nanos);
        valid = ncr_tv_add_i64(epoch_second, offset, &millis);
    }
    if (!valid) {
        ncr_deallocate(zone_bytes);
        return NCR_TV_RESULT_ERROR(@TEMPORAL_RESULT@,
            "Temporal.zonedDateTime: invalid date, DST gap, or ICU range", ncr_line, ncr_column);
    }
    ncr_obj_@TEMPORAL_ID@ *value = ncr_tv_new(NCR_TV_ZONED_DATE_TIME, ncr_line, ncr_column);
    value->calendar = calendar_id;
    value->zone = zone_bytes;
    value->zone_length = zone_bytes_length;
    value->epoch_second = epoch_second;
    value->local_second = millis;
    value->offset_seconds = offset;
    value->nanosecond = nanos;
    ncr_tv_store_fields(value, &fields, nanos);
    return (ncr_obj_@TEMPORAL_RESULT@){ .tag = @TEMPORAL_OK_TAG@,
        .data.v@TEMPORAL_OK_TAG@.f0 = value };
}

ncr_obj_@TEMPORAL_LIST_ID@ * @TEMPORAL_AVAILABLE_CALENDARS@(
    size_t ncr_line, size_t ncr_column
) {
    ncr_obj_@TEMPORAL_LIST_ID@ *calendars = ncr_allocate(sizeof(*calendars), ncr_line, ncr_column);
    @TEMPORAL_LIST_NEW@(calendars, ncr_line, ncr_column);
    for (int32_t index = 0; index < NCR_TV_CALENDAR_COUNT; ++index) {
        const char *name = ncr_tv_calendar_specs[index].name;
        ncr_obj_@TEMPORAL_TEXT_ID@ *text = ncr_tv_text_ascii(name, strlen(name), ncr_line, ncr_column);
        if (text == NULL) {
            ncr_drop_@TEMPORAL_LIST_ID@(calendars);
            ncr_fail("Temporal.availableCalendars: calendar name allocation failed", ncr_line, ncr_column);
        }
        @TEMPORAL_LIST_ADD@(calendars, text, ncr_line, ncr_column);
    }
    return calendars;
}

ncr_obj_@TEMPORAL_TEXT_ID@ * @TEMPORAL_KIND@(ncr_obj_@TEMPORAL_ID@ *ncr_v_0,
    size_t ncr_line, size_t ncr_column
) {
    static const char *const kinds[] = {
        "", "instant", "duration", "period", "localDate", "localTime",
        "localDateTime", "offsetDateTime", "zonedDateTime"
    };
    const char *name = ncr_v_0->kind >= 0
        && (size_t)ncr_v_0->kind < sizeof(kinds) / sizeof(kinds[0])
        ? kinds[ncr_v_0->kind] : "";
    return ncr_tv_text_ascii(name, strlen(name), ncr_line, ncr_column);
}

ncr_obj_@TEMPORAL_TEXT_ID@ * @TEMPORAL_CALENDAR@(ncr_obj_@TEMPORAL_ID@ *ncr_v_0,
    size_t ncr_line, size_t ncr_column
) {
    bool has_calendar = ncr_v_0->kind == NCR_TV_LOCAL_DATE
        || ncr_v_0->kind == NCR_TV_LOCAL_DATE_TIME
        || ncr_v_0->kind == NCR_TV_OFFSET_DATE_TIME
        || ncr_v_0->kind == NCR_TV_ZONED_DATE_TIME;
    const char *name = has_calendar ? ncr_tv_calendar_name(ncr_v_0->calendar) : "";
    return ncr_tv_text_ascii(name, strlen(name), ncr_line, ncr_column);
}

ncr_obj_@TEMPORAL_TEXT_ID@ * @TEMPORAL_ZONE_ID@(ncr_obj_@TEMPORAL_ID@ *ncr_v_0,
    size_t ncr_line, size_t ncr_column
) {
    const char *name = ncr_v_0->zone == NULL ? "" : ncr_v_0->zone;
    size_t length = ncr_v_0->zone == NULL ? 0 : (size_t)ncr_v_0->zone_length;
    return ncr_tv_text_ascii(name, length, ncr_line, ncr_column);
}

