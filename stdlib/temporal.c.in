    }
    ncr_obj_@TEMPORAL_FIELDS_ID@ *fields = ncr_allocate(sizeof(*fields), ncr_line, ncr_column);
    fields->ncr_f_0 = ncr_v_0->era;
    fields->ncr_f_1 = ncr_v_0->year;
    fields->ncr_f_2 = ncr_v_0->extended_year;
    fields->ncr_f_3 = ncr_v_0->month;
    fields->ncr_f_4 = ncr_v_0->day;
    fields->ncr_f_5 = ncr_v_0->day_of_year;
