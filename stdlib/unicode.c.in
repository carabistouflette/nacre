/* NACRE_UNICODE_BEGIN CHARACTER_NUMERIC_VALUE */
static double @CHARACTER_NUMERIC_VALUE@(uint32_t ncr_v_@CHAR_NUMERIC@, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    double value = u_getNumericValue((UChar32)ncr_v_@CHAR_NUMERIC@);
    return value == U_NO_NUMERIC_VALUE ? -1.0 : value;
}
