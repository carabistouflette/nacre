/* NACRE_UNICODE_BEGIN UNICODE_TO_UPPER_CASE */
static ncr_obj_@UPPER_RESULT@ @UNICODE_TO_UPPER_CASE@(ncr_obj_@TEXT_ID@ *ncr_v_@UPPER_TEXT@, ncr_obj_@TEXT_ID@ *ncr_v_@UPPER_LOCALE@, size_t ncr_line, size_t ncr_column) {
    char locale[ULOC_FULLNAME_CAPACITY];
    if (!ncr_unicode_locale(ncr_v_@UPPER_LOCALE@, locale)) {
        return ncr_result_error_@UPPER_RESULT@("invalid, noncanonical, or unknown BCP-47 locale", sizeof("invalid, noncanonical, or unknown BCP-47 locale") - 1, ncr_line, ncr_column);
    }
    UChar *source = NULL; int32_t source_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@UPPER_TEXT@, &source, &source_length, ncr_line, ncr_column)) {
        return ncr_result_error_@UPPER_RESULT@("Text could not be converted to UTF-16", sizeof("Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    UChar *mapped = NULL; int32_t mapped_length = 0;
    bool converted = ncr_unicode_case_map(&mapped, &mapped_length, source, source_length, locale, u_strToUpper, ncr_line, ncr_column);
    if (source != NULL) { ncr_deallocate(source); }
    if (!converted) { return ncr_result_error_@UPPER_RESULT@("Unicode uppercase mapping failed", sizeof("Unicode uppercase mapping failed") - 1, ncr_line, ncr_column); }
    ncr_obj_@TEXT_ID@ *result = ncr_unicode_make_text(mapped, mapped_length, ncr_line, ncr_column);
    if (mapped != NULL) { ncr_deallocate(mapped); }
    if (result == NULL) { return ncr_result_error_@UPPER_RESULT@("Unicode uppercase output is invalid", sizeof("Unicode uppercase output is invalid") - 1, ncr_line, ncr_column); }
    return (ncr_obj_@UPPER_RESULT@){ .tag = @UPPER_OK@, .data.v@UPPER_OK@.f0 = result };
}
/* NACRE_UNICODE_END UNICODE_TO_UPPER_CASE */

/* NACRE_UNICODE_BEGIN UNICODE_TO_LOWER_CASE */
static ncr_obj_@LOWER_RESULT@ @UNICODE_TO_LOWER_CASE@(ncr_obj_@TEXT_ID@ *ncr_v_@LOWER_TEXT@, ncr_obj_@TEXT_ID@ *ncr_v_@LOWER_LOCALE@, size_t ncr_line, size_t ncr_column) {
    char locale[ULOC_FULLNAME_CAPACITY];
    if (!ncr_unicode_locale(ncr_v_@LOWER_LOCALE@, locale)) {
        return ncr_result_error_@LOWER_RESULT@("invalid, noncanonical, or unknown BCP-47 locale", sizeof("invalid, noncanonical, or unknown BCP-47 locale") - 1, ncr_line, ncr_column);
    }
    UChar *source = NULL; int32_t source_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@LOWER_TEXT@, &source, &source_length, ncr_line, ncr_column)) {
        return ncr_result_error_@LOWER_RESULT@("Text could not be converted to UTF-16", sizeof("Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    UChar *mapped = NULL; int32_t mapped_length = 0;
    bool converted = ncr_unicode_case_map(&mapped, &mapped_length, source, source_length, locale, u_strToLower, ncr_line, ncr_column);
    if (source != NULL) { ncr_deallocate(source); }
    if (!converted) { return ncr_result_error_@LOWER_RESULT@("Unicode lowercase mapping failed", sizeof("Unicode lowercase mapping failed") - 1, ncr_line, ncr_column); }
    ncr_obj_@TEXT_ID@ *result = ncr_unicode_make_text(mapped, mapped_length, ncr_line, ncr_column);
    if (mapped != NULL) { ncr_deallocate(mapped); }
    if (result == NULL) { return ncr_result_error_@LOWER_RESULT@("Unicode lowercase output is invalid", sizeof("Unicode lowercase output is invalid") - 1, ncr_line, ncr_column); }
    return (ncr_obj_@LOWER_RESULT@){ .tag = @LOWER_OK@, .data.v@LOWER_OK@.f0 = result };
}
/* NACRE_UNICODE_END UNICODE_TO_LOWER_CASE */

/* NACRE_UNICODE_BEGIN UNICODE_CASE_FOLD */
static ncr_obj_@FOLD_RESULT@ @UNICODE_CASE_FOLD@(ncr_obj_@TEXT_ID@ *ncr_v_@FOLD_TEXT@, size_t ncr_line, size_t ncr_column) {
    UChar *source = NULL; int32_t source_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@FOLD_TEXT@, &source, &source_length, ncr_line, ncr_column)) {
        return ncr_result_error_@FOLD_RESULT@("Text could not be converted to UTF-16", sizeof("Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    UChar *mapped = NULL; int32_t mapped_length = 0;
    bool converted = ncr_unicode_fold(&mapped, &mapped_length, source, source_length, ncr_line, ncr_column);
    if (source != NULL) { ncr_deallocate(source); }
    if (!converted) { return ncr_result_error_@FOLD_RESULT@("Unicode case folding failed", sizeof("Unicode case folding failed") - 1, ncr_line, ncr_column); }
    ncr_obj_@TEXT_ID@ *result = ncr_unicode_make_text(mapped, mapped_length, ncr_line, ncr_column);
    if (mapped != NULL) { ncr_deallocate(mapped); }
    if (result == NULL) { return ncr_result_error_@FOLD_RESULT@("Unicode case-fold output is invalid", sizeof("Unicode case-fold output is invalid") - 1, ncr_line, ncr_column); }
    return (ncr_obj_@FOLD_RESULT@){ .tag = @FOLD_OK@, .data.v@FOLD_OK@.f0 = result };
}
/* NACRE_UNICODE_END UNICODE_CASE_FOLD */

/* NACRE_UNICODE_BEGIN UNICODE_NORMALIZE */
static ncr_obj_@NORMALIZE_RESULT@ @UNICODE_NORMALIZE@(ncr_obj_@TEXT_ID@ *ncr_v_@NORMALIZE_TEXT@, ncr_obj_@TEXT_ID@ *ncr_v_@NORMALIZE_FORM@, size_t ncr_line, size_t ncr_column) {
    const UNormalizer2 *normalizer = NULL;
    UErrorCode status = U_ZERO_ERROR;
    ncr_obj_@TEXT_ID@ *form = ncr_v_@NORMALIZE_FORM@;
    if (form != NULL && form->length == 3 && memcmp(form->bytes, "NFC", 3) == 0) { normalizer = unorm2_getNFCInstance(&status); }
    else if (form != NULL && form->length == 3 && memcmp(form->bytes, "NFD", 3) == 0) { normalizer = unorm2_getNFDInstance(&status); }
    else if (form != NULL && form->length == 4 && memcmp(form->bytes, "NFKC", 4) == 0) { normalizer = unorm2_getNFKCInstance(&status); }
    else if (form != NULL && form->length == 4 && memcmp(form->bytes, "NFKD", 4) == 0) { normalizer = unorm2_getNFKDInstance(&status); }
    else { return ncr_result_error_@NORMALIZE_RESULT@("normalization form must be NFC, NFD, NFKC, or NFKD", sizeof("normalization form must be NFC, NFD, NFKC, or NFKD") - 1, ncr_line, ncr_column); }
    if (U_FAILURE(status) || normalizer == NULL) {
        return ncr_result_error_@NORMALIZE_RESULT@("ICU normalization is unavailable", sizeof("ICU normalization is unavailable") - 1, ncr_line, ncr_column);
    }
    UChar *source = NULL; int32_t source_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@NORMALIZE_TEXT@, &source, &source_length, ncr_line, ncr_column)) {
        return ncr_result_error_@NORMALIZE_RESULT@("Text could not be converted to UTF-16", sizeof("Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    UChar *normalized = NULL; int32_t normalized_length = 0;
    bool converted = ncr_unicode_normalize(&normalized, &normalized_length, normalizer, source, source_length, ncr_line, ncr_column);
    if (source != NULL) { ncr_deallocate(source); }
    if (!converted) { return ncr_result_error_@NORMALIZE_RESULT@("Unicode normalization failed", sizeof("Unicode normalization failed") - 1, ncr_line, ncr_column); }
    ncr_obj_@TEXT_ID@ *result = ncr_unicode_make_text(normalized, normalized_length, ncr_line, ncr_column);
    if (normalized != NULL) { ncr_deallocate(normalized); }
    if (result == NULL) { return ncr_result_error_@NORMALIZE_RESULT@("Unicode normalization output is invalid", sizeof("Unicode normalization output is invalid") - 1, ncr_line, ncr_column); }
    return (ncr_obj_@NORMALIZE_RESULT@){ .tag = @NORMALIZE_OK@, .data.v@NORMALIZE_OK@.f0 = result };
}
/* NACRE_UNICODE_END UNICODE_NORMALIZE */

/* NACRE_UNICODE_BEGIN UNICODE_GRAPHEME_COUNT */
static ncr_obj_@COUNT_RESULT@ @UNICODE_GRAPHEME_COUNT@(ncr_obj_@TEXT_ID@ *ncr_v_@COUNT_TEXT@, size_t ncr_line, size_t ncr_column) {
    UChar *source = NULL; int32_t source_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@COUNT_TEXT@, &source, &source_length, ncr_line, ncr_column)) {
        return ncr_result_error_@COUNT_RESULT@("Text could not be converted to UTF-16", sizeof("Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    static const UChar empty[1] = { 0 };
    UErrorCode status = U_ZERO_ERROR;
    UBreakIterator *iterator = ubrk_open(UBRK_CHARACTER, "root", source == NULL ? empty : source, source_length, &status);
    if (U_FAILURE(status) || iterator == NULL) {
        if (iterator != NULL) { ubrk_close(iterator); }
        if (source != NULL) { ncr_deallocate(source); }
        return ncr_result_error_@COUNT_RESULT@("ICU grapheme segmentation failed", sizeof("ICU grapheme segmentation failed") - 1, ncr_line, ncr_column);
    }
    int32_t count = 0;
    (void)ubrk_first(iterator);
    while (ubrk_next(iterator) != UBRK_DONE) {
        if (count == INT32_MAX) {
            ubrk_close(iterator);
            if (source != NULL) { ncr_deallocate(source); }
            return ncr_result_error_@COUNT_RESULT@("grapheme count exceeds int range", sizeof("grapheme count exceeds int range") - 1, ncr_line, ncr_column);
        }
        ++count;
    }
    ubrk_close(iterator);
    if (source != NULL) { ncr_deallocate(source); }
    return (ncr_obj_@COUNT_RESULT@){ .tag = @COUNT_OK@, .data.v@COUNT_OK@.f0 = count };
}
/* NACRE_UNICODE_END UNICODE_GRAPHEME_COUNT */

/* NACRE_UNICODE_BEGIN UNICODE_GRAPHEME_AT */
static ncr_obj_@AT_RESULT@ @UNICODE_GRAPHEME_AT@(ncr_obj_@TEXT_ID@ *ncr_v_@AT_TEXT@, int32_t ncr_v_@AT_INDEX@, size_t ncr_line, size_t ncr_column) {
    if (ncr_v_@AT_INDEX@ < 0) {
        return ncr_result_error_@AT_RESULT@("grapheme index out of bounds", sizeof("grapheme index out of bounds") - 1, ncr_line, ncr_column);
    }
    UChar *source = NULL; int32_t source_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@AT_TEXT@, &source, &source_length, ncr_line, ncr_column)) {
        return ncr_result_error_@AT_RESULT@("Text could not be converted to UTF-16", sizeof("Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    static const UChar empty[1] = { 0 };
    UErrorCode status = U_ZERO_ERROR;
    UBreakIterator *iterator = ubrk_open(UBRK_CHARACTER, "root", source == NULL ? empty : source, source_length, &status);
    if (U_FAILURE(status) || iterator == NULL) {
        if (iterator != NULL) { ubrk_close(iterator); }
        if (source != NULL) { ncr_deallocate(source); }
        return ncr_result_error_@AT_RESULT@("ICU grapheme segmentation failed", sizeof("ICU grapheme segmentation failed") - 1, ncr_line, ncr_column);
    }
    int32_t start = ubrk_first(iterator);
    int32_t cluster_index = 0;
    int32_t end = UBRK_DONE;
    while ((end = ubrk_next(iterator)) != UBRK_DONE) {
        if (cluster_index == ncr_v_@AT_INDEX@) { break; }
        start = end;
        ++cluster_index;
    }
    if (end == UBRK_DONE) {
        ubrk_close(iterator);
        if (source != NULL) { ncr_deallocate(source); }
        return ncr_result_error_@AT_RESULT@("grapheme index out of bounds", sizeof("grapheme index out of bounds") - 1, ncr_line, ncr_column);
    }
    unsigned char *bytes = NULL; int32_t byte_length = 0;
    bool converted = ncr_unicode_utf16_to_utf8(source == NULL ? empty : source + start, end - start, &bytes, &byte_length, ncr_line, ncr_column);
    ubrk_close(iterator);
    if (source != NULL) { ncr_deallocate(source); }
    if (!converted) {
        if (bytes != NULL) { ncr_deallocate(bytes); }
        return ncr_result_error_@AT_RESULT@("grapheme could not be converted to UTF-8", sizeof("grapheme could not be converted to UTF-8") - 1, ncr_line, ncr_column);
    }
    ncr_obj_@TEXT_ID@ *result = ncr_text_take_bytes_@TEXT_ID@(bytes, (size_t)byte_length, (size_t)byte_length, ncr_line, ncr_column);
    return (ncr_obj_@AT_RESULT@){ .tag = @AT_OK@, .data.v@AT_OK@.f0 = result };
}
/* NACRE_UNICODE_END UNICODE_GRAPHEME_AT */

/* NACRE_UNICODE_BEGIN UNICODE_COMPARE_LOCALE */
static ncr_obj_@COMPARE_RESULT@ @UNICODE_COMPARE_LOCALE@(ncr_obj_@TEXT_ID@ *ncr_v_@COMPARE_LEFT@, ncr_obj_@TEXT_ID@ *ncr_v_@COMPARE_RIGHT@, ncr_obj_@TEXT_ID@ *ncr_v_@COMPARE_LOCALE@, size_t ncr_line, size_t ncr_column) {
    char locale[ULOC_FULLNAME_CAPACITY];
    if (!ncr_unicode_locale(ncr_v_@COMPARE_LOCALE@, locale)) {
        return ncr_result_error_@COMPARE_RESULT@("invalid, noncanonical, or unknown BCP-47 locale", sizeof("invalid, noncanonical, or unknown BCP-47 locale") - 1, ncr_line, ncr_column);
    }
    UChar *left = NULL; int32_t left_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@COMPARE_LEFT@, &left, &left_length, ncr_line, ncr_column)) {
        return ncr_result_error_@COMPARE_RESULT@("left Text could not be converted to UTF-16", sizeof("left Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    UChar *right = NULL; int32_t right_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@COMPARE_RIGHT@, &right, &right_length, ncr_line, ncr_column)) {
        if (left != NULL) { ncr_deallocate(left); }
        return ncr_result_error_@COMPARE_RESULT@("right Text could not be converted to UTF-16", sizeof("right Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    UErrorCode status = U_ZERO_ERROR;
    UCollator *collator = ucol_open(locale, &status);
    if (U_FAILURE(status) || collator == NULL) {
        if (collator != NULL) { ucol_close(collator); }
        if (left != NULL) { ncr_deallocate(left); }
        if (right != NULL) { ncr_deallocate(right); }
        return ncr_result_error_@COMPARE_RESULT@("ICU locale collation failed", sizeof("ICU locale collation failed") - 1, ncr_line, ncr_column);
    }
    static const UChar empty[1] = { 0 };
    UCollationResult comparison = ucol_strcoll(collator, left == NULL ? empty : left, left_length,
        right == NULL ? empty : right, right_length);
    ucol_close(collator);
    if (left != NULL) { ncr_deallocate(left); }
    if (right != NULL) { ncr_deallocate(right); }
    int32_t sign = comparison < 0 ? -1 : comparison > 0 ? 1 : 0;
    return (ncr_obj_@COMPARE_RESULT@){ .tag = @COMPARE_OK@, .data.v@COMPARE_OK@.f0 = sign };
}
/* NACRE_UNICODE_END UNICODE_COMPARE_LOCALE */

/* NACRE_UNICODE_BEGIN CHARSET_ENCODE */
static ncr_obj_@ENCODE_RESULT@ @CHARSET_ENCODE@(ncr_obj_@TEXT_ID@ *ncr_v_@ENCODE_TEXT@, ncr_obj_@TEXT_ID@ *ncr_v_@ENCODE_CHARSET@, size_t ncr_line, size_t ncr_column) {
    UConverter *converter = ncr_unicode_open_converter(ncr_v_@ENCODE_CHARSET@, ncr_line, ncr_column);
    if (converter == NULL) {
        return ncr_result_error_@ENCODE_RESULT@("empty, default, unknown, or invalid charset name", sizeof("empty, default, unknown, or invalid charset name") - 1, ncr_line, ncr_column);
    }
    UChar *source = NULL; int32_t source_length = 0;
    if (!ncr_unicode_text_to_utf16(ncr_v_@ENCODE_TEXT@, &source, &source_length, ncr_line, ncr_column)) {
        ucnv_close(converter);
        return ncr_result_error_@ENCODE_RESULT@("Text could not be converted to UTF-16", sizeof("Text could not be converted to UTF-16") - 1, ncr_line, ncr_column);
    }
    unsigned char *bytes = NULL; int32_t byte_length = 0;
    bool converted = ncr_unicode_from_uchars(converter, source, source_length, &bytes, &byte_length, ncr_line, ncr_column);
    ucnv_close(converter);
    if (source != NULL) { ncr_deallocate(source); }
    if (!converted) {
        if (bytes != NULL) { ncr_deallocate(bytes); }
        return ncr_result_error_@ENCODE_RESULT@("Text is unrepresentable in the requested charset", sizeof("Text is unrepresentable in the requested charset") - 1, ncr_line, ncr_column);
    }
    ncr_obj_@BUFFER_ID@ *buffer = ncr_allocate(sizeof(*buffer), ncr_line, ncr_column);
    buffer->bytes = bytes;
    buffer->length = (size_t)byte_length;
    buffer->capacity = byte_length == 0 ? 0 : (size_t)byte_length + 1;
    return (ncr_obj_@ENCODE_RESULT@){ .tag = @ENCODE_OK@, .data.v@ENCODE_OK@.f0 = buffer };
}
/* NACRE_UNICODE_END CHARSET_ENCODE */

/* NACRE_UNICODE_BEGIN CHARSET_DECODE */
static ncr_obj_@DECODE_RESULT@ @CHARSET_DECODE@(ncr_obj_@BUFFER_ID@ *ncr_v_@DECODE_BUFFER@, ncr_obj_@TEXT_ID@ *ncr_v_@DECODE_CHARSET@, size_t ncr_line, size_t ncr_column) {
    if (ncr_v_@DECODE_BUFFER@ == NULL || ncr_v_@DECODE_BUFFER@->length > (size_t)INT32_MAX) {
        return ncr_result_error_@DECODE_RESULT@("ByteBuffer is too large for ICU conversion", sizeof("ByteBuffer is too large for ICU conversion") - 1, ncr_line, ncr_column);
    }
    UConverter *converter = ncr_unicode_open_converter(ncr_v_@DECODE_CHARSET@, ncr_line, ncr_column);
    if (converter == NULL) {
        return ncr_result_error_@DECODE_RESULT@("empty, default, unknown, or invalid charset name", sizeof("empty, default, unknown, or invalid charset name") - 1, ncr_line, ncr_column);
    }
    const char *source = ncr_v_@DECODE_BUFFER@->length == 0 ? "" : (const char *)ncr_v_@DECODE_BUFFER@->bytes;
    UChar *decoded = NULL; int32_t decoded_length = 0;
    bool converted = ncr_unicode_to_uchars(converter, source, (int32_t)ncr_v_@DECODE_BUFFER@->length, &decoded, &decoded_length, ncr_line, ncr_column);
    ucnv_close(converter);
    if (!converted) {
        if (decoded != NULL) { ncr_deallocate(decoded); }
        return ncr_result_error_@DECODE_RESULT@("byte sequence is malformed for the requested charset", sizeof("byte sequence is malformed for the requested charset") - 1, ncr_line, ncr_column);
    }
    unsigned char *utf8 = NULL; int32_t utf8_length = 0;
    converted = ncr_unicode_utf16_to_utf8(decoded, decoded_length, &utf8, &utf8_length, ncr_line, ncr_column);
    if (decoded != NULL) { ncr_deallocate(decoded); }
    if (!converted) {
        if (utf8 != NULL) { ncr_deallocate(utf8); }
        return ncr_result_error_@DECODE_RESULT@("decoded data is not valid Unicode scalar text", sizeof("decoded data is not valid Unicode scalar text") - 1, ncr_line, ncr_column);
    }
    ncr_obj_@TEXT_ID@ *text = ncr_text_take_bytes_@TEXT_ID@(utf8, (size_t)utf8_length, (size_t)utf8_length, ncr_line, ncr_column);
    return (ncr_obj_@DECODE_RESULT@){ .tag = @DECODE_OK@, .data.v@DECODE_OK@.f0 = text };
}
/* NACRE_UNICODE_END CHARSET_DECODE */
