/* NACRE_UNICODE_BEGIN ICU_HEADERS */
#include <float.h>
#include <unicode/ubrk.h>
#include <unicode/uchar.h>
#include <unicode/ucnv.h>
#include <unicode/ucnv_err.h>
#include <unicode/uloc.h>
