/* NACRE_UNICODE_BEGIN PREFLIGHT */
static bool ncr_unicode_preflight_ok(UErrorCode status) {
    return status == U_BUFFER_OVERFLOW_ERROR || U_SUCCESS(status);
}
/* NACRE_UNICODE_END PREFLIGHT */

/* NACRE_UNICODE_BEGIN TEXT_TO_UTF16 */
static bool ncr_unicode_text_to_utf16(ncr_obj_@TEXT_ID@ *text, UChar **output, int32_t *output_length, size_t line, size_t column) {
    *output = NULL;
    *output_length = 0;
    if (text == NULL || text->length < 0) { return false; }
    int32_t required = 0;
    UErrorCode status = U_ZERO_ERROR;
    const char *source = (const char *)text->bytes;
    (void)u_strFromUTF8(NULL, 0, &required, source, text->length, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0) { return false; }
    if (required == 0) { return true; }
    if ((size_t)required > SIZE_MAX / sizeof(UChar)) { return false; }
    UChar *converted = ncr_allocate((size_t)required * sizeof(UChar), line, column);
    int32_t written = 0;
    status = U_ZERO_ERROR;
    if (u_strFromUTF8(converted, required, &written, source, text->length, &status) == NULL ||
        U_FAILURE(status) || written != required) {
        ncr_deallocate(converted);
        return false;
    }
    *output = converted;
    *output_length = written;
    return true;
}
/* NACRE_UNICODE_END TEXT_TO_UTF16 */

/* NACRE_UNICODE_BEGIN UTF16_TO_UTF8 */
static bool ncr_unicode_utf16_to_utf8(const UChar *source, int32_t source_length, unsigned char **output, int32_t *output_length, size_t line, size_t column) {
    static const UChar empty_source[1] = { 0 };
    *output = NULL;
    *output_length = 0;
    if (source_length < 0) { return false; }
    if (source == NULL) { source = empty_source; }
    int32_t required = 0;
    UErrorCode status = U_ZERO_ERROR;
    (void)u_strToUTF8(NULL, 0, &required, source, source_length, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0) { return false; }
    if (required == 0) { return true; }
    unsigned char *converted = ncr_allocate((size_t)required, line, column);
    int32_t written = 0;
    status = U_ZERO_ERROR;
    if (u_strToUTF8((char *)converted, required, &written, source, source_length, &status) == NULL ||
        U_FAILURE(status) || written != required) {
        ncr_deallocate(converted);
        return false;
    }
    *output = converted;
    *output_length = written;
    return true;
}
/* NACRE_UNICODE_END UTF16_TO_UTF8 */

/* NACRE_UNICODE_BEGIN CHARSET_TO_UCHARS */
static bool ncr_unicode_to_uchars(UConverter *converter, const char *source, int32_t source_length, UChar **output, int32_t *output_length, size_t line, size_t column) {
    static const char empty_source[1] = { 0 };
    UChar empty_output[1] = { 0 };
    *output = NULL;
    *output_length = 0;
    if (converter == NULL || source_length < 0) { return false; }
    if (source == NULL) { source = empty_source; }
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = ucnv_toUChars(converter, NULL, 0, source, source_length, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0 || required >= INT32_MAX) { return false; }
    if ((size_t)(required + 1) > SIZE_MAX / sizeof(UChar)) { return false; }
    UChar *converted = required == 0 ? (UChar *)empty_output :
        ncr_allocate((size_t)(required + 1) * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = ucnv_toUChars(converter, converted, required + 1, source, source_length, &status);
    if (U_FAILURE(status) || written != required) {
        if (required != 0) { ncr_deallocate(converted); }
        return false;
    }
    if (required != 0) { *output = converted; }
    *output_length = written;
    return true;
}
/* NACRE_UNICODE_END CHARSET_TO_UCHARS */

/* NACRE_UNICODE_BEGIN CHARSET_FROM_UCHARS */
static bool ncr_unicode_from_uchars(UConverter *converter, const UChar *source, int32_t source_length, unsigned char **output, int32_t *output_length, size_t line, size_t column) {
    static const UChar empty_source[1] = { 0 };
    unsigned char empty_output[1] = { 0 };
    *output = NULL;
    *output_length = 0;
    if (converter == NULL || source_length < 0) { return false; }
    if (source == NULL) { source = empty_source; }
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = ucnv_fromUChars(converter, NULL, 0, source, source_length, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0 || required >= INT32_MAX) { return false; }
    if ((size_t)(required + 1) > SIZE_MAX) { return false; }
    unsigned char *converted = required == 0 ? empty_output :
        ncr_allocate((size_t)required + 1, line, column);
    status = U_ZERO_ERROR;
    int32_t written = ucnv_fromUChars(converter, (char *)converted, required + 1, source, source_length, &status);
    if (U_FAILURE(status) || written != required) {
        if (required != 0) { ncr_deallocate(converted); }
        return false;
    }
    if (required != 0) { *output = converted; }
    *output_length = written;
    return true;
}
/* NACRE_UNICODE_END CHARSET_FROM_UCHARS */

/* NACRE_UNICODE_BEGIN CASE_MAP_HELPER */
static bool ncr_unicode_case_map(UChar **output, int32_t *output_length, const UChar *source, int32_t source_length, const char *locale, int32_t (*map)(UChar *, int32_t, const UChar *, int32_t, const char *, UErrorCode *), size_t line, size_t column) {
    static const UChar empty_source[1] = { 0 };
    UChar empty_output[1] = { 0 };
    *output = NULL;
    *output_length = 0;
    if (source_length < 0 || map == NULL) { return false; }
    if (source == NULL) { source = empty_source; }
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = map(NULL, 0, source, source_length, locale, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0 || (size_t)required > SIZE_MAX / sizeof(UChar)) { return false; }
    UChar *converted = required == 0 ? empty_output :
        ncr_allocate((size_t)required * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = map(converted, required == 0 ? 1 : required, source, source_length, locale, &status);
    if (U_FAILURE(status) || written != required) {
        if (required != 0) { ncr_deallocate(converted); }
        return false;
    }
    if (required != 0) { *output = converted; }
    *output_length = written;
    return true;
}
/* NACRE_UNICODE_END CASE_MAP_HELPER */

/* NACRE_UNICODE_BEGIN FOLD_HELPER */
static bool ncr_unicode_fold(UChar **output, int32_t *output_length, const UChar *source, int32_t source_length, size_t line, size_t column) {
    static const UChar empty_source[1] = { 0 };
    UChar empty_output[1] = { 0 };
    *output = NULL;
    *output_length = 0;
    if (source_length < 0) { return false; }
    if (source == NULL) { source = empty_source; }
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = u_strFoldCase(NULL, 0, source, source_length, U_FOLD_CASE_DEFAULT, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0 || (size_t)required > SIZE_MAX / sizeof(UChar)) { return false; }
    UChar *converted = required == 0 ? empty_output :
        ncr_allocate((size_t)required * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = u_strFoldCase(converted, required == 0 ? 1 : required, source, source_length, U_FOLD_CASE_DEFAULT, &status);
    if (U_FAILURE(status) || written != required) {
        if (required != 0) { ncr_deallocate(converted); }
        return false;
    }
    if (required != 0) { *output = converted; }
    *output_length = written;
    return true;
}
/* NACRE_UNICODE_END FOLD_HELPER */

/* NACRE_UNICODE_BEGIN NORMALIZE_HELPER */
static bool ncr_unicode_normalize(UChar **output, int32_t *output_length, const UNormalizer2 *normalizer, const UChar *source, int32_t source_length, size_t line, size_t column) {
    static const UChar empty_source[1] = { 0 };
    UChar empty_output[1] = { 0 };
    *output = NULL;
    *output_length = 0;
    if (normalizer == NULL || source_length < 0) { return false; }
    if (source == NULL) { source = empty_source; }
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = unorm2_normalize(normalizer, source, source_length, NULL, 0, &status);
    if (!ncr_unicode_preflight_ok(status) || required < 0 || (size_t)required > SIZE_MAX / sizeof(UChar)) { return false; }
    UChar *converted = required == 0 ? empty_output :
        ncr_allocate((size_t)required * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = unorm2_normalize(normalizer, source, source_length, converted, required == 0 ? 1 : required, &status);
    if (U_FAILURE(status) || written != required) {
        if (required != 0) { ncr_deallocate(converted); }
        return false;
    }
    if (required != 0) { *output = converted; }
    *output_length = written;
    return true;
}
/* NACRE_UNICODE_END NORMALIZE_HELPER */

/* NACRE_UNICODE_BEGIN MAKE_TEXT */
static ncr_obj_@TEXT_ID@ *ncr_unicode_make_text(const UChar *source, int32_t source_length, size_t line, size_t column) {
    unsigned char *bytes = NULL;
    int32_t byte_length = 0;
    if (!ncr_unicode_utf16_to_utf8(source, source_length, &bytes, &byte_length, line, column)) { return NULL; }
    return ncr_text_take_bytes_@TEXT_ID@(bytes, (size_t)byte_length, (size_t)byte_length, line, column);
}
/* NACRE_UNICODE_END MAKE_TEXT */

/* NACRE_UNICODE_BEGIN LOCALE */
static bool ncr_unicode_locale(ncr_obj_@TEXT_ID@ *locale, char output[ULOC_FULLNAME_CAPACITY]) {
    if (locale == NULL || locale->length < 0) { return false; }
    if (locale->length == 0) {
        memcpy(output, "root", sizeof("root"));
        return true;
    }
    if (locale->length >= ULOC_FULLNAME_CAPACITY) { return false; }
    char tag[ULOC_FULLNAME_CAPACITY];
    for (int32_t i = 0; i < locale->length; ++i) {
        unsigned char byte = locale->bytes[i];
        if (byte == 0 || byte > 0x7f) { return false; }
        tag[i] = (char)byte;
    }
    tag[locale->length] = '\0';
    char locale_id[ULOC_FULLNAME_CAPACITY];
    int32_t parsed_length = 0;
    UErrorCode status = U_ZERO_ERROR;
    int32_t locale_length = uloc_forLanguageTag(tag, locale_id, ULOC_FULLNAME_CAPACITY, &parsed_length, &status);
    if (U_FAILURE(status) || locale_length < 0 || locale_length >= ULOC_FULLNAME_CAPACITY || parsed_length != locale->length) { return false; }
    locale_id[locale_length] = '\0';
    char canonical[ULOC_FULLNAME_CAPACITY];
    status = U_ZERO_ERROR;
    int32_t canonical_length = uloc_toLanguageTag(locale_id, canonical, ULOC_FULLNAME_CAPACITY, true, &status);
    if (U_FAILURE(status) || canonical_length != locale->length || memcmp(canonical, tag, (size_t)locale->length) != 0) { return false; }
    if (strcmp(tag, "und") == 0) {
        memcpy(output, "root", sizeof("root"));
        return true;
    }

    char base[ULOC_FULLNAME_CAPACITY];
    status = U_ZERO_ERROR;
    int32_t base_length = uloc_getBaseName(locale_id, base, ULOC_FULLNAME_CAPACITY, &status);
    if (U_FAILURE(status) || base_length < 0 || base_length >= ULOC_FULLNAME_CAPACITY) { return false; }
    base[base_length] = '\0';
    bool base_is_root = base_length == 0 || strcmp(base, "root") == 0;
    const char *base_locale = base_is_root ? "root" : base;
    bool available = false;
    int32_t available_count = uloc_countAvailable();
    if (available_count < 0) { return false; }
    for (int32_t i = 0; i < available_count; ++i) {
        const char *candidate = uloc_getAvailable(i);
        if (candidate == NULL) { return false; }
        char candidate_base[ULOC_FULLNAME_CAPACITY];
        status = U_ZERO_ERROR;
        int32_t candidate_length = uloc_getBaseName(candidate, candidate_base, ULOC_FULLNAME_CAPACITY, &status);
        if (U_FAILURE(status) || candidate_length < 0 || candidate_length >= ULOC_FULLNAME_CAPACITY) { return false; }
        candidate_base[candidate_length] = '\0';
        bool candidate_is_root = candidate_length == 0 || strcmp(candidate_base, "root") == 0;
        if ((base_is_root && candidate_is_root) || strcmp(base, candidate_base) == 0) {
            available = true;
            break;
        }
    }
    if (!available) { return false; }

    char collation[ULOC_FULLNAME_CAPACITY];
    status = U_ZERO_ERROR;
    int32_t collation_length = uloc_getKeywordValue(locale_id, "collation", collation, ULOC_FULLNAME_CAPACITY, &status);
    if (U_FAILURE(status) || collation_length < 0 || collation_length >= ULOC_FULLNAME_CAPACITY) { return false; }
    if (collation_length > 0) {
        collation[collation_length] = '\0';
        status = U_ZERO_ERROR;
        UEnumeration *values = ucol_getKeywordValuesForLocale("collation", base_locale, false, &status);
        if (U_FAILURE(status) || values == NULL) {
            if (values != NULL) { uenum_close(values); }
            return false;
        }
        bool collation_available = false;
        for (;;) {
            int32_t value_length = 0;
            status = U_ZERO_ERROR;
            const char *value = uenum_next(values, &value_length, &status);
            if (U_FAILURE(status)) {
                uenum_close(values);
                return false;
            }
            if (value == NULL) { break; }
            if (value_length == collation_length && memcmp(value, collation, (size_t)collation_length) == 0) {
                collation_available = true;
                break;
            }
        }
        uenum_close(values);
        if (!collation_available) { return false; }
    }

    char numbering[ULOC_FULLNAME_CAPACITY];
    status = U_ZERO_ERROR;
    int32_t numbering_length = uloc_getKeywordValue(locale_id, "numbers", numbering, ULOC_FULLNAME_CAPACITY, &status);
    if (U_FAILURE(status) || numbering_length < 0 || numbering_length >= ULOC_FULLNAME_CAPACITY) { return false; }
    if (numbering_length > 0) {
        UNumberingSystem *system = unumsys_open(locale_id, &status);
        if (U_FAILURE(status) || system == NULL) {
            if (system != NULL) { unumsys_close(system); }
            return false;
        }
        unumsys_close(system);
    }
    memcpy(output, locale_id, (size_t)locale_length + 1);
    return true;
}
/* NACRE_UNICODE_END LOCALE */


/* NACRE_UNICODE_BEGIN CHARSET_NAME */
static UConverter *ncr_unicode_open_converter(ncr_obj_@TEXT_ID@ *charset, size_t line, size_t column) {
    if (charset == NULL || charset->length <= 0) { return NULL; }
    size_t length = (size_t)charset->length;
    if (memchr(charset->bytes, 0, length) != NULL) { return NULL; }
    for (size_t index = 0; index < length; ++index) {
        if (charset->bytes[index] > 0x7f) { return NULL; }
    }
    char *name = ncr_allocate(length + 1, line, column);
    memcpy(name, charset->bytes, length);
    name[length] = '\0';
    if (ucnv_compareNames(name, "default") == 0) {
        ncr_deallocate(name);
        return NULL;
    }
    UErrorCode status = U_ZERO_ERROR;
    UConverter *converter = ucnv_open(name, &status);
    ncr_deallocate(name);
    if (U_FAILURE(status) || converter == NULL) {
        if (converter != NULL) { ucnv_close(converter); }
        return NULL;
    }
    UConverterToUCallback old_to_callback = NULL;
    const void *old_to_context = NULL;
    status = U_ZERO_ERROR;
    ucnv_setToUCallBack(converter, UCNV_TO_U_CALLBACK_STOP, NULL, &old_to_callback, &old_to_context, &status);
    if (U_FAILURE(status)) { ucnv_close(converter); return NULL; }
    UConverterFromUCallback old_from_callback = NULL;
    const void *old_from_context = NULL;
    status = U_ZERO_ERROR;
    ucnv_setFromUCallBack(converter, UCNV_FROM_U_CALLBACK_STOP, NULL, &old_from_callback, &old_from_context, &status);
    if (U_FAILURE(status)) { ucnv_close(converter); return NULL; }
    return converter;
}
/* NACRE_UNICODE_END CHARSET_NAME */

/* NACRE_UNICODE_BEGIN CHARSET_AVAILABLE */
static @LIST_TYPE@ @CHARSET_AVAILABLE@(size_t ncr_line, size_t ncr_column) {
    @LIST_TYPE@ charsets = ncr_allocate(sizeof(*charsets), ncr_line, ncr_column);
    @LIST_NEW@(charsets, ncr_line, ncr_column);
    int32_t available_count = ucnv_countAvailable();
    if (available_count < 0) {
        @LIST_DROP@(charsets);
        ncr_fail("ICU charset inventory failed", ncr_line, ncr_column);
    }
    for (int32_t index = 0; index < available_count; ++index) {
        const char *name = ucnv_getAvailableName(index);
        if (name == NULL || name[0] == '\0') {
            @LIST_DROP@(charsets);
            ncr_fail("ICU charset inventory returned an invalid entry", ncr_line, ncr_column);
        }
        if (ucnv_compareNames(name, "default") == 0) { continue; }
        size_t length = strlen(name);
        ncr_obj_@TEXT_ID@ *name_text = ncr_text_from_bytes_@TEXT_ID@(
            (const unsigned char *)name, length, ncr_line, ncr_column);
        @LIST_ADD@(charsets, name_text, ncr_line, ncr_column);
    }
    return charsets;
}
/* NACRE_UNICODE_END CHARSET_AVAILABLE */

/* NACRE_UNICODE_BEGIN CHARACTER_IS_LETTER */
static bool @CHARACTER_IS_LETTER@(uint32_t ncr_v_@CHAR_LETTER@, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column; return u_isalpha((UChar32)ncr_v_@CHAR_LETTER@);
}
