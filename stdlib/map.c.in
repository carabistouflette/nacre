/* Native Map<int, @ELEMENT@>. Entries occupy a single contiguous buffer. */
static uint32_t ncr_map_hash_@ID@(int32_t key) {
    uint32_t value = (uint32_t)key;
    value ^= value >> 16;
    value *= UINT32_C(0x7feb352d);
    value ^= value >> 15;
    value *= UINT32_C(0x846ca68b);
    value ^= value >> 16;
    return value;
}
static int32_t ncr_map_find_@ID@(ncr_obj_@ID@ *p, int32_t key) {
    if (p->capacity == 0) { return -1; }
    uint32_t mask = (uint32_t)p->capacity - UINT32_C(1);
    uint32_t index = ncr_map_hash_@ID@(key) & mask;
    for (int32_t probes = 0; probes < p->capacity; ++probes) {
        @ENTRY_TYPE@ *entry = &p->entries[index];
        if (!entry->occupied) { return -1; }
        if (entry->key == key) { return (int32_t)index; }
        index = (index + UINT32_C(1)) & mask;
    }
    return -1;
}
static void ncr_map_grow_@ID@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    int32_t capacity;
    if (p->capacity == 0) {
        capacity = 8;
    } else {
        if (p->capacity > INT32_MAX / 2) {
            ncr_fail("capacite de Map trop grande", line, column);
        }
        capacity = p->capacity * 2;
    }
    size_t count = (size_t)capacity;
    if (count > SIZE_MAX / sizeof(@ENTRY_TYPE@)) {
        ncr_fail("capacite de Map trop grande", line, column);
    }
    size_t bytes = count * sizeof(@ENTRY_TYPE@);
    @ENTRY_TYPE@ *entries = ncr_allocate(bytes, line, column);
    /* ncr_allocate is calloc-backed; zero occupied flags mark every slot empty. */
    uint32_t mask = (uint32_t)capacity - UINT32_C(1);
    for (int32_t index = 0; index < p->capacity; ++index) {
        if (!p->entries[index].occupied) { continue; }
        @ENTRY_TYPE@ *old = &p->entries[index];
        uint32_t target = ncr_map_hash_@ID@(old->key) & mask;
        while (entries[target].occupied) {
            target = (target + UINT32_C(1)) & mask;
        }
        entries[target] = *old;
        old->occupied = false;
    }
    /* Raw relocation transfers every owner; old entries are never destroyed. */
    ncr_deallocate(p->entries);
    p->entries = entries;
    p->capacity = capacity;
}
static void @MAP_NEW@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    p->entries = NULL;
    p->length = 0;
    p->capacity = 0;
}
static bool @MAP_CONTAINS_KEY@(ncr_obj_@ID@ *p, int32_t key, size_t line, size_t column) {
    (void)line; (void)column;
    return ncr_map_find_@ID@(p, key) >= 0;
}
static int32_t @MAP_SIZE@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->length;
}
static bool @MAP_IS_EMPTY@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->length == 0;
}
static @OPTION_TYPE@ @MAP_PUT@(ncr_obj_@ID@ *p, int32_t key, @ELEMENT@ value, size_t line, size_t column) {
    int32_t index = ncr_map_find_@ID@(p, key);
    if (index >= 0) {
        @ELEMENT@ previous = p->entries[index].value;
        p->entries[index].value = value;
        return (@OPTION_TYPE@){ .tag = @SOME_TAG@, .data.v@SOME_TAG@.f0 = previous };
    }
    if (p->capacity == 0 || p->length >= p->capacity - p->capacity / 4) {
        ncr_map_grow_@ID@(p, line, column);
    }
    uint32_t mask = (uint32_t)p->capacity - UINT32_C(1);
    uint32_t target = ncr_map_hash_@ID@(key) & mask;
    while (p->entries[target].occupied) {
        target = (target + UINT32_C(1)) & mask;
    }
    p->entries[target].key = key;
    p->entries[target].value = value;
    p->entries[target].occupied = true;
    ++p->length;
    return (@OPTION_TYPE@){ .tag = @NONE_TAG@ };
}
static @OPTION_TYPE@ @MAP_TRY_REMOVE@(ncr_obj_@ID@ *p, int32_t key, size_t line, size_t column) {
    (void)line; (void)column;
    int32_t index = ncr_map_find_@ID@(p, key);
    if (index < 0) { return (@OPTION_TYPE@){ .tag = @NONE_TAG@ }; }
    @ELEMENT@ value = p->entries[index].value;
    uint32_t mask = (uint32_t)p->capacity - UINT32_C(1);
    uint32_t hole = (uint32_t)index;
    uint32_t scan = (hole + UINT32_C(1)) & mask;
    while (p->entries[scan].occupied) {
        uint32_t home = ncr_map_hash_@ID@(p->entries[scan].key) & mask;
        if (((hole - home) & mask) < ((scan - home) & mask)) {
            p->entries[hole] = p->entries[scan];
            hole = scan;
        }
        scan = (scan + UINT32_C(1)) & mask;
    }
    p->entries[hole].occupied = false;
    --p->length;
    return (@OPTION_TYPE@){ .tag = @SOME_TAG@, .data.v@SOME_TAG@.f0 = value };
}
@TRY_GET_METHOD@
@BORROWED_GETTERS@
static void @MAP_CLEAR@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    for (int32_t index = 0; index < p->capacity; ++index) {
        if (!p->entries[index].occupied) { continue; }
        @DROP_VALUE@
        p->entries[index].occupied = false;
    }
    p->length = 0;
}
