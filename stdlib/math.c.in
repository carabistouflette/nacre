    if ((ncr_v_1 > 0 && ncr_v_0 > INT64_MAX - ncr_v_1) || (ncr_v_1 < 0 && ncr_v_0 < INT64_MIN - ncr_v_1)) {
        return ncr_result_error_@MATH_LONG_RESULT@("Math.addExactLong: integer overflow", sizeof("Math.addExactLong: integer overflow") - 1, ncr_line, ncr_column);
    }
    int64_t value = ncr_v_0 + ncr_v_1;
    return (ncr_obj_@MATH_LONG_RESULT@){.tag = @MATH_LONG_OK_TAG@, .data.v@MATH_LONG_OK_TAG@.f0 = value};
}
