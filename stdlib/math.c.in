double @MATH_HYPOT@(double ncr_v_0, double ncr_v_1, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column; return hypot(ncr_v_0, ncr_v_1);
}
bool @MATH_IS_NAN@(double ncr_v_0, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column; return isnan(ncr_v_0);
}
bool @MATH_IS_FINITE@(double ncr_v_0, size_t ncr_line, size_t ncr_column) {
