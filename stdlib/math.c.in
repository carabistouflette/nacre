    return ncr_v_0 < ncr_v_1 ? ncr_v_0 : ncr_v_1;
}
double @MATH_MIN_DOUBLE@(double ncr_v_0, double ncr_v_1, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    if (ncr_v_0 == 0.0 && ncr_v_1 == 0.0) {
        return signbit(ncr_v_0) || signbit(ncr_v_1) ? -0.0 : 0.0;
    }
    return fmin(ncr_v_0, ncr_v_1);
}
