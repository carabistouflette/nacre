ncr_obj_@MATH_INT_RESULT@ @MATH_ADD_EXACT_INT@(int32_t ncr_v_0, int32_t ncr_v_1, size_t ncr_line, size_t ncr_column) {
    if ((ncr_v_1 > 0 && ncr_v_0 > INT32_MAX - ncr_v_1) || (ncr_v_1 < 0 && ncr_v_0 < INT32_MIN - ncr_v_1)) {
        return ncr_result_error_@MATH_INT_RESULT@("Math.addExactInt: integer overflow", sizeof("Math.addExactInt: integer overflow") - 1, ncr_line, ncr_column);
    }
    int32_t value = ncr_v_0 + ncr_v_1;
    return (ncr_obj_@MATH_INT_RESULT@){.tag = @MATH_INT_OK_TAG@, .data.v@MATH_INT_OK_TAG@.f0 = value};
}
