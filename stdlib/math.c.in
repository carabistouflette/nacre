ncr_obj_@MATH_INT_RESULT@ @MATH_FLOOR_DIV_INT@(int32_t ncr_v_0, int32_t ncr_v_1, size_t ncr_line, size_t ncr_column) {
    if (ncr_v_1 == 0) {
        return ncr_result_error_@MATH_INT_RESULT@("Math.floorDivInt: division by zero", sizeof("Math.floorDivInt: division by zero") - 1, ncr_line, ncr_column);
    }
    if (ncr_v_0 == INT32_MIN && ncr_v_1 == -1) {
        return ncr_result_error_@MATH_INT_RESULT@("Math.floorDivInt: integer overflow", sizeof("Math.floorDivInt: integer overflow") - 1, ncr_line, ncr_column);
    }
    int32_t quotient = ncr_v_0 / ncr_v_1;
    int32_t remainder = ncr_v_0 % ncr_v_1;
    if (remainder != 0 && ((remainder < 0) != (ncr_v_1 < 0))) --quotient;
    return (ncr_obj_@MATH_INT_RESULT@){.tag = @MATH_INT_OK_TAG@, .data.v@MATH_INT_OK_TAG@.f0 = quotient};
}
