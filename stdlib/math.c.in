/* ISO C libm domain/range cases remain IEEE values: e.g. sqrt(-x) and trig
   of infinity produce NaN, log(0) is -infinity, and exp overflow is +infinity.
   min/max ignore one NaN and return NaN for two NaNs. Zero ties explicitly
   choose -0/+0; libm does not portably promise that choice. round ties away
   from zero and fabs(-0) is +0. C11 libm functions keep their standard
   domain/range behavior; nextafter steps to an adjacent value, and remainder
   uses a nearest-integer quotient with ties to even. */
ncr_obj_@ABS_INT_RESULT@ @MATH_ABS_INT@(int32_t @ABS_INT_VALUE@, size_t ncr_line, size_t ncr_column) {
    if (@ABS_INT_VALUE@ == INT32_MIN) {
        return ncr_result_error_@ABS_INT_RESULT@("Math.absInt: INT32_MIN has no positive int value", sizeof("Math.absInt: INT32_MIN has no positive int value") - 1, ncr_line, ncr_column);
    }
    int32_t absolute = @ABS_INT_VALUE@ < 0 ? -@ABS_INT_VALUE@ : @ABS_INT_VALUE@;
    return (ncr_obj_@ABS_INT_RESULT@){.tag = @ABS_INT_OK_TAG@, .data.v@ABS_INT_OK_TAG@.f0 = absolute};
}

ncr_obj_@ABS_LONG_RESULT@ @MATH_ABS_LONG@(int64_t @ABS_LONG_VALUE@, size_t ncr_line, size_t ncr_column) {
    if (@ABS_LONG_VALUE@ == INT64_MIN) {
        return ncr_result_error_@ABS_LONG_RESULT@("Math.absLong: INT64_MIN has no positive long value", sizeof("Math.absLong: INT64_MIN has no positive long value") - 1, ncr_line, ncr_column);
    }
    int64_t absolute = @ABS_LONG_VALUE@ < 0 ? -@ABS_LONG_VALUE@ : @ABS_LONG_VALUE@;
    return (ncr_obj_@ABS_LONG_RESULT@){.tag = @ABS_LONG_OK_TAG@, .data.v@ABS_LONG_OK_TAG@.f0 = absolute};
}

double @MATH_ABS_DOUBLE@(double ncr_v_0, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    return fabs(ncr_v_0);
}
