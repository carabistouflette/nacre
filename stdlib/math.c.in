ncr_obj_@MATH_INT_RESULT@ @MATH_MULTIPLY_EXACT_INT@(int32_t ncr_v_0, int32_t ncr_v_1, size_t ncr_line, size_t ncr_column) {
    bool overflow = false;
    if (ncr_v_0 > 0) {
        if (ncr_v_1 > 0) overflow = ncr_v_0 > INT32_MAX / ncr_v_1;
        else if (ncr_v_1 < 0) overflow = ncr_v_1 < INT32_MIN / ncr_v_0;
    } else if (ncr_v_0 < 0) {
        if (ncr_v_1 > 0) overflow = ncr_v_0 < INT32_MIN / ncr_v_1;
        else if (ncr_v_1 < 0) overflow = ncr_v_0 < INT32_MAX / ncr_v_1;
    }
    if (overflow) {
        return ncr_result_error_@MATH_INT_RESULT@("Math.multiplyExactInt: integer overflow", sizeof("Math.multiplyExactInt: integer overflow") - 1, ncr_line, ncr_column);
    }
    int32_t value = ncr_v_0 * ncr_v_1;
    return (ncr_obj_@MATH_INT_RESULT@){.tag = @MATH_INT_OK_TAG@, .data.v@MATH_INT_OK_TAG@.f0 = value};
}
