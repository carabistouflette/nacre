    if ((ncr_v_1 > 0 && ncr_v_0 < INT32_MIN + ncr_v_1) || (ncr_v_1 < 0 && ncr_v_0 > INT32_MAX + ncr_v_1)) {
        return ncr_result_error_@MATH_INT_RESULT@("Math.subtractExactInt: integer overflow", sizeof("Math.subtractExactInt: integer overflow") - 1, ncr_line, ncr_column);
    }
