    bool overflow = false;
    if (ncr_v_0 > 0) {
        if (ncr_v_1 > 0) overflow = ncr_v_0 > INT64_MAX / ncr_v_1;
        else if (ncr_v_1 < 0) overflow = ncr_v_1 < INT64_MIN / ncr_v_0;
    } else if (ncr_v_0 < 0) {
        if (ncr_v_1 > 0) overflow = ncr_v_0 < INT64_MIN / ncr_v_1;
        else if (ncr_v_1 < 0) overflow = ncr_v_0 < INT64_MAX / ncr_v_1;
    }
    if (overflow) {
        return ncr_result_error_@MATH_LONG_RESULT@("Math.multiplyExactLong: integer overflow", sizeof("Math.multiplyExactLong: integer overflow") - 1, ncr_line, ncr_column);
    }
    int64_t value = ncr_v_0 * ncr_v_1;
    return (ncr_obj_@MATH_LONG_RESULT@){.tag = @MATH_LONG_OK_TAG@, .data.v@MATH_LONG_OK_TAG@.f0 = value};
}
