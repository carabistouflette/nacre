double @MATH_NEXT_UP@(double ncr_v_0, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    if (isnan(ncr_v_0) || ncr_v_0 == INFINITY) return ncr_v_0;
    if (ncr_v_0 == 0.0) return nextafter(0.0, INFINITY);
    return nextafter(ncr_v_0, INFINITY);
}
double @MATH_NEXT_DOWN@(double ncr_v_0, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    if (isnan(ncr_v_0) || ncr_v_0 == -INFINITY) return ncr_v_0;
    if (ncr_v_0 == 0.0) return nextafter(0.0, -INFINITY);
    return nextafter(ncr_v_0, -INFINITY);
}
double @MATH_ULP@(double ncr_v_0, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    if (isnan(ncr_v_0)) return ncr_v_0;
    if (isinf(ncr_v_0)) return INFINITY;
    double magnitude = fabs(ncr_v_0);
    double next = nextafter(magnitude, INFINITY);
    if (isinf(next)) return magnitude - nextafter(magnitude, -INFINITY);
    return next - magnitude;
}
int32_t @MATH_GET_EXPONENT@(double ncr_v_0, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    if (!isfinite(ncr_v_0)) return DBL_MAX_EXP;
    if (ncr_v_0 == 0.0 || fpclassify(ncr_v_0) == FP_SUBNORMAL) return DBL_MIN_EXP - 2;
    return (int32_t)ilogb(ncr_v_0);
}
