ncr_obj_@DATE_TIME_FROM_PARTS_RESULT@ @DATE_TIME_FROM_PARTS@(
    int32_t ncr_v_0, int32_t ncr_v_1, int32_t ncr_v_2,
    int32_t ncr_v_3, int32_t ncr_v_4, int32_t ncr_v_5,
    int32_t ncr_v_6, ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_7, bool ncr_v_8,
    size_t ncr_line, size_t ncr_column
) {
    int32_t maximum_day = 0;
    if (!ncr_dt_days_in_month(ncr_v_0, ncr_v_1, &maximum_day)
        || ncr_v_2 < 1 || ncr_v_2 > maximum_day
        || ncr_v_3 < 0 || ncr_v_3 > 23 || ncr_v_4 < 0 || ncr_v_4 > 59
        || ncr_v_5 < 0 || ncr_v_5 > 59 || ncr_v_6 < 0 || ncr_v_6 > 999) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FROM_PARTS_RESULT@,
            "DateTime.fromParts: invalid Gregorian date or time", ncr_line, ncr_column);
    }
    UChar *zone = NULL;
    int32_t zone_length = 0;
    const char *failure = ncr_dt_zone_id(ncr_v_7, &zone, &zone_length, ncr_line, ncr_column);
    if (failure != NULL) {
        return ncr_result_error_@DATE_TIME_FROM_PARTS_RESULT@(failure, strlen(failure), ncr_line, ncr_column);
    }
    UCalendar *calendar = ncr_dt_open_calendar(zone, zone_length, "en_US_POSIX", ncr_line, ncr_column);
    ncr_deallocate(zone);
    if (calendar == NULL) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FROM_PARTS_RESULT@,
            "DateTime.fromParts: ICU calendar initialization failed", ncr_line, ncr_column);
    }
    int64_t epoch = 0;
    bool valid = ncr_dt_resolve_wall(calendar, ncr_v_0, ncr_v_1, ncr_v_2,
        ncr_v_3, ncr_v_4, ncr_v_5, ncr_v_6, ncr_v_8, false, &epoch);
    ucal_close(calendar);
    if (!valid) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FROM_PARTS_RESULT@,
            "DateTime.fromParts: invalid date, unrepresentable time, or daylight-saving gap",
            ncr_line, ncr_column);
    }
    return (ncr_obj_@DATE_TIME_FROM_PARTS_RESULT@){
        .tag = @DATE_TIME_FROM_PARTS_OK_TAG@,
        .data.v@DATE_TIME_FROM_PARTS_OK_TAG@.f0 = epoch
    };
}

ncr_obj_@DATE_TIME_PARTS_RESULT@ @DATE_TIME_PARTS@(
    int64_t ncr_v_0, ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_1,
    size_t ncr_line, size_t ncr_column
) {
    if (!ncr_dt_epoch_in_range(ncr_v_0)) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_PARTS_RESULT@,
            "DateTime.parts: epoch milliseconds exceed exact ICU precision", ncr_line, ncr_column);
    }
    UChar *zone = NULL;
    int32_t zone_length = 0;
    const char *failure = ncr_dt_zone_id(ncr_v_1, &zone, &zone_length, ncr_line, ncr_column);
    if (failure != NULL) {
        return ncr_result_error_@DATE_TIME_PARTS_RESULT@(failure, strlen(failure), ncr_line, ncr_column);
    }
    UCalendar *calendar = ncr_dt_open_calendar(zone, zone_length, "en_US_POSIX", ncr_line, ncr_column);
    ncr_deallocate(zone);
    if (calendar == NULL) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_PARTS_RESULT@,
            "DateTime.parts: ICU calendar initialization failed", ncr_line, ncr_column);
    }
    UErrorCode status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)ncr_v_0, &status);
    struct ncr_dt_fields fields;
    bool valid = U_SUCCESS(status);
    int64_t offset_millis = 0;
    bool daylight = false;
    if (valid) {
        status = U_ZERO_ERROR;
        offset_millis = (int64_t)ucal_get(calendar, UCAL_ZONE_OFFSET, &status)
            + (int64_t)ucal_get(calendar, UCAL_DST_OFFSET, &status);
        daylight = ucal_inDaylightTime(calendar, &status);
        valid = U_SUCCESS(status) && ncr_dt_local_epoch_in_range(ncr_v_0, offset_millis)
            && ncr_dt_calendar_fields(calendar, &fields);
    }
    ucal_close(calendar);
    if (!valid) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_PARTS_RESULT@,
            "DateTime.parts: ICU could not represent the requested epoch", ncr_line, ncr_column);
    }

    ncr_obj_@DATE_TIME_FIELDS_ID@ *parts = ncr_allocate(sizeof(*parts), ncr_line, ncr_column);
    parts->ncr_f_0 = fields.year;
    parts->ncr_f_1 = fields.month + 1;
    parts->ncr_f_2 = fields.day;
    parts->ncr_f_3 = fields.hour;
    parts->ncr_f_4 = fields.minute;
    parts->ncr_f_5 = fields.second;
    parts->ncr_f_6 = fields.millisecond;
    parts->ncr_f_7 = (int32_t)(offset_millis / INT64_C(1000));
    parts->ncr_f_8 = daylight;
    return (ncr_obj_@DATE_TIME_PARTS_RESULT@){
        .tag = @DATE_TIME_PARTS_OK_TAG@,
        .data.v@DATE_TIME_PARTS_OK_TAG@.f0 = parts
    };
}

ncr_obj_@DATE_TIME_FORMAT_RESULT@ @DATE_TIME_FORMAT@(
    int64_t ncr_v_0, ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_1,
    ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_2, ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_3,
    size_t ncr_line, size_t ncr_column
) {
    if (!ncr_dt_epoch_in_range(ncr_v_0)) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FORMAT_RESULT@,
            "DateTime.format: epoch milliseconds exceed exact ICU precision", ncr_line, ncr_column);
    }
    const char *failure = NULL;
    UCalendar *calendar = NULL;
    UDateFormat *formatter = ncr_dt_open_formatter(ncr_v_1, ncr_v_2, ncr_v_3,
        &failure, &calendar, ncr_line, ncr_column);
    if (formatter == NULL) {
        return ncr_result_error_@DATE_TIME_FORMAT_RESULT@(failure, strlen(failure), ncr_line, ncr_column);
    }

    UErrorCode status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)ncr_v_0, &status);
    bool exact = U_SUCCESS(status) && ncr_dt_calendar_epoch_exact(calendar, ncr_v_0);
    ucal_close(calendar);
    if (!exact) {
        udat_close(formatter);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FORMAT_RESULT@,
            "DateTime.format: local milliseconds exceed exact ICU precision", ncr_line, ncr_column);
    }
    status = U_ZERO_ERROR;
    int32_t required = udat_formatForFields(formatter, (UDate)ncr_v_0, NULL, 0, NULL, &status);
    if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) || required < 0
        || required == INT32_MAX) {
        udat_close(formatter);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FORMAT_RESULT@,
            "DateTime.format: ICU could not format the requested epoch", ncr_line, ncr_column);
    }
    UChar *output = ncr_allocate(((size_t)required + 1) * sizeof(UChar), ncr_line, ncr_column);
    status = U_ZERO_ERROR;
    int32_t written = udat_formatForFields(formatter, (UDate)ncr_v_0, output, required + 1, NULL, &status);
    udat_close(formatter);
    if (U_FAILURE(status) || written != required) {
        ncr_deallocate(output);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FORMAT_RESULT@,
            "DateTime.format: ICU could not format the requested epoch", ncr_line, ncr_column);
    }
    ncr_obj_@DATE_TIME_TEXT_ID@ *text = ncr_dt_text_from_uchar(output, written, ncr_line, ncr_column);
    ncr_deallocate(output);
    if (text == NULL) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_FORMAT_RESULT@,
            "DateTime.format: formatted result is too large or invalid", ncr_line, ncr_column);
    }
    return (ncr_obj_@DATE_TIME_FORMAT_RESULT@){
        .tag = @DATE_TIME_FORMAT_OK_TAG@,
        .data.v@DATE_TIME_FORMAT_OK_TAG@.f0 = text
    };
}

ncr_obj_@DATE_TIME_PARSE_RESULT@ @DATE_TIME_PARSE@(
    ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_0, ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_1,
    ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_2, ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_3,
    size_t ncr_line, size_t ncr_column
) {
    const char *failure = NULL;
    UDateFormat *formatter = ncr_dt_open_formatter(ncr_v_1, ncr_v_2, ncr_v_3,
        &failure, NULL, ncr_line, ncr_column);
    if (formatter == NULL) {
        return ncr_result_error_@DATE_TIME_PARSE_RESULT@(failure, strlen(failure), ncr_line, ncr_column);
    }
    UChar *input = NULL;
    int32_t input_length = 0;
    if (!ncr_dt_utf8_to_uchar(ncr_v_0, false, &input, &input_length, ncr_line, ncr_column)) {
        udat_close(formatter);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_PARSE_RESULT@,
            "DateTime.parse: value is not valid UTF-8", ncr_line, ncr_column);
    }

    int64_t first = 0;
    int64_t last = 0;
    int64_t skipped = 0;
    bool valid = ncr_dt_parse_candidate(formatter, input, input_length,
            UCAL_WALLTIME_FIRST, UCAL_WALLTIME_FIRST, &first)
        && ncr_dt_parse_candidate(formatter, input, input_length,
            UCAL_WALLTIME_LAST, UCAL_WALLTIME_FIRST, &last)
        && ncr_dt_parse_candidate(formatter, input, input_length,
            UCAL_WALLTIME_FIRST, UCAL_WALLTIME_LAST, &skipped)
        && first == skipped && first == last;
    ncr_deallocate(input);
    udat_close(formatter);
    if (!valid) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_PARSE_RESULT@,
            "DateTime.parse: invalid, ambiguous, or trailing input; DST gaps and overlaps are rejected",
            ncr_line, ncr_column);
    }
    return (ncr_obj_@DATE_TIME_PARSE_RESULT@){
        .tag = @DATE_TIME_PARSE_OK_TAG@,
        .data.v@DATE_TIME_PARSE_OK_TAG@.f0 = first
    };
}

bool @DATE_TIME_IS_LEAP_YEAR@(int32_t ncr_v_0, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line;
    (void)ncr_column;
    return ncr_v_0 % 4 == 0 && (ncr_v_0 % 100 != 0 || ncr_v_0 % 400 == 0);
}

ncr_obj_@DATE_TIME_DAYS_RESULT@ @DATE_TIME_DAYS_IN_MONTH@(
    int32_t ncr_v_0, int32_t ncr_v_1, size_t ncr_line, size_t ncr_column
) {
    int32_t days = 0;
    if (!ncr_dt_days_in_month(ncr_v_0, ncr_v_1, &days)) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_DAYS_RESULT@,
            "DateTime.daysInMonth: month must be in 1 through 12", ncr_line, ncr_column);
    }
    return (ncr_obj_@DATE_TIME_DAYS_RESULT@){
        .tag = @DATE_TIME_DAYS_OK_TAG@,
        .data.v@DATE_TIME_DAYS_OK_TAG@.f0 = days
    };
}

ncr_obj_@DATE_TIME_ADD_RESULT@ @DATE_TIME_ADD_CALENDAR@(
    int64_t ncr_v_0, int32_t ncr_v_1, int32_t ncr_v_2, int32_t ncr_v_3,
    ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_v_4, size_t ncr_line, size_t ncr_column
) {
    if (!ncr_dt_epoch_in_range(ncr_v_0)) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: epoch milliseconds exceed exact ICU precision", ncr_line, ncr_column);
    }
    UChar *zone = NULL;
    int32_t zone_length = 0;
    const char *failure = ncr_dt_zone_id(ncr_v_4, &zone, &zone_length, ncr_line, ncr_column);
    if (failure != NULL) {
        return ncr_result_error_@DATE_TIME_ADD_RESULT@(failure, strlen(failure), ncr_line, ncr_column);
    }
    UCalendar *calendar = ncr_dt_open_calendar(zone, zone_length, "en_US_POSIX", ncr_line, ncr_column);
    ncr_deallocate(zone);
    if (calendar == NULL) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: ICU calendar initialization failed", ncr_line, ncr_column);
    }
    UErrorCode status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)ncr_v_0, &status);
    struct ncr_dt_fields fields;
    bool valid = U_SUCCESS(status) && ncr_dt_calendar_epoch_exact(calendar, ncr_v_0)
        && ncr_dt_calendar_fields(calendar, &fields);
    if (!valid) {
        ucal_close(calendar);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: ICU could not read the requested epoch", ncr_line, ncr_column);
    }

    int64_t target_year = (int64_t)fields.year + ncr_v_1;
    if (target_year < INT32_MIN || target_year > INT32_MAX) {
        ucal_close(calendar);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: target year is outside the Gregorian range", ncr_line, ncr_column);
    }
    int32_t target_day = fields.day;
    int32_t maximum_day = 0;
    if (!ncr_dt_days_in_month((int32_t)target_year, fields.month + 1, &maximum_day)) {
        ucal_close(calendar);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: invalid Gregorian source date", ncr_line, ncr_column);
    }
    if (target_day > maximum_day) { target_day = maximum_day; }

    int64_t month_index = target_year * INT64_C(12) + fields.month + ncr_v_2;
    int64_t shifted_year = month_index / INT64_C(12);
    int64_t shifted_month = month_index % INT64_C(12);
    if (shifted_month < 0) { shifted_month += 12; --shifted_year; }
    if (shifted_year < INT32_MIN || shifted_year > INT32_MAX) {
        ucal_close(calendar);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: target year is outside the Gregorian range", ncr_line, ncr_column);
    }
    if (!ncr_dt_days_in_month((int32_t)shifted_year, (int32_t)shifted_month + 1, &maximum_day)) {
        ucal_close(calendar);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: invalid Gregorian target month", ncr_line, ncr_column);
    }
    if (target_day > maximum_day) { target_day = maximum_day; }
    struct ncr_dt_fields expected_date;
    int64_t expected_day_number = ncr_dt_gregorian_days_from_date(
        shifted_year, (int32_t)shifted_month + 1, target_day) + ncr_v_3;
    if (!ncr_dt_gregorian_date_from_days(expected_day_number, &expected_date)) {
        ucal_close(calendar);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: target date is outside the Gregorian range",
            ncr_line, ncr_column);
    }

    int64_t intermediate = 0;
    if (!ncr_dt_resolve_wall(calendar, (int32_t)shifted_year, (int32_t)shifted_month + 1,
        target_day, fields.hour, fields.minute, fields.second, fields.millisecond,
        false, true, &intermediate)) {
        ucal_close(calendar);
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: target month lands in an invalid date or daylight-saving gap",
            ncr_line, ncr_column);
    }
    status = U_ZERO_ERROR;
    ucal_setMillis(calendar, (UDate)intermediate, &status);
    if (U_SUCCESS(status)) { ucal_add(calendar, UCAL_DATE, ncr_v_3, &status); }
    UDate final_instant = U_FAILURE(status) ? 0.0 : ucal_getMillis(calendar, &status);
    struct ncr_dt_fields final_fields;
    valid = U_SUCCESS(status) && ncr_dt_calendar_fields(calendar, &final_fields)
        && final_fields.year == expected_date.year
        && final_fields.month == expected_date.month && final_fields.day == expected_date.day
        && final_fields.hour == fields.hour && final_fields.minute == fields.minute
        && final_fields.second == fields.second && final_fields.millisecond == fields.millisecond;
    int64_t result = 0;
    if (valid) {
        valid = ncr_dt_resolve_wall(calendar, final_fields.year, final_fields.month + 1,
            final_fields.day, fields.hour, fields.minute, fields.second, fields.millisecond,
            false, true, &result);
    }
    if (valid) {
        valid = ncr_dt_udate_to_epoch(final_instant, &intermediate)
            && intermediate == result && ncr_dt_epoch_in_range(result);
    }
    ucal_close(calendar);
    if (!valid) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_ADD_RESULT@,
            "DateTime.addCalendar: target date is invalid, ambiguous, in a daylight-saving gap, or outside ICU precision",
            ncr_line, ncr_column);
    }
    return (ncr_obj_@DATE_TIME_ADD_RESULT@){
        .tag = @DATE_TIME_ADD_OK_TAG@,
        .data.v@DATE_TIME_ADD_OK_TAG@.f0 = result
    };
}

ncr_obj_@DATE_TIME_DURATION_RESULT@ @DATE_TIME_DURATION_MILLIS@(
    int64_t ncr_v_0, int64_t ncr_v_1, size_t ncr_line, size_t ncr_column
) {
    if ((ncr_v_0 > 0 && ncr_v_1 < INT64_MIN + ncr_v_0)
        || (ncr_v_0 < 0 && ncr_v_1 > INT64_MAX + ncr_v_0)) {
        return NCR_DT_RESULT_ERROR(@DATE_TIME_DURATION_RESULT@,
            "DateTime.durationMillis: signed duration overflow", ncr_line, ncr_column);
    }
    int64_t difference = ncr_v_1 - ncr_v_0;
    return (ncr_obj_@DATE_TIME_DURATION_RESULT@){
        .tag = @DATE_TIME_DURATION_OK_TAG@,
        .data.v@DATE_TIME_DURATION_OK_TAG@.f0 = difference
    };
}

ncr_obj_@DATE_TIME_LIST_ID@ * @DATE_TIME_AVAILABLE_ZONES@(
    size_t ncr_line, size_t ncr_column
) {
    UErrorCode status = U_ZERO_ERROR;
    UEnumeration *enumeration = ucal_openTimeZoneIDEnumeration(
        UCAL_ZONE_TYPE_ANY, NULL, NULL, &status);
    if (enumeration == NULL || U_FAILURE(status)) {
        uenum_close(enumeration);
        ncr_fail("DateTime.availableZones: ICU zone enumeration failed", ncr_line, ncr_column);
    }
    ncr_obj_@DATE_TIME_LIST_ID@ *zones = ncr_allocate(sizeof(*zones), ncr_line, ncr_column);
    @DATE_TIME_LIST_NEW@(zones, ncr_line, ncr_column);
    static const UChar utc_id[] = { 0x0055, 0x0054, 0x0043 };
    bool has_utc = false;
    for (;;) {
        int32_t zone_length = 0;
        const UChar *zone = uenum_unext(enumeration, &zone_length, &status);
        if (U_FAILURE(status)) {
            uenum_close(enumeration);
            ncr_drop_@DATE_TIME_LIST_ID@(zones);
            ncr_fail("DateTime.availableZones: ICU zone enumeration failed", ncr_line, ncr_column);
        }
        if (zone == NULL) { break; }
        if (zone_length == 3 && zone[0] == utc_id[0] && zone[1] == utc_id[1] && zone[2] == utc_id[2]) {
            has_utc = true;
        }
        ncr_obj_@DATE_TIME_TEXT_ID@ *text = ncr_dt_text_from_uchar(zone, zone_length, ncr_line, ncr_column);
        if (text == NULL) {
            uenum_close(enumeration);
            ncr_drop_@DATE_TIME_LIST_ID@(zones);
            ncr_fail("DateTime.availableZones: ICU zone data is invalid", ncr_line, ncr_column);
        }
        @DATE_TIME_LIST_ADD@(zones, text, ncr_line, ncr_column);
    }
    uenum_close(enumeration);
    if (!has_utc) {
        ncr_obj_@DATE_TIME_TEXT_ID@ *text = ncr_dt_text_from_uchar(utc_id, 3, ncr_line, ncr_column);
        if (text == NULL) {
            ncr_drop_@DATE_TIME_LIST_ID@(zones);
            ncr_fail("DateTime.availableZones: ICU zone data is invalid", ncr_line, ncr_column);
        }
        @DATE_TIME_LIST_ADD@(zones, text, ncr_line, ncr_column);
    }
    return zones;
}
