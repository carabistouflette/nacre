/* Native Deque<@ELEMENT@>, with initialized ownership in logical [0,length). */
static inline int32_t ncr_deque_physical_@ID@(ncr_obj_@ID@ *p, int32_t logical) {
    int32_t until_end = p->capacity - p->head;
    return logical < until_end ? p->head + logical : logical - until_end;
}
static void ncr_deque_reserve_@ID@(ncr_obj_@ID@ *p, int32_t requested, size_t line, size_t column) {
    if (requested < 0) { ncr_fail("negative Deque capacity", line, column); }
    if (requested <= p->capacity) { return; }
    int64_t capacity = p->capacity == 0 ? 4 : p->capacity;
    while (capacity < requested) {
        capacity = capacity > INT32_MAX / 2 ? INT32_MAX : capacity * 2;
    }
    if ((uint64_t)capacity > SIZE_MAX / sizeof(@ELEMENT@)) {
        ncr_fail("Deque capacity is too large", line, column);
    }
    if (p->head == 0) {
        p->items = ncr_reallocate(p->items, (size_t)capacity * sizeof(@ELEMENT@), line, column);
        p->capacity = (int32_t)capacity;
        return;
    }
    @ELEMENT@ *items = ncr_allocate_raw((size_t)capacity * sizeof(@ELEMENT@), line, column);
    int32_t first = p->capacity - p->head;
    if (first > p->length) { first = p->length; }
    if (first > 0) {
        memcpy(items, p->items + p->head, (size_t)first * sizeof(@ELEMENT@));
    }
    if (p->length > first) {
        int32_t second = p->length - first;
        memcpy(items + first, p->items, (size_t)second * sizeof(@ELEMENT@));
    }
    /* The two spans relocate each owner once; the old slots are never dropped. */
    ncr_deallocate(p->items);
    p->items = items;
    p->head = 0;
    p->capacity = (int32_t)capacity;
}
static inline void ncr_deque_check_@ID@(ncr_obj_@ID@ *p, int32_t index, size_t line, size_t column) {
    if (__builtin_expect(index < 0 || index >= p->length, 0)) { ncr_fail("Deque index out of bounds", line, column); }
}
static void @DEQUE_NEW@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    p->items = NULL;
    p->head = 0;
    p->length = 0;
    p->capacity = 0;
}
static inline void @DEQUE_PUSH_FRONT@(ncr_obj_@ID@ *p, @ELEMENT@ value, size_t line, size_t column) {
    if (__builtin_expect(p->length >= p->capacity, 0)) {
        if (__builtin_expect(p->length == INT32_MAX, 0)) { ncr_fail("Deque is full", line, column); }
        ncr_deque_reserve_@ID@(p, p->length + 1, line, column);
    }
    p->head = p->head == 0 ? p->capacity - 1 : p->head - 1;
    p->items[p->head] = value;
    ++p->length;
}
static inline void @DEQUE_PUSH_BACK@(ncr_obj_@ID@ *p, @ELEMENT@ value, size_t line, size_t column) {
    if (__builtin_expect(p->length >= p->capacity, 0)) {
        if (__builtin_expect(p->length == INT32_MAX, 0)) { ncr_fail("Deque is full", line, column); }
        ncr_deque_reserve_@ID@(p, p->length + 1, line, column);
    }
    int32_t physical = ncr_deque_physical_@ID@(p, p->length);
    p->items[physical] = value;
    ++p->length;
}
static @ELEMENT@ @DEQUE_POP_FRONT@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    if (p->length == 0) { ncr_fail("popFront from empty Deque", line, column); }
    @ELEMENT@ value = p->items[p->head];
    p->items[p->head] = @ZERO@;
    --p->length;
    if (p->length == 0) { p->head = 0; }
    else { p->head = p->head + 1 == p->capacity ? 0 : p->head + 1; }
    return value;
}
static @ELEMENT@ @DEQUE_POP_BACK@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    if (p->length == 0) { ncr_fail("popBack from empty Deque", line, column); }
    int32_t physical = ncr_deque_physical_@ID@(p, p->length - 1);
    @ELEMENT@ value = p->items[physical];
    p->items[physical] = @ZERO@;
    --p->length;
    if (p->length == 0) { p->head = 0; }
    return value;
}
static inline int32_t @DEQUE_SIZE@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->length;
}
static inline int32_t @DEQUE_CAPACITY@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->capacity;
}
static inline bool @DEQUE_IS_EMPTY@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->length == 0;
}
@GET_METHOD@
@BORROWED_GETTERS@
@TRY_GET_METHOD@
static inline void @DEQUE_SET@(ncr_obj_@ID@ *p, int32_t logical, @ELEMENT@ value, size_t line, size_t column) {
    ncr_deque_check_@ID@(p, logical, line, column);
    int32_t physical = ncr_deque_physical_@ID@(p, logical);
    @DROP_AT_INDEX@
    p->items[physical] = value;
}
@TRY_POP_METHODS@
static void @DEQUE_CLEAR@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    while (p->length > 0) {
        int32_t logical = --p->length;
        int32_t physical = ncr_deque_physical_@ID@(p, logical);
        @DROP_AT_INDEX@
        p->items[physical] = @ZERO@;
    }
    p->head = 0;
}
static void @DEQUE_RESERVE@(ncr_obj_@ID@ *p, int32_t capacity, size_t line, size_t column) {
    ncr_deque_reserve_@ID@(p, capacity, line, column);
}
