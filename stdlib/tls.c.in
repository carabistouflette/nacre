        ncr_v_@SERVER_CLIENT_AUTH_CA_ID@->text, ncr_line, ncr_column);
    if (ca_path == NULL) {
        ncr_drop_@CERTIFICATE_ID@(ncr_v_@SERVER_CLIENT_AUTH_CERT_ID@);
