    if (config == NULL) { NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.server", failure, ncr_line, ncr_column); }
    if (!ncr_tls_config_set_identity(config, &failure)) {
        ncr_drop_@TLS_CONFIG_ID@(config);
        NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.server identity", failure, ncr_line, ncr_column);
    }
    return (ncr_obj_@CONFIG_RESULT_ID@){ .tag = @CONFIG_OK_TAG@, .data.v@CONFIG_OK_TAG@.f0 = config };
}
/* TLS_GROUP_END config_server */

/* TLS_GROUP config_server_with_client_auth */
static ncr_obj_@CONFIG_RESULT_ID@ @TLS_CONFIG_SERVER_WITH_CLIENT_AUTH_FN@(
    ncr_obj_@CERTIFICATE_ID@ *ncr_v_@SERVER_CLIENT_AUTH_CERT_ID@,
