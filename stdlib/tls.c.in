/* nacre-link: ssl */
#include <openssl/ssl.h>
#include <openssl/err.h>
#include <openssl/x509.h>
#include <openssl/x509v3.h>
#include <arpa/inet.h>
#include <errno.h>
#include <limits.h>
#include <poll.h>
#include <signal.h>
#include <pthread.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <sys/socket.h>
#include <time.h>
#include <unistd.h>

/* TLS_GROUP common */
static size_t ncr_tls_format_error(char *message, size_t capacity, const char *operation, int failure) {
    int written = snprintf(message, capacity, "%s failed (code=%d)", operation, failure);
    if (written < 0) { if (capacity != 0) { message[0] = '\0'; } return 0; }
    return (size_t)written < capacity ? (size_t)written : capacity - 1;
}

static size_t ncr_tls_format_timeout(char *message, size_t capacity, const char *operation) {
    int written = snprintf(message, capacity, "%s timed out", operation);
    if (written < 0) { if (capacity != 0) { message[0] = '\0'; } return 0; }
    return (size_t)written < capacity ? (size_t)written : capacity - 1;
}

#define NCR_TLS_RETURN_ERROR(result_id, operation, failure, line, column) do { \
    char ncr_tls_message[192]; \
    size_t ncr_tls_length = ncr_tls_format_error(ncr_tls_message, sizeof(ncr_tls_message), operation, failure); \
    return ncr_result_error_ ## result_id(ncr_tls_message, ncr_tls_length, line, column); \
} while (0)
#define NCR_TLS_RETURN_TIMEOUT(result_id, operation, line, column) do { \
    char ncr_tls_message[160]; \
    size_t ncr_tls_length = ncr_tls_format_timeout(ncr_tls_message, sizeof(ncr_tls_message), operation); \
    return ncr_result_error_ ## result_id(ncr_tls_message, ncr_tls_length, line, column); \
} while (0)
/* TLS_GROUP_END common */
/* TLS_GROUP ssl_release */
static void ncr_tls_ssl_release(void *ssl) {
    if (ssl != NULL) { SSL_free((SSL *)ssl); }
}
/* TLS_GROUP_END ssl_release */

/* TLS_GROUP config_drop */
static void ncr_tls_config_release(ncr_obj_@TLS_CONFIG_ID@ *config) {
    if (config == NULL) { return; }
    if (config->context != NULL) { SSL_CTX_free((SSL_CTX *)config->context); config->context = NULL; }
}
/* TLS_GROUP_END config_drop */

/* TLS_GROUP stream_drop */
static int ncr_tls_stream_release(ncr_obj_@TLS_STREAM_ID@ *stream) {
    if (stream == NULL) { return 0; }
    ncr_tls_ssl_release(stream->ssl);
    stream->ssl = NULL;
    if (stream->config != NULL) { ncr_drop_@CONFIG_MUTEX_ID@(stream->config); stream->config = NULL; }
    int descriptor = stream->fd;
    stream->fd = -1;
    if (descriptor >= 0 && close(descriptor) != 0) { return errno; }
    return 0;
}
/* TLS_GROUP_END stream_drop */

/* TLS_GROUP config_core */
static ncr_obj_@TLS_CONFIG_ID@ *ncr_tls_config_create(
    bool server, bool require_client_auth, bool system_trust, const char *ca_path,
    void *certificate, void *key, size_t line, size_t column, int *failure
) {
    ncr_obj_@TLS_CONFIG_ID@ *owner = ncr_allocate(sizeof(*owner), line, column);
    owner->context = NULL;
    owner->certificate = certificate;
    owner->key = key;
    owner->server = server;

    SSL_CTX *context = SSL_CTX_new(server ? TLS_server_method() : TLS_client_method());
    if (context == NULL) { *failure = EPROTO; goto failed; }
    owner->context = context;
    if (SSL_CTX_set_min_proto_version(context, TLS1_2_VERSION) != 1) { *failure = EPROTO; goto failed; }
    (void)SSL_CTX_set_options(context, SSL_OP_NO_COMPRESSION | SSL_OP_NO_RENEGOTIATION);
    (void)SSL_CTX_set_mode(context, SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER);

    if (ca_path != NULL && SSL_CTX_load_verify_locations(context, ca_path, NULL) != 1) {
        *failure = EACCES;
        goto failed;
    }
    if (!server && system_trust && SSL_CTX_set_default_verify_paths(context) != 1) {
        *failure = EACCES;
        goto failed;
    }
    if (server) {
        int verify = require_client_auth ? (SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT) : SSL_VERIFY_NONE;
        SSL_CTX_set_verify(context, verify, NULL);
    } else {
        SSL_CTX_set_verify(context, SSL_VERIFY_PEER, NULL);
    }
    return owner;

failed:
    ncr_drop_@TLS_CONFIG_ID@(owner);
    return NULL;
}
/* TLS_GROUP_END config_core */

/* TLS_GROUP config_identity */
static bool ncr_tls_config_set_identity(ncr_obj_@TLS_CONFIG_ID@ *config, int *failure) {
    ncr_obj_@CERTIFICATE_ID@ *certificate = config->certificate;
    ncr_obj_@CRYPTO_KEY_ID@ *key = config->key;
    if (certificate == NULL || certificate->certificate == NULL || key == NULL
        || key->pkey == NULL || !key->has_private) {
        *failure = EINVAL;
        return false;
    }
    SSL_CTX *context = (SSL_CTX *)config->context;
    if (SSL_CTX_use_certificate(context, (X509 *)certificate->certificate) != 1
        || SSL_CTX_use_PrivateKey(context, (EVP_PKEY *)key->pkey) != 1
        || SSL_CTX_check_private_key(context) != 1) {
        *failure = EINVAL;
        return false;
    }
    STACK_OF(X509) *chain = (STACK_OF(X509) *)certificate->chain;
    int chain_count = chain == NULL ? 0 : sk_X509_num(chain);
    for (int i = 0; i < chain_count; ++i) {
        X509 *item = sk_X509_value(chain, i);
        if (item == NULL || SSL_CTX_add1_chain_cert(context, item) != 1) {
            *failure = EINVAL;
            return false;
        }
    }
    return true;
}
/* TLS_GROUP_END config_identity */

/* TLS_GROUP config_client */
static ncr_obj_@CONFIG_RESULT_ID@ @TLS_CONFIG_CLIENT_FN@(size_t ncr_line, size_t ncr_column) {
    int failure = 0;
    ncr_obj_@TLS_CONFIG_ID@ *config = ncr_tls_config_create(false, false, true, NULL, NULL, NULL,
        ncr_line, ncr_column, &failure);
    if (config == NULL) { NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.client", failure, ncr_line, ncr_column); }
    return (ncr_obj_@CONFIG_RESULT_ID@){ .tag = @CONFIG_OK_TAG@, .data.v@CONFIG_OK_TAG@.f0 = config };
}
/* TLS_GROUP_END config_client */

/* TLS_GROUP config_client_with_ca */
static ncr_obj_@CONFIG_RESULT_ID@ @TLS_CONFIG_CLIENT_WITH_CA_FN@(
    ncr_obj_@PATH_ID@ *ncr_v_@CLIENT_WITH_CA_PATH_ID@, size_t ncr_line, size_t ncr_column) {
    int failure = 0;
    char *ca_path = ncr_fs_path_cstring_@TEXT_ID@(
        ncr_v_@CLIENT_WITH_CA_PATH_ID@->text, ncr_line, ncr_column);
    if (ca_path == NULL) {
        failure = errno == 0 ? EINVAL : errno;
        NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.clientWithCa path", failure, ncr_line, ncr_column);
    }
    ncr_obj_@TLS_CONFIG_ID@ *config = ncr_tls_config_create(false, false, false, ca_path, NULL, NULL,
        ncr_line, ncr_column, &failure);
    ncr_deallocate(ca_path);
    if (config == NULL) { NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.clientWithCa", failure, ncr_line, ncr_column); }
    return (ncr_obj_@CONFIG_RESULT_ID@){ .tag = @CONFIG_OK_TAG@, .data.v@CONFIG_OK_TAG@.f0 = config };
}
/* TLS_GROUP_END config_client_with_ca */

/* TLS_GROUP config_client_with_identity */
static ncr_obj_@CONFIG_RESULT_ID@ @TLS_CONFIG_CLIENT_WITH_IDENTITY_FN@(
    ncr_obj_@CERTIFICATE_ID@ *ncr_v_@CLIENT_WITH_IDENTITY_CERT_ID@,
    ncr_obj_@CRYPTO_KEY_ID@ *ncr_v_@CLIENT_WITH_IDENTITY_KEY_ID@,
    ncr_obj_@PATH_ID@ *ncr_v_@CLIENT_WITH_IDENTITY_CA_ID@,
    size_t ncr_line, size_t ncr_column) {
    int failure = 0;
    char *ca_path = ncr_fs_path_cstring_@TEXT_ID@(
        ncr_v_@CLIENT_WITH_IDENTITY_CA_ID@->text, ncr_line, ncr_column);
    if (ca_path == NULL) {
        ncr_drop_@CERTIFICATE_ID@(ncr_v_@CLIENT_WITH_IDENTITY_CERT_ID@);
        ncr_drop_@CRYPTO_KEY_ID@(ncr_v_@CLIENT_WITH_IDENTITY_KEY_ID@);
        failure = errno == 0 ? EINVAL : errno;
        NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.clientWithIdentity path", failure, ncr_line, ncr_column);
    }
    ncr_obj_@TLS_CONFIG_ID@ *config = ncr_tls_config_create(false, false, false, ca_path,
        ncr_v_@CLIENT_WITH_IDENTITY_CERT_ID@, ncr_v_@CLIENT_WITH_IDENTITY_KEY_ID@,
        ncr_line, ncr_column, &failure);
    ncr_deallocate(ca_path);
    if (config == NULL) { NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.clientWithIdentity", failure, ncr_line, ncr_column); }
    if (!ncr_tls_config_set_identity(config, &failure)) {
        ncr_drop_@TLS_CONFIG_ID@(config);
        NCR_TLS_RETURN_ERROR(@CONFIG_RESULT_ID@, "TlsConfig.clientWithIdentity identity", failure, ncr_line, ncr_column);
    }
    return (ncr_obj_@CONFIG_RESULT_ID@){ .tag = @CONFIG_OK_TAG@, .data.v@CONFIG_OK_TAG@.f0 = config };
}
/* TLS_GROUP_END config_client_with_identity */

/* TLS_GROUP config_server */
static ncr_obj_@CONFIG_RESULT_ID@ @TLS_CONFIG_SERVER_FN@(
    ncr_obj_@CERTIFICATE_ID@ *ncr_v_@SERVER_CERT_ID@,
    ncr_obj_@CRYPTO_KEY_ID@ *ncr_v_@SERVER_KEY_ID@,
