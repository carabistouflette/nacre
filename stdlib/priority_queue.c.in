/* Comparator-driven min-heap with affine element relocation. */
static int32_t ncr_priority_compare_@ID@(ncr_obj_@COMPARATOR_ID@ comparator,
                                        @COMPARE_TYPE@ left, @COMPARE_TYPE@ right) {
    return comparator.vtable->m@COMPARE_SLOT@(comparator.data, left, right);
}

static void ncr_priority_reserve_@ID@(ncr_obj_@ID@ *p, int32_t requested,
                                      size_t line, size_t column) {
    if (requested < 0) { ncr_fail("PriorityQueue capacity is too large", line, column); }
    if (requested <= p->capacity) { return; }
    int64_t capacity = p->capacity == 0 ? 4 : p->capacity;
    while (capacity < requested) {
        capacity = capacity > INT32_MAX / 2 ? INT32_MAX : capacity * 2;
    }
    if ((uint64_t)capacity > SIZE_MAX / sizeof(@ELEMENT@)) {
        ncr_fail("PriorityQueue capacity is too large", line, column);
    }
    @ELEMENT@ *items = ncr_allocate((size_t)capacity * sizeof(@ELEMENT@), line, column);
    if (p->length > 0) {
        memcpy(items, p->items, (size_t)p->length * sizeof(@ELEMENT@));
    }
    /* Raw relocation transfers owners; the old slots are not destroyed. */
    ncr_deallocate(p->items);
    p->items = items;
    p->capacity = (int32_t)capacity;
}

static void ncr_priority_sift_down_@ID@(ncr_obj_@ID@ *p, int32_t index) {
    while (index < p->length / 2) {
        int32_t child = index * 2 + 1;
        if (child + 1 < p->length &&
            ncr_priority_compare_@ID@(p->@COMPARATOR_FIELD@,
                @RIGHT_CHILD_KEY@, @LEFT_CHILD_KEY@) < 0) {
            ++child;
        }
        if (ncr_priority_compare_@ID@(p->@COMPARATOR_FIELD@,
                @CHILD_KEY@, @PARENT_KEY@) >= 0) { break; }
        @ELEMENT@ temporary = p->items[index];
        p->items[index] = p->items[child];
        p->items[child] = temporary;
        index = child;
    }
}

static @ELEMENT@ ncr_priority_pop_@ID@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    if (p->length == 0) { ncr_fail("pop from empty PriorityQueue", line, column); }
    @ELEMENT@ result = p->items[0];
    --p->length;
    if (p->length > 0) {
        p->items[0] = p->items[p->length];
        p->items[p->length] = @ZERO@;
        ncr_priority_sift_down_@ID@(p, 0);
    } else {
        p->items[0] = @ZERO@;
    }
    return result;
}

static void @PRIORITY_QUEUE_NEW@(ncr_obj_@ID@ *p, ncr_obj_@COMPARATOR_ID@ comparator,
                                 size_t line, size_t column) {
    (void)line; (void)column;
    p->items = NULL;
    p->length = 0;
    p->capacity = 0;
    p->@COMPARATOR_FIELD@ = comparator;
}

static void @PRIORITY_QUEUE_ADD@(ncr_obj_@ID@ *p, @ELEMENT@ value,
                                 size_t line, size_t column) {
    if (p->length == INT32_MAX) { ncr_fail("PriorityQueue is full", line, column); }
    ncr_priority_reserve_@ID@(p, p->length + 1, line, column);
    int32_t index = p->length++;
    p->items[index] = value;
    while (index > 0) {
        int32_t parent = (index - 1) / 2;
        if (ncr_priority_compare_@ID@(p->@COMPARATOR_FIELD@,
                @ITEM_KEY@, @PARENT_KEY_FOR_ADD@) >= 0) { break; }
        @ELEMENT@ temporary = p->items[index];
        p->items[index] = p->items[parent];
        p->items[parent] = temporary;
        index = parent;
    }
}

static @ELEMENT@ @PRIORITY_QUEUE_POP@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    return ncr_priority_pop_@ID@(p, line, column);
}

static @OPTION_TYPE@ @PRIORITY_QUEUE_TRY_POP@(ncr_obj_@ID@ *p,
                                               size_t line, size_t column) {
    if (p->length == 0) { return (@OPTION_TYPE@){ .tag = @NONE_TAG@ }; }
    @ELEMENT@ value = ncr_priority_pop_@ID@(p, line, column);
    return (@OPTION_TYPE@){ .tag = @SOME_TAG@, .data.v@SOME_TAG@.f0 = value };
}

@PEEK_METHOD@
@GET_REF_METHOD@
@TRY_PEEK_METHOD@

static int32_t @PRIORITY_QUEUE_SIZE@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->length;
}

static bool @PRIORITY_QUEUE_IS_EMPTY@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    return p->length == 0;
}

static void @PRIORITY_QUEUE_CLEAR@(ncr_obj_@ID@ *p, size_t line, size_t column) {
    (void)line; (void)column;
    while (p->length > 0) {
        int32_t index = --p->length;
        @DROP_AT_INDEX@
        p->items[index] = @ZERO@;
    }
}
