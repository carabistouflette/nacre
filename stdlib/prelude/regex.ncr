// PCRE2-8 uses UTF-8 and Unicode properties; patterns use PCRE2 syntax.
// Pattern and subject lengths are explicit, so embedded NUL is matched as text.
// matches anchors both ends; search follows PCRE2's leftmost-first semantics.
// Match, depth, or heap limit exhaustion returns Err instead of reporting no match.
class Regex {
    public static Result<Regex, Text> compile(borrow Text pattern) {}
    // matches is a full-subject match; search returns the first leftmost-first match.
    public readonly Result<boolean, Text> matches(borrow Text subject) {}
    public readonly Result<Option<RegexMatch>, Text> search(borrow Text subject) {}
}

// Captures are owned copies, independent of both Regex and subject lifetimes.
class RegexMatch {
    public readonly int groupCount() {}
    public readonly boolean hasGroup(int index) {}
    public readonly borrow Text group(int index) {}
    public readonly int start(int index) {}
    public readonly int end(int index) {}
}
