// Linux POSIX extended regular expressions only, not Java-compatible syntax.
// Compilation requires C.UTF-8 and returns Err if that locale is unavailable; no fallback is used.
// Patterns and subjects containing NUL are rejected rather than C-string truncated.
class Regex {
    public static Result<Regex, Text> compile(borrow Text pattern) {}
    // matches is a full-subject match; search returns POSIX's first leftmost-longest match.
    public readonly Result<boolean, Text> matches(borrow Text subject) {}
    public readonly Result<Option<RegexMatch>, Text> search(borrow Text subject) {}
}

// Captures are copied into this owner; group 0 is the whole match, offsets are byte-based and half-open.
class RegexMatch {
    public readonly int groupCount() {}
    public readonly boolean hasGroup(int index) {}
    public readonly borrow Text group(int index) {}
    public readonly int start(int index) {}
    public readonly int end(int index) {}
}
