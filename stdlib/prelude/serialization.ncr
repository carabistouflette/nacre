interface Codec<T> {
    Result<Unit, Text> encode(borrow T value, borrow mut BinaryWriter writer);
    Result<T, Text> decode(borrow mut BinaryReader reader);
}

class Serialization<T> {
    public static Result<ByteBuffer, Text> encode(borrow T value, borrow mut Codec<T> codec) {
        BinaryWriter writer = new BinaryWriter(0L, false);
        writer.writeByte((byte)78)?;
        writer.writeByte((byte)67)?;
        writer.writeByte((byte)82)?;
        writer.writeByte((byte)83)?;
        writer.writeByte((byte)1)?;
        codec.encode(value, writer)?;
        return new Result<ByteBuffer, Text>.Ok(BinaryWriter.finish(move(writer)));
    }

    public static Result<T, Text> decode(ByteBuffer input, borrow mut Codec<T> codec) {
        BinaryReader reader = new BinaryReader(input, false);
        byte first = reader.readByte()?;
        byte second = reader.readByte()?;
        byte third = reader.readByte()?;
        byte fourth = reader.readByte()?;
        byte version = reader.readByte()?;
        if (first != (byte)78 || second != (byte)67 || third != (byte)82 || fourth != (byte)83) {
            return new Result<T, Text>.Err(new Text("Serialization.decode: invalid magic"));
        }
        if (version != (byte)1) {
            return new Result<T, Text>.Err(new Text("Serialization.decode: unsupported version"));
        }

        T value = codec.decode(reader)?;
        if (reader.remaining() != 0L) {
            return new Result<T, Text>.Err(new Text("Serialization.decode: trailing input"));
        }
        return new Result<T, Text>.Ok(value);
    }
}

class ByteCodec implements Codec<byte> {
    public Result<Unit, Text> encode(byte value, borrow mut BinaryWriter writer) {
        return writer.writeByte(value);
    }
    public Result<byte, Text> decode(borrow mut BinaryReader reader) {
        return reader.readByte();
    }
}

class CharCodec implements Codec<char> {
    public Result<Unit, Text> encode(char value, borrow mut BinaryWriter writer) {
        return writer.writeInt32((int)value);
    }
    public Result<char, Text> decode(borrow mut BinaryReader reader) {
        int scalar = reader.readInt32()?;
        if (scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343)) {
            return new Result<char, Text>.Err(new Text("CharCodec.decode: invalid Unicode scalar"));
        }
        return new Result<char, Text>.Ok((char)scalar);
    }
}

class UnitCodec implements Codec<Unit> {
    public Result<Unit, Text> encode(Unit value, borrow mut BinaryWriter writer) {
        return new Result<Unit, Text>.Ok(());
    }
    public Result<Unit, Text> decode(borrow mut BinaryReader reader) {
        return new Result<Unit, Text>.Ok(());
    }
}

class IntCodec implements Codec<int> {
    public Result<Unit, Text> encode(int value, borrow mut BinaryWriter writer) {
        return writer.writeInt32(value);
    }
    public Result<int, Text> decode(borrow mut BinaryReader reader) {
        return reader.readInt32();
    }
}

class LongCodec implements Codec<long> {
    public Result<Unit, Text> encode(long value, borrow mut BinaryWriter writer) {
        return writer.writeInt64(value);
    }
    public Result<long, Text> decode(borrow mut BinaryReader reader) {
        return reader.readInt64();
    }
}

class DoubleCodec implements Codec<double> {
    public Result<Unit, Text> encode(double value, borrow mut BinaryWriter writer) {
        return writer.writeDouble(value);
    }
    public Result<double, Text> decode(borrow mut BinaryReader reader) {
        return reader.readDouble();
    }
}

class BooleanCodec implements Codec<boolean> {
    public Result<Unit, Text> encode(boolean value, borrow mut BinaryWriter writer) {
        byte encoded = (byte)0;
        if (value) { encoded = (byte)1; }
        return writer.writeByte(encoded);
    }
    public Result<boolean, Text> decode(borrow mut BinaryReader reader) {
        byte encoded = reader.readByte()?;
        if (encoded == (byte)0) { return new Result<boolean, Text>.Ok(false); }
        if (encoded == (byte)1) { return new Result<boolean, Text>.Ok(true); }
        return new Result<boolean, Text>.Err(new Text("BooleanCodec.decode: noncanonical boolean"));
    }
}

class TextCodec implements Codec<Text> {
    public Result<Unit, Text> encode(borrow Text value, borrow mut BinaryWriter writer) {
        int length = value.byteLength();
        writer.writeInt32(length)?;
        return writer.writeUtf8(value);
    }
    public Result<Text, Text> decode(borrow mut BinaryReader reader) {
        int length = reader.readInt32()?;
        if (length < 0 || (long)length > reader.remaining()) {
            return new Result<Text, Text>.Err(new Text("TextCodec.decode: invalid or truncated length"));
        }
        return reader.readUtf8((long)length);
    }
}

class BytesCodec implements Codec<ByteBuffer> {
    public Result<Unit, Text> encode(borrow ByteBuffer value, borrow mut BinaryWriter writer) {
        long length = value.length();
        if (length > 2147483647L) {
            return new Result<Unit, Text>.Err(new Text("BytesCodec.encode: length exceeds signed 32-bit format"));
        }
        writer.writeInt32((int)length)?;
        return writer.writeBytes(value);
    }
    public Result<ByteBuffer, Text> decode(borrow mut BinaryReader reader) {
        int length = reader.readInt32()?;
        if (length < 0 || (long)length > reader.remaining()) {
            return new Result<ByteBuffer, Text>.Err(new Text("BytesCodec.decode: invalid or truncated length"));
        }
        return reader.readBytes((long)length);
    }
}

// Aggregate codecs own their child codecs. Calls mutate child state in wire order;
// errors do not roll back a child's state, so callers choose when to reuse a codec.
class ListCodec<T> implements Codec<List<T>> {
    private Codec<T> elementCodec;
    private int maxElements;
    public ListCodec(Codec<T> elementCodec, int maxElements) {
        this.elementCodec = elementCodec;
        this.maxElements = maxElements;
    }
    public Result<Unit, Text> encode(borrow List<T> value, borrow mut BinaryWriter writer) {
        int count = value.size();
        if (this.maxElements < 0) {
            return new Result<Unit, Text>.Err(new Text("ListCodec.encode: maxElements must be nonnegative"));
        }
        if (count > this.maxElements) {
            return new Result<Unit, Text>.Err(new Text("ListCodec.encode: element count exceeds maxElements"));
        }
        writer.writeInt32(count)?;
        for (borrow T element : value) {
            this.elementCodec.encode(element, writer)?;
        }
        return new Result<Unit, Text>.Ok(());
    }
    public Result<List<T>, Text> decode(borrow mut BinaryReader reader) {
        if (this.maxElements < 0) {
            return new Result<List<T>, Text>.Err(new Text("ListCodec.decode: maxElements must be nonnegative"));
        }
        int count = reader.readInt32()?;
        if (count < 0) {
            return new Result<List<T>, Text>.Err(new Text("ListCodec.decode: negative element count"));
        }
        if (count > this.maxElements) {
            return new Result<List<T>, Text>.Err(new Text("ListCodec.decode: element count exceeds maxElements"));
        }
        List<T> values = new List<T>();
        values.reserve(count);
        int index = 0;
        while (index < count) {
            match (this.elementCodec.decode(reader)) {
                Ok(value) { values.add(value); }
                Err(error) {
                    return new Result<List<T>, Text>.Err(error);
                }
            }
            index = index + 1;
        }
        return new Result<List<T>, Text>.Ok(values);
    }
}

class OptionCodec<T> implements Codec<Option<T>> {
    private Codec<T> valueCodec;
    public OptionCodec(Codec<T> valueCodec) {
        this.valueCodec = valueCodec;
    }
    public Result<Unit, Text> encode(borrow Option<T> value, borrow mut BinaryWriter writer) {
        match (value) {
            None { return writer.writeByte((byte)0); }
            Some(payload) {
                writer.writeByte((byte)1)?;
                return this.valueCodec.encode(payload, writer);
            }
        }
    }
    public Result<Option<T>, Text> decode(borrow mut BinaryReader reader) {
        byte tag = reader.readByte()?;
        if (tag == (byte)0) {
            return new Result<Option<T>, Text>.Ok(new Option<T>.None());
        }
        if (tag == (byte)1) {
            T payload = this.valueCodec.decode(reader)?;
            return new Result<Option<T>, Text>.Ok(new Option<T>.Some(payload));
        }
        return new Result<Option<T>, Text>.Err(new Text("OptionCodec.decode: invalid discriminant"));
    }
}

// ResultCodec encodes Ok with tag 0 and Err with tag 1.
class ResultCodec<T, E> implements Codec<Result<T, E>> {
    private Codec<T> okCodec;
    private Codec<E> errCodec;
    public ResultCodec(Codec<T> okCodec, Codec<E> errCodec) {
        this.okCodec = okCodec;
        this.errCodec = errCodec;
    }
    public Result<Unit, Text> encode(borrow Result<T, E> value, borrow mut BinaryWriter writer) {
        match (value) {
            Ok(payload) {
                writer.writeByte((byte)0)?;
                return this.okCodec.encode(payload, writer);
            }
            Err(payload) {
                writer.writeByte((byte)1)?;
                return this.errCodec.encode(payload, writer);
            }
        }
    }
    public Result<Result<T, E>, Text> decode(borrow mut BinaryReader reader) {
        byte tag = reader.readByte()?;
        if (tag == (byte)0) {
            T payload = this.okCodec.decode(reader)?;
            return new Result<Result<T, E>, Text>.Ok(new Result<T, E>.Ok(payload));
        }
        if (tag == (byte)1) {
            E payload = this.errCodec.decode(reader)?;
            return new Result<Result<T, E>, Text>.Ok(new Result<T, E>.Err(payload));
        }
        return new Result<Result<T, E>, Text>.Err(new Text("ResultCodec.decode: invalid discriminant"));
    }
}

class UuidCodec implements Codec<Uuid> {
    public Result<Unit, Text> encode(borrow Uuid value, borrow mut BinaryWriter writer) {
        // Write the UUID's canonical halves explicitly, independent of writer byte order.
        long most = value.mostSignificantBits();
        long least = value.leastSignificantBits();
        int index = 7;
        while (index >= 0) {
            writer.writeByte((byte)((most >> (index * 8)) & 255L))?;
            index = index - 1;
        }
        index = 7;
        while (index >= 0) {
            writer.writeByte((byte)((least >> (index * 8)) & 255L))?;
            index = index - 1;
        }
        return new Result<Unit, Text>.Ok(());
    }
    public Result<Uuid, Text> decode(borrow mut BinaryReader reader) {
        long most = 0L;
        long least = 0L;
        int index = 0;
        while (index < 8) {
            byte encoded = reader.readByte()?;
            most = (most << 8) | ((long)encoded & 255L);
            index = index + 1;
        }
        index = 0;
        while (index < 8) {
            byte encoded = reader.readByte()?;
            least = (least << 8) | ((long)encoded & 255L);
            index = index + 1;
        }
        return new Result<Uuid, Text>.Ok(Uuid.fromLongs(most, least));
    }
}
