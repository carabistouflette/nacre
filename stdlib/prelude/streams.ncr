// ByteSource and ByteSink are allocation-free interfaces; native implementations
// use their concrete object directly in the generated vtable.
interface ByteSource {
    // maxBytes == 0 returns zero without touching destination. For a positive
    // request, read blocks until bytes or EOF; zero means EOF. On Ok, exactly
    // the returned count is appended. An Err may follow physical source progress;
    // any bytes it already appended remain observable.
    Result<long, Text> read(borrow mut ByteBuffer destination, long maxBytes);
}

interface ByteSink {
    // A zero request returns zero. For a positive request, Ok returns a positive
    // count no larger than maxBytes. An Err may follow physical writes.
    Result<long, Text> write(borrow ByteBuffer source, long offset, long maxBytes);
    // Flush errors do not undo earlier writes or imply that they were not delivered.
    Result<Unit, Text> flush();
}

class StreamError {
    private Text message;
    private long sourceBytesRead;
    private long sinkBytesWritten;
    private Option<ByteBuffer> retainedBytes;
    private long confirmedOffset;

    public StreamError(Text message, long sourceBytesRead, long sinkBytesWritten,
        Option<ByteBuffer> retainedBytes, long confirmedOffset) {
        this.message = message;
        this.sourceBytesRead = sourceBytesRead;
        this.sinkBytesWritten = sinkBytesWritten;
        this.retainedBytes = retainedBytes;
        this.confirmedOffset = confirmedOffset;
    }
    public readonly borrow Text message() { return this.message; }
    public readonly long sourceBytesRead() { return this.sourceBytesRead; }
    public readonly long sinkBytesWritten() { return this.sinkBytesWritten; }
    public readonly long confirmedOffset() { return this.confirmedOffset; }
    public readonly borrow Option<ByteBuffer> retainedBytes() { return this.retainedBytes; }
}

class Streams {
    // Counts are confirmed logical progress; a failed transport call may have
    // advanced physically beyond them. Pending bytes are retained, not a retry
    // or rollback promise. Flush follows the sink contract, not peer delivery.
    public static Result<long, StreamError> copy(borrow mut ByteSource source, borrow mut ByteSink sink, long maxBytes, long bufferSize) {
        if (maxBytes < 0L || bufferSize <= 0L) {
            return new Result<long, StreamError>.Err(new StreamError(
                new Text("Streams.copy requires maxBytes >= 0 and bufferSize > 0"),
                0L, 0L, new Option<ByteBuffer>.None(), 0L));
        }
        if (maxBytes == 0L) {
            match (sink.flush()) {
                Err(error) {
                    return new Result<long, StreamError>.Err(new StreamError(
                        error, 0L, 0L, new Option<ByteBuffer>.None(), 0L));
                }
                Ok(unit) { return new Result<long, StreamError>.Ok(0L); }
            }
        }

        long chunkCapacity = bufferSize;
        if (chunkCapacity > maxBytes) { chunkCapacity = maxBytes; }
        ByteBuffer buffer;
        match (ByteBuffer.withCapacity(chunkCapacity)) {
            Err(error) {
                return new Result<long, StreamError>.Err(new StreamError(
                    error, 0L, 0L, new Option<ByteBuffer>.None(), 0L));
            }
            Ok(value) { buffer = value; }
        }

        long sourceBytesRead = 0L;
        long sinkBytesWritten = 0L;
        while (sourceBytesRead < maxBytes) {
            buffer.clear();
            long requested = maxBytes - sourceBytesRead;
            if (requested > chunkCapacity) { requested = chunkCapacity; }
            match (source.read(buffer, requested)) {
                Err(error) {
                    long appended = buffer.length();
                    if (appended <= requested) { sourceBytesRead = sourceBytesRead + appended; }
                    return new Result<long, StreamError>.Err(new StreamError(
                        error, sourceBytesRead, sinkBytesWritten,
                        new Option<ByteBuffer>.Some(buffer), 0L));
                }
                Ok(count) {
                    if (count < 0L || count > requested || buffer.length() != count) {
                        return new Result<long, StreamError>.Err(new StreamError(
                            new Text("ByteSource.read returned an invalid byte count"),
                            sourceBytesRead, sinkBytesWritten,
                            new Option<ByteBuffer>.Some(buffer), 0L));
                    }
                    if (count == 0L) { break; }
                    sourceBytesRead = sourceBytesRead + count;

                    long offset = 0L;
                    while (offset < count) {
                        match (sink.write(buffer, offset, count - offset)) {
                            Err(error) {
                                return new Result<long, StreamError>.Err(new StreamError(
                                    error, sourceBytesRead, sinkBytesWritten + offset,
                                    new Option<ByteBuffer>.Some(buffer), offset));
                            }
                            Ok(written) {
                                if (written <= 0L || written > count - offset) {
                                    return new Result<long, StreamError>.Err(new StreamError(
                                        new Text("ByteSink.write made no progress or returned an invalid byte count"),
                                        sourceBytesRead, sinkBytesWritten + offset,
                                        new Option<ByteBuffer>.Some(buffer), offset));
                                }
                                offset = offset + written;
                            }
                        }
                    }
                    sinkBytesWritten = sinkBytesWritten + offset;
                }
            }
        }
        match (sink.flush()) {
            Err(error) {
                return new Result<long, StreamError>.Err(new StreamError(
                    error, sourceBytesRead, sinkBytesWritten,
                    new Option<ByteBuffer>.None(), 0L));
            }
            Ok(unit) { return new Result<long, StreamError>.Ok(sinkBytesWritten); }
        }
    }

    // Returns the owned prefix at maxBytes without probing. Errors retain it.
    public static Result<ByteBuffer, StreamError> readUpTo(borrow mut ByteSource source, long maxBytes, long bufferSize) {
        if (maxBytes < 0L || bufferSize <= 0L) {
            return new Result<ByteBuffer, StreamError>.Err(new StreamError(
                new Text("Streams.readUpTo requires maxBytes >= 0 and bufferSize > 0"),
                0L, 0L, new Option<ByteBuffer>.None(), 0L));
        }
        long chunkCapacity = bufferSize;
        if (chunkCapacity > maxBytes) { chunkCapacity = maxBytes; }
        ByteBuffer output;
        match (ByteBuffer.withCapacity(chunkCapacity)) {
            Err(error) {
                return new Result<ByteBuffer, StreamError>.Err(new StreamError(
                    error, 0L, 0L, new Option<ByteBuffer>.None(), 0L));
            }
            Ok(value) { output = value; }
        }

        long sourceBytesRead = 0L;
        while (output.length() < maxBytes) {
            long before = output.length();
            long requested = maxBytes - before;
            if (requested > chunkCapacity) { requested = chunkCapacity; }
            match (source.read(output, requested)) {
                Err(error) {
                    long appended = output.length() - before;
                    if (appended >= 0L && appended <= requested) {
                        sourceBytesRead = sourceBytesRead + appended;
                    }
                    return new Result<ByteBuffer, StreamError>.Err(new StreamError(
                        error, sourceBytesRead, 0L,
                        new Option<ByteBuffer>.Some(output), 0L));
                }
                Ok(count) {
                    long appended = output.length() - before;
                    if (count < 0L || count > requested || appended != count) {
                        return new Result<ByteBuffer, StreamError>.Err(new StreamError(
                            new Text("ByteSource.read returned an invalid byte count"),
                            sourceBytesRead, 0L,
                            new Option<ByteBuffer>.Some(output), 0L));
                    }
                    if (count == 0L) { break; }
                    sourceBytesRead = sourceBytesRead + count;
                }
            }
        }
        return new Result<ByteBuffer, StreamError>.Ok(output);
    }

    // Succeeds only at EOF. At the limit it consumes at most one probe byte;
    // the over-limit error retains that byte after the accumulated prefix.
    public static Result<ByteBuffer, StreamError> readAll(borrow mut ByteSource source, long maxBytes, long bufferSize) {
        ByteBuffer output = Streams.readUpTo(source, maxBytes, bufferSize)?;
        if (output.length() < maxBytes) { return new Result<ByteBuffer, StreamError>.Ok(output); }
        long sourceBytesRead = output.length();
        long before = output.length();
        match (source.read(output, 1L)) {
            Err(error) {
                long appended = output.length() - before;
                if (appended >= 0L && appended <= 1L) {
                    sourceBytesRead = sourceBytesRead + appended;
                }
                return new Result<ByteBuffer, StreamError>.Err(new StreamError(
                    error, sourceBytesRead, 0L,
                    new Option<ByteBuffer>.Some(output), 0L));
            }
            Ok(count) {
                long appended = output.length() - before;
                if (count < 0L || count > 1L || appended != count) {
                    return new Result<ByteBuffer, StreamError>.Err(new StreamError(
                        new Text("ByteSource.read returned an invalid byte count"),
                        sourceBytesRead, 0L,
                        new Option<ByteBuffer>.Some(output), 0L));
                }
                if (count == 0L) { return new Result<ByteBuffer, StreamError>.Ok(output); }
                return new Result<ByteBuffer, StreamError>.Err(new StreamError(
                    new Text("Streams.readAll: input exceeds maxBytes"),
                    sourceBytesRead + count, 0L,
                    new Option<ByteBuffer>.Some(output), 0L));
            }
        }
    }

    // source stays borrowed and owned by the caller; confirmedOffset is the
    // successful prefix, not a claim about physical progress during an Err.
    public static Result<Unit, StreamError> writeAll(borrow mut ByteSink sink, borrow ByteBuffer source) {
        long offset = 0L;
        long length = source.length();
        while (offset < length) {
            match (sink.write(source, offset, length - offset)) {
                Err(error) {
                    return new Result<Unit, StreamError>.Err(new StreamError(
                        error, 0L, offset, new Option<ByteBuffer>.None(), offset));
                }
                Ok(written) {
                    if (written <= 0L || written > length - offset) {
                        return new Result<Unit, StreamError>.Err(new StreamError(
                            new Text("ByteSink.write made no progress or returned an invalid byte count"),
                            0L, offset, new Option<ByteBuffer>.None(), offset));
                    }
                    offset = offset + written;
                }
            }
        }
        match (sink.flush()) {
            Err(error) {
                return new Result<Unit, StreamError>.Err(new StreamError(
                    error, 0L, offset, new Option<ByteBuffer>.None(), offset));
            }
            Ok(unit) { return new Result<Unit, StreamError>.Ok(()); }
        }
    }
}

class BinaryReader {
    public BinaryReader(ByteBuffer bytes, boolean littleEndian) {}
    public static Result<BinaryReader, Text> fromSource(ByteSource source, boolean littleEndian, long maxBytes) {}
    public readonly long position() {}
    public readonly long remaining() {}
    public Result<Unit, Text> seek(long position) {}
    public Result<byte, Text> readByte() {}
    public Result<int, Text> readInt16() {}
    public Result<int, Text> readInt32() {}
    public Result<long, Text> readInt64() {}
    public Result<double, Text> readDouble() {}
    public Result<double, Text> readFloat32() {}
    public Result<ByteBuffer, Text> readBytes(long length) {}
    public Result<Text, Text> readUtf8(long length) {}
}

class BinaryWriter {
    public BinaryWriter(long capacity, boolean littleEndian) {}
    public static Result<BinaryWriter, Text> toSink(ByteSink sink, boolean littleEndian, long maxBytes) {}
    public readonly long position() {}
    public readonly long pendingOffset() {}
    public Result<Unit, Text> writeByte(byte value) {}
    public Result<Unit, Text> writeInt16(int value) {}
    public Result<Unit, Text> writeInt32(int value) {}
    public Result<Unit, Text> writeInt64(long value) {}
    public Result<Unit, Text> writeDouble(double value) {}
    public Result<Unit, Text> writeFloat32(double value) {}
    public Result<Unit, Text> writeBytes(borrow ByteBuffer source) {}
    public Result<Unit, Text> writeUtf8(borrow Text value) {}
    public readonly borrow ByteBuffer bytes() {}
    public Result<Unit, Text> flush() {}
    public static ByteBuffer finish(BinaryWriter writer) {}
}

