class Path {
    public static Result<Path, Text> fromText(Text path) {}
    public readonly Path clone() {}
    public static Result<Path, Text> join(borrow Path base, borrow Path child) {}
    public readonly boolean isAbsolute() {}
    public readonly borrow Text asText() {}
}

class File implements ByteSource, ByteSink {
    public static Result<File, Text> openRead(borrow Path path) {}
    public static Result<File, Text> create(borrow Path path, int mode) {}
    public static Result<File, Text> openAppend(borrow Path path, int mode) {}
    public static Result<File, Text> openReadWrite(borrow Path path, int mode, boolean create) {}
    public Result<long, Text> readSome(borrow mut ByteBuffer destination, long maxBytes) {}
    public Result<long, Text> writeSome(borrow ByteBuffer source, long offset, long maxBytes) {}
    public Result<long, Text> read(borrow mut ByteBuffer destination, long maxBytes) {}
    public Result<long, Text> write(borrow ByteBuffer source, long offset, long maxBytes) {}
    public Result<Unit, Text> writeAll(borrow ByteBuffer source) {}
    public Result<long, Text> position() {}
    public Result<long, Text> seek(long offset, int origin) {}
    public Result<Unit, Text> truncate(long length) {}
    public Result<long, Text> readAt(borrow mut ByteBuffer destination, long fileOffset, long maxBytes) {}
    public Result<long, Text> writeAt(borrow ByteBuffer source, long bufferOffset, long fileOffset, long maxBytes) {}
    public Result<Unit, Text> flush() {}
    public Result<Unit, Text> close() {}
}

class Directory {
    public static Result<Directory, Text> open(borrow Path path) {}
    public Result<Option<Text>, Text> nextName() {}
    public Result<Unit, Text> close() {}
}

class FileInfo {
    public readonly long size() {}
    public readonly boolean isFile() {}
    public readonly boolean isDirectory() {}
    public readonly boolean isSymlink() {}
    public readonly long modifiedMillis() {}
    public readonly long accessedMillis() {}
    public readonly long changedMillis() {}
    public readonly int mode() {}
}

class Files {
    public static Result<Text, Text> readText(borrow Text path) {}
    public static Result<Unit, Text> writeText(borrow Text path, borrow Text content) {}
    public static Result<Unit, Text> writeTextAtomic(borrow Text path, borrow Text content) {}
    public static Result<FileInfo, Text> metadata(borrow Path path) {}
    public static Result<Unit, Text> createDirectory(borrow Path path, int mode) {}
    public static Result<Unit, Text> removeFile(borrow Path path) {}
    public static Result<Unit, Text> removeDirectory(borrow Path path) {}
    public static Result<Unit, Text> rename(borrow Path from, borrow Path to) {}
    public static Result<Unit, Text> copy(borrow Path source, borrow Path target, boolean replace) {}
    public static Result<Unit, Text> createDirectories(borrow Path path, int mode) {}
    public static Result<Path, Text> readLink(borrow Path path) {}
    public static Result<Unit, Text> symlink(borrow Path target, borrow Path link) {}
    public static Result<Unit, Text> chmod(borrow Path path, int mode) {}
    public static Result<List<Text>, Text> list(borrow Path path) {}
    public static Result<Path, Text> canonical(borrow Path path) {}
}

enum WatchKind {
    Created;
    Modified;
    AttributesChanged;
    ClosedForWrite;
    Deleted;
    MovedFrom;
    MovedTo;
    MovedSelf;
    DeletedSelf;
    Ignored;
    Overflow;
}

class Watcher {
    public static Result<Watcher, Text> open(borrow Path directory) {}
    public Result<Option<WatchEvent>, Text> next(long timeoutMillis) {}
    public Result<Unit, Text> close() {}
}

class WatchEvent {
    public readonly borrow Text name() {}
    public readonly WatchKind kind() {}
    public readonly long cookie() {}
    public readonly boolean isDirectory() {}
    public readonly boolean overflow() {}
}
