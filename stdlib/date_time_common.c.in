/* Shared ICU primitives used by DateTime and Temporal. */
/* nacre-link: icu */
#include <unicode/ucal.h>
#include <unicode/udat.h>
#include <unicode/uenum.h>
#include <unicode/uloc.h>
#include <unicode/ustring.h>
#include <unicode/utypes.h>

#define NCR_DT_MAX_EXACT_MILLIS INT64_C(9007199254740991)
#define NCR_DT_RESULT_ERROR(result_id, message, line, column) \
    ncr_result_error_##result_id((message), sizeof(message) - 1, (line), (column))

struct ncr_dt_fields {
    int32_t year;
    int32_t month;
    int32_t day;
    int32_t hour;
    int32_t minute;
    int32_t second;
    int32_t millisecond;
};

static bool ncr_dt_epoch_in_range(int64_t value) {
    return value >= -NCR_DT_MAX_EXACT_MILLIS && value <= NCR_DT_MAX_EXACT_MILLIS;
}

static bool ncr_dt_udate_to_epoch(UDate value, int64_t *result) {
    if (!isfinite(value) || value < -(double)NCR_DT_MAX_EXACT_MILLIS
        || value > (double)NCR_DT_MAX_EXACT_MILLIS || trunc(value) != value) {
        return false;
    }
    *result = (int64_t)value;
    return true;
}

static bool ncr_dt_utf8_to_uchar(
    const ncr_obj_@DATE_TIME_TEXT_ID@ *text,
    bool reject_nul,
    UChar **result,
    int32_t *result_length,
    size_t line,
    size_t column
) {
    size_t byte_length = (size_t)text->length;
    if (byte_length > (size_t)INT32_MAX || (reject_nul && byte_length > 0 && memchr(text->bytes, 0, byte_length) != NULL)) {
        return false;
    }

    UErrorCode status = U_ZERO_ERROR;
    int32_t required = 0;
    (void)u_strFromUTF8(NULL, 0, &required, (const char *)text->bytes,
        (int32_t)byte_length, &status);
    if (status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) {
        return false;
    }
    if (required < 0 || required == INT32_MAX || (size_t)required >= SIZE_MAX / sizeof(UChar)) {
        return false;
    }

    UChar *converted = ncr_allocate(((size_t)required + 1) * sizeof(UChar), line, column);
    status = U_ZERO_ERROR;
    int32_t written = 0;
    (void)u_strFromUTF8(converted, required + 1, &written, (const char *)text->bytes,
        (int32_t)byte_length, &status);
    if (U_FAILURE(status) || written < 0) {
        ncr_deallocate(converted);
        return false;
    }
    *result = converted;
    *result_length = written;
    return true;
}

static const char *ncr_dt_zone_id(
    const ncr_obj_@DATE_TIME_TEXT_ID@ *zone,
    UChar **result,
    int32_t *result_length,
    size_t line,
    size_t column
) {
    UChar *input = NULL;
    int32_t input_length = 0;
    if (!ncr_dt_utf8_to_uchar(zone, true, &input, &input_length, line, column)) {
        return "DateTime: timezone must be valid UTF-8 without NUL";
    }
    if (input_length == 0) {
        ncr_deallocate(input);
        return "DateTime: timezone must be a known IANA zone ID";
    }

    UErrorCode status = U_ZERO_ERROR;
    UBool is_system_id = false;
    int32_t capacity = 64;
    UChar *canonical = ncr_allocate((size_t)capacity * sizeof(UChar), line, column);
    int32_t written = ucal_getCanonicalTimeZoneID(
        input, input_length, canonical, capacity, &is_system_id, &status);
    if ((status == U_BUFFER_OVERFLOW_ERROR || status == U_STRING_NOT_TERMINATED_WARNING)
        && written > 0 && written < INT32_MAX) {
        ncr_deallocate(canonical);
        capacity = written + 1;
        canonical = ncr_allocate((size_t)capacity * sizeof(UChar), line, column);
        status = U_ZERO_ERROR;
        written = ucal_getCanonicalTimeZoneID(
            input, input_length, canonical, capacity, &is_system_id, &status);
    }
    ncr_deallocate(input);
    if (U_FAILURE(status) || !is_system_id || written <= 0 || written >= capacity) {
        ncr_deallocate(canonical);
        return "DateTime: timezone must be a known IANA zone ID";
    }
    *result = canonical;
    *result_length = written;
    return NULL;
}

static UCalendar *ncr_dt_open_calendar(
    const UChar *zone,
    int32_t zone_length,
    const char *locale,
    size_t line,
    size_t column
) {
    UErrorCode status = U_ZERO_ERROR;
    UCalendar *calendar = ucal_open(zone, zone_length, locale, UCAL_GREGORIAN, &status);
    if (U_FAILURE(status) || calendar == NULL) {
        if (calendar != NULL) { ucal_close(calendar); }
        return NULL;
    }
    /* Every supported epoch is after this cutover, so ICU uses Gregorian rules. */
    ucal_setGregorianChange(calendar, -9007199254740992.0, &status);
    if (U_FAILURE(status)) {
        ucal_close(calendar);
        return NULL;
    }
    ucal_setAttribute(calendar, UCAL_LENIENT, false);
    (void)line;
    (void)column;
    return calendar;
}

static bool ncr_dt_locale_available(const char *locale_id, size_t line, size_t column) {
    UErrorCode status = U_ZERO_ERROR;
    int32_t base_length = uloc_getBaseName(locale_id, NULL, 0, &status);
    if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) || base_length < 0
        || base_length == INT32_MAX) {
        return false;
    }
    char *base = ncr_allocate((size_t)base_length + 1, line, column);
    status = U_ZERO_ERROR;
    int32_t written = uloc_getBaseName(locale_id, base, base_length + 1, &status);
    if (U_FAILURE(status) || written != base_length) {
        ncr_deallocate(base);
        return false;
    }

    bool found = false;
    int32_t available = uloc_countAvailable();
    for (int32_t index = 0; index < available; ++index) {
        const char *candidate = uloc_getAvailable(index);
        if (candidate != NULL && strcmp(candidate, base) == 0) {
            found = true;
            break;
        }
    }
    ncr_deallocate(base);
    return found;
}

static const char *ncr_dt_locale_id(
    const ncr_obj_@DATE_TIME_TEXT_ID@ *locale,
    char **result,
    size_t line,
    size_t column
) {
    size_t length = (size_t)locale->length;
    if (length > 0 && memchr(locale->bytes, 0, length) != NULL) {
        return "DateTime: locale must be an installed BCP47 locale without NUL";
    }
    if (length == 0) {
        char *root = ncr_allocate(32, line, column);
        root[0] = '\0';
        UErrorCode status = U_ZERO_ERROR;
        int32_t written = uloc_setKeywordValue("calendar", "gregorian", root, 32, &status);
        if (U_FAILURE(status) || written >= 32) {
            ncr_deallocate(root);
            return "DateTime: ICU root locale initialization failed";
        }
        *result = root;
        return NULL;
    }
    for (size_t index = 0; index < length; ++index) {
        if (locale->bytes[index] > 0x7f) {
            return "DateTime: locale must be an installed BCP47 locale";
        }
    }
    if (length > (size_t)INT32_MAX - 64) {
        return "DateTime: locale tag is too large";
    }

    char *tag = ncr_allocate(length + 1, line, column);
    memcpy(tag, locale->bytes, length);
    tag[length] = '\0';
    UErrorCode status = U_ZERO_ERROR;
    int32_t parsed_length = 0;
    int32_t required = uloc_forLanguageTag(tag, NULL, 0, &parsed_length, &status);
    if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) || required < 0
        || required > INT32_MAX - 65) {
        ncr_deallocate(tag);
        return "DateTime: locale must be an installed BCP47 locale";
    }
    char *locale_id = ncr_allocate((size_t)required + 65, line, column);
    status = U_ZERO_ERROR;
    int32_t written = uloc_forLanguageTag(
        tag, locale_id, required + 65, &parsed_length, &status);
    ncr_deallocate(tag);
    if (U_FAILURE(status) || written != required || parsed_length != (int32_t)length
        || required == 0 || !ncr_dt_locale_available(locale_id, line, column)) {
        ncr_deallocate(locale_id);
        return "DateTime: locale must be an installed BCP47 locale";
    }

    status = U_ZERO_ERROR;
    written = uloc_setKeywordValue("calendar", "gregorian", locale_id, required + 65, &status);
    if (U_FAILURE(status) || written >= required + 65) {
        ncr_deallocate(locale_id);
        return "DateTime: ICU Gregorian locale initialization failed";
    }
    *result = locale_id;
    return NULL;
}

static bool ncr_dt_calendar_fields(UCalendar *calendar, struct ncr_dt_fields *fields) {
    UErrorCode status = U_ZERO_ERROR;
    fields->year = ucal_get(calendar, UCAL_EXTENDED_YEAR, &status);
    fields->month = ucal_get(calendar, UCAL_MONTH, &status);
    fields->day = ucal_get(calendar, UCAL_DATE, &status);
    fields->hour = ucal_get(calendar, UCAL_HOUR_OF_DAY, &status);
    fields->minute = ucal_get(calendar, UCAL_MINUTE, &status);
    fields->second = ucal_get(calendar, UCAL_SECOND, &status);
    fields->millisecond = ucal_get(calendar, UCAL_MILLISECOND, &status);
    return U_SUCCESS(status);
}

static void ncr_dt_set_wall_fields(
    UCalendar *calendar,
    int32_t year,
    int32_t month,
    int32_t day,
    int32_t hour,
    int32_t minute,
    int32_t second,
    int32_t millisecond,
    UCalendarWallTimeOption repeated,
    UCalendarWallTimeOption skipped
) {
    ucal_clear(calendar);
    ucal_setAttribute(calendar, UCAL_LENIENT, false);
    ucal_setAttribute(calendar, UCAL_REPEATED_WALL_TIME, repeated);
    ucal_setAttribute(calendar, UCAL_SKIPPED_WALL_TIME, skipped);
    ucal_set(calendar, UCAL_EXTENDED_YEAR, year);
    ucal_set(calendar, UCAL_MONTH, month - 1);
    ucal_set(calendar, UCAL_DATE, day);
    ucal_set(calendar, UCAL_HOUR_OF_DAY, hour);
    ucal_set(calendar, UCAL_MINUTE, minute);
    ucal_set(calendar, UCAL_SECOND, second);
    ucal_set(calendar, UCAL_MILLISECOND, millisecond);
}

static bool ncr_dt_wall_matches(
    UCalendar *calendar,
    int32_t year,
    int32_t month,
    int32_t day,
    int32_t hour,
    int32_t minute,
    int32_t second,
    int32_t millisecond
) {
    struct ncr_dt_fields actual;
    return ncr_dt_calendar_fields(calendar, &actual)
        && actual.year == year && actual.month + 1 == month && actual.day == day
        && actual.hour == hour && actual.minute == minute && actual.second == second
        && actual.millisecond == millisecond;
}

static bool ncr_dt_resolve_wall(
    UCalendar *calendar,
    int32_t year,
    int32_t month,
    int32_t day,
    int32_t hour,
    int32_t minute,
    int32_t second,
    int32_t millisecond,
    bool prefer_later,
    bool reject_overlap,
    int64_t *result
) {
    UCalendarWallTimeOption repeated = prefer_later ? UCAL_WALLTIME_LAST : UCAL_WALLTIME_FIRST;
    ncr_dt_set_wall_fields(calendar, year, month, day, hour, minute, second, millisecond,
        repeated, UCAL_WALLTIME_FIRST);
    UErrorCode status = U_ZERO_ERROR;
    UDate instant = ucal_getMillis(calendar, &status);
    int64_t epoch = 0;
    if (U_FAILURE(status) || !ncr_dt_wall_matches(calendar, year, month, day, hour, minute,
        second, millisecond) || !ncr_dt_udate_to_epoch(instant, &epoch)) {
        return false;
    }

    if (reject_overlap) {
        UCalendar *later = ucal_clone(calendar, &status);
        if (U_FAILURE(status) || later == NULL) {
            if (later != NULL) { ucal_close(later); }
            return false;
        }
        ncr_dt_set_wall_fields(later, year, month, day, hour, minute, second, millisecond,
            UCAL_WALLTIME_LAST, UCAL_WALLTIME_FIRST);
        status = U_ZERO_ERROR;
        UDate later_instant = ucal_getMillis(later, &status);
        ucal_close(later);
        if (U_FAILURE(status) || later_instant != instant) {
            return false;
        }
    }
    *result = epoch;
    return true;
}

static bool ncr_dt_days_in_month(int32_t year, int32_t month, int32_t *result) {
    static const int32_t month_lengths[12] = {
        31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
    };
    if (month < 1 || month > 12) { return false; }
    int32_t days = month_lengths[month - 1];
    if (month == 2 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)) {
        days = 29;
    }
    *result = days;
    return true;
}

static int64_t ncr_dt_gregorian_days_from_date(int64_t year, int32_t month, int32_t day) {
    year -= month <= 2;
    int64_t era = year >= 0 ? year / 400 : (year - 399) / 400;
    int64_t year_of_era = year - era * 400;
    int64_t month_adjusted = month + (month > 2 ? -3 : 9);
    int64_t day_of_year = (153 * month_adjusted + 2) / 5 + day - 1;
    int64_t day_of_era = year_of_era * 365 + year_of_era / 4
        - year_of_era / 100 + day_of_year;
    return era * 146097 + day_of_era - 719468;
}

static bool ncr_dt_gregorian_date_from_days(int64_t days, struct ncr_dt_fields *result) {
    int64_t shifted = days + 719468;
    int64_t era = shifted >= 0 ? shifted / 146097 : (shifted - 146096) / 146097;
    int64_t day_of_era = shifted - era * 146097;
    int64_t year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524
        - day_of_era / 146096) / 365;
    int64_t year = year_of_era + era * 400;
    int64_t day_of_year = day_of_era
        - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
    int64_t month_prime = (5 * day_of_year + 2) / 153;
    int64_t day = day_of_year - (153 * month_prime + 2) / 5 + 1;
    int64_t month = month_prime + (month_prime < 10 ? 3 : -9);
    year += month <= 2;
    if (year < INT32_MIN || year > INT32_MAX) { return false; }
    result->year = (int32_t)year;
    result->month = (int32_t)month - 1;
    result->day = (int32_t)day;
    return true;
}

static bool ncr_dt_pattern_valid(const UChar *pattern, int32_t length) {
    static const char fields[] = "GyYuUrQqMLlwWdDFgEecabBhHKkmsSAzZOvVXx";
    bool quoted = false;
    for (int32_t index = 0; index < length; ++index) {
        UChar value = pattern[index];
        if (value == '\'') {
            if (index + 1 < length && pattern[index + 1] == '\'') {
                ++index;
            } else {
                quoted = !quoted;
            }
        } else if (!quoted && ((value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z'))
                   && strchr(fields, (char)value) == NULL) {
            return false;
        }
    }
    return !quoted;
}

static UDateFormat *ncr_dt_open_formatter(
    const ncr_obj_@DATE_TIME_TEXT_ID@ *pattern_text,
    const ncr_obj_@DATE_TIME_TEXT_ID@ *zone_text,
    const ncr_obj_@DATE_TIME_TEXT_ID@ *locale_text,
    const char **failure,
    size_t line,
    size_t column
) {
    UChar *pattern = NULL;
    int32_t pattern_length = 0;
    if (!ncr_dt_utf8_to_uchar(pattern_text, true, &pattern, &pattern_length, line, column)
        || pattern_length == 0) {
        if (pattern != NULL) { ncr_deallocate(pattern); }
        *failure = "DateTime: pattern must be nonempty valid ICU pattern text without NUL";
        return NULL;
    }
    if (!ncr_dt_pattern_valid(pattern, pattern_length)) {
        ncr_deallocate(pattern);
        *failure = "DateTime: invalid ICU pattern field or unmatched quote";
        return NULL;
    }

    UChar *zone = NULL;
    int32_t zone_length = 0;
    const char *zone_failure = ncr_dt_zone_id(zone_text, &zone, &zone_length, line, column);
    if (zone_failure != NULL) {
        ncr_deallocate(pattern);
        *failure = zone_failure;
        return NULL;
    }

    char *locale = NULL;
    const char *locale_failure = ncr_dt_locale_id(locale_text, &locale, line, column);
    if (locale_failure != NULL) {
        ncr_deallocate(pattern);
        ncr_deallocate(zone);
        *failure = locale_failure;
        return NULL;
    }

    UCalendar *calendar = ncr_dt_open_calendar(zone, zone_length, locale, line, column);
    if (calendar == NULL) {
        ncr_deallocate(pattern);
        ncr_deallocate(zone);
        ncr_deallocate(locale);
        *failure = "DateTime: ICU Gregorian calendar initialization failed";
        return NULL;
    }
    UErrorCode status = U_ZERO_ERROR;
    UDateFormat *formatter = udat_open(UDAT_PATTERN, UDAT_PATTERN, locale,
        zone, zone_length, pattern, pattern_length, &status);
    ncr_deallocate(pattern);
    ncr_deallocate(zone);
    ncr_deallocate(locale);
    if (U_FAILURE(status) || formatter == NULL) {
        if (formatter != NULL) { udat_close(formatter); }
        ucal_close(calendar);
        *failure = "DateTime: invalid ICU pattern, locale, or timezone";
        return NULL;
    }
    status = U_ZERO_ERROR;
    ncr_dt_set_wall_fields(calendar, 1940, 1, 1, 0, 0, 0, 0,
        UCAL_WALLTIME_FIRST, UCAL_WALLTIME_NEXT_VALID);
    UDate century_start = ucal_getMillis(calendar, &status);
    if (U_FAILURE(status)) {
        ucal_close(calendar);
        udat_close(formatter);
        *failure = "DateTime: local two-digit year boundary could not be resolved";
        return NULL;
    }
    udat_setCalendar(formatter, calendar);
    ucal_close(calendar);
    udat_setLenient(formatter, false);
    status = U_ZERO_ERROR;
    udat_setBooleanAttribute(formatter, UDAT_PARSE_ALLOW_WHITESPACE, false, &status);
    udat_setBooleanAttribute(formatter, UDAT_PARSE_ALLOW_NUMERIC, false, &status);
    udat_setBooleanAttribute(formatter, UDAT_PARSE_PARTIAL_LITERAL_MATCH, false, &status);
    udat_setBooleanAttribute(formatter, UDAT_PARSE_MULTIPLE_PATTERNS_FOR_MATCH, false, &status);
    udat_set2DigitYearStart(formatter, century_start, &status);
    if (U_FAILURE(status)) {
        udat_close(formatter);
        *failure = "DateTime: ICU strict formatter initialization failed";
        return NULL;
    }
    return formatter;
}

static ncr_obj_@DATE_TIME_TEXT_ID@ *ncr_dt_text_from_uchar(
    const UChar *source,
    int32_t source_length,
    size_t line,
    size_t column
) {
    UErrorCode status = U_ZERO_ERROR;
    int32_t required = 0;
    (void)u_strToUTF8(NULL, 0, &required, source, source_length, &status);
    if ((status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status)) || required < 0
        || required == INT32_MAX) {
        return NULL;
    }
    unsigned char *bytes = required == 0 ? NULL : ncr_allocate((size_t)required, line, column);
    if (required > 0) {
        status = U_ZERO_ERROR;
        int32_t written = 0;
        (void)u_strToUTF8((char *)bytes, required, &written, source, source_length, &status);
        if (U_FAILURE(status) || written != required) {
            ncr_deallocate(bytes);
            return NULL;
        }
    }
    return @DATE_TIME_TEXT_TAKE@(bytes, (size_t)required, (size_t)required, line, column);
}

static bool ncr_dt_parse_candidate(
    const UDateFormat *formatter,
    const UChar *input,
    int32_t input_length,
    UCalendarWallTimeOption repeated,
    UCalendarWallTimeOption skipped,
    int64_t *result
) {
    UErrorCode status = U_ZERO_ERROR;
    UCalendar *calendar = ucal_clone(udat_getCalendar(formatter), &status);
    if (U_FAILURE(status) || calendar == NULL) {
        if (calendar != NULL) { ucal_close(calendar); }
        return false;
    }
    ncr_dt_set_wall_fields(calendar, 1970, 1, 1, 0, 0, 0, 0, repeated, skipped);
    int32_t parse_position = 0;
    status = U_ZERO_ERROR;
    udat_parseCalendar(formatter, calendar, input, input_length, &parse_position, &status);
    if (U_FAILURE(status) || parse_position != input_length) {
        ucal_close(calendar);
        return false;
    }
    status = U_ZERO_ERROR;
    UDate instant = ucal_getMillis(calendar, &status);
    ucal_close(calendar);
    return U_SUCCESS(status) && ncr_dt_udate_to_epoch(instant, result);
}

