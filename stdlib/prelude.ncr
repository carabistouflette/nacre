    public readonly int size() {}
    public readonly boolean isEmpty() {}
    public Option<V> put(int key, V value) {}
    public Option<V> tryRemove(int key) {}
    public readonly Option<V> tryGet(int key) {}
    public readonly borrow V getRef(int key) {}
    public borrow mut V getMut(int key) {}
