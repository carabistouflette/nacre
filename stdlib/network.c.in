}
/* NETWORK_GROUP_END stream */
/* NETWORK_GROUP udp */

static ncr_obj_@SOCKET_RESULT_TYPE@ @UDP_SOCKET_BIND@(ncr_obj_@ADDRESS_ID@ *ncr_v_@UDP_BIND_ADDRESS_ID@, size_t ncr_line, size_t ncr_column) {
    if (!ncr_network_valid_address(ncr_v_@UDP_BIND_ADDRESS_ID@)) {
        NCR_NETWORK_RETURN_ERROR(@UDP_BIND_RESULT_ID@, "UdpSocket.bind address", EAFNOSUPPORT, ncr_line, ncr_column);
    }
    int fd = socket(ncr_v_@UDP_BIND_ADDRESS_ID@->family, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
    if (fd < 0) { int failure = errno; NCR_NETWORK_RETURN_ERROR(@UDP_BIND_RESULT_ID@, "UdpSocket.bind socket", failure, ncr_line, ncr_column); }
    if (bind(fd, (const struct sockaddr *)&ncr_v_@UDP_BIND_ADDRESS_ID@->address, ncr_v_@UDP_BIND_ADDRESS_ID@->length) != 0) {
        int failure = errno;
        ncr_network_drop_fd(&fd);
        NCR_NETWORK_RETURN_ERROR(@UDP_BIND_RESULT_ID@, "UdpSocket.bind", failure, ncr_line, ncr_column);
    }
    ncr_obj_@UDP_SOCKET_ID@ *socket = ncr_allocate(sizeof(*socket), ncr_line, ncr_column);
    socket->fd = fd;
    return (ncr_obj_@SOCKET_RESULT_TYPE@){
        .tag = @UDP_SOCKET_RESULT_OK_TAG@,
        .data.v@UDP_SOCKET_RESULT_OK_TAG@.f0 = socket
    };
}

static ncr_obj_@LONG_RESULT_TYPE@ @UDP_SOCKET_SEND_TO@(ncr_obj_@UDP_SOCKET_ID@ *p, ncr_obj_@BUFFER_ID@ *ncr_v_@UDP_SEND_SOURCE_ID@, int64_t ncr_v_@UDP_SEND_OFFSET_ID@, int64_t ncr_v_@UDP_SEND_LENGTH_ID@, ncr_obj_@ADDRESS_ID@ *ncr_v_@UDP_SEND_DESTINATION_ID@, int64_t ncr_v_@UDP_SEND_TIMEOUT_ID@, size_t ncr_line, size_t ncr_column) {
    if (p->fd < 0) { NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo", EBADF, ncr_line, ncr_column); }
    if (ncr_v_@UDP_SEND_OFFSET_ID@ < 0 || ncr_v_@UDP_SEND_LENGTH_ID@ < 0
        || (uint64_t)ncr_v_@UDP_SEND_OFFSET_ID@ > (uint64_t)ncr_v_@UDP_SEND_SOURCE_ID@->length
        || (uint64_t)ncr_v_@UDP_SEND_LENGTH_ID@ > (uint64_t)ncr_v_@UDP_SEND_SOURCE_ID@->length - (uint64_t)ncr_v_@UDP_SEND_OFFSET_ID@) {
        NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo range", EINVAL, ncr_line, ncr_column);
    }
    if (!ncr_network_valid_address(ncr_v_@UDP_SEND_DESTINATION_ID@)) {
        NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo destination", EAFNOSUPPORT, ncr_line, ncr_column);
    }
    if (ncr_v_@UDP_SEND_TIMEOUT_ID@ < 0) { NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo timeout", EINVAL, ncr_line, ncr_column); }
    uint64_t length_value = (uint64_t)ncr_v_@UDP_SEND_LENGTH_ID@;
    if (length_value > (uint64_t)SIZE_MAX || length_value > (uint64_t)SSIZE_MAX) {
        NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo length", EOVERFLOW, ncr_line, ncr_column);
    }
    size_t length = (size_t)length_value;
    bool finite = false;
    int64_t deadline = 0;
    int failure = 0;
    if (!ncr_network_deadline(ncr_v_@UDP_SEND_TIMEOUT_ID@, &finite, &deadline, &failure)) {
        NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo timeout", failure, ncr_line, ncr_column);
    }
    const unsigned char *bytes = length == 0 ? NULL : ncr_v_@UDP_SEND_SOURCE_ID@->bytes + (size_t)ncr_v_@UDP_SEND_OFFSET_ID@;
    for (;;) {
        int ready = ncr_network_poll(p->fd, POLLOUT, finite, deadline, &failure);
        if (ready == 0) { NCR_NETWORK_RETURN_TIMEOUT(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo", ncr_line, ncr_column); }
        if (ready < 0) { NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo poll", failure, ncr_line, ncr_column); }
        ssize_t count = sendto(p->fd, bytes, length, 0,
            (const struct sockaddr *)&ncr_v_@UDP_SEND_DESTINATION_ID@->address, ncr_v_@UDP_SEND_DESTINATION_ID@->length);
        if (count >= 0) {
            if ((size_t)count != length) { NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo short datagram", EIO, ncr_line, ncr_column); }
            return (ncr_obj_@LONG_RESULT_ID@){.tag = @LONG_RESULT_OK_TAG@, .data.v@LONG_RESULT_OK_TAG@.f0 = (int64_t)count};
        }
        failure = errno;
        if (failure == EINTR || failure == EAGAIN || failure == EWOULDBLOCK) { continue; }
        NCR_NETWORK_RETURN_ERROR(@UDP_SEND_RESULT_ID@, "UdpSocket.sendTo", failure, ncr_line, ncr_column);
    }
}

static ncr_obj_@DATAGRAM_RESULT_TYPE@ @UDP_SOCKET_RECEIVE_FROM@(ncr_obj_@UDP_SOCKET_ID@ *p, ncr_obj_@BUFFER_ID@ *ncr_v_@UDP_RECEIVE_DESTINATION_ID@, int64_t ncr_v_@UDP_RECEIVE_MAX_ID@, int64_t ncr_v_@UDP_RECEIVE_TIMEOUT_ID@, size_t ncr_line, size_t ncr_column) {
    if (p->fd < 0) { NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom", EBADF, ncr_line, ncr_column); }
    if (ncr_v_@UDP_RECEIVE_MAX_ID@ < 0) { NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom maxBytes", EINVAL, ncr_line, ncr_column); }
    if (ncr_v_@UDP_RECEIVE_TIMEOUT_ID@ < 0) { NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom timeout", EINVAL, ncr_line, ncr_column); }
    uint64_t requested_value = (uint64_t)ncr_v_@UDP_RECEIVE_MAX_ID@;
    if (requested_value > (uint64_t)SIZE_MAX) { NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom maxBytes", EOVERFLOW, ncr_line, ncr_column); }
    if (requested_value > (uint64_t)SSIZE_MAX) { requested_value = (uint64_t)SSIZE_MAX; }
    size_t requested = (size_t)requested_value;
    if (requested > (size_t)INT64_MAX - ncr_v_@UDP_RECEIVE_DESTINATION_ID@->length
        || requested > SIZE_MAX - ncr_v_@UDP_RECEIVE_DESTINATION_ID@->length) {
        NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom buffer length", EOVERFLOW, ncr_line, ncr_column);
    }
    bool finite = false;
    int64_t deadline = 0;
    int failure = 0;
    if (!ncr_network_deadline(ncr_v_@UDP_RECEIVE_TIMEOUT_ID@, &finite, &deadline, &failure)) {
        NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom timeout", failure, ncr_line, ncr_column);
    }
    @BUFFER_RESERVE@(ncr_v_@UDP_RECEIVE_DESTINATION_ID@, ncr_v_@UDP_RECEIVE_DESTINATION_ID@->length + requested, ncr_line, ncr_column);
    for (;;) {
        int ready = ncr_network_poll(p->fd, POLLIN, finite, deadline, &failure);
        if (ready == 0) { NCR_NETWORK_RETURN_TIMEOUT(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom", ncr_line, ncr_column); }
        if (ready < 0) { NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom poll", failure, ncr_line, ncr_column); }
        struct sockaddr_storage source_storage;
        memset(&source_storage, 0, sizeof(source_storage));
        struct iovec vector = {
            .iov_base = requested == 0 ? NULL : ncr_v_@UDP_RECEIVE_DESTINATION_ID@->bytes + ncr_v_@UDP_RECEIVE_DESTINATION_ID@->length,
            .iov_len = requested
        };
        struct msghdr message;
        memset(&message, 0, sizeof(message));
        message.msg_name = &source_storage;
        message.msg_namelen = (socklen_t)sizeof(source_storage);
        message.msg_iov = &vector;
        message.msg_iovlen = 1;
        ssize_t count = recvmsg(p->fd, &message, MSG_TRUNC);
        if (count < 0) {
            failure = errno;
            if (failure == EINTR || failure == EAGAIN || failure == EWOULDBLOCK) { continue; }
            NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom", failure, ncr_line, ncr_column);
        }
        if ((uint64_t)count > (uint64_t)INT64_MAX) {
            NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom datagram length", EOVERFLOW, ncr_line, ncr_column);
        }
        ncr_obj_@ADDRESS_ID@ *source = ncr_allocate(sizeof(*source), ncr_line, ncr_column);
        if (!ncr_network_store_address(source, (const struct sockaddr *)&source_storage, message.msg_namelen)) {
            ncr_drop_@ADDRESS_ID@(source);
            NCR_NETWORK_RETURN_ERROR(@UDP_RECEIVE_RESULT_ID@, "UdpSocket.receiveFrom source", EAFNOSUPPORT, ncr_line, ncr_column);
        }
        size_t copied = (uint64_t)count > (uint64_t)requested ? requested : (size_t)count;
        ncr_v_@UDP_RECEIVE_DESTINATION_ID@->length += copied;
        ncr_obj_@DATAGRAM_ID@ *datagram = ncr_allocate(sizeof(*datagram), ncr_line, ncr_column);
        datagram->source = source;
        datagram->bytes_read = (int64_t)copied;
        datagram->truncated = (message.msg_flags & MSG_TRUNC) != 0 || (uint64_t)count > (uint64_t)requested;
        return (ncr_obj_@DATAGRAM_RESULT_TYPE@){
            .tag = @UDP_RECEIVE_RESULT_OK_TAG@,
            .data.v@UDP_RECEIVE_RESULT_OK_TAG@.f0 = datagram
        };
    }
}

static ncr_obj_@ADDRESS_RESULT_TYPE@ @UDP_SOCKET_LOCAL_ADDRESS@(ncr_obj_@UDP_SOCKET_ID@ *p, size_t ncr_line, size_t ncr_column) {
    return ncr_network_get_address(p->fd, false, "UdpSocket.localAddress", ncr_line, ncr_column);
}

