    (void)ncr_line; (void)ncr_column;
    return p->source;
}

static int64_t @DATAGRAM_BYTES_READ@(ncr_obj_@DATAGRAM_ID@ *p, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    return p->bytes_read;
}

static bool @DATAGRAM_TRUNCATED@(ncr_obj_@DATAGRAM_ID@ *p, size_t ncr_line, size_t ncr_column) {
    (void)ncr_line; (void)ncr_column;
    return p->truncated;
}
/* NETWORK_GROUP_END datagram */

#undef NCR_NETWORK_RETURN_ERROR
#undef NCR_NETWORK_RETURN_TIMEOUT
#undef NCR_NETWORK_RETURN_GAI
