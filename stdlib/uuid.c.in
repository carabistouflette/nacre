@UUID_CRYPTO_HEADERS@

static ncr_obj_@ID@ *ncr_uuid_new_@ID@(
    const unsigned char bytes[16], size_t line, size_t column
) {
    ncr_obj_@ID@ *uuid = ncr_allocate(sizeof(*uuid), line, column);
    memcpy(uuid->bytes, bytes, 16);
    return uuid;
}

static int ncr_uuid_hex_digit_@ID@(unsigned char byte) {
    if (byte >= '0' && byte <= '9') { return (int)(byte - '0'); }
    if (byte >= 'a' && byte <= 'f') { return (int)(byte - 'a') + 10; }
    if (byte >= 'A' && byte <= 'F') { return (int)(byte - 'A') + 10; }
    return -1;
}

static void ncr_uuid_store_long_@ID@(unsigned char bytes[8], int64_t value) {
    uint64_t bits;
    memcpy(&bits, &value, sizeof(bits));
    for (size_t index = 0; index < 8; ++index) {
        const unsigned int shift = (unsigned int)((7u - (unsigned int)index) * 8u);
        bytes[index] = (unsigned char)(bits >> shift);
    }
}

static int64_t ncr_uuid_load_long_@ID@(const unsigned char bytes[8]) {
    uint64_t bits = 0;
    for (size_t index = 0; index < 8; ++index) {
        bits = (bits << 8) | (uint64_t)bytes[index];
    }
    int64_t value;
    memcpy(&value, &bits, sizeof(value));
    return value;
}

static void ncr_uuid_version_variant_@ID@(unsigned char bytes[16], unsigned int version) {
    bytes[6] = (unsigned char)((bytes[6] & 0x0fu) | (unsigned char)(version << 4));
    bytes[8] = (unsigned char)((bytes[8] & 0x3fu) | 0x80u);
}

@UUID_CRYPTO_DIGEST_HELPER@

@UUID_PARSE_SIGNATURE@ {
    const unsigned char *input = @UUID_PARSE_TEXT@->bytes;
    if (@UUID_PARSE_TEXT@->length != 36) {
        static const char message[] = "Uuid.parse: expected canonical 36-byte UUID text";
        return @UUID_RESULT_ERROR@(message, sizeof(message) - 1, ncr_line, ncr_column);
    }

    static const size_t separators[] = { 8, 13, 18, 23 };
    unsigned char bytes[16];
    size_t input_index = 0;
    size_t output_index = 0;
    size_t separator_index = 0;
    while (input_index < 36) {
        if (separator_index < sizeof(separators) / sizeof(separators[0])
            && input_index == separators[separator_index]) {
            if (input[input_index] != '-') {
                static const char message[] = "Uuid.parse: invalid UUID separator";
                return @UUID_RESULT_ERROR@(message, sizeof(message) - 1, ncr_line, ncr_column);
            }
            ++separator_index;
            ++input_index;
            continue;
        }
        if (input_index + 1 >= 36) {
            static const char message[] = "Uuid.parse: invalid UUID hexadecimal field";
            return @UUID_RESULT_ERROR@(message, sizeof(message) - 1, ncr_line, ncr_column);
        }
        const int high = ncr_uuid_hex_digit_@ID@(input[input_index]);
        const int low = ncr_uuid_hex_digit_@ID@(input[input_index + 1]);
        if (high < 0 || low < 0 || output_index >= sizeof(bytes)) {
            static const char message[] = "Uuid.parse: invalid UUID hexadecimal field";
            return @UUID_RESULT_ERROR@(message, sizeof(message) - 1, ncr_line, ncr_column);
        }
        bytes[output_index++] = (unsigned char)(((unsigned int)high << 4) | (unsigned int)low);
        input_index += 2;
    }
    if (output_index != sizeof(bytes) || separator_index != sizeof(separators) / sizeof(separators[0])) {
        static const char message[] = "Uuid.parse: invalid UUID shape";
        return @UUID_RESULT_ERROR@(message, sizeof(message) - 1, ncr_line, ncr_column);
    }

    ncr_obj_@ID@ *uuid = ncr_uuid_new_@ID@(bytes, ncr_line, ncr_column);
    return (ncr_obj_@UUID_RESULT_ID@){ .tag = @UUID_OK_TAG@, .data.v@UUID_OK_TAG@.f0 = uuid };
}

@UUID_FROM_BYTES_SIGNATURE@ {
    if (@UUID_FROM_BYTES_BUFFER@->length != 16) {
        static const char message[] = "Uuid.fromBytes: expected exactly 16 network-order bytes";
        return @UUID_RESULT_ERROR@(message, sizeof(message) - 1, ncr_line, ncr_column);
    }
    ncr_obj_@ID@ *uuid = ncr_uuid_new_@ID@(@UUID_FROM_BYTES_BUFFER@->bytes, ncr_line, ncr_column);
    return (ncr_obj_@UUID_RESULT_ID@){ .tag = @UUID_OK_TAG@, .data.v@UUID_OK_TAG@.f0 = uuid };
}

@UUID_FROM_LONGS_SIGNATURE@ {
    ncr_obj_@ID@ *uuid = ncr_allocate(sizeof(*uuid), ncr_line, ncr_column);
    ncr_uuid_store_long_@ID@(uuid->bytes, @UUID_FROM_LONGS_MOST@);
    ncr_uuid_store_long_@ID@(uuid->bytes + 8, @UUID_FROM_LONGS_LEAST@);
    return uuid;
}

@UUID_RANDOM_SIGNATURE@ {
@UUID_RANDOM_BODY@
}

@UUID_NAME_MD5_SIGNATURE@ {
@UUID_NAME_MD5_BODY@
}

@UUID_NAME_SHA1_SIGNATURE@ {
@UUID_NAME_SHA1_BODY@
}

@UUID_CLONE_SIGNATURE@ {
    return ncr_uuid_new_@ID@(ncr_self->bytes, ncr_line, ncr_column);
}

@UUID_TO_TEXT_SIGNATURE@ {
    static const unsigned char digits[] = "0123456789abcdef";
    unsigned char text[36];
    size_t output_index = 0;
    for (size_t index = 0; index < 16; ++index) {
        if (index == 4 || index == 6 || index == 8 || index == 10) {
            text[output_index++] = '-';
        }
        text[output_index++] = digits[ncr_self->bytes[index] >> 4];
        text[output_index++] = digits[ncr_self->bytes[index] & 0x0fu];
    }
    return @TEXT_FROM_BYTES@(text, sizeof(text), ncr_line, ncr_column);
}

@UUID_TO_BYTES_SIGNATURE@ {
    ncr_obj_@BUFFER_RESULT_ID@ created = @BUFFER_FACTORY_FN@(INT64_C(16), ncr_line, ncr_column);
    if (created.tag != @BUFFER_OK_TAG@) {
        if (created.tag == @BUFFER_ERR_TAG@) {
            @BUFFER_DROP_TEXT@(created.data.v@BUFFER_ERR_TAG@.f0);
        }
        ncr_fail("Uuid.toBytes: ByteBuffer factory violated its fixed-capacity contract", ncr_line, ncr_column);
    }
    ncr_obj_@BUFFER_ID@ *bytes = created.data.v@BUFFER_OK_TAG@.f0;
    memcpy(bytes->bytes, ncr_self->bytes, 16);
    bytes->length = 16;
    return bytes;
}

@UUID_MOST_SIGNIFICANT_BITS_SIGNATURE@ {
    return ncr_uuid_load_long_@ID@(ncr_self->bytes);
}

@UUID_LEAST_SIGNIFICANT_BITS_SIGNATURE@ {
    return ncr_uuid_load_long_@ID@(ncr_self->bytes + 8);
}

@UUID_VERSION_SIGNATURE@ {
    return (int32_t)(ncr_self->bytes[6] >> 4);
}

@UUID_VARIANT_SIGNATURE@ {
    const unsigned char field = ncr_self->bytes[8];
    if ((field & 0x80u) == 0) { return 0; }
    if ((field & 0xc0u) == 0x80u) { return 2; }
    if ((field & 0xe0u) == 0xc0u) { return 6; }
    return 7;
}

@UUID_EQUALS_SIGNATURE@ {
    return memcmp(ncr_self->bytes, @UUID_EQUALS_OTHER@->bytes, 16) == 0;
}

@UUID_COMPARE_TO_SIGNATURE@ {
    for (size_t index = 0; index < 16; ++index) {
        const unsigned char left = ncr_self->bytes[index];
        const unsigned char right = @UUID_COMPARE_TO_OTHER@->bytes[index];
        if (left < right) { return -1; }
        if (left > right) { return 1; }
    }
    return 0;
}
