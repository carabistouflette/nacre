/* WEBSOCKET_GROUP standard_includes_1 */
#include <errno.h>
#include <limits.h>
/* WEBSOCKET_GROUP_END standard_includes_1 */
/* WEBSOCKET_GROUP ssl_includes */
#include <openssl/evp.h>
#include <openssl/rand.h>
#include <openssl/sha.h>
/* WEBSOCKET_GROUP_END ssl_includes */
/* WEBSOCKET_GROUP standard_includes_2 */
#include <poll.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>
/* WEBSOCKET_GROUP_END standard_includes_2 */

/* WEBSOCKET_GROUP constants */
#define NCR_WS_HEADER_LIMIT 16384U
#define NCR_WS_IO_CHUNK 4096U
#define NCR_WS_CLOSE_PAYLOAD_LIMIT 125U
/* WEBSOCKET_GROUP_END constants */

/* WEBSOCKET_GROUP connect_text */
static bool ncr_ws_bytes_equal_ascii_ci(const unsigned char *bytes, size_t length, const char *literal) {
    size_t literal_length = strlen(literal);
    if (length != literal_length) { return false; }
    for (size_t index = 0; index < length; ++index) {
        unsigned char left = bytes[index];
        unsigned char right = (unsigned char)literal[index];
        if (left >= (unsigned char)'A' && left <= (unsigned char)'Z') { left = (unsigned char)(left + ('a' - 'A')); }
        if (right >= (unsigned char)'A' && right <= (unsigned char)'Z') { right = (unsigned char)(right + ('a' - 'A')); }
        if (left != right) { return false; }
    }
    return true;
}

static bool ncr_ws_text_equals_ascii_ci(const ncr_obj_@TEXT_ID@ *text, const char *literal) {
    return text != NULL && text->length >= 0
        && ncr_ws_bytes_equal_ascii_ci(text->bytes, (size_t)text->length, literal);
}
/* WEBSOCKET_GROUP_END connect_text */
/* WEBSOCKET_GROUP utf8 */
static bool ncr_ws_valid_utf8(const unsigned char *bytes, size_t length) {
    return length == 0 || (bytes != NULL && @TEXT_UTF8_VALID@(bytes, length));
}
/* WEBSOCKET_GROUP_END utf8 */

/* WEBSOCKET_GROUP connect_uri */
static bool ncr_ws_token_byte(unsigned char byte) {
    if ((byte >= '0' && byte <= '9') || (byte >= 'A' && byte <= 'Z')
        || (byte >= 'a' && byte <= 'z')) { return true; }
    switch (byte) {
        case '!': case '#': case '$': case '%': case '&': case '\'': case '*': case '+':
        case '-': case '.': case '^': case '_': case '`': case '|': case '~':
            return true;
        default:
            return false;
    }
}

static bool ncr_ws_valid_uri_component(const ncr_obj_@TEXT_ID@ *text, bool require_origin_path) {
    if (text == NULL || text->length < 0 || (text->length > 0 && text->bytes == NULL)) { return false; }
    size_t length = (size_t)text->length;
    if (require_origin_path && length > 0 && text->bytes[0] != '/') { return false; }
    for (size_t index = 0; index < length; ++index) {
        unsigned char byte = text->bytes[index];
        if (byte <= 0x20U || byte >= 0x7fU) { return false; }
    }
    return true;
}

static bool ncr_ws_valid_host_bytes(const ncr_obj_@TEXT_ID@ *host, bool ipv6) {
    if (host == NULL || host->length <= 0 || host->bytes == NULL) { return false; }
    for (size_t index = 0; index < (size_t)host->length; ++index) {
        unsigned char byte = host->bytes[index];
        if (byte == 0 || byte <= 0x20U || byte >= 0x7fU || byte == '[' || byte == ']'
            || byte == '/' || byte == '?' || byte == '#' || byte == '@' || byte == '\\') { return false; }
        if (ipv6) {
            bool allowed = (byte >= '0' && byte <= '9') || (byte >= 'A' && byte <= 'F')
                || (byte >= 'a' && byte <= 'f') || byte == ':' || byte == '.' || byte == '%'
                || byte == '-' || byte == '_' || (byte >= 'g' && byte <= 'z') || (byte >= 'G' && byte <= 'Z');
            if (!allowed) { return false; }
        } else if (!((byte >= '0' && byte <= '9') || (byte >= 'A' && byte <= 'Z')
            || (byte >= 'a' && byte <= 'z') || byte == '.' || byte == '-')) {
            return false;
        }
    }
    return true;
}

static bool ncr_ws_format_authority(const ncr_obj_@TEXT_ID@ *host, bool ipv6, int32_t port,
    int32_t default_port, char *authority, size_t capacity, size_t *length) {
    if (!ncr_ws_valid_host_bytes(host, ipv6) || capacity == 0) { return false; }
    size_t at = 0;
    if (ipv6) {
        if (at >= capacity) { return false; }
        authority[at++] = '[';
    }
    size_t host_length = (size_t)host->length;
    if (host_length > capacity - at) { return false; }
    memcpy(authority + at, host->bytes, host_length);
    at += host_length;
    if (ipv6) {
        if (at >= capacity) { return false; }
        authority[at++] = ']';
    }
    if (port != default_port) {
        char service[6];
        int service_length = snprintf(service, sizeof(service), "%d", (int)port);
        if (service_length < 0 || (size_t)service_length >= sizeof(service)
            || (size_t)service_length + 1U > capacity - at) { return false; }
        authority[at++] = ':';
        memcpy(authority + at, service, (size_t)service_length);
        at += (size_t)service_length;
    }
    if (at >= capacity) { return false; }
    authority[at] = '\0';
    *length = at;
    return true;
}

static bool ncr_ws_make_key(char key[25], char expected_accept[29]) {
    unsigned char nonce[16];
    if (RAND_bytes(nonce, (int)sizeof(nonce)) != 1) { return false; }
    int key_length = EVP_EncodeBlock((unsigned char *)key, nonce, (int)sizeof(nonce));
    if (key_length != 24) { return false; }
    key[24] = '\0';
    static const unsigned char guid[] = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    unsigned char challenge[24U + sizeof(guid) - 1U];
    memcpy(challenge, key, 24U);
    memcpy(challenge + 24U, guid, sizeof(guid) - 1U);
    unsigned char digest[SHA_DIGEST_LENGTH];
    if (SHA1(challenge, sizeof(challenge), digest) == NULL) { return false; }
    int accept_length = EVP_EncodeBlock((unsigned char *)expected_accept, digest, (int)sizeof(digest));
    if (accept_length != 28) { return false; }
    expected_accept[28] = '\0';
    return true;
}
/* WEBSOCKET_GROUP_END connect_uri */

/* WEBSOCKET_GROUP transport_read */
static int ncr_ws_fill(@WEBSOCKET_TYPE@ ws, bool finite, int64_t deadline, bool *timed_out, int *failure) {
    ws->read_buffer_offset = 0;
    ws->read_buffer_length = 0;
    if (ws->fd < 0 || ws->closed) { *failure = EBADF; return -1; }
    if (ws->ssl != NULL) {
        @TLS_READ_BRANCH@
    }
    for (;;) {
        int ready = ncr_network_poll(ws->fd, POLLIN, finite, deadline, failure);
        if (ready == 0) { *timed_out = true; return 0; }
        if (ready < 0) { return -1; }
        ssize_t amount = recv(ws->fd, ws->read_buffer, sizeof(ws->read_buffer), 0);
        if (amount > 0) {
            ws->read_buffer_length = (size_t)amount;
            return 1;
        }
        if (amount == 0) { *failure = ECONNRESET; return -1; }
        if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) { continue; }
        *failure = errno;
        return -1;
    }
}

static int ncr_ws_read_some(@WEBSOCKET_TYPE@ ws, unsigned char *destination, size_t maximum,
    size_t *received, bool finite, int64_t deadline, bool *timed_out, int *failure) {
    *received = 0;
    if (maximum == 0) { return 1; }
    if (ws->read_buffer_offset == ws->read_buffer_length) {
        int status = ncr_ws_fill(ws, finite, deadline, timed_out, failure);
        if (status != 1) { return status; }
    }
    size_t available = ws->read_buffer_length - ws->read_buffer_offset;
    size_t amount = available < maximum ? available : maximum;
    memcpy(destination, ws->read_buffer + ws->read_buffer_offset, amount);
    ws->read_buffer_offset += amount;
    *received = amount;
    return 1;
}

static int ncr_ws_read_exact(@WEBSOCKET_TYPE@ ws, unsigned char *destination, size_t length,
    size_t *received, bool finite, int64_t deadline, bool *timed_out, int *failure) {
    *received = 0;
    while (*received < length) {
        size_t amount = 0;
        int status = ncr_ws_read_some(ws, destination + *received, length - *received,
            &amount, finite, deadline, timed_out, failure);
        if (status != 1) { return status; }
        if (amount == 0) { *failure = ECONNRESET; return -1; }
        *received += amount;
    }
    return 1;
}
/* WEBSOCKET_GROUP_END transport_read */

/* WEBSOCKET_GROUP transport_write */
static bool ncr_ws_write_all(@WEBSOCKET_TYPE@ ws, const unsigned char *source, size_t length,
    bool finite, int64_t deadline, bool *timed_out, int *failure) {
    size_t offset = 0;
    while (offset < length) {
        if (ws->fd < 0 || ws->closed) { *failure = EBADF; return false; }
        if (ws->ssl != NULL) {
            @TLS_WRITE_BRANCH@
        }
        int ready = ncr_network_poll(ws->fd, POLLOUT, finite, deadline, failure);
        if (ready == 0) { *timed_out = true; return false; }
        if (ready < 0) { return false; }
        ssize_t amount = send(ws->fd, source + offset, length - offset, MSG_NOSIGNAL);
        if (amount > 0) { offset += (size_t)amount; continue; }
        if (amount == 0) { *failure = EPIPE; return false; }
        if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) { continue; }
        *failure = errno;
        return false;
    }
    return true;
}
/* WEBSOCKET_GROUP_END transport_write */

/* WEBSOCKET_GROUP transport_frame */
static bool ncr_ws_send_frame(@WEBSOCKET_TYPE@ ws, unsigned char opcode, bool final,
    const unsigned char *payload, size_t length, bool finite, int64_t deadline,
    bool *timed_out, int *failure) {
    if (length > (size_t)INT64_MAX || (length > 0 && payload == NULL)) { *failure = EINVAL; return false; }
    unsigned char mask[4];
    if (RAND_bytes(mask, (int)sizeof(mask)) != 1) { *failure = EIO; return false; }
    unsigned char header[14];
    size_t header_length = 0;
    header[header_length++] = (unsigned char)((final ? 0x80U : 0U) | (opcode & 0x0fU));
    if (length <= 125U) {
        header[header_length++] = (unsigned char)(0x80U | (unsigned char)length);
    } else if (length <= UINT16_MAX) {
        header[header_length++] = 0xfeU;
        header[header_length++] = (unsigned char)(length >> 8);
        header[header_length++] = (unsigned char)length;
    } else {
        header[header_length++] = 0xffU;
        uint64_t wire_length = (uint64_t)length;
        for (int shift = 56; shift >= 0; shift -= 8) {
            header[header_length++] = (unsigned char)(wire_length >> (unsigned)shift);
        }
    }
    memcpy(header + header_length, mask, sizeof(mask));
    header_length += sizeof(mask);
    if (!ncr_ws_write_all(ws, header, header_length, finite, deadline, timed_out, failure)) { return false; }

    unsigned char masked[NCR_WS_IO_CHUNK];
    size_t offset = 0;
    while (offset < length) {
        size_t amount = length - offset;
        if (amount > sizeof(masked)) { amount = sizeof(masked); }
        for (size_t index = 0; index < amount; ++index) {
            masked[index] = payload[offset + index] ^ mask[(offset + index) & 3U];
        }
        if (!ncr_ws_write_all(ws, masked, amount, finite, deadline, timed_out, failure)) { return false; }
        offset += amount;
    }
    return true;
}
/* WEBSOCKET_GROUP_END transport_frame */

/* WEBSOCKET_GROUP http */
static bool ncr_ws_valid_http_field_name(const unsigned char *name, size_t length) {
    if (length == 0) { return false; }
    for (size_t index = 0; index < length; ++index) {
        if (!ncr_ws_token_byte(name[index])) { return false; }
    }
    return true;
}

static bool ncr_ws_header_contains_token(const unsigned char *value, size_t length,
    const char *required, bool *contains) {
    size_t offset = 0;
    *contains = false;
    while (offset < length) {
        size_t end = offset;
        while (end < length && value[end] != ',') { ++end; }
        size_t begin = offset;
        while (begin < end && (value[begin] == ' ' || value[begin] == '\t')) { ++begin; }
        while (end > begin && (value[end - 1U] == ' ' || value[end - 1U] == '\t')) { --end; }
        if (begin == end) { return false; }
        for (size_t index = begin; index < end; ++index) {
            if (!ncr_ws_token_byte(value[index])) { return false; }
        }
        if (ncr_ws_bytes_equal_ascii_ci(value + begin, end - begin, required)) { *contains = true; }
        offset = end;
        while (offset < length && value[offset] != ',') { ++offset; }
        if (offset < length) { ++offset; if (offset == length) { return false; } }
    }
    return length > 0;
}

static bool ncr_ws_validate_upgrade(const unsigned char *header, size_t length,
    const char expected_accept[29]) {
    size_t status_end = 0;
    while (status_end + 1U < length && !(header[status_end] == '\r' && header[status_end + 1U] == '\n')) { ++status_end; }
    if (status_end + 1U >= length || status_end < 12U
        || memcmp(header, "HTTP/1.1 101", 12U) != 0
        || (status_end > 12U && header[12] != ' ')) { return false; }
    for (size_t index = 0; index < status_end; ++index) {
        if ((header[index] < 0x20U && header[index] != '\t') || header[index] == 0x7fU) { return false; }
    }

    bool have_upgrade = false;
    bool have_connection = false;
    bool have_accept = false;
    size_t offset = status_end + 2U;
    while (offset + 1U < length) {
        size_t end = offset;
        while (end + 1U < length && !(header[end] == '\r' && header[end + 1U] == '\n')) { ++end; }
        if (end + 1U >= length) { return false; }
        size_t line_length = end - offset;
        if (line_length == 0) { return end + 2U == length && have_upgrade && have_connection && have_accept; }
        if (header[offset] == ' ' || header[offset] == '\t') { return false; }
        size_t colon = 0;
        while (colon < line_length && header[offset + colon] != ':') { ++colon; }
        if (colon == line_length || !ncr_ws_valid_http_field_name(header + offset, colon)) { return false; }
        size_t value_begin = colon + 1U;
        size_t value_end = line_length;
        while (value_begin < value_end && (header[offset + value_begin] == ' ' || header[offset + value_begin] == '\t')) { ++value_begin; }
        while (value_end > value_begin && (header[offset + value_end - 1U] == ' ' || header[offset + value_end - 1U] == '\t')) { --value_end; }
        for (size_t index = value_begin; index < value_end; ++index) {
            unsigned char byte = header[offset + index];
            if ((byte < 0x20U && byte != '\t') || byte == 0x7fU) { return false; }
        }
        const unsigned char *name = header + offset;
        const unsigned char *value = header + offset + value_begin;
        size_t value_length = value_end - value_begin;
        if (ncr_ws_bytes_equal_ascii_ci(name, colon, "upgrade")) {
            bool found = false;
            if (!ncr_ws_header_contains_token(value, value_length, "websocket", &found)) { return false; }
            have_upgrade = have_upgrade || found;
        } else if (ncr_ws_bytes_equal_ascii_ci(name, colon, "connection")) {
            bool found = false;
            if (!ncr_ws_header_contains_token(value, value_length, "upgrade", &found)) { return false; }
            have_connection = have_connection || found;
        } else if (ncr_ws_bytes_equal_ascii_ci(name, colon, "sec-websocket-accept")) {
            if (have_accept || value_length != 28U || memcmp(value, expected_accept, 28U) != 0) { return false; }
            have_accept = true;
        } else if (ncr_ws_bytes_equal_ascii_ci(name, colon, "sec-websocket-extensions")
            || ncr_ws_bytes_equal_ascii_ci(name, colon, "sec-websocket-protocol")) {
            return false;
        }
        offset = end + 2U;
    }
    return false;
}

static bool ncr_ws_http_handshake(@WEBSOCKET_TYPE@ ws, const ncr_obj_@TEXT_ID@ *path,
    const @OPTION_TEXT_TYPE@ *query, int32_t query_some_tag,
    const unsigned char *authority, size_t authority_length, const char key[25], const char expected_accept[29],
    bool finite, int64_t deadline, bool *timed_out, int *failure) {
    static const unsigned char get[] = "GET ";
    static const unsigned char query_mark = '?';
    static const unsigned char request_suffix[] = " HTTP/1.1\r\nHost: ";
    static const unsigned char request_headers[] =
        "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ";
    static const unsigned char request_version[] = "\r\nSec-WebSocket-Version: 13\r\n\r\n";
    if (!ncr_ws_write_all(ws, get, sizeof(get) - 1U, finite, deadline, timed_out, failure)) { return false; }
    if (path->length == 0) {
        static const unsigned char slash = '/';
        if (!ncr_ws_write_all(ws, &slash, 1U, finite, deadline, timed_out, failure)) { return false; }
    } else if (!ncr_ws_write_all(ws, path->bytes, (size_t)path->length, finite, deadline, timed_out, failure)) {
        return false;
    }
    if (query->tag == query_some_tag) {
        if (!ncr_ws_write_all(ws, &query_mark, 1U, finite, deadline, timed_out, failure)
            || !ncr_ws_write_all(ws, query->data.v@URI_TEXT_SOME_TAG@.f0->bytes,
                (size_t)query->data.v@URI_TEXT_SOME_TAG@.f0->length, finite, deadline, timed_out, failure)) { return false; }
    }
    if (!ncr_ws_write_all(ws, request_suffix, sizeof(request_suffix) - 1U, finite, deadline, timed_out, failure)
        || !ncr_ws_write_all(ws, authority, authority_length, finite, deadline, timed_out, failure)
        || !ncr_ws_write_all(ws, request_headers, sizeof(request_headers) - 1U, finite, deadline, timed_out, failure)
        || !ncr_ws_write_all(ws, (const unsigned char *)key, 24U, finite, deadline, timed_out, failure)
        || !ncr_ws_write_all(ws, request_version, sizeof(request_version) - 1U, finite, deadline, timed_out, failure)) { return false; }

    unsigned char response[NCR_WS_HEADER_LIMIT];
    size_t response_length = 0;
    bool complete = false;
    while (response_length < sizeof(response)) {
        size_t amount = 0;
        int status = ncr_ws_read_exact(ws, response + response_length, 1U, &amount,
            finite, deadline, timed_out, failure);
        if (status != 1 || amount != 1U) { return false; }
        ++response_length;
        if (response_length >= 4U && response[response_length - 4U] == '\r'
            && response[response_length - 3U] == '\n' && response[response_length - 2U] == '\r'
            && response[response_length - 1U] == '\n') {
            complete = true;
            break;
        }
    }
    return complete && ncr_ws_validate_upgrade(response, response_length, expected_accept);
}
/* WEBSOCKET_GROUP_END http */

/* WEBSOCKET_GROUP tls_shutdown */
static bool ncr_ws_tls_shutdown(@WEBSOCKET_TYPE@ ws, int64_t timeout_ms,
    bool *timed_out, int *failure) {
    (void)timeout_ms;
    (void)timed_out;
    if (ws->ssl == NULL) { return true; }
    @TLS_SHUTDOWN_BRANCH@
}
/* WEBSOCKET_GROUP_END tls_shutdown */

/* WEBSOCKET_GROUP cleanup */
static void ncr_ws_transport_cleanup(@WEBSOCKET_TYPE@ ws) {
    if (ws == NULL) { return; }
    if (ws->ssl != NULL) { ncr_tls_ssl_release(ws->ssl); ws->ssl = NULL; }
    @DROP_TLS_CONFIG@
    if (ws->fd >= 0) { int owned_fd = ws->fd; ws->fd = -1; (void)close(owned_fd); }
    ws->closed = true;
    ws->read_buffer_offset = 0;
    ws->read_buffer_length = 0;
}
/* WEBSOCKET_GROUP_END cleanup */

/* WEBSOCKET_GROUP close_core */
static bool ncr_ws_valid_close_code(int32_t code) {
    if (code >= 3000 && code <= 4999) { return true; }
    if (code < 1000 || code > 1014) { return false; }
    return code != 1004 && code != 1005 && code != 1006;
}

static int ncr_ws_finish_peer_close(@WEBSOCKET_TYPE@ ws, const unsigned char *payload,
    size_t length, int64_t timeout_ms, bool finite, int64_t deadline,
    bool *timed_out, int *failure) {
    if (!ws->closing) {
        if (!ncr_ws_send_frame(ws, 8U, true, payload, length, finite, deadline, timed_out, failure)) {
            ncr_ws_transport_cleanup(ws);
            return -1;
        }
    }
    if (!ncr_ws_tls_shutdown(ws, timeout_ms, timed_out, failure)) {
        ncr_ws_transport_cleanup(ws);
        return -1;
    }
    ncr_ws_transport_cleanup(ws);
    return 1;
}
/* WEBSOCKET_GROUP_END close_core */
/* WEBSOCKET_GROUP receive_core */
static @BUFFER_TYPE@ ncr_ws_new_accumulator(size_t line, size_t column) {
    @BUFFER_TYPE@ buffer = ncr_allocate(sizeof(*buffer), line, column);
    buffer->bytes = NULL;
    buffer->length = 0;
    buffer->capacity = 0;
    return buffer;
}

static void ncr_ws_drop_accumulator(@BUFFER_TYPE@ buffer) {
    if (buffer != NULL) { ncr_drop_@BUFFER_ID@(buffer); }
}

/* Returns 1 with an owned message, 2 after an orderly peer close, 0 on timeout, and -1 on error. */
static int ncr_ws_receive_inner(@WEBSOCKET_TYPE@ ws, int64_t timeout_ms,
    bool finite, int64_t deadline, @BUFFER_TYPE@ *message_body, bool *message_text,
    bool *timed_out, int *failure, size_t line, size_t column) {
    *message_body = NULL;
    *message_text = false;
    if (ws->closed || ws->fd < 0) { *failure = EBADF; return -1; }
    @BUFFER_TYPE@ accumulated = NULL;
    bool fragmented = false;

    for (;;) {
        unsigned char header[2];
        size_t header_bytes = 0;
        int status = ncr_ws_read_exact(ws, header, sizeof(header), &header_bytes,
            finite, deadline, timed_out, failure);
        if (status != 1) {
            if (status < 0 || header_bytes != 0 || fragmented) { ncr_ws_transport_cleanup(ws); }
            ncr_ws_drop_accumulator(accumulated);
            return status;
        }
        unsigned char first = header[0];
        unsigned char second = header[1];
        bool final = (first & 0x80U) != 0;
        unsigned char opcode = first & 0x0fU;
        if ((first & 0x70U) != 0 || (second & 0x80U) != 0) { goto protocol_error; }
        if (opcode != 0U && opcode != 1U && opcode != 2U && opcode != 8U && opcode != 9U && opcode != 10U) {
            goto protocol_error;
        }

        uint64_t payload_length = (uint64_t)(second & 0x7fU);
        if (payload_length == 126U) {
            unsigned char extended[2];
            size_t got = 0;
            status = ncr_ws_read_exact(ws, extended, sizeof(extended), &got, finite, deadline, timed_out, failure);
            if (status != 1) { ncr_ws_transport_cleanup(ws); ncr_ws_drop_accumulator(accumulated); return status; }
            payload_length = ((uint64_t)extended[0] << 8) | (uint64_t)extended[1];
            if (payload_length < 126U) { goto protocol_error; }
        } else if (payload_length == 127U) {
            unsigned char extended[8];
            size_t got = 0;
            status = ncr_ws_read_exact(ws, extended, sizeof(extended), &got, finite, deadline, timed_out, failure);
            if (status != 1) { ncr_ws_transport_cleanup(ws); ncr_ws_drop_accumulator(accumulated); return status; }
            if ((extended[0] & 0x80U) != 0) { goto protocol_error; }
            payload_length = 0;
            for (size_t index = 0; index < sizeof(extended); ++index) {
                payload_length = (payload_length << 8) | (uint64_t)extended[index];
            }
            if (payload_length <= UINT16_MAX) { goto protocol_error; }
        }
        if (payload_length > (uint64_t)SIZE_MAX || payload_length > (uint64_t)INT64_MAX) { goto protocol_error; }
        bool control = opcode >= 8U;
        if (control && (!final || payload_length > NCR_WS_CLOSE_PAYLOAD_LIMIT)) { goto protocol_error; }

        if (opcode == 8U || opcode == 9U || opcode == 10U) {
            unsigned char control_payload[NCR_WS_CLOSE_PAYLOAD_LIMIT];
            if (payload_length > 0) {
                size_t got = 0;
                status = ncr_ws_read_exact(ws, control_payload, (size_t)payload_length, &got,
                    finite, deadline, timed_out, failure);
                if (status != 1) { ncr_ws_transport_cleanup(ws); ncr_ws_drop_accumulator(accumulated); return status; }
            }
            if (opcode == 9U) {
                bool send_timed_out = false;
                if (!ncr_ws_send_frame(ws, 10U, true, control_payload, (size_t)payload_length,
                    finite, deadline, &send_timed_out, failure)) {
                    *timed_out = *timed_out || send_timed_out;
                    ncr_ws_transport_cleanup(ws);
                    ncr_ws_drop_accumulator(accumulated);
                    return -1;
                }
                continue;
            }
            if (opcode == 10U) { continue; }
            if (payload_length == 1U) { goto protocol_error; }
            if (payload_length >= 2U) {
                int32_t close_code = (int32_t)(((uint16_t)control_payload[0] << 8) | control_payload[1]);
                if (!ncr_ws_valid_close_code(close_code)
                    || !ncr_ws_valid_utf8(control_payload + 2U, (size_t)payload_length - 2U)) { goto protocol_error; }
            }
            int close_status = ncr_ws_finish_peer_close(ws, control_payload, (size_t)payload_length,
                timeout_ms, finite, deadline, timed_out, failure);
            ncr_ws_drop_accumulator(accumulated);
            return close_status == 1 ? 2 : -1;
        }

        if (opcode == 0U) {
            if (!fragmented) { goto protocol_error; }
        } else {
            if (fragmented || (opcode != 1U && opcode != 2U)) { goto protocol_error; }
            *message_text = opcode == 1U;
        }
        size_t accumulated_length = accumulated == NULL ? 0 : accumulated->length;
        if (payload_length > (uint64_t)(ws->max_message_bytes - accumulated_length)) { goto protocol_error; }
        if (accumulated == NULL) { accumulated = ncr_ws_new_accumulator(line, column); }
        size_t frame_length = (size_t)payload_length;
        size_t old_length = accumulated->length;
        size_t new_length = old_length + frame_length;
        if (frame_length > 0) {
            @BUFFER_RESERVE@(accumulated, new_length, line, column);
            size_t got = 0;
            status = ncr_ws_read_exact(ws, accumulated->bytes + old_length, frame_length, &got,
                finite, deadline, timed_out, failure);
            if (status != 1) { ncr_ws_transport_cleanup(ws); ncr_ws_drop_accumulator(accumulated); return status; }
        }
        accumulated->length = new_length;
        if (!final) {
            fragmented = true;
            continue;
        }
        if (opcode == 0U) { fragmented = false; }
        if (*message_text && !ncr_ws_valid_utf8(accumulated->bytes, accumulated->length)) { goto protocol_error; }
        *message_body = accumulated;
        return 1;

protocol_error:
        *failure = EPROTO;
        ncr_ws_transport_cleanup(ws);
        ncr_ws_drop_accumulator(accumulated);
        return -1;
    }
}
/* WEBSOCKET_GROUP_END receive_core */

/* WEBSOCKET_GROUP connect_core */
static @CONNECT_CORE_RESULT_TYPE@ ncr_ws_connect_impl(@URI_TYPE@ uri, int64_t timeout_ms,
    int64_t max_message_bytes, void *config, bool secure, size_t line, size_t column) {
    bool finite = false;
    int64_t deadline = 0;
    int failure = 0;
    bool timed_out = false;
    const char *error_message = "WebSocket connection failed";
    int connected_fd = -1;
    @WEBSOCKET_TYPE@ websocket = NULL;
    bool have_scheme = false, have_user_info = false, have_host = false, have_path = false;
    bool have_port = false, have_query = false, have_fragment = false;
    bool have_addresses = false;
    @OPTION_TEXT_TYPE@ scheme;
    @OPTION_TEXT_TYPE@ user_info;
    @OPTION_TEXT_TYPE@ host_option;
    @OPTION_TEXT_TYPE@ query;
    @OPTION_TEXT_TYPE@ fragment;
    @TEXT_TYPE@ path = NULL;
    @TEXT_TYPE@ idna_host = NULL;
    @TEXT_TYPE@ idna_error = NULL;
    @URI_PORT_RESULT_TYPE@ port_result;
    @DNS_RESOLVE_RESULT_TYPE@ addresses_result;
    (void)config;
    if (!ncr_network_deadline(timeout_ms, &finite, &deadline, &failure)) {
        error_message = "invalid WebSocket timeout";
        goto failed;
    }
    if (max_message_bytes < 0 || (uint64_t)max_message_bytes > (uint64_t)SIZE_MAX) {
        error_message = "invalid WebSocket message limit";
        goto failed;
    }

    scheme = @URI_SCHEME_FN@(uri, line, column); have_scheme = true;
    user_info = @URI_USER_INFO_FN@(uri, line, column); have_user_info = true;
    host_option = @URI_HOST_FN@(uri, line, column); have_host = true;
    path = @URI_PATH_FN@(uri, line, column); have_path = true;
    port_result = @URI_PORT_FN@(uri, line, column); have_port = true;
    query = @URI_QUERY_FN@(uri, line, column); have_query = true;
    fragment = @URI_FRAGMENT_FN@(uri, line, column); have_fragment = true;

    if (scheme.tag != @URI_TEXT_SOME_TAG@
        || !ncr_ws_text_equals_ascii_ci(scheme.data.v@URI_TEXT_SOME_TAG@.f0, secure ? "wss" : "ws")
        || user_info.tag == @URI_TEXT_SOME_TAG@ || fragment.tag == @URI_TEXT_SOME_TAG@
        || host_option.tag != @URI_TEXT_SOME_TAG@ || path == NULL) {
        error_message = "invalid WebSocket URI";
        goto failed;
    }
    @TEXT_TYPE@ host = host_option.data.v@URI_TEXT_SOME_TAG@.f0;
    bool query_valid = query.tag != @URI_TEXT_SOME_TAG@
        || ncr_ws_valid_uri_component(query.data.v@URI_TEXT_SOME_TAG@.f0, false);
    if (host == NULL || host->length <= 0 || host->bytes == NULL
        || !ncr_ws_valid_uri_component(path, true) || !query_valid) {
        error_message = "invalid WebSocket URI";
        goto failed;
    }
    if (port_result.tag != @URI_PORT_OK_TAG@) {
        error_message = "invalid WebSocket URI port";
        goto failed;
    }
    int32_t port = secure ? 443 : 80;
    @OPTION_PORT_TYPE@ port_option = port_result.data.v@URI_PORT_OK_TAG@.f0;
    if (port_option.tag == @URI_PORT_SOME_TAG@) { port = port_option.data.v@URI_PORT_SOME_TAG@.f0; }

    bool ipv6 = memchr(host->bytes, ':', (size_t)host->length) != NULL;
    @TEXT_TYPE@ connect_host = host;
    if (!ipv6) {
        if (!ncr_dns_idna_host(host, &idna_host, &idna_error, line, column)) {
            error_message = "WebSocket host resolution failed";
            goto failed;
        }
        connect_host = idna_host;
        if (connect_host == NULL || !ncr_ws_valid_host_bytes(connect_host, false)) {
            error_message = "invalid WebSocket host";
            goto failed;
        }
    } else if (!ncr_ws_valid_host_bytes(host, true)) {
        error_message = "invalid WebSocket host";
        goto failed;
    }

    char authority_bytes[1024];
    size_t authority_length = 0;
    if (!ncr_ws_format_authority(connect_host, ipv6, port, secure ? 443 : 80,
        authority_bytes, sizeof(authority_bytes), &authority_length)) {
        error_message = "invalid WebSocket authority";
        goto failed;
    }

    addresses_result = ncr_dns_resolve_host(connect_host, port, line, column); have_addresses = true;
    if (addresses_result.tag != @DNS_RESOLVE_OK_TAG@) {
        error_message = "WebSocket host resolution failed";
        goto failed;
    }
    @ADDRESS_LIST_TYPE@ addresses = addresses_result.data.v@DNS_RESOLVE_OK_TAG@.f0;
    if (addresses == NULL || addresses->length <= 0) {
        error_message = "WebSocket host resolution failed";
        goto failed;
    }
    for (int32_t index = 0; index < addresses->length; ++index) {
        connected_fd = ncr_network_connect(addresses->items[index], finite, deadline, &timed_out, &failure);
        if (connected_fd >= 0 || timed_out) { break; }
    }
    if (connected_fd < 0) {
        error_message = timed_out ? "WebSocket connection timed out" : "WebSocket connection failed";
        goto failed;
    }

    websocket = ncr_allocate(sizeof(*websocket), line, column);
    websocket->fd = connected_fd;
    connected_fd = -1;
    websocket->ssl = NULL;
    @INIT_TLS_CONFIG@
    websocket->closing = false;
    websocket->closed = false;
    websocket->max_message_bytes = (size_t)max_message_bytes;
    websocket->read_buffer_offset = 0;
    websocket->read_buffer_length = 0;
    @TLS_UPGRADE@

    char key[25];
    char expected_accept[29];
    if (!ncr_ws_make_key(key, expected_accept)) {
        error_message = "WebSocket handshake failed";
        goto failed;
    }
    if (!ncr_ws_http_handshake(websocket, path, &query, @URI_TEXT_SOME_TAG@,
        authority_bytes, authority_length, key, expected_accept, finite, deadline, &timed_out, &failure)) {
        error_message = timed_out ? "WebSocket handshake timed out" : "WebSocket handshake failed";
        goto failed;
    }

    if (have_scheme) { ncr_drop_@OPTION_TEXT_ID@(scheme); have_scheme = false; }
    if (have_user_info) { ncr_drop_@OPTION_TEXT_ID@(user_info); have_user_info = false; }
    if (have_host) { ncr_drop_@OPTION_TEXT_ID@(host_option); have_host = false; }
    if (have_path) { ncr_drop_@TEXT_ID@(path); have_path = false; }
    if (have_port) { ncr_drop_@URI_PORT_RESULT_ID@(port_result); have_port = false; }
    if (have_query) { ncr_drop_@OPTION_TEXT_ID@(query); have_query = false; }
    if (have_fragment) { ncr_drop_@OPTION_TEXT_ID@(fragment); have_fragment = false; }
    if (idna_host != NULL) { ncr_drop_@TEXT_ID@(idna_host); idna_host = NULL; }
    if (have_addresses) { ncr_drop_@DNS_RESOLVE_RESULT_ID@(addresses_result); have_addresses = false; }
    return (@CONNECT_CORE_RESULT_TYPE@){
        .tag = @CONNECT_CORE_OK_TAG@,
        .data.v@CONNECT_CORE_OK_TAG@.f0 = websocket
    };

failed:
    if (have_scheme) { ncr_drop_@OPTION_TEXT_ID@(scheme); }
    if (have_user_info) { ncr_drop_@OPTION_TEXT_ID@(user_info); }
    if (have_host) { ncr_drop_@OPTION_TEXT_ID@(host_option); }
    if (have_path) { ncr_drop_@TEXT_ID@(path); }
    if (have_port) { ncr_drop_@URI_PORT_RESULT_ID@(port_result); }
    if (have_query) { ncr_drop_@OPTION_TEXT_ID@(query); }
    if (have_fragment) { ncr_drop_@OPTION_TEXT_ID@(fragment); }
    if (idna_host != NULL) { ncr_drop_@TEXT_ID@(idna_host); }
    if (idna_error != NULL) { ncr_drop_@TEXT_ID@(idna_error); }
    if (have_addresses) { ncr_drop_@DNS_RESOLVE_RESULT_ID@(addresses_result); }
    @DROP_UNMOVED_TLS_CONFIG@
    if (websocket != NULL) { ncr_ws_transport_cleanup(websocket); ncr_deallocate(websocket); }
    if (connected_fd >= 0) { int owned_fd = connected_fd; connected_fd = -1; (void)close(owned_fd); }
    return ncr_result_error_@CONNECT_CORE_RESULT_ID@(error_message, strlen(error_message), line, column);
}
/* WEBSOCKET_GROUP_END connect_core */

/* WEBSOCKET_GROUP connect_method */
static @CONNECT_RESULT_TYPE@ @CONNECT_FN@(@CONNECT_URI_PARAM_TYPE@ @CONNECT_URI_ARG@,
    @CONNECT_TIMEOUT_PARAM_TYPE@ @CONNECT_TIMEOUT_ARG@, @CONNECT_MAX_MESSAGE_PARAM_TYPE@ @CONNECT_MAX_MESSAGE_ARG@,
    size_t line, size_t column) {
    return ncr_ws_connect_impl(@CONNECT_URI_ARG@, @CONNECT_TIMEOUT_ARG@, @CONNECT_MAX_MESSAGE_ARG@,
        NULL, false, line, column);
}
/* WEBSOCKET_GROUP_END connect_method */

/* WEBSOCKET_GROUP connect_tls_method */
static @CONNECT_TLS_RESULT_TYPE@ @CONNECT_TLS_FN@(@CONNECT_TLS_URI_PARAM_TYPE@ @CONNECT_TLS_URI_ARG@,
    @CONNECT_TLS_CONFIG_PARAM_TYPE@ @CONNECT_TLS_CONFIG_ARG@, @CONNECT_TLS_TIMEOUT_PARAM_TYPE@ @CONNECT_TLS_TIMEOUT_ARG@,
    @CONNECT_TLS_MAX_MESSAGE_PARAM_TYPE@ @CONNECT_TLS_MAX_MESSAGE_ARG@, size_t line, size_t column) {
    return ncr_ws_connect_impl(@CONNECT_TLS_URI_ARG@, @CONNECT_TLS_TIMEOUT_ARG@,
        @CONNECT_TLS_MAX_MESSAGE_ARG@, @CONNECT_TLS_CONFIG_ARG@, true, line, column);
}
/* WEBSOCKET_GROUP_END connect_tls_method */

/* WEBSOCKET_GROUP send_text_method */
static @SEND_TEXT_RESULT_TYPE@ @SEND_TEXT_FN@(@WEBSOCKET_SELF_TYPE@ ncr_self,
    @SEND_TEXT_PARAM_TYPE@ @SEND_TEXT_ARG@, @SEND_TEXT_TIMEOUT_PARAM_TYPE@ @SEND_TEXT_TIMEOUT_ARG@,
    size_t line, size_t column) {
    bool finite = false, timed_out = false;
    int64_t deadline = 0;
    int failure = 0;
    if (ncr_self->closed || ncr_self->closing || ncr_self->fd < 0) {
        return ncr_result_error_@SEND_TEXT_RESULT_ID@("WebSocket is closed", sizeof("WebSocket is closed") - 1U, line, column);
    }
    if (!ncr_network_deadline(@SEND_TEXT_TIMEOUT_ARG@, &finite, &deadline, &failure)) {
        return ncr_result_error_@SEND_TEXT_RESULT_ID@("invalid WebSocket timeout", sizeof("invalid WebSocket timeout") - 1U, line, column);
    }
    if (@SEND_TEXT_ARG@ == NULL || @SEND_TEXT_ARG@->length < 0
        || (@SEND_TEXT_ARG@->length > 0 && @SEND_TEXT_ARG@->bytes == NULL)) {
        return ncr_result_error_@SEND_TEXT_RESULT_ID@("invalid WebSocket text", sizeof("invalid WebSocket text") - 1U, line, column);
    }
    if (!ncr_ws_send_frame(ncr_self, 1U, true, @SEND_TEXT_ARG@->bytes, (size_t)@SEND_TEXT_ARG@->length,
        finite, deadline, &timed_out, &failure)) {
        ncr_ws_transport_cleanup(ncr_self);
        const char *error = timed_out ? "WebSocket send timed out" : "WebSocket send failed";
        return ncr_result_error_@SEND_TEXT_RESULT_ID@(error, strlen(error), line, column);
    }
    return (@SEND_TEXT_RESULT_TYPE@){ .tag = @SEND_TEXT_OK_TAG@, .data.v@SEND_TEXT_OK_TAG@.f0 = UINT8_C(0) };
}
/* WEBSOCKET_GROUP_END send_text_method */

/* WEBSOCKET_GROUP send_binary_method */
static @SEND_BINARY_RESULT_TYPE@ @SEND_BINARY_FN@(@WEBSOCKET_SELF_TYPE@ ncr_self,
    @SEND_BINARY_PARAM_TYPE@ @SEND_BINARY_ARG@, @SEND_BINARY_TIMEOUT_PARAM_TYPE@ @SEND_BINARY_TIMEOUT_ARG@,
    size_t line, size_t column) {
    bool finite = false, timed_out = false;
    int64_t deadline = 0;
    int failure = 0;
    if (ncr_self->closed || ncr_self->closing || ncr_self->fd < 0) {
        return ncr_result_error_@SEND_BINARY_RESULT_ID@("WebSocket is closed", sizeof("WebSocket is closed") - 1U, line, column);
    }
    if (!ncr_network_deadline(@SEND_BINARY_TIMEOUT_ARG@, &finite, &deadline, &failure)) {
        return ncr_result_error_@SEND_BINARY_RESULT_ID@("invalid WebSocket timeout", sizeof("invalid WebSocket timeout") - 1U, line, column);
    }
    if (@SEND_BINARY_ARG@ == NULL || @SEND_BINARY_ARG@->length > @SEND_BINARY_ARG@->capacity
        || (@SEND_BINARY_ARG@->length > 0 && @SEND_BINARY_ARG@->bytes == NULL)) {
        return ncr_result_error_@SEND_BINARY_RESULT_ID@("invalid WebSocket binary payload", sizeof("invalid WebSocket binary payload") - 1U, line, column);
    }
    if (!ncr_ws_send_frame(ncr_self, 2U, true, @SEND_BINARY_ARG@->bytes, @SEND_BINARY_ARG@->length,
        finite, deadline, &timed_out, &failure)) {
        ncr_ws_transport_cleanup(ncr_self);
        const char *error = timed_out ? "WebSocket send timed out" : "WebSocket send failed";
        return ncr_result_error_@SEND_BINARY_RESULT_ID@(error, strlen(error), line, column);
    }
    return (@SEND_BINARY_RESULT_TYPE@){ .tag = @SEND_BINARY_OK_TAG@, .data.v@SEND_BINARY_OK_TAG@.f0 = UINT8_C(0) };
}
/* WEBSOCKET_GROUP_END send_binary_method */

/* WEBSOCKET_GROUP ping_method */
static @PING_RESULT_TYPE@ @PING_FN@(@WEBSOCKET_SELF_TYPE@ ncr_self,
    @PING_PARAM_TYPE@ @PING_ARG@, @PING_TIMEOUT_PARAM_TYPE@ @PING_TIMEOUT_ARG@,
    size_t line, size_t column) {
    bool finite = false, timed_out = false;
    int64_t deadline = 0;
    int failure = 0;
    if (ncr_self->closed || ncr_self->closing || ncr_self->fd < 0) {
        return ncr_result_error_@PING_RESULT_ID@("WebSocket is closed", sizeof("WebSocket is closed") - 1U, line, column);
    }
    if (!ncr_network_deadline(@PING_TIMEOUT_ARG@, &finite, &deadline, &failure)) {
        return ncr_result_error_@PING_RESULT_ID@("invalid WebSocket timeout", sizeof("invalid WebSocket timeout") - 1U, line, column);
    }
    if (@PING_ARG@ == NULL || @PING_ARG@->length > @PING_ARG@->capacity
        || (@PING_ARG@->length > 0 && @PING_ARG@->bytes == NULL)
        || @PING_ARG@->length > NCR_WS_CLOSE_PAYLOAD_LIMIT) {
        return ncr_result_error_@PING_RESULT_ID@("invalid WebSocket ping payload", sizeof("invalid WebSocket ping payload") - 1U, line, column);
    }
    if (!ncr_ws_send_frame(ncr_self, 9U, true, @PING_ARG@->bytes, @PING_ARG@->length,
        finite, deadline, &timed_out, &failure)) {
        ncr_ws_transport_cleanup(ncr_self);
        const char *error = timed_out ? "WebSocket ping timed out" : "WebSocket ping failed";
        return ncr_result_error_@PING_RESULT_ID@(error, strlen(error), line, column);
    }
    return (@PING_RESULT_TYPE@){ .tag = @PING_OK_TAG@, .data.v@PING_OK_TAG@.f0 = UINT8_C(0) };
}
/* WEBSOCKET_GROUP_END ping_method */

/* WEBSOCKET_GROUP receive_method */
static @RECEIVE_RESULT_TYPE@ @RECEIVE_FN@(@WEBSOCKET_SELF_TYPE@ ncr_self,
    @RECEIVE_TIMEOUT_PARAM_TYPE@ @RECEIVE_TIMEOUT_ARG@, size_t line, size_t column) {
    bool finite = false, timed_out = false;
    int64_t deadline = 0;
    int failure = 0;
    if (ncr_self->closed || ncr_self->fd < 0) {
        return ncr_result_error_@RECEIVE_RESULT_ID@("WebSocket is closed", sizeof("WebSocket is closed") - 1U, line, column);
    }
    if (!ncr_network_deadline(@RECEIVE_TIMEOUT_ARG@, &finite, &deadline, &failure)) {
        return ncr_result_error_@RECEIVE_RESULT_ID@("invalid WebSocket timeout", sizeof("invalid WebSocket timeout") - 1U, line, column);
    }
    @BUFFER_TYPE@ message_body = NULL;
    bool message_text = false;
    int status = ncr_ws_receive_inner(ncr_self, @RECEIVE_TIMEOUT_ARG@, finite, deadline,
        &message_body, &message_text, &timed_out, &failure, line, column);
    if (status == 1) {
        @MESSAGE_TYPE@ message = ncr_allocate(sizeof(*message), line, column);
        message->is_text = message_text;
        message->body = message_body;
        @OPTION_MESSAGE_TYPE@ option = { .tag = @RECEIVE_SOME_TAG@, .data.v@RECEIVE_SOME_TAG@.f0 = message };
        return (@RECEIVE_RESULT_TYPE@){ .tag = @RECEIVE_OK_TAG@, .data.v@RECEIVE_OK_TAG@.f0 = option };
    }
    if (status == 2) {
        @OPTION_MESSAGE_TYPE@ option = { .tag = @RECEIVE_NONE_TAG@ };
        return (@RECEIVE_RESULT_TYPE@){ .tag = @RECEIVE_OK_TAG@, .data.v@RECEIVE_OK_TAG@.f0 = option };
    }
    const char *error = status == 0 || timed_out ? "WebSocket receive timed out" : "WebSocket receive failed";
    return ncr_result_error_@RECEIVE_RESULT_ID@(error, strlen(error), line, column);
}
/* WEBSOCKET_GROUP_END receive_method */

/* WEBSOCKET_GROUP close_method */
static @CLOSE_RESULT_TYPE@ @CLOSE_FN@(@WEBSOCKET_SELF_TYPE@ ncr_self,
    @CLOSE_CODE_PARAM_TYPE@ @CLOSE_CODE_ARG@, @CLOSE_REASON_PARAM_TYPE@ @CLOSE_REASON_ARG@,
    @CLOSE_TIMEOUT_PARAM_TYPE@ @CLOSE_TIMEOUT_ARG@, size_t line, size_t column) {
    bool finite = false, timed_out = false;
    int64_t deadline = 0;
    int failure = 0;
    if (ncr_self->closed || ncr_self->closing || ncr_self->fd < 0) {
        return ncr_result_error_@CLOSE_RESULT_ID@("WebSocket is closed", sizeof("WebSocket is closed") - 1U, line, column);
    }
    if (!ncr_network_deadline(@CLOSE_TIMEOUT_ARG@, &finite, &deadline, &failure)) {
        return ncr_result_error_@CLOSE_RESULT_ID@("invalid WebSocket timeout", sizeof("invalid WebSocket timeout") - 1U, line, column);
    }
    if (!ncr_ws_valid_close_code(@CLOSE_CODE_ARG@) || @CLOSE_REASON_ARG@ == NULL
        || @CLOSE_REASON_ARG@->length < 0 || @CLOSE_REASON_ARG@->length > 123
        || (@CLOSE_REASON_ARG@->length > 0 && @CLOSE_REASON_ARG@->bytes == NULL)
        || !ncr_ws_valid_utf8(@CLOSE_REASON_ARG@->bytes, (size_t)@CLOSE_REASON_ARG@->length)) {
        return ncr_result_error_@CLOSE_RESULT_ID@("invalid WebSocket close payload", sizeof("invalid WebSocket close payload") - 1U, line, column);
    }
    unsigned char close_payload[NCR_WS_CLOSE_PAYLOAD_LIMIT];
    close_payload[0] = (unsigned char)((uint32_t)@CLOSE_CODE_ARG@ >> 8);
    close_payload[1] = (unsigned char)@CLOSE_CODE_ARG@;
    if (@CLOSE_REASON_ARG@->length > 0) {
        memcpy(close_payload + 2U, @CLOSE_REASON_ARG@->bytes, (size_t)@CLOSE_REASON_ARG@->length);
    }
    size_t close_length = 2U + (size_t)@CLOSE_REASON_ARG@->length;
    ncr_self->closing = true;
    if (!ncr_ws_send_frame(ncr_self, 8U, true, close_payload, close_length,
        finite, deadline, &timed_out, &failure)) {
        ncr_ws_transport_cleanup(ncr_self);
        const char *error = timed_out ? "WebSocket close timed out" : "WebSocket close failed";
        return ncr_result_error_@CLOSE_RESULT_ID@(error, strlen(error), line, column);
    }
    for (;;) {
        @BUFFER_TYPE@ message_body = NULL;
        bool message_text = false;
        int status = ncr_ws_receive_inner(ncr_self, @CLOSE_TIMEOUT_ARG@, finite, deadline,
            &message_body, &message_text, &timed_out, &failure, line, column);
        if (status == 1) {
            ncr_drop_@BUFFER_ID@(message_body);
            continue;
        }
        if (status == 2) {
            return (@CLOSE_RESULT_TYPE@){ .tag = @CLOSE_OK_TAG@, .data.v@CLOSE_OK_TAG@.f0 = UINT8_C(0) };
        }
        if (ncr_self->ssl != NULL) {
            bool shutdown_timed_out = false;
            int shutdown_failure = 0;
            (void)ncr_ws_tls_shutdown(ncr_self, @CLOSE_TIMEOUT_ARG@, &shutdown_timed_out, &shutdown_failure);
        }
        ncr_ws_transport_cleanup(ncr_self);
        const char *error = status == 0 || timed_out ? "WebSocket close timed out" : "WebSocket close failed";
        return ncr_result_error_@CLOSE_RESULT_ID@(error, strlen(error), line, column);
    }
}
/* WEBSOCKET_GROUP_END close_method */

/* WEBSOCKET_GROUP message_is_text_method */
static bool @MESSAGE_IS_TEXT_FN@(@MESSAGE_SELF_TYPE@ ncr_self, size_t line, size_t column) {
    (void)line; (void)column;
    return ncr_self->is_text;
}

/* WEBSOCKET_GROUP_END message_is_text_method */
/* WEBSOCKET_GROUP message_body_method */
static @MESSAGE_BODY_RETURN_TYPE@ @MESSAGE_BODY_FN@(@MESSAGE_SELF_TYPE@ ncr_self, size_t line, size_t column) {
    (void)line; (void)column;
    return ncr_self->body;
}
/* WEBSOCKET_GROUP_END message_body_method */

/* WEBSOCKET_GROUP message_as_text_method */
static @AS_TEXT_RESULT_TYPE@ @MESSAGE_AS_TEXT_FN@(@MESSAGE_SELF_TYPE@ ncr_self, size_t line, size_t column) {
    if (!ncr_self->is_text || ncr_self->body == NULL
        || !ncr_ws_valid_utf8(ncr_self->body->bytes, ncr_self->body->length)) {
        return ncr_result_error_@AS_TEXT_RESULT_ID@("WebSocket message is not valid text", sizeof("WebSocket message is not valid text") - 1U, line, column);
    }
    @TEXT_TYPE@ text = @TEXT_FROM_BYTES@(ncr_self->body->bytes, ncr_self->body->length, line, column);
    return (@AS_TEXT_RESULT_TYPE@){ .tag = @AS_TEXT_OK_TAG@, .data.v@AS_TEXT_OK_TAG@.f0 = text };
}
/* WEBSOCKET_GROUP_END message_as_text_method */
